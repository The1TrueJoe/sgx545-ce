+</bitset>
+
+<bitset name="op16s1" extends="#hw16">
+	<doc>Repeat h12-13 only. Operation unknown.</doc>
+	<display>
+		{PRED}{NAME} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {F2_15} {S8} {X38} {X1C} {X39} {II}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="F2_15" low="35" high="38" type="custom"/>
+	<field name="S8" pos="39" type="bool" display=" s8"/>
+	<field name="X38" pos="40" type="bool" display=" x38"/>
+	<field name="X1C" pos="41" type="bool" display=" x1c"/>
+	<field name="X39" low="42" high="43" type="custom"/>
+	<field name="RPT" low="44" high="45" type="#rpt4"/>
+	<pattern pos="46">0</pattern>
+	<field name="II" pos="47" type="#op16s1-i"/>
+	<pattern low="52" high="53">01</pattern>
+	<pattern pos="56">0</pattern>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="bilin" extends="#hw16">
+	<display>
+		{PRED}{NAME}{FMTX} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {ILEAVE} {SRC23} {DST23} {IRND}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<pattern low="35" high="39">00000</pattern>
+	<field name="FMTX" low="40" high="41" type="#fmt-u8"/>
+	<field name="DST23" pos="42" type="bool" display=" dst23"/>
+	<field name="SRC23" pos="43" type="bool" display=" src23"/>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<field name="IRND" pos="47" type="bool" display=" rnd"/>
+	<pattern low="52" high="53">10</pattern>
+	<field name="ILEAVE" pos="56" type="bool" display=" ileave"/>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="#ssum16" extends="#hw16-noext1">
+	<doc>
+		src0 has no bank bits: its number (l14-20) is read in src1's bank;
+		src1 has no extension bit.
+	</doc>
+	<display>
+		{PRED}ssum16{FMTX} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {X1B} {X1C} {X1D} {NF16}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<pattern low="34" high="38">00000</pattern>
+	<field name="X1C" pos="39" type="bool" display=" x1c"/>
+	<field name="X1D" pos="42" type="bool" display=" x1d"/>
+	<pattern pos="43">0</pattern>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<field name="NF16" pos="47" type="bool" display=" nf16"/>
+	<pattern low="52" high="53">11</pattern>
+	<field name="X1B" pos="56" type="bool" display=" x1b"/>
+	<derived name="SRC0" type="#src" width="10">
+		<expr>{S0N} | ({S1B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="S0N">SGX_SRC(0, 0) &amp; 0x7f</map>
+	</encode>
+</bitset>
+<bitset name="ssum16" extends="#ssum16">
+	<derived name="FMTX" type="#fmt-u8"><expr>0</expr></derived>
+	<pattern low="40" high="41">00</pattern>
+</bitset>
+<bitset name="ssum16.s8" extends="#ssum16">
+	<derived name="FMTX" type="#fmt-u8"><expr>1</expr></derived>
+	<pattern low="40" high="41">01</pattern>
+</bitset>
+<bitset name="ssum16.o8" extends="#ssum16">
+	<derived name="FMTX" type="#fmt-u8"><expr>2</expr></derived>
+	<pattern low="40" high="41">10</pattern>
+</bitset>
+
+<bitset name="ssum16i" extends="#instruction">
+	<doc>src0 is an internal register, its number raw in l14-20; no src1.</doc>
+	<display>
+		{PRED}{NAME} {DST}, i{S0N}, {SRC2} [{SKIPINV} {NOSCHED} {END} {RPT} {X1B} {X1C} {X1D} {NF16}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<pattern low="7" high="13">0000000</pattern>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<pattern low="30" high="31">00</pattern>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<pattern low="34" high="38">00000</pattern>
+	<field name="X1C" pos="39" type="bool" display=" x1c"/>
+	<pattern low="40" high="41">11</pattern>
+	<field name="X1D" pos="42" type="bool" display=" x1d"/>
+	<pattern pos="43">0</pattern>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<field name="NF16" pos="47" type="bool" display=" nf16"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<pattern pos="49">0</pattern>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="DE" pos="51" type="uint"/>
+	<pattern low="52" high="53">11</pattern>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="X1B" pos="56" type="bool" display=" x1b"/>
+	<field name="PRED" low="57" high="58" type="#pred2"/>
+	<pattern low="59" high="63">10110</pattern>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="S0N">src->src[0].num</map>
+		<map name="RPT">sgx_isa_rpt(src)</map>
+	</encode>
+</bitset>
+
+<!-- hw 17: firv (h2 = 0), firh (h2 = 1) -->
+<bitset name="firv" extends="#int-plain">
+	<doc>
+		src0's number (l14-20) is read in src1's bank. shift is 5 bits:
+		0-1 h10-11, 2-3 h14-15, 4 h24 (printed raw). Repeat h12-13.
+	</doc>
+	<display>
+		{PRED}{NAME}{FMTX} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {A5} {COEF} {SHIFT} {A8}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<pattern pos="34">0</pattern>
+	<field name="COEF" low="35" high="37" type="custom"/>
+	<field name="A5" low="38" high="39" type="custom"/>
+	<field name="FMTX" low="40" high="41" type="#fmt-u8"/>
+	<field name="SH01" low="42" high="43" type="uint"/>
+	<field name="RPT" low="44" high="45" type="#rpt4"/>
+	<field name="SH23" low="46" high="47" type="uint"/>
+	<field name="A8" low="52" high="53" type="custom"/>
+	<field name="SH4" pos="56" type="uint"/>
+	<pattern low="59" high="63">10111</pattern>
+	<derived name="SHIFT" type="custom" width="5">
+		<expr>{SH01} | ({SH23} &lt;&lt; 2) | ({SH4} &lt;&lt; 4)</expr>
+	</derived>
+	<derived name="SRC0" type="#src" width="10">
+		<expr>{S0N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="S0N">SGX_SRC(0, 0) &amp; 0x7f</map>
+	</encode>
+</bitset>
+
+<bitset name="firh" extends="#instruction">
+	<doc>
+		The dest is an internal register, its number raw in l21-27; shift
+		bits 2-3 move to h0-1; repeat h12-14; h19 = f2_27.
+	</doc>
+	<display>
+		{PRED}{NAME}{FMTX} i{DN}, {SRC0}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {END} {RPT} {A5} {COEF} {SHIFT} {A8} {F2_27}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="SH23" low="32" high="33" type="uint"/>
+	<pattern pos="34">1</pattern>
+	<field name="COEF" low="35" high="37" type="custom"/>
+	<field name="A5" low="38" high="39" type="custom"/>
+	<field name="FMTX" low="40" high="41" type="#fmt-u8"/>
+	<field name="SH01" low="42" high="43" type="uint"/>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<pattern pos="47">0</pattern>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="F2_27" pos="51" type="bool" display=" f2_27"/>
+	<field name="A8" low="52" high="53" type="custom"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="SH4" pos="56" type="uint"/>
+	<field name="PRED" low="57" high="58" type="#pred2"/>
+	<pattern low="59" high="63">10111</pattern>
+	<derived name="SHIFT" type="custom" width="5">
+		<expr>{SH01} | ({SH23} &lt;&lt; 2) | ({SH4} &lt;&lt; 4)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="SRC0" type="#src" width="10">
+		<expr>{S0N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="DN">src->dst.num</map>
+		<map name="S0N">SGX_SRC(0, 0) &amp; 0x7f</map>
+		<map name="RPT">sgx_isa_rpt(src)</map>
+	</encode>
+</bitset>
+
+<!-- hw 07: efo -->
+<expr name="#efo-mode">(ISA_GPU_ID() % 100 &amp; 2) ? 4 : 0</expr>
+
+<bitset name="efo" extends="#instruction">
+	<doc>
+		Two multipliers and two adders feeding i0/i1: d (h20-21) picks what
+		the destination gets, i (h18-19) the internal writes, a (h16-17) the
+		adder inputs, m (h14-15) the multiplier inputs. Short predicate
+		h24-25; no end bit. Operands follow the F16 format control.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {S0NEG}{SRC0}, {S1NEG}{SRC1}, {S2NEG}{SRC2} [{SKIPINV} {NOSCHED} {RPT} {D} {I} {A} {M} {WI0} {WI1} {A0LNEG} {A0RNEG} {F3_10}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="S2NEG" pos="35" type="bool" display="-"/>
+	<field name="S1NEG" pos="36" type="bool" display="-"/>
+	<field name="S0NEG" pos="37" type="bool" display="-"/>
+	<field name="S0E" pos="38" type="uint"/>
+	<field name="S2E" pos="39" type="uint"/>
+	<field name="F3_10" pos="40" type="bool" display=" f3_10"/>
+	<field name="WI1" pos="41" type="bool" display=" wi1"/>
+	<field name="WI0" pos="42" type="bool" display=" wi0"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="RPT" low="44" high="45" type="#rpt4"/>
+	<field name="M" low="46" high="47" type="#efo-m"/>
+	<field name="A" low="48" high="49" type="#efo-a"/>
+	<field name="I" low="50" high="51" type="#efo-i"/>
+	<field name="D" low="52" high="53" type="#efo-d"/>
+	<field name="A0LNEG" pos="54" type="bool" display=" a0lneg"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="57" type="#pred2"/>
+	<field name="A0RNEG" pos="58" type="bool" display=" a0rneg"/>
+	<pattern low="59" high="63">00111</pattern>
+	<derived name="EMODE" expr="#efo-mode" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+		<param name="EMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7) | ({S0E} &lt;&lt; 8)</expr>
+		<param name="EMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7)</expr>
+		<param name="EMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="EMODE" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="DN">SGX_DSTX(SGX_EXPR(__efo_mode)) &amp; 0x7f</map>
+		<map name="DB">(SGX_DSTX(SGX_EXPR(__efo_mode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S0N">SGX_SRC0(SGX_EXPR(__efo_mode)) &amp; 0x7f</map>
+		<map name="S0B">(SGX_SRC0(SGX_EXPR(__efo_mode)) &gt;&gt; 7) &amp; 1</map>
+		<map name="S0E">SGX_SRC0(SGX_EXPR(__efo_mode)) &gt;&gt; 8</map>
+		<map name="S1N">SGX_SRCX(1, SGX_EXPR(__efo_mode)) &amp; 0x7f</map>
+		<map name="S1B">(SGX_SRCX(1, SGX_EXPR(__efo_mode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S2N">SGX_SRC(2, SGX_EXPR(__efo_mode)) &amp; 0x7f</map>
+		<map name="S2B">(SGX_SRC(2, SGX_EXPR(__efo_mode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S2E">SGX_SRC(2, SGX_EXPR(__efo_mode)) &gt;&gt; 9</map>
+		<map name="S0NEG">src->src[0].neg</map>
+		<map name="S1NEG">src->src[1].neg</map>
+		<map name="S2NEG">src->src[2].neg</map>
+		<map name="F3_10">src->f3_10</map>
+		<map name="WI0">src->wi0</map>
+		<map name="WI1">src->wi1</map>
+		<map name="M">src->efo_m</map>
+		<map name="A">src->efo_a</map>
+		<map name="I">src->efo_i</map>
+		<map name="D">src->efo_d</map>
+		<map name="A0LNEG">src->a0lneg</map>
+		<map name="A0RNEG">src->a0rneg</map>
+	</encode>
+</bitset>
+
+<!-- hw 1b: fdual -->
+<bitset name="fdual" extends="#instruction">
+	<doc>
+		Two ops in one word: the primary (pri = h18 | h19 &lt;&lt; 1 | h26 &lt;&lt; 2)
+		on dst (no extension bit) and the slots, the secondary (sec, h6-9)
+		into i0-i2: sd = h5 | h13 &lt;&lt; 1, sb = h14-15, sc = h10 | h21 &lt;&lt; 1;
+		for a mov secondary msrc = h14 | h15 &lt;&lt; 1 | h21 &lt;&lt; 2 instead.
+		No end bit.
+	</doc>
+	<override>
+		<expr>{SEC} == 15</expr>
+		<display>
+			{PRED}{NAME}{PRI}{SEC} {DST}, {SRC0}, {NEG1}{SRC1}, {NEG2}{SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {RPT} {FMT} {SD} {MSRC}]
+		</display>
+		<derived name="MSRC" type="#fdual-msrc">
+			<expr>{SB} | ({SCHI} &lt;&lt; 2)</expr>
+		</derived>
+		<assert pos="42">0</assert>
+	</override>
+	<display>
+		{PRED}{NAME}{PRI}{SEC} {DST}, {SRC0}, {NEG1}{SRC1}, {NEG2}{SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {RPT} {FMT} {SD} {SB} {SC}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="NEG2" pos="35" type="bool" display="-"/>
+	<field name="NEG1" pos="36" type="bool" display="-"/>
+	<field name="SDLO" pos="37" type="uint"/>
+	<field name="SEC" low="38" high="41" type="#fdual-sec"/>
+	<field name="SCLO" pos="42" type="uint"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="RPT" pos="44" type="#rpt2"/>
+	<field name="SDHI" pos="45" type="uint"/>
+	<field name="SB" low="46" high="47" type="#fdual-sb"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="PRI0" pos="50" type="uint"/>
+	<field name="PRI1" pos="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="SCHI" pos="53" type="uint"/>
+	<field name="FMT" pos="54" type="bool" display=" fmt"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="57" type="#pred2"/>
+	<field name="PRI2" pos="58" type="uint"/>
+	<pattern low="59" high="63">11011</pattern>
+	<derived name="PRI" type="#fdual-pri">
+		<expr>{PRI0} | ({PRI1} &lt;&lt; 1) | ({PRI2} &lt;&lt; 2)</expr>
+	</derived>
+	<derived name="SD" type="#fdual-sd"><expr>{SDLO} | ({SDHI} &lt;&lt; 1)</expr></derived>
+	<derived name="SC" type="#fdual-sc"><expr>{SCLO} | ({SCHI} &lt;&lt; 1)</expr></derived>
+	<derived name="SMODE" expr="#float-smode" type="uint"/>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="SMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="SMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="SMODE" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="DN">SGX_DSTX(0) &amp; 0x7f</map>
+		<map name="DB">(SGX_DSTX(0) &gt;&gt; 7) &amp; 3</map>
+		<map name="S0N">SGX_SRC0(SGX_EXPR(__float_smode)) &amp; 0x7f</map>
+		<map name="S0B">(SGX_SRC0(SGX_EXPR(__float_smode)) &gt;&gt; 7) &amp; 1</map>
+		<map name="S1N">SGX_SRC(1, SGX_EXPR(__float_smode)) &amp; 0x7f</map>
+		<map name="S1B">(SGX_SRC(1, SGX_EXPR(__float_smode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S1E">SGX_SRC(1, SGX_EXPR(__float_smode)) &gt;&gt; 9</map>
+		<map name="S2N">SGX_SRC(2, SGX_EXPR(__float_smode)) &amp; 0x7f</map>
+		<map name="S2B">(SGX_SRC(2, SGX_EXPR(__float_smode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S2E">SGX_SRC(2, SGX_EXPR(__float_smode)) &gt;&gt; 9</map>
+		<map name="NEG1">src->src[1].neg</map>
+		<map name="NEG2">src->src[2].neg</map>
+		<map name="SEC">src->sec</map>
+		<map name="PRI0">src->pri &amp; 1</map>
+		<map name="PRI1">(src->pri &gt;&gt; 1) &amp; 1</map>
+		<map name="PRI2">src->pri &gt;&gt; 2</map>
+		<map name="SDLO">src->sd &amp; 1</map>
+		<map name="SDHI">src->sd &gt;&gt; 1</map>
+		<map name="SB">src->sec == 15 ? (src->msrc &amp; 3) : src->sb</map>
+		<map name="SCLO">src->sc &amp; 1</map>
+		<map name="SCHI">src->sec == 15 ? (src->msrc &gt;&gt; 2) : (src->sc &gt;&gt; 1)</map>
+	</encode>
+</bitset>
+
+
+
+</isa>
diff --git a/src/sgx/isa/sgx_isa.h b/src/sgx/isa/sgx_isa.h
new file mode 100644
index 0000000..dbe0897
--- /dev/null
+++ b/src/sgx/isa/sgx_isa.h
@@ -0,0 +1,237 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * SGX545 USSE instructions: the encoder and disassembler generated from
+ * sgx.xml. The compiler fills a struct sgx_isa_instr and calls
+ * sgx_isa_encode().
+ *
+ * Operands are given by slot: dst, src[0] (src0), src[1] (src1), src[2]
+ * (src2). A form with one source (frcp, mov, ...) uses src[1]. Fields a form
+ * doesn't have are ignored.
+ */
+
+#ifndef SGX_ISA_H
+#define SGX_ISA_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "sgx-isa-enums.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum sgx_isa_file {
+   SGX_ISA_FILE_NONE = 0,
+   SGX_ISA_FILE_R,   /* temporaries */
+   SGX_ISA_FILE_O,   /* outputs */
+   SGX_ISA_FILE_PA,  /* primary attributes */
+   SGX_ISA_FILE_SA,  /* secondary attributes */
+   SGX_ISA_FILE_IX,  /* ixbank[idx<ixreg> + num] */
+   SGX_ISA_FILE_C,   /* hardware constants c0-c63 */
+   SGX_ISA_FILE_G,   /* special registers */
+   SGX_ISA_FILE_IMM, /* #num */
+   SGX_ISA_FILE_I,   /* internal registers i0-i3 */
+   SGX_ISA_FILE_IDX, /* index registers (destination only) */
+};
+
+enum sgx_isa_fmt {
+   SGX_ISA_FMT_NONE = 0,
+   SGX_ISA_FMT_F16,
+   SGX_ISA_FMT_C10,
+};
+
+struct sgx_isa_src {
+   uint8_t file; /* enum sgx_isa_file */
+   uint8_t fmt; /* enum sgx_isa_fmt: number bit 6 under format select/control */
+   uint8_t half;   /* F16 half (0 lo, 1 hi) where F16 numbers count halves */
+   uint8_t ixbank; /* IX: 0 r, 1 o, 2 pa, 3 sa */
+   uint8_t ixreg;  /* IX: 1 or 2 */
+   uint8_t lane;   /* pck .l<n> */
+   bool neg, abs;
+   uint32_t num; /* register, constant, immediate, or IX offset */
+};
+
+struct sgx_isa_instr {
+   enum sgx_isa_opc opc;
+
+   /* Common */
+   uint8_t
+      pred; /* the class's predicate field value (enum sgx_isa_pred3/pred2) */
+   bool skipinv, nosched, syncs, end;
+   bool fmt; /* format select */
+   bool moe, inc[3];
+   bool rcnt;    /* repeat-count form (classes with h21 rcnt) */
+   uint8_t rpt;  /* repeat count; 0 and 1 both mean once */
+   uint8_t mask; /* write mask when there is no repeat count */
+   uint8_t drc;
+
+   struct sgx_isa_src dst, src[3];
+
+   /* float */
+   bool f16d;
+   bool sf16,
+      sc10;      /* hw 1: the source is F16 (h7) / C10 (h8); both may be set */
+   uint8_t chan; /* hw1 chan, test chan */
+   uint8_t swz[3]; /* fmad16, enum sgx_isa_f16swz */
+   uint8_t cp[2];  /* fdpc / fddpc clip planes */
+   uint8_t idst;   /* fddp / fddpc second destination i0/i1 */
+
+   /* moves */
+   uint8_t cond; /* movc, enum sgx_isa_movc_cond */
+   bool f1_1, f1_26;
+   uint8_t a3f;
+
+   /* pck */
+   uint8_t dfmt, sfmt; /* enum sgx_isa_pck_fmt */
+   uint8_t dmask;
+   bool scale; /* l18: scale, or rint for float pairs */
+   uint8_t rnd;
+
+   /* test / testmask */
+   uint8_t alu;   /* enum sgx_isa_test_alu */
+   uint8_t tcond; /* enum sgx_isa_test_cond */
+   uint8_t pdst;
+   uint8_t ttype;    /* enum sgx_isa_testmask_type */
+   bool has_nodst;   /* without a destination, the dst field holds nodst */
+   uint16_t nodst;   /* (default 0x280 when has_nodst is false) */
+   bool has_unused2; /* rlp: src2's slot as one 10-bit value is unused2 */
+   uint16_t unused2; /* (default 0x300, the unused pattern, when has_unused2 is
+                        false) */
+   bool f2_0;
+
+   /* bitwise */
+   bool inv, partial;
+   uint8_t rot;
+
+   /* smp */
+   uint8_t dim, lod, cfmt, pcf, ret;
+
+   /* ld / st / eld */
+   uint8_t am, size;
+   bool range, preinc, postinc, f2_2, f2_3, f2_9, f3_13;
+
+   /* special */
+   int32_t target; /* branch target, phas.i pc */
+   bool link, f1_22, syncend, xsyncend, f2_26, f3_5;
+   int16_t v[4];   /* smoa/smr/smbo/imo/smlsi values */
+   uint8_t am4[4]; /* smoa modes */
+   bool swzf[4];   /* smlsi: value is a swizzle */
+   uint8_t lim[3]; /* smlsi */
+   uint8_t a[2];   /* setfc */
+   uint8_t n;
+   uint8_t path, tgt;
+   bool f10, f12, f13, f3_20, f3_6, f3_11, f3_12;
+   uint32_t imm; /* limm, emit, eld immediates */
+   bool sel34, sel36, sel37, sel43, pw, f2_25;
+   uint8_t temps4, wait, rate;
+
+   /*
+    * Color / integer classes (sop2, sopwm, sop3 family, dot, ima8, fpma):
+    * each select is a value and a complement flag ("1-x").
+    */
+   uint8_t c0, c1, c2, a0, a1, a2, asel;
+   bool c0c, c1c, c2c, a0c, a1c, a2c, aselc;
+   uint8_t cop, aop;
+   bool cs1c, as1c, aneg, arev, cneg;
+   uint8_t l1, l2, lcs, p; /* lrp1, sop3x */
+   bool l1c, l2c;
+   bool f4, f6, s1c, s2c, s1ac; /* dot */
+   uint8_t dcs, das;            /* dot color / alpha scale */
+
+   /* ima16 / imae / ima32 */
+   bool sat, sgn, dflag1, s0hi, s1hi, s2hi, cout, cin, ci, negp;
+   uint8_t f2_15, f1, f2, t2, hi, cin3;
+
+   /* hw 16 / 17 */
+   uint8_t ifmt, x39, ii, a5, coef, shift, a8;
+   bool ileave, src23, dst23, irnd, x1b, x1c, x1d, nf16, s8, x38, s0f13, f2_27;
+
+   /* efo */
+   uint8_t efo_d, efo_i, efo_a, efo_m;
+   bool wi0, wi1, a0lneg, a0rneg, f3_10;
+
+   /* fdual */
+   uint8_t pri, sec, sd, sb, sc, msrc;
+};
+
+/* Cores sgx.xml describes; the value is the core's number. */
+enum sgx_isa_core {
+   SGX_ISA_CORE_SGX545 = 545,
+};
+
+/*
+ * What an encoding depends on besides the instruction: the target core and
+ * format control (setfc), program state the color/integer classes read.
+ */
+struct sgx_isa_fc {
+   bool c10;      /* setfc a1: on at program start */
+   bool f16;      /* setfc a0 (efo): off at program start */
+   uint16_t core; /* enum sgx_isa_core; 0 is SGX545 */
+};
+
+#define SGX_ISA_FC_START ((struct sgx_isa_fc){.c10 = true, .f16 = false})
+
+/* Whether sgx.xml describes the core (0 counts as SGX545). */
+bool sgx_isa_core_supported(unsigned core);
+
+/*
+ * What sgx.xml's expressions read as ISA_GPU_ID() and its <gen> ranges
+ * compare: core * 100 + format control (bit 0 C10, bit 1 F16).
+ */
+uint32_t sgx_isa_gpu_id(const struct sgx_isa_fc *fc);
+
+/* If word is a setfc, apply it to *fc and return true. */
+bool sgx_isa_setfc(uint64_t word, struct sgx_isa_fc *fc);
+
+/* Encode one instruction. fc may be NULL (program-start state). */
+uint64_t sgx_isa_encode(const struct sgx_isa_instr *instr,
+                        const struct sgx_isa_fc *fc);
+
+/*
+ * Disassemble n instructions (low word first) to out, one per line.
+ * Format control is tracked through setfc from fc (NULL: program start).
+ */
+void sgx_disasm(const uint32_t *words, unsigned n, FILE *out,
+                const struct sgx_isa_fc *fc);
+
+/* One instruction to a string (no newline); false if nothing matched. */
+bool sgx_disasm_one(uint64_t word, const struct sgx_isa_fc *fc, char *buf,
+                    size_t size);
+
+/*
+ * Co-issue (fdual, and efo's internal registers). What an fdual's two
+ * halves read and write: bit n of an _i mask is i<n> (r124+n counts as
+ * i<n>), bit k of a _slots mask the src<k> slot. settled is false where the
+ * op's operands aren't known (fmaxmin, fmad16 and ima32 as the secondary,
+ * fddp and ima32 as the primary); the masks then assume the most.
+ */
+struct sgx_isa_fdual_use {
+   uint8_t sec_reads_i, sec_writes_i, sec_reads_slots;
+   uint8_t pri_reads_i, pri_writes_i, pri_reads_slots;
+   bool settled;
+};
+
+bool sgx_isa_fdual_use(const struct sgx_isa_instr *instr,
+                       struct sgx_isa_fdual_use *use);
+
+/*
+ * A same-word race the hardware shows (an fdual primary reading an internal
+ * register its secondary writes; efo's d naming I0 while the word writes I0):
+ * a reason, or NULL. Not hazards: both halves reading one slot, the
+ * secondary reading an internal register the primary writes, the next
+ * instruction reading the secondary's result, efo's d=i1 with wi1 (it reads
+ * the old I1).
+ */
+const char *sgx_isa_coissue_hazard(const struct sgx_isa_instr *instr);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/sgx/isa/sgx_isa_asm.c b/src/sgx/isa/sgx_isa_asm.c
new file mode 100644
index 0000000..8882a2b
--- /dev/null
+++ b/src/sgx/isa/sgx_isa_asm.c
@@ -0,0 +1,1077 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * A small assembler for the USSE text notation (README.md), into struct
+ * sgx_isa_instr:
+ *
+ *    [(pred)] mnemonic[.suffix...] operand, operand, ... [item item=value ...]
+ *
+ * It only knows the notation (names, operand order, defaults); the bits
+ * come from the encoder generated from sgx.xml. Used by the tests and
+ * by tools that want to write USSE by hand.
+ */
+
+#include <ctype.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sgx_isa_asm.h"
+
+#define ARRAY_LEN(a) (sizeof(a) / sizeof((a)[0]))
+
+struct asm_ctx {
+   char *err;
+   size_t errsize;
+};
+
+static bool
+fail(struct asm_ctx *c, const char *fmt, const char *arg)
+{
+   if (c->err && c->errsize) {
+      snprintf(c->err, c->errsize, fmt, arg);
+   }
+   return false;
+}
+
+static int
+lookup(const char *const *names, unsigned n, const char *s)
+{
+   for (unsigned i = 0; i < n; i++) {
+      if (names[i] && !strcmp(names[i], s))
+         return i;
+   }
+   return -1;
+}
+
+#define LOOKUP(tbl, s) lookup(tbl, ARRAY_LEN(tbl), s)
+
+static const char *const pck_fmt[] = {"u8",  "s8",  "o8",  "u16",
+                                      "s16", "f16", "f32", "c10"};
+static const char *const movc_cond[] = {"z", "nz", "ltz", "gez"};
+static const char *const movc_type[] = {NULL, "u8", "i16", "i32", "f32", "c10"};
+static const char *const smp_dim[] = {"1d", "2d", "3d", "dim3"};
+static const char *const smp_lod[] = {NULL, "bias", "lod", "grad"};
+static const char *const smp_cfmt[] = {NULL, "f16", "c10", "cfmt3"};
+static const char *const smp_pcf[] = {NULL, "pcf", "pcf16", "pcf3"};
+static const char *const smp_ret[] = {NULL, "rdata", "rinfo", "ret3"};
+static const char *const ld_am[] = {"a", "l", "t", "am3"};
+static const char *const ld_size[] = {"d", "w", "b", "q"};
+static const char *const tm_type[] = {"byte", "word", "dword", "tm3"};
+static const char *const emit_tgt[] = {"t0", "t1", "t2", "t3"};
+static const char *const rnd_names[] = {"ne", "down", "up", "zero"};
+static const char *const f16swz[] = {NULL, "ll", "hh", "f32"};
+
+static const char *const test_alu[64] = {
+   [0x00] = "fadd",    [0x03] = "fsubflr", [0x04] = "frcp",
+   [0x05] = "frsq",    [0x06] = "flog2",   [0x07] = "fexp2",
+   [0x08] = "fdp",     [0x09] = "fmin",    [0x0a] = "fmax",
+   [0x0b] = "fdsx",    [0x0c] = "fdsy",    [0x0d] = "fmul",
+   [0x0e] = "fsub",    [0x16] = "iadd16",  [0x17] = "isub16",
+   [0x18] = "imul16",  [0x19] = "iaddu16", [0x1a] = "isubu16",
+   [0x1b] = "imulu16", [0x1c] = "iadd32",  [0x1d] = "iaddu32",
+   [0x20] = "i8op0",   [0x21] = "i8op1",   [0x22] = "i8op2",
+   [0x23] = "i8op3",   [0x24] = "i8op4",   [0x25] = "i8op5",
+   [0x26] = "i8op6",   [0x27] = "fpadd8",  [0x28] = "fpsub8",
+   [0x30] = "and",     [0x31] = "or",      [0x32] = "xor",
+   [0x33] = "shl",     [0x34] = "shr",     [0x35] = "rol",
+   [0x37] = "asr",
+};
+
+static int
+parse_test_alu(const char *s)
+{
+   int v = LOOKUP(test_alu, s);
+   if (v < 0 && !strncmp(s, "alu", 3) && strlen(s) == 5 &&
+       isxdigit((unsigned char)s[3]) && isxdigit((unsigned char)s[4]))
+      v = strtol(s + 3, NULL, 16);
+   return v;
+}
+
+static int
+parse_test_cond(const char *s)
+{
+   static const struct {
+      const char *name;
+      int v;
+   } named[] = {
+      {"lt", 0x19}, {"le", 0x05}, {"eq", 0x14},  {"ne", 0x18},
+      {"gt", 0x1a}, {"ge", 0x06}, {"neg", 0x11}, {"pos", 0x12},
+   };
+   for (unsigned i = 0; i < ARRAY_LEN(named); i++) {
+      if (!strcmp(s, named[i].name))
+         return named[i].v;
+   }
+   /* s<sign>z<zero><o|a> */
+   if (strlen(s) == 5 && s[0] == 's' && s[2] == 'z' &&
+       (s[4] == 'o' || s[4] == 'a'))
+      return (s[1] - '0') | (s[3] - '0') << 2 | (s[4] == 'a') << 4;
+   return -1;
+}
+
+static char *
+trim(char *s)
+{
+   while (isspace((unsigned char)*s))
+      s++;
+   char *e = s + strlen(s);
+   while (e > s && isspace((unsigned char)e[-1]))
+      *--e = '\0';
+   return s;
+}
+
+/* A number as wide as a 32-bit field takes, signed or not: -2^31 .. 2^32 - 1. */
+static bool
+parse_int(const char *s, int64_t *v)
+{
+   char *end;
+   if (!*s)
+      return false;
+   errno = 0;
+   long long n = strtoll(s, &end, 0);
+   if (*end || errno || n < INT32_MIN || n > UINT32_MAX)
+      return false;
+   *v = n;
+   return true;
+}
+
+/* Store a parsed number; true if the member holds it unchanged. */
+#define STORE(lv, v) ((lv) = (v), (int64_t)(lv) == (v))
+
+/* Register-like prefixes, longest first. */
+static const struct {
+   const char *prefix;
+   uint8_t file;
+} files[] = {
+   {"idx", SGX_ISA_FILE_IDX}, {"pa", SGX_ISA_FILE_PA}, {"sa", SGX_ISA_FILE_SA},
+   {"r", SGX_ISA_FILE_R},     {"o", SGX_ISA_FILE_O},   {"c", SGX_ISA_FILE_C},
+   {"g", SGX_ISA_FILE_G},     {"i", SGX_ISA_FILE_I},
+};
+
+static bool
+parse_operand(struct asm_ctx *c, char *s, struct sgx_isa_src *o)
+{
+   memset(o, 0, sizeof(*o));
+   s = trim(s);
+   if (*s == '-') {
+      o->neg = true;
+      s = trim(s + 1);
+   }
+   if (*s == '|') {
+      size_t l = strlen(s);
+      if (l < 2 || s[l - 1] != '|')
+         return fail(c, "bad |abs| in '%s'", s);
+      o->abs = true;
+      s[l - 1] = '\0';
+      s++;
+   }
+
+   /* suffixes: .f16[.lo|.hi], .c10, .l<n> */
+   char *dot = strchr(s, '.');
+   char *base = s;
+   if (*s == '#') {
+      /* an immediate's suffixes come after its digits */
+      dot = strchr(s, '.');
+   }
+   char *sfx = NULL;
+   if (dot) {
+      *dot = '\0';
+      sfx = dot + 1;
+   }
+   while (sfx && *sfx) {
+      char *next = strchr(sfx, '.');
+      if (next)
+         *next++ = '\0';
+      if (!strcmp(sfx, "f16"))
+         o->fmt = SGX_ISA_FMT_F16;
+      else if (!strcmp(sfx, "c10"))
+         o->fmt = SGX_ISA_FMT_C10;
+      else if (!strcmp(sfx, "lo"))
+         o->half = 0;
+      else if (!strcmp(sfx, "hi"))
+         o->half = 1;
+      else if (sfx[0] == 'l' && sfx[1] >= '0' && sfx[1] <= '3' && !sfx[2])
+         o->lane = sfx[1] - '0';
+      else
+         return fail(c, "unknown operand suffix '%s'", sfx);
+      sfx = next;
+   }
+
+   int64_t v;
+   if (*base == '#') {
+      if (!parse_int(base + 1, &v))
+         return fail(c, "bad immediate '%s'", base);
+      o->file = SGX_ISA_FILE_IMM;
+      o->num = (uint32_t)v;
+      return true;
+   }
+
+   char *br = strchr(base, '[');
+   if (br) {
+      /* bank[idx<k>+off] */
+      *br = '\0';
+      static const char *const ib[] = {"r", "o", "pa", "sa"};
+      int b = LOOKUP(ib, base);
+      unsigned k, off = 0;
+      if (b < 0 || sscanf(br + 1, "idx%u+%u]", &k, &off) < 1)
+         return fail(c, "bad indexed operand '%s'", base);
+      o->file = SGX_ISA_FILE_IX;
+      o->ixbank = b;
+      o->ixreg = k;
+      o->num = off;
+      return true;
+   }
+
+   for (unsigned i = 0; i < ARRAY_LEN(files); i++) {
+      size_t l = strlen(files[i].prefix);
+      if (!strncmp(base, files[i].prefix, l) &&
+          isdigit((unsigned char)base[l]) && parse_int(base + l, &v)) {
+         o->file = files[i].file;
+         o->num = (uint32_t)v;
+         return true;
+      }
+   }
+   return fail(c, "bad operand '%s'", base);
+}
+
+static int
+parse_pn(const char *s)
+{
+   if (s[0] == 'p' && s[1] >= '0' && s[1] <= '3' && (!s[2] || s[2] == '.'))
+      return s[1] - '0';
+   return -1;
+}
+
+static bool
+parse_hash(struct asm_ctx *c, const char *s, int64_t *v)
+{
+   s = trim((char *)s);
+   if (*s != '#' || !parse_int(s + 1, v))
+      return fail(c, "expected #value, got '%s'", s);
+   return true;
+}
+
+static bool
+parse_pred(const char *s, bool short_form, uint8_t *pred)
+{
+   static const char *const p3[] = {NULL, "p0",  "p1",  "p2",
+                                    "p3", "!p0", "!p1", "pn"};
+   static const char *const p2[] = {NULL, "p0", "p1", "!p0"};
+   int v = short_form ? LOOKUP(p2, s) : LOOKUP(p3, s);
+   if (v < 0)
+      return false;
+   *pred = v;
+   return true;
+}
+
+/* Bracket items: "name" or "name=value". */
+static bool
+parse_item(struct asm_ctx *c, struct sgx_isa_instr *I, char *item)
+{
+   char *eq = strchr(item, '=');
+   const char *val = NULL;
+   int64_t v = 0;
+   if (eq) {
+      *eq = '\0';
+      val = eq + 1;
+      if (!parse_int(val, &v))
+         v = -1;
+   }
+
+   /* clang-format off */
+#define FLAG(name, field)                                                     \
+   if (!strcmp(item, name) && !eq) { I->field = true; return true; }
+#define VAL(name, field)                                                      \
+   if (!strcmp(item, name) && eq && v >= 0)                                    \
+      return STORE(I->field, v) || fail(c, "%s doesn't fit its field", val);
+   FLAG("skipinv", skipinv) FLAG("nosched", nosched) FLAG("syncs", syncs)
+   FLAG("end", end) FLAG("fmt", fmt) FLAG("moe", moe)
+   FLAG("inc0", inc[0]) FLAG("inc1", inc[1]) FLAG("inc2", inc[2])
+   FLAG("f16d", f16d) FLAG("f1_1", f1_1) FLAG("f1_26", f1_26)
+   FLAG("f2_0", f2_0) FLAG("partial", partial) FLAG("preinc", preinc)
+   FLAG("postinc", postinc) FLAG("range", range) FLAG("f2_2", f2_2)
+   FLAG("f2_3", f2_3) FLAG("f2_9", f2_9) FLAG("f3_13", f3_13)
+   FLAG("syncend", syncend) FLAG("xsyncend", xsyncend) FLAG("link", link)
+   FLAG("f1_22", f1_22) FLAG("f2_26", f2_26) FLAG("f3_5", f3_5)
+   FLAG("f10", f10) FLAG("f12", f12) FLAG("f13", f13) FLAG("f3_20", f3_20)
+   FLAG("f3_6", f3_6) FLAG("f3_11", f3_11) FLAG("f3_12", f3_12)
+   FLAG("sel34", sel34) FLAG("sel36", sel36) FLAG("sel37", sel37)
+   FLAG("sel43", sel43) FLAG("f2_25", f2_25) FLAG("scale", scale)
+   FLAG("rint", scale)
+   VAL("mask", mask) VAL("drc", drc) VAL("chan", chan) VAL("a3f", a3f)
+   VAL("dmask", dmask) VAL("rot", rot) VAL("path", path)
+   VAL("n", n) VAL("imm", imm) VAL("rate", rate) VAL("wait", wait)
+   VAL("am0", am4[0]) VAL("am1", am4[1]) VAL("am2", am4[2])
+   VAL("am3", am4[3]) VAL("lim0", lim[0]) VAL("lim1", lim[1])
+   VAL("lim2", lim[2])
+#undef FLAG
+#undef VAL
+      /* clang-format on */
+
+      if (!strcmp(item, "unused2") && eq && v >= 0 && I->opc == SGX_ISA_OPC_RLP)
+   {
+      I->has_unused2 = true;
+      return STORE(I->unused2, v) || fail(c, "%s doesn't fit its field", val);
+   }
+   if (!strcmp(item, "nodst") && eq && v >= 0) {
+      I->has_nodst = true;
+      return STORE(I->nodst, v) || fail(c, "%s doesn't fit its field", val);
+   }
+   /* the classes with h21 rcnt write "rcnt" or "rcnt rpt=n" (checked at the
+    * end) */
+   if (!strcmp(item, "rcnt") && !eq) {
+      I->rcnt = true;
+      return true;
+   }
+   if (!strcmp(item, "rpt") && eq && v >= 1)
+      return STORE(I->rpt, v) || fail(c, "%s doesn't fit its field", val);
+   if ((!strcmp(item, "swz0") || !strcmp(item, "swz1") ||
+        !strcmp(item, "swz2")) &&
+       eq) {
+      int sw = v >= 0 ? v : LOOKUP(f16swz, val);
+      if (sw < 0 || sw > 3)
+         return fail(c, "bad swizzle '%s'", val);
+      I->swz[item[3] - '0'] = sw;
+      return true;
+   }
+   if (!strcmp(item, "rnd") && eq) {
+      int r = v >= 0 ? v : LOOKUP(rnd_names, val);
+      if (r < 0)
+         return fail(c, "bad rnd '%s'", val);
+      I->rnd = r;
+      return true;
+   }
+   if ((!strcmp(item, "f16") || !strcmp(item, "c10")) && !eq) {
+      /* hw 1: the source's format */
+      if (item[0] == 'f')
+         I->sf16 = true;
+      else
+         I->sc10 = true;
+      return true;
+   }
+   return sgx_isa_asm_item_int(I, item, val)
+             ? true
+             : fail(c, "unknown item '%s'", item);
+}
