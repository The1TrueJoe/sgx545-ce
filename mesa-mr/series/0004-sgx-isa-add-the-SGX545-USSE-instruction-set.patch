+/* The forms with h21 rcnt: h12-15 is a repeat count or a write mask. */
+static bool
+has_rcnt(enum sgx_isa_opc opc)
+{
+   switch (opc) {
+   case SGX_ISA_OPC_FRCP:
+   case SGX_ISA_OPC_FRSQ:
+   case SGX_ISA_OPC_FLOG2:
+   case SGX_ISA_OPC_FEXP2:
+   case SGX_ISA_OPC_FSQRT:
+   case SGX_ISA_OPC_FSIN:
+   case SGX_ISA_OPC_FCOS:
+   case SGX_ISA_OPC_MOV:
+   case SGX_ISA_OPC_MOVC_U8:
+   case SGX_ISA_OPC_MOVC_I16:
+   case SGX_ISA_OPC_MOVC_I32:
+   case SGX_ISA_OPC_MOVC_F32:
+   case SGX_ISA_OPC_MOVC_C10:
+   case SGX_ISA_OPC_OP0XF3_S6:
+   case SGX_ISA_OPC_OP0XF3_S7:
+   case SGX_ISA_OPC_PCK:
+   case SGX_ISA_OPC_AND:
+   case SGX_ISA_OPC_OR:
+   case SGX_ISA_OPC_XOR:
+   case SGX_ISA_OPC_SHL:
+   case SGX_ISA_OPC_ROL:
+   case SGX_ISA_OPC_SHR:
+   case SGX_ISA_OPC_ASR:
+   case SGX_ISA_OPC_RLP:
+   case SGX_ISA_OPC_SMP:
+      return true;
+   default:
+      return false;
+   }
+}
