diff --git a/src/loader/tests/child_render_node_test.c b/src/loader/tests/child_render_node_test.c
new file mode 100644
index 0000000..8bc0155
--- /dev/null
+++ b/src/loader/tests/child_render_node_test.c
@@ -0,0 +1,123 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ *
+ * loader_find_child_render_node on fake sysfs trees: a render node on an
+ * auxiliary device of the display's PCI function is found, render nodes of
+ * other devices are not.
+ */
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "loader.h"
+
+static char root[PATH_MAX];
+static int failures;
+
+static void
+mkdirs(const char *rel)
+{
+   char p[PATH_MAX];
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel);
+   for (char *s = p + strlen(root) + 1; *s; s++) {
+      if (*s == '/') {
+         *s = 0;
+         mkdir(p, 0755);
+         *s = '/';
+      }
+   }
+   mkdir(p, 0755);
+}
+
+static void
+link_at(const char *target, const char *rel)
+{
+   char p[PATH_MAX];
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel);
+   if (symlink(target, p)) {
+      perror(p);
+      exit(1);
+   }
+}
+
+/* a DRM node under device dir rel_dev, and its /sys/class/drm link */
+static void
+node(const char *rel_dev, const char *name)
+{
+   char rel[PATH_MAX], target[PATH_MAX];
+
+   snprintf(rel, sizeof(rel), "%s/drm/%s", rel_dev, name);
+   mkdirs(rel);
+   snprintf(rel, sizeof(rel), "%s/drm/%s/device", rel_dev, name);
+   link_at("../..", rel);
+   snprintf(target, sizeof(target), "../../%s/drm/%s", rel_dev, name);
+   snprintf(rel, sizeof(rel), "class/drm/%s", name);
+   link_at(target, rel);
+}
+
+static void
+expect(const char *rel_parent, const char *want)
+{
+   char parent[PATH_MAX], p[PATH_MAX], name[32] = "";
+   bool found;
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel_parent);
+   if (!realpath(p, parent)) {
+      perror(p);
+      exit(1);
+   }
+   snprintf(p, sizeof(p), "%s/class/drm", root);
+   found = loader_find_child_render_node(p, parent, name, sizeof(name));
+   if (want ? !found || strcmp(name, want) != 0 : found) {
+      fprintf(stderr, "%s: got %s, want %s\n", rel_parent,
+              found ? name : "none", want ? want : "none");
+      failures++;
+   }
+}
+
+int
+main(void)
+{
+   const char *gma = "devices/pci0000:00/0000:00:02.0";
+   const char *other = "devices/pci0000:00/0000:00:03.0";
+   const char *plat = "devices/platform/simple-framebuffer.0";
+
+   snprintf(root, sizeof(root), "%s/child-render-XXXXXX",
+            getenv("TMPDIR") ? getenv("TMPDIR") : "/tmp");
+   if (!mkdtemp(root)) {
+      perror("mkdtemp");
+      return 1;
+   }
+   mkdirs("class/drm");
+
+   /* gma500: the display (card0) on the PCI function, the SGX's render node
+    * on its auxiliary device */
+   node(gma, "card0");
+   node("devices/pci0000:00/0000:00:02.0/gma500_gfx.sgx.0", "card1");
+   node("devices/pci0000:00/0000:00:02.0/gma500_gfx.sgx.0", "renderD129");
+   /* another PCI GPU with a render node of its own, and a platform display */
+   node(other, "card2");
+   node(other, "renderD128");
+   node(plat, "card3");
+
+   expect(gma, "renderD129");
+   /* a GPU's own render node is no child of its device */
+   expect(other, NULL);
+   expect(plat, NULL);
+
+   /* two children: the lowest numbered */
+   node("devices/pci0000:00/0000:00:02.0/second.0", "renderD200");
+   node("devices/pci0000:00/0000:00:02.0/third.0", "renderD130");
+   expect(gma, "renderD129");
+
+   if (!failures)
+      printf("loader_find_child_render_node: all passed\n");
+   return failures != 0;
+}
