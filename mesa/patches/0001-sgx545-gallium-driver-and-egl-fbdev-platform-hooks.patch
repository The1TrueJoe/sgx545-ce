+/* the Intel CE (Cedarview/Groveland) SoCs' PowerVR SGX545, under its
+ * services driver */
+bool
+sgx545_predicate(int fd, const char *driver)
+{
+   char *kernel_driver = loader_get_kernel_driver_name(fd);
+   bool ret = kernel_driver && strcmp(kernel_driver, "pvrsrvkm") == 0;
+
+   free(kernel_driver);
+   return ret;
+}
