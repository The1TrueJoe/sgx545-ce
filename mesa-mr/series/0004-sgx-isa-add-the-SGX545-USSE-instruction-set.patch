+<!-- Operands                                                               -->
+<!-- ===================================================================== -->
+
+<!--
+Destination slot: number l21-27, bank h0-1, extension h19, rebuilt as
+NUM | BANK << 7 | EXT << 9.
+-->
+<bitset name="#dst" size="10">
+	<encode type="struct sgx_isa_src *" case-prefix="SGX_">
+		<map name="NUM">sgx_isa_opnd_num(src)</map>
+		<map name="LNUM">src->num</map>
+		<map name="REG">src->num</map>
+		<map name="HALF">src->half</map>
+		<map name="F">src->fmt != SGX_ISA_FMT_NONE</map>
+		<map name="IB">src->ixbank</map>
+		<map name="K">src->ixreg - 1</map>
+		<map name="OFF">src->num</map>
+	</encode>
+</bitset>
+
+<bitset name="#dst-reg" extends="#dst">
+	<override expr="#m-half">
+		<display>{NAME}{REG}.f16.{HALF}</display>
+		<field name="HALF" pos="0" type="#half"/>
+		<field name="REG" low="1" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-c10">
+		<display>{NAME}{LNUM}.c10</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<display>{NAME}{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+</bitset>
+
+<bitset name="#dst.r" extends="#dst-reg" displayname="r">
+	<pattern low="7" high="9">000</pattern>
+</bitset>
+<bitset name="#dst.o" extends="#dst-reg" displayname="o">
+	<pattern low="7" high="9">001</pattern>
+</bitset>
+<bitset name="#dst.pa" extends="#dst-reg" displayname="pa">
+	<pattern low="7" high="9">010</pattern>
+</bitset>
+<bitset name="#dst.sa" extends="#dst-reg" displayname="sa">
+	<pattern low="7" high="9">100</pattern>
+</bitset>
+
+<bitset name="#dst.ix" extends="#dst">
+	<doc>
+		Indexed: bank[idx&lt;k&gt;+off], number = ib &lt;&lt; (w - 2) | (k - 1) &lt;&lt; (w - 3)
+		| off, w = 7, or 6 under format select.
+	</doc>
+	<override expr="#m-sel-f16">
+		<display>{IB}[idx{KK}+{OFF}].f16</display>
+		<field name="OFF" low="0" high="2" type="uint"/>
+		<field name="K" pos="3" type="uint"/>
+		<field name="IB" low="4" high="5" type="#ibank"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-sel-c10">
+		<display>{IB}[idx{KK}+{OFF}].c10</display>
+		<field name="OFF" low="0" high="2" type="uint"/>
+		<field name="K" pos="3" type="uint"/>
+		<field name="IB" low="4" high="5" type="#ibank"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-sel">
+		<display>{IB}[idx{KK}+{OFF}]</display>
+		<field name="OFF" low="0" high="2" type="uint"/>
+		<field name="K" pos="3" type="uint"/>
+		<field name="IB" low="4" high="5" type="#ibank"/>
+	</override>
+	<display>{IB}[idx{KK}+{OFF}]</display>
+	<field name="OFF" low="0" high="3" type="uint"/>
+	<field name="K" pos="4" type="uint"/>
+	<field name="IB" low="5" high="6" type="#ibank"/>
+	<derived name="KK" type="uint">
+		<expr>{K} + 1</expr>
+	</derived>
+	<pattern low="7" high="9">011</pattern>
+</bitset>
+
+<bitset name="#dst.g" extends="#dst">
+	<doc>Extension bank 1: g&lt;n&gt; is n + 0x40; a number below 64 is c&lt;n&gt;.</doc>
+	<override expr="#m-g">
+		<display>g{GNUM}</display>
+		<derived name="GNUM" type="uint">
+			<expr>{NUM} - 64</expr>
+		</derived>
+	</override>
+	<display>c{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+	<pattern low="7" high="9">101</pattern>
+</bitset>
+
+<bitset name="#dst.idx" extends="#dst">
+	<doc>
+		Not halved under format select: a bare .f16 (or .c10) only sets
+		bit 6: idx16.f16 is number 16 with bit 6 set.
+	</doc>
+	<override expr="#m-sel-f16">
+		<display>idx{LNUM}.f16</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-sel-c10">
+		<display>idx{LNUM}.c10</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<display>idx{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+	<pattern low="7" high="9">110</pattern>
+</bitset>
+
+<bitset name="#dst.i" extends="#dst">
+	<override expr="#m-half">
+		<display>i{LNUM}.f16</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-c10">
+		<display>i{LNUM}.c10</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<display>i{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+	<pattern low="7" high="9">111</pattern>
+</bitset>
+
