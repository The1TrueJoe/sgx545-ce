# kit-desktop RESULTS: Xorg on vt7 (modesetting with glamor on our Mesa) and an
# Xfce session as "desk", then the smoke test (kit-smoke) inside it. Returns 0
# when the session came up; the session stays for the tester afterwards.
R=$1
chmod 1777 "$R" "$R/screenshots"
rm -f /tmp/kit-smoke.done
# the server's EGL and DRI loader explain themselves in xinit.txt (not the clients)
xinit /usr/local/bin/kit-session -- /usr/local/bin/kit-xorg :0 vt7 -nolisten tcp -logfile /var/log/Xorg.0.log > "$R/xinit.txt" 2>&1 &
for i in $(seq 1 40); do [ -S /tmp/.X11-unix/X0 ] && break; sleep 1; done
if [ ! -S /tmp/.X11-unix/X0 ]; then
	printf '    %-5s %s\n' FAIL "X server started" >> "$R/summary.txt"
	return 1 2>/dev/null || exit 1
fi
printf '    %-5s %s\n' PASS "X server started" >> "$R/summary.txt"
# the smoke test signals when it is done; give it at most 10 minutes
for i in $(seq 1 600); do [ -e /tmp/kit-smoke.done ] && break; sleep 1; done
[ -e /tmp/kit-smoke.done ] || printf '    %-5s %s\n' FAIL "desktop smoke test (did not finish in 10 minutes)" >> "$R/summary.txt"
[ -f "$R/modeset.txt" ] && cat "$R/modeset.txt" >> "$R/summary.txt"
[ -f "$R/smoke.txt" ] && cat "$R/smoke.txt" >> "$R/summary.txt"
exit 0
