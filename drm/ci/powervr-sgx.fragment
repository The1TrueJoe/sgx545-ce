# The CE5300 board kernel with powervr_sgx in place of the vendor driver.
# RAM-boot test kernel only: never flash it.
CONFIG_LOCALVERSION="-m2drm"
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DRM=y
# CONFIG_SGX545_CE is not set
CONFIG_DRM_POWERVR_SGX=m
# The vendor microkernel for A/B runs; the upstream build leaves it out.
CONFIG_DRM_POWERVR_SGX_DDK_COMPAT=y
CONFIG_DEBUG_FS=y
CONFIG_FW_LOADER=y
# simpledrm in place of simplefb on the CEFDK framebuffer: a KMS device for
# PRIME (powervr_sgx_prime). It only writes the framebuffer, never the VDC.
# CONFIG_FB_SIMPLE is not set
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# Tracepoints for the latency numbers in docs/PERF.md.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
