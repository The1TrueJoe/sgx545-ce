+<bitset name="#int" extends="#instruction">
+	<doc>
+		Shared by hw 10-19 and 1a: short predicate h25-26, skipinv h23,
+		nosched h22, end h18; generic dst, src1 and src2 slots.
+	</doc>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="57" high="58" type="#pred2"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<!-- Color classes: operands follow the C10 format control. -->
+<bitset name="#int-c10" extends="#int">
+	<derived name="IMODE" expr="#fc-c10" type="uint"/>
+	<encode>
+		<map name="DN">SGX_DST(SGX_EXPR(__fc_c10)) &amp; 0x7f</map>
+		<map name="DB">(SGX_DST(SGX_EXPR(__fc_c10)) &gt;&gt; 7) &amp; 3</map>
+		<map name="DE">SGX_DST(SGX_EXPR(__fc_c10)) &gt;&gt; 9</map>
+		<map name="S0N">SGX_SRC0(SGX_EXPR(__fc_c10)) &amp; 0x7f</map>
+		<map name="S0B">(SGX_SRC0(SGX_EXPR(__fc_c10)) &gt;&gt; 7) &amp; 1</map>
+		<map name="S1N">SGX_SRC(1, SGX_EXPR(__fc_c10)) &amp; 0x7f</map>
+		<map name="S1B">(SGX_SRC(1, SGX_EXPR(__fc_c10)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S1E">SGX_SRC(1, SGX_EXPR(__fc_c10)) &gt;&gt; 9</map>
+		<map name="S2N">SGX_SRC(2, SGX_EXPR(__fc_c10)) &amp; 0x7f</map>
+		<map name="S2B">(SGX_SRC(2, SGX_EXPR(__fc_c10)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S2E">SGX_SRC(2, SGX_EXPR(__fc_c10)) &gt;&gt; 9</map>
+	</encode>
+</bitset>
+
+<!-- The other integer classes don't read format control. -->
+<bitset name="#int-plain" extends="#int">
+	<derived name="IMODE" expr="#zero" type="uint"/>
+</bitset>
+
+<template name="INT_FLAGS">{SKIPINV} {NOSCHED} {END}</template>
