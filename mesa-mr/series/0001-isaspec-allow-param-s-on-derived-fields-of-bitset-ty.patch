From 859ae5db05636046f8074d0d3ed31fd44b4f1efb Mon Sep 17 00:00:00 2001
From: Joseph Telaak <joseph@telaak.dev>
Date: Thu, 12 Nov 2026 17:31:12 -0500
Subject: [PATCH 01/21] isaspec: allow <param>s on derived fields of bitset
 type

A <derived> field may now have a bitset type. Like a plain field of
bitset type, it then takes <param>s, which isa.py parses and the encoder
adds to its bitset_params struct.

This is for operands whose number, bank and extension bits are spread
over the instruction word: an expression puts the bits back together,
and one operand hierarchy decodes the result, instead of a copy of the
hierarchy per layout. The first user is the SGX545 instruction set in
src/sgx/isa.

isaspec has no tests of its own. With PYTHONHASHSEED fixed, the ir3,
etnaviv and qrisc decoders and encoders generated before and after this
change are identical.

Assisted-by: LLM
---
 docs/isaspec.rst               |  5 ++++-
 src/compiler/isaspec/encode.py | 13 +++++++++++++
 src/compiler/isaspec/isa.py    |  8 ++++++++
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/docs/isaspec.rst b/docs/isaspec.rst
index 3f3e498..34877b8 100644
--- a/docs/isaspec.rst
+++ b/docs/isaspec.rst
@@ -155,7 +155,10 @@ which have bitset types, parameters can be "passed" in via ``<param>``
 elements, which can be referred to by the display template string, and/or
 expressions.  For example, this helps to deal with cases where other fields
 outside of that bitset control the encoding/decoding, such as in the
-``#multisrc`` example:
+``#multisrc`` example.  A ``<derived>`` field may have a bitset type too,
+for a sub-encoding whose bits are scattered across the instruction: its
+expression puts the bits together, and it takes ``<param>`` elements the
+same way:
 
 .. code-block:: xml
 
diff --git a/src/compiler/isaspec/encode.py b/src/compiler/isaspec/encode.py
index da94d59..24690f7 100755
--- a/src/compiler/isaspec/encode.py
+++ b/src/compiler/isaspec/encode.py
@@ -212,6 +212,19 @@ class State(object):
                                     if target_name not in unique_names:
                                         yield target_name
                                         unique_names.append(target_name)
+        # Derived fields of bitset type aren't encoded themselves (their
+        # expression's fields are), but their params still reach the
+        # bitset's own expressions:
+        for name, bitset in self.isa.all_bitsets():
+            for case in bitset.cases:
+                for field in case.fields.values():
+                    if isinstance(field, BitSetDerivedField) and \
+                       field.get_c_typename() == 'TYPE_BITSET':
+                        for param in field.params:
+                            target_name = param[1]
+                            if target_name not in unique_names:
+                                yield target_name
+                                unique_names.append(target_name)
 
     def case_name(self, bitset, name):
        return bitset.encode.case_prefix + name.upper().replace('.', '_').replace('-', '_').replace('#', '')
diff --git a/src/compiler/isaspec/isa.py b/src/compiler/isaspec/isa.py
index dddf7db..08bb000 100644
--- a/src/compiler/isaspec/isa.py
+++ b/src/compiler/isaspec/isa.py
@@ -178,6 +178,14 @@ class BitSetDerivedField(BitSetField):
         if 'display' in xml.attrib:
             self.display = xml.attrib['display'].strip()
         self.call = 'call' in xml.attrib and xml.attrib['call'] == 'true'
+        # A derived field may have a bitset type (e.g. an operand whose bits
+        # are scattered across the instruction), and pass it parameters:
+        self.params = []
+        for param in xml.findall('param'):
+            aas = name = param.attrib['name']
+            if 'as' in param.attrib:
+                aas = param.attrib['as']
+            self.params.append([name, aas])
 
 class BitSetCase(object):
     """Class that encapsulates a single bitset case
