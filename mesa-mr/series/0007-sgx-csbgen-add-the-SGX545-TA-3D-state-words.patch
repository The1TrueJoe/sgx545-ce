diff --git a/src/sgx/csbgen/README.md b/src/sgx/csbgen/README.md
new file mode 100644
index 0000000..68feee0
--- /dev/null
+++ b/src/sgx/csbgen/README.md
@@ -0,0 +1,47 @@
+# SGX545 TA/3D state words (csbgen)
+
+The XML files here describe the PowerVR SGX545's TA/3D state words in the
+format of Imagination's csbgen. `src/imagination/csbgen/gen_pack_header.py`,
+the generator the PowerVR Vulkan driver uses, turns each `<name>.xml` into
+`csbgen/<name>.h`, with a struct, `_header` defaults, `_pack()` and
+`_unpack()` per word. The same layout as `src/imagination/csbgen/rogue`.
+
+| file | prefix | words |
+|---|---|---|
+| `vdm.xml` | `SGX_VDMCTRL_` | the VDM control stream: state program (`PDS_STATE0/1`), the six draw words (`INDEX_LIST0`-`5`), stream terminate |
+| `ta.xml` | `SGX_TA_` | the TA state block: header, ISPA, ISPB, ISPC, the pixel PDS words, region clip, viewport, output select, W clamp, MTE, TSP0/TSP1 |
+| `pbe.xml` | `SGX_PBE_` | the pixel back end's four words and its sideband word |
+| `tex.xml` | `SGX_TEXSTATE_` | the four texture words a DOUTT sends (T0, strided T0, T1, T2, T3) |
+| `sgx_csb.h` | | the address type the generated code needs, the four headers, and `sgx_pack()` |
+| `tests/sgx_csb_test.c` | | packs and unpacks known words |
+
+## Use
+
+```c
+#include "sgx_csb.h"
+
+uint32_t w;
+
+sgx_pack(&w, TA_STATE_ISPB, ispb) {
+   ispb.line_width = 0x10;
+   ispb.color_mask = 0xf;
+}
+```
+
+`sgx_pack()` is the pack-in-place idiom of the Vulkan driver's
+`pvr_csb_pack()`: the struct starts from the XML's defaults, the block sets
+fields, and the word is packed when the block ends. Addresses are
+`sgx_dev_addr_t` (`SGX_DEV_ADDR(va)`).
+
+## Conventions
+
+- A field named `unknown_<bits>` holds bits whose value is known but whose
+  meaning isn't; its `default` (or a `<define>` per use, such as
+  `SGX_TA_STATE_MTE_UNKNOWN_2_31_DRAW`) is that value, so the constant
+  bits come from the description, not the caller.
+- Where a field's width isn't known, it runs up to the next known field.
+- Bits no field names are 0.
+
+## Tests
+
+`meson test --suite sgx` runs `sgx_csb` (with `-Dbuild-tests=true`).
diff --git a/src/sgx/csbgen/meson.build b/src/sgx/csbgen/meson.build
new file mode 100644
index 0000000..5cc1e48
--- /dev/null
+++ b/src/sgx/csbgen/meson.build
@@ -0,0 +1,34 @@
+# Copyright © 2026 Joseph Telaak
+# SPDX-License-Identifier: MIT
+
+# The TA/3D state words, described in csbgen's XML and packed by the helpers
+# its generator (src/imagination/csbgen) writes: csbgen/<name>.h for each
+# <name>.xml, as src/imagination/csbgen/rogue does.
+
+sgx_csb_xml_files = [
+  'pbe.xml',
+  'ta.xml',
+  'tex.xml',
+  'vdm.xml',
+]
+
+sgx_csb_h = []
+foreach f : sgx_csb_xml_files
+  _name = '@0@.h'.format(f.split('.')[0])
+  sgx_csb_h += custom_target(
+    _name,
+    input : [pvr_gen_pack_header_py, f],
+    output : _name,
+    command : [prog_python, '@INPUT@'],
+    capture : true,
+  )
+endforeach
+
+idep_sgx_csb = declare_dependency(
+  include_directories : [include_directories('.', '..'), inc_imagination],
+  sources : sgx_csb_h,
+)
+
+if with_tests
+  subdir('tests')
+endif
diff --git a/src/sgx/csbgen/pbe.xml b/src/sgx/csbgen/pbe.xml
new file mode 100644
index 0000000..f9025d9
--- /dev/null
+++ b/src/sgx/csbgen/pbe.xml
@@ -0,0 +1,55 @@
+<?xml version="1.0" ?>
+
+<!--
+Copyright © 2026 Joseph Telaak
+SPDX-License-Identifier: MIT
+
+The PBE (pixel back end) words the end-of-tile program emits, for Mesa's
+csbgen. A field named unknown_<bits> holds bits whose meaning is unknown,
+defaulting to the value they always have. A field of unknown width runs up
+to the next known field.
+-->
+
+<csbgen name="SGX" prefix="PBE">
+
+  <enum name="FORMAT">
+    <value name="BGRA8888" value="0"/>
+    <value name="RGBA8888" value="1"/>
+    <value name="RGB565"   value="3"/>
+    <value name="RGBA5551" value="4"/>
+    <value name="RGBA4444" value="5"/>
+  </enum>
+
+  <!-- the clip rectangle, in pixels, inclusive -->
+  <struct name="STATE_WORD0" length="1">
+    <field name="y_min" start="16" end="31" type="uint"/>
+    <field name="x_min" start="0" end="15" type="uint"/>
+  </struct>
+
+  <struct name="STATE_WORD1" length="1">
+    <field name="y_max" start="16" end="31" type="uint"/>
+    <field name="x_max" start="0" end="15" type="uint"/>
+  </struct>
+
+  <struct name="STATE_WORD2" length="1">
+    <field name="downscale" start="30" end="31" type="uint"/>
+    <field name="rotation" start="28" end="29" type="uint"/>
+    <field name="pitch" start="16" end="27" type="uint"/>  <!-- pitch in pixels / 2 - 1 -->
+    <!-- cleared, the PBE writes nothing at the address -->
+    <field name="write_enable" start="15" end="15" type="bool" default="1"/>
+  </struct>
+
+  <struct name="STATE_WORD3" length="1">
+    <field name="address" start="2" end="31" type="address" shift="2"/>
+  </struct>
+
+  <!-- the sideband word, the end-of-tile program's second EMITPIX -->
+  <struct name="SIDEBAND" length="1">
+    <field name="twiddled" start="13" end="13" type="bool"/>
+    <field name="unknown_12" start="12" end="12" type="bool"/>
+    <field name="dither" start="10" end="10" type="bool"/>
+    <field name="unknown_9" start="9" end="9" type="bool" default="1"/>
+    <field name="format" start="0" end="5" type="FORMAT"/>
+  </struct>
+
+</csbgen>
diff --git a/src/sgx/csbgen/sgx_csb.h b/src/sgx/csbgen/sgx_csb.h
new file mode 100644
index 0000000..6d4f4bd
--- /dev/null
+++ b/src/sgx/csbgen/sgx_csb.h
@@ -0,0 +1,45 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The state words of vdm.xml, ta.xml, pbe.xml and tex.xml, packed by csbgen's
+ * generated helpers.
+ */
+
+#ifndef SGX_CSB_H
+#define SGX_CSB_H
+
+#include <stdint.h>
+
+/* a GPU virtual address */
+typedef struct {
+   uint32_t addr;
+} sgx_dev_addr_t;
+
+#define SGX_DEV_ADDR(v) ((sgx_dev_addr_t){.addr = (v)})
+
+#define __pvr_address_type    sgx_dev_addr_t
+#define __pvr_get_address(a)  ((a).addr)
+#define __pvr_make_address(v) SGX_DEV_ADDR((uint32_t)(v))
+
+#include "csbgen/pbe.h"
+#include "csbgen/ta.h"
+#include "csbgen/tex.h"
+#include "csbgen/vdm.h"
+
+/*
+ * Pack one SGX_<T> at dst, with its fixed bits (the XML's defaults) and
+ * the fields the block sets:
+ *
+ *    sgx_pack(&w, TA_STATE_ISPB, ispb) {
+ *       ispb.line_width = 0x10;
+ *    }
+ */
+#define sgx_pack(dst, T, name)                                                 \
+   for (struct SGX_##T name = {SGX_##T##_header}, *_sgx_loop_##name = &name;   \
+        _sgx_loop_##name != NULL;                                              \
+        SGX_##T##_pack((dst), &name), _sgx_loop_##name = NULL)
+
+#endif
diff --git a/src/sgx/csbgen/ta.xml b/src/sgx/csbgen/ta.xml
new file mode 100644
index 0000000..970ecb7
--- /dev/null
+++ b/src/sgx/csbgen/ta.xml
@@ -0,0 +1,193 @@
+<?xml version="1.0" ?>
+
+<!--
+Copyright © 2026 Joseph Telaak
+SPDX-License-Identifier: MIT
+
+The TA state block: a header word, then the groups it names, in the
+header's bit order. For Mesa's csbgen. A field named unknown_<bits> holds
+bits whose meaning is unknown, defaulting to the value they always have. A
+field of unknown width runs up to the next known field.
+-->
+
+<csbgen name="SGX" prefix="TA">
+
+  <!-- the GL compare functions, GL enum - 0x200 -->
+  <enum name="CMP">
+    <value name="NEVER"    value="0"/>
+    <value name="LESS"     value="1"/>
+    <value name="EQUAL"    value="2"/>
+    <value name="LEQUAL"   value="3"/>
+    <value name="GREATER"  value="4"/>
+    <value name="NOTEQUAL" value="5"/>
+    <value name="GEQUAL"   value="6"/>
+    <value name="ALWAYS"   value="7"/>
+  </enum>
+
+  <enum name="OBJTYPE">
+    <value name="TRIANGLE" value="0"/>
+    <value name="LINE"     value="1"/>
+    <value name="POINT"    value="3"/>
+    <value name="SPRITE"   value="4"/>  <!-- a point that generates gl_PointCoord -->
+  </enum>
+
+  <enum name="PASSTYPE">
+    <value name="OPAQUE"              value="0"/>
+    <value name="TRANSLUCENT"         value="1"/>
+    <value name="TRANSLUCENT_DISCARD" value="2"/>
+    <value name="VIEWPORT_GENERATE"   value="3"/>  <!-- writes the visible bits, draws nothing -->
+    <value name="PUNCH_THROUGH"       value="4"/>
+    <value name="DEPTH_ONLY"          value="5"/>
+  </enum>
+
+  <enum name="STENCILOP">
+    <value name="KEEP"      value="0"/>
+    <value name="ZERO"      value="1"/>
+    <value name="REPLACE"   value="2"/>
+    <value name="INCR"      value="3"/>
+    <value name="DECR"      value="4"/>
+    <value name="INVERT"    value="5"/>
+    <value name="INCR_WRAP" value="6"/>
+    <value name="DECR_WRAP" value="7"/>
+  </enum>
+
+  <enum name="CULL">
+    <value name="NONE" value="0"/>
+    <value name="CW"   value="1"/>  <!-- cull clockwise in screen space -->
+    <value name="CCW"  value="2"/>
+  </enum>
+
+  <!-- the groups that follow, in this order -->
+  <struct name="STATE_HEADER" length="1">
+    <field name="tsp1" start="15" end="15" type="bool"/>
+    <field name="tsp0" start="14" end="14" type="bool"/>
+    <field name="mte" start="12" end="12" type="bool"/>
+    <field name="wclamp" start="11" end="11" type="bool"/>
+    <field name="outselect" start="10" end="10" type="bool"/>
+    <field name="unknown_word" start="9" end="9" type="bool"/>  <!-- one word, always 0 -->
+    <field name="viewport" start="8" end="8" type="bool"/>
+    <field name="region_clip" start="7" end="7" type="bool"/>
+    <field name="pds" start="6" end="6" type="bool"/>
+    <!-- the second face's ISPA, ISPB, ISPC (two-sided stencil) -->
+    <field name="ispc2" start="5" end="5" type="bool"/>
+    <field name="ispb2" start="4" end="4" type="bool"/>
+    <field name="ispa2" start="3" end="3" type="bool"/>
+    <field name="ispc" start="2" end="2" type="bool"/>
+    <field name="ispb" start="1" end="1" type="bool"/>
+    <field name="ispa" start="0" end="0" type="bool"/>
+  </struct>
+
+  <struct name="STATE_ISPA" length="1">
+    <field name="pass_type" start="25" end="27" type="PASSTYPE"/>
+    <field name="depth_func" start="22" end="24" type="CMP"/>
+    <field name="no_color_write" start="21" end="21" type="bool"/>
+    <field name="depth_write_disable" start="20" end="20" type="bool"/>
+    <field name="objtype" start="15" end="18" type="OBJTYPE"/>
+    <field name="two_sided" start="11" end="11" type="bool"/>
+    <field name="ispb_present" start="9" end="9" type="bool"/>
+    <field name="ispc_present" start="8" end="8" type="bool"/>
+    <field name="stencil_ref" start="0" end="7" type="uint"/>
+  </struct>
+
+  <struct name="STATE_ISPB" length="1">
+    <field name="depth_bias" start="23" end="23" type="bool"/>
+    <field name="line_width" start="8" end="15" type="uint"/>  <!-- width * 16, at most 0xff -->
+    <field name="color_mask" start="4" end="7" type="uint"/>   <!-- R 8, G 4, B 2, A 1 -->
+  </struct>
+
+  <!-- stencil; for a VIEWPORT_GENERATE object func is 1 to set the visible
+       bits, 0 to reset them -->
+  <struct name="STATE_ISPC" length="1">
+    <field name="func" start="25" end="27" type="CMP"/>
+    <field name="sfail" start="22" end="24" type="STENCILOP"/>
+    <field name="zfail" start="19" end="21" type="STENCILOP"/>
+    <field name="zpass" start="16" end="18" type="STENCILOP"/>
+    <field name="compare_mask" start="8" end="15" type="uint"/>
+    <field name="write_mask" start="0" end="7" type="uint"/>
+  </struct>
+
+  <!-- PDS words 0 (secondary) and 2 (primary): a pixel PDS program -->
+  <struct name="STATE_PDS_PROGRAM" length="1">
+    <field name="data_rows" start="26" end="31" type="uint"/>  <!-- data bytes / 16 -->
+    <field name="offset" start="0" end="25" type="uint"/>      <!-- (addr - PDS pixel heap) >> 4 -->
+  </struct>
+
+  <!-- PDS word 1 -->
+  <struct name="STATE_PDS_SIZEINFO" length="1">
+    <!-- 12 / primary_units without secondary attributes, 0xb with -->
+    <field name="unknown_25_28" start="25" end="28" type="uint"/>
+    <field name="secondary_size" start="18" end="24" type="uint"/>  <!-- (dwords + 3) >> 2 -->
+    <field name="unknown_16_17" start="16" end="17" type="uint" default="3"/>
+    <!-- the primary attributes in units of 4 dwords, at least 1 -->
+    <field name="primary_units" start="0" end="15" type="uint"/>
+  </struct>
+
+  <!-- in 32 x 16-pixel tiles, inclusive -->
+  <struct name="STATE_REGION_CLIP0" length="1">
+    <field name="unknown_31" start="31" end="31" type="bool" default="1"/>
+    <field name="x_min" start="16" end="30" type="uint"/>
+    <field name="x_max" start="0" end="14" type="uint"/>
+  </struct>
+
+  <struct name="STATE_REGION_CLIP1" length="1">
+    <field name="y_min" start="16" end="30" type="uint"/>
+    <field name="y_max" start="0" end="14" type="uint"/>
+  </struct>
+
+  <struct name="STATE_VIEWPORT" length="6">
+    <field name="x_offset" start="0" end="31" type="float"/>
+    <field name="x_scale" start="32" end="63" type="float"/>
+    <field name="y_offset" start="64" end="95" type="float"/>
+    <field name="y_scale" start="96" end="127" type="float"/>
+    <field name="z_offset" start="128" end="159" type="float"/>
+    <field name="z_scale" start="160" end="191" type="float"/>
+  </struct>
+
+  <struct name="STATE_OUTSELECT" length="1">
+    <field name="out_dwords" start="16" end="31" type="uint"/>  <!-- vertex output dwords -->
+    <!-- 0 for a VIEWPORT_GENERATE object -->
+    <field name="unknown_11_13" start="11" end="13" type="uint">
+      <define name="DRAW" value="6"/>   <!-- 0x3000 -->
+      <!-- 0x3800: the first set after the position is the vertex colour,
+           the PDS's colour source (0x20) -->
+      <define name="DRAW_COLOUR" value="7"/>
+      <define name="CLEAR" value="3"/>  <!-- 0x1800 -->
+    </field>
+    <field name="point_size" start="8" end="8" type="bool"/>   <!-- the last output is the size -->
+    <!-- the user clip planes the TA clips against, plane n's result (fdpc
+         into cp<n>) an output after the others -->
+    <field name="clip_planes" start="0" end="5" type="uint"/>
+  </struct>
+
+  <struct name="STATE_WCLAMP" length="1">
+    <field name="value" start="0" end="31" type="float"/>  <!-- 1e-5 -->
+  </struct>
+
+  <struct name="STATE_MTE" length="1">
+    <field name="unknown_2_31" start="2" end="31" type="uint">
+      <define name="DRAW" value="0x555588"/>  <!-- 0x1555620 -->
+      <define name="CLEAR" value="0x10"/>     <!-- 0x40, also VIEWPORT_GENERATE objects -->
+    </field>
+    <field name="cull" start="0" end="1" type="CULL"/>
+  </struct>
+
+  <!-- TSP word 0: each texcoord set's size, 1-3 components or 5 for 4 -->
+  <struct name="STATE_TSP0" length="1">
+    <field name="set9" start="27" end="29" type="uint"/>
+    <field name="set8" start="24" end="26" type="uint"/>
+    <field name="set7" start="21" end="23" type="uint"/>
+    <field name="set6" start="18" end="20" type="uint"/>
+    <field name="set5" start="15" end="17" type="uint"/>
+    <field name="set4" start="12" end="14" type="uint"/>
+    <field name="set3" start="9" end="11" type="uint"/>
+    <field name="set2" start="6" end="8" type="uint"/>
+    <field name="set1" start="3" end="5" type="uint"/>
+    <field name="set0" start="0" end="2" type="uint"/>
+  </struct>
+
+  <!-- TSP word 1: the sets iterated as F16 (precision value at most 2) -->
+  <struct name="STATE_TSP1" length="1">
+    <field name="f16" start="0" end="9" type="uint"/>
+  </struct>
+
+</csbgen>
