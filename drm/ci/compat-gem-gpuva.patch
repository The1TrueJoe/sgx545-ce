Kernels before 7.3 initialize a GEM object's GPU VA list only for drivers
with DRIVER_GEM_GPUVA; 7.3 always does and drops the flag. For builds on
those kernels only (drm/ci/compat.sh applies it when drm_drv.h still has
the flag). Never upstream.
---
--- a/drivers/gpu/drm/powervr_sgx/pvrsgx_drv.c	2026-11-08 20:20:51
+++ b/drivers/gpu/drm/powervr_sgx/pvrsgx_drv.c	2026-11-08 20:20:51
@@ -190,7 +190,8 @@
 DEFINE_DRM_GEM_FOPS(pvrsgx_fops);
 
 static const struct drm_driver pvrsgx_drm_driver = {
-	.driver_features = DRIVER_GEM | DRIVER_RENDER | DRIVER_SYNCOBJ | DRIVER_SYNCOBJ_TIMELINE,
+	.driver_features = DRIVER_GEM | DRIVER_GEM_GPUVA | DRIVER_RENDER | DRIVER_SYNCOBJ |
+			   DRIVER_SYNCOBJ_TIMELINE,
 	.open = pvrsgx_open,
 	.postclose = pvrsgx_postclose,
 	.ioctls = pvrsgx_ioctls,
