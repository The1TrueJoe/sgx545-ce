# The EA test kernel with the kernel's debug checks, for running the uAPI and
# frame tests under them (docs/UPSTREAM-READINESS.md). RAM boot only.
CONFIG_LOCALVERSION="-m2drm-debug"
# The board config leaves this off; lockdep, kmemleak and debug objects need it.
CONFIG_DEBUG_KERNEL=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_SHIFT=y
CONFIG_DMA_API_DEBUG=y
CONFIG_DMA_API_DEBUG_SG=y
CONFIG_DEBUG_KMEMLEAK=y
# CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF is not set
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_KALLSYMS_ALL=y
# /sys/power/pm_test: a suspend cycle that never leaves RAM, so the box needs no wake source.
CONFIG_PM_DEBUG=y
# The importer must never touch an exporter's pages: poison them (D6).
CONFIG_DMABUF_DEBUG=y
# drm_exec's ww_mutex backoff, taken on every contended submit.
CONFIG_DEBUG_WW_MUTEX_SLOWPATH=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
# The kernel log off the box (/sys/kernel/config/netconsole), for a soak that loses userspace.
CONFIG_CONFIGFS_FS=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
