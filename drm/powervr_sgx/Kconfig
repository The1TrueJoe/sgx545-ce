config DRM_POWERVR_SGX
	tristate "PowerVR SGX545 (Intel CE5300/CE5310)"
	depends on DRM && PCI && MMU && X86
	select DRM_EXEC
	select DRM_GEM_SHMEM_HELPER
	select DRM_GPUVM
	select DRM_SCHED
	select CRC32
	select FW_LOADER
	select WANT_DEV_COREDUMP
	help
	  Render-only DRM driver for the PowerVR SGX545 in the Intel CE5300
	  family (Control4 EA-1/EA-3), where the GPU is its own PCI function
	  (8086:089b). The GPU runs a microkernel loaded with request_firmware().

	  Not compatible with the vendor services driver (SGX545_CE): bind one
	  or the other.

	  If M is selected the module will be called powervr_sgx.

config DRM_POWERVR_SGX_KUNIT_TEST
	tristate "KUnit tests for the PowerVR SGX545 driver" if !KUNIT_ALL_TESTS
	depends on DRM_POWERVR_SGX && KUNIT
	default KUNIT_ALL_TESTS
	help
	  Unit tests of the driver's firmware file checks. For developers;
	  if unsure, say N.
