+
+/* Split "a, b, c" at top-level commas. */
+static unsigned
+split_operands(char *s, char **ops, unsigned max)
+{
+   unsigned n = 0;
+   s = trim(s);
+   if (!*s)
+      return 0;
+   ops[n++] = s;
+   for (char *p = s; *p && n < max; p++) {
+      if (*p == ',') {
+         *p = '\0';
+         ops[n++] = p + 1;
+      }
+   }
+   return n;
+}
+
+static bool
+parse_line(const char *line, struct sgx_isa_instr *I, char *err, size_t errsize)
+{
+   struct asm_ctx c = {err, errsize};
+   char buf[512], *s, *items = NULL;
+   char predtext[8] = "";
+
+   memset(I, 0, sizeof(*I));
+   snprintf(buf, sizeof(buf), "%s", line);
+   if ((s = strchr(buf, ';')))
+      *s = '\0';
+   s = trim(buf);
+
+   if (*s == '(') {
+      char *e = strchr(s, ')');
+      if (!e || e - s - 1 >= (int)sizeof(predtext))
+         return fail(&c, "bad predicate in '%s'", line);
+      memcpy(predtext, s + 1, e - s - 1);
+      predtext[e - s - 1] = '\0';
+      s = trim(e + 1);
+   }
+
+   /* trailing [items], unless the '[' belongs to an indexed operand */
+   char *lb = strrchr(s, '[');
+   if (lb && lb > s && lb[-1] == ' ' && s[strlen(s) - 1] == ']') {
+      *lb = '\0';
+      items = lb + 1;
+      items[strlen(items) - 1] = '\0';
+   }
+
+   char *mnem = s;
+   char *rest = mnem;
+   while (*rest && !isspace((unsigned char)*rest))
+      rest++;
+   if (*rest)
+      *rest++ = '\0';
+
+   char *ops[12];
+   unsigned nops = split_operands(rest, ops, ARRAY_LEN(ops));
+
+   char *parts[8];
+   unsigned nparts = 0;
+   char mbuf[64];
+   snprintf(mbuf, sizeof(mbuf), "%s", mnem);
+   for (char *t = strtok(mbuf, "."); t && nparts < ARRAY_LEN(parts);
+        t = strtok(NULL, "."))
+      parts[nparts++] = t;
+   if (!nparts)
+      return fail(&c, "empty line%s", "");
+   const char *base = parts[0];
+   const char *pat = NULL;
+   int v;
+
+   I->dmask = 15;
+
+   for (unsigned i = 0; i < ARRAY_LEN(simple); i++) {
+      if (!strcmp(mnem, simple[i].name)) {
+         I->opc = simple[i].opc;
+         I->mask = simple[i].mask;
+         pat = simple[i].ops;
+         break;
+      }
+   }
+
+   if (I->opc) {
+      /* done */
+   } else if (!strcmp(base, "and") || !strcmp(base, "or") ||
+              !strcmp(base, "xor") || !strcmp(base, "shl") ||
+              !strcmp(base, "rol") || !strcmp(base, "shr") ||
+              !strcmp(base, "asr")) {
+      if (nparts != 2 || strcmp(parts[1], "inv"))
+         return fail(&c, "bad bitwise mnemonic '%s'", mnem);
+      for (unsigned i = 0; i < ARRAY_LEN(simple); i++) {
+         if (!strcmp(base, simple[i].name))
+            I->opc = simple[i].opc;
+      }
+      I->inv = true;
+      I->mask = 1;
+      pat = "D12";
+   } else if (!strcmp(base, "movc")) {
+      static const enum sgx_isa_opc t[] = {0,
+                                           SGX_ISA_OPC_MOVC_U8,
+                                           SGX_ISA_OPC_MOVC_I16,
+                                           SGX_ISA_OPC_MOVC_I32,
+                                           SGX_ISA_OPC_MOVC_F32,
+                                           SGX_ISA_OPC_MOVC_C10};
+      int cnd = nparts == 3 ? LOOKUP(movc_cond, parts[1]) : -1;
+      int ty = nparts == 3 ? LOOKUP(movc_type, parts[2]) : -1;
+      if (cnd < 0 || ty < 1)
+         return fail(&c, "bad movc '%s'", mnem);
+      I->opc = t[ty];
+      I->cond = cnd;
+      pat = "D012";
+   } else if (!strcmp(base, "pck")) {
+      int d = nparts == 3 ? LOOKUP(pck_fmt, parts[1]) : -1;
+      int sf = nparts == 3 ? LOOKUP(pck_fmt, parts[2]) : -1;
+      if (d < 0 || sf < 0)
+         return fail(&c, "bad pck '%s'", mnem);
+      I->opc = SGX_ISA_OPC_PCK;
+      I->dfmt = d;
+      I->sfmt = sf;
+      I->mask = 1;
+      pat = "D12";
+   } else if (!strcmp(base, "test") || !strcmp(base, "testmask")) {
+      bool tm = base[4] == 'm';
+      if (nparts != (tm ? 4u : 3u))
+         return fail(&c, "bad test '%s'", mnem);
+      int alu = parse_test_alu(parts[1]);
+      int cnd = parse_test_cond(parts[2]);
+      if (alu < 0 || cnd < 0)
+         return fail(&c, "bad test op/cond '%s'", mnem);
+      I->opc = tm ? SGX_ISA_OPC_TESTMASK : SGX_ISA_OPC_TEST;
+      I->alu = alu;
+      I->tcond = cnd;
+      I->mask = 1;
+      if (tm) {
+         if ((v = LOOKUP(tm_type, parts[3])) < 0)
+            return fail(&c, "bad testmask type '%s'", parts[3]);
+         I->ttype = v;
+         pat = nops == 3 ? "D12" : "12";
+      } else {
+         pat = nops == 4 ? "PD12" : "P12";
+      }
+   } else if (!strcmp(base, "smp")) {
+      I->opc = SGX_ISA_OPC_SMP;
+      I->mask = 1;
+      if (nparts < 2 || (v = LOOKUP(smp_dim, parts[1])) < 0)
+         return fail(&c, "bad smp dim '%s'", mnem);
+      I->dim = v;
+      for (unsigned i = 2; i < nparts; i++) {
+         if ((v = LOOKUP(smp_lod, parts[i])) > 0)
+            I->lod = v;
+         else if ((v = LOOKUP(smp_cfmt, parts[i])) > 0)
+            I->cfmt = v;
+         else if ((v = LOOKUP(smp_pcf, parts[i])) > 0)
+            I->pcf = v;
+         else if ((v = LOOKUP(smp_ret, parts[i])) > 0)
+            I->ret = v;
+         else
+            return fail(&c, "bad smp suffix '%s'", parts[i]);
+      }
+      pat = I->lod ? "D012" : "D01";
+      if (!I->lod) {
+         I->src[2].file = SGX_ISA_FILE_IMM; /* the unused-source pattern */
+      }
+   } else if (!strcmp(base, "ld") || !strcmp(base, "st")) {
+      int am = nparts == 3 ? LOOKUP(ld_am, parts[1]) : -1;
+      int sz = nparts == 3 ? LOOKUP(ld_size, parts[2]) : -1;
+      if (am < 0 || sz < 0)
+         return fail(&c, "bad ld/st '%s'", mnem);
+      I->am = am;
+      I->size = sz;
+      if (base[0] == 'l') {
+         I->opc = SGX_ISA_OPC_LD;
+         pat = nops == 4 ? "D012" : "D01";
+         if (nops == 3)
+            I->src[2].file = SGX_ISA_FILE_IMM;
+      } else {
+         I->opc = SGX_ISA_OPC_ST;
+         pat = "012";
+      }
+   } else if (!strcmp(base, "eld")) {
+      if (nparts != 2 || (strcmp(parts[1], "d") && strcmp(parts[1], "q")))
+         return fail(&c, "bad eld '%s'", mnem);
+      I->opc = parts[1][0] == 'd' ? SGX_ISA_OPC_ELD_D : SGX_ISA_OPC_ELD_Q;
+      I->size = parts[1][0] == 'q';
+      pat = "D10E2";
+   } else if (!strcmp(base, "emit")) {
+      if (nparts != 2 || (v = LOOKUP(emit_tgt, parts[1])) < 0)
+         return fail(&c, "bad emit '%s'", mnem);
+      I->opc = SGX_ISA_OPC_EMIT;
+      I->tgt = v;
+      pat = "012";
+   } else if (sgx_isa_asm_mnemonic_int(I, parts, nparts, nops, &pat)) {
+      /* integer / fixed-point / dual-issue classes */
+   } else {
+      return fail(&c, "unknown mnemonic '%s'", mnem);
+   }
+
+   if (*predtext && !has_pred(I->opc))
+      return fail(&c, "'%s' has no predicate field", mnem);
+   if (*predtext && !parse_pred(predtext, uses_pred2(I->opc), &I->pred))
+      return fail(&c, "bad predicate '%s'", predtext);
+
+   if (!parse_operands(&c, I, pat, ops, nops))
+      return false;
+   /* any format suffix sets format select (classes without the field
+    * ignore it) */
+   for (unsigned k = 0; k < 3; k++)
+      I->fmt |= I->src[k].fmt != SGX_ISA_FMT_NONE;
+   I->fmt |= I->dst.fmt != SGX_ISA_FMT_NONE;
+
+   /* ldr/str: a 14-bit immediate address is fine; atst8 writes its pdst unless
+    * .nw */
+   if (items) {
+      for (char *t = strtok(items, " "); t; t = strtok(NULL, " ")) {
+         if (!parse_item(&c, I, t))
+            return false;
+      }
+   }
+   if (has_rcnt(I->opc)) {
+      if (I->rpt > 1 && !I->rcnt)
+         return fail(&c, "rpt=n needs rcnt here%s", "");
+      if (I->rcnt && !I->rpt)
+         I->rpt = 1;
+   } else if (I->rcnt) {
+      return fail(&c, "'%s' has no rcnt", mnem);
+   }
+   /* a source immediate is 7 bits, unsigned or (in the integer forms with
+    * signed immediates) two's complement: -64..127; the bitwise classes'
+    * src2 takes 16 bits, ldr/str's address 14 */
+   for (unsigned k = 0; k < 3; k++) {
+      bool wide =
+         k == 2 && (I->opc == SGX_ISA_OPC_AND || I->opc == SGX_ISA_OPC_OR ||
+                    I->opc == SGX_ISA_OPC_XOR || I->opc == SGX_ISA_OPC_SHL ||
+                    I->opc == SGX_ISA_OPC_SHR || I->opc == SGX_ISA_OPC_ROL ||
+                    I->opc == SGX_ISA_OPC_ASR);
+      bool addr =
+         k == 2 && (I->opc == SGX_ISA_OPC_LDR || I->opc == SGX_ISA_OPC_STR);
+      int32_t n = (int32_t)I->src[k].num;
+      if (I->src[k].file == SGX_ISA_FILE_IMM && !wide &&
+          (addr ? n < 0 || n > 0x3fff : n < -64 || n > 127)) {
+         char num[16];
+         snprintf(num, sizeof(num), "#%d", n);
+         return fail(&c, "immediate %s doesn't fit its field", num);
+      }
+   }
+   return true;
+}
+
+/*
+ * A flag the form has no field for would be dropped by the encoder, so the
+ * text would claim what the word doesn't do. Each bare item must show in the
+ * word's disassembly, or (another spelling, or implied by an operand) change
+ * the word: the line without it encodes differently.
+ */
+static bool
+has_item(const char *dis, const char *item)
+{
+   const char *lb = strrchr(dis, '[');
+   size_t n = strlen(item);
+
+   if (!lb)
+      return false;
+   for (const char *p = lb + 1; (p = strstr(p, item)); p += n) {
+      if ((p[-1] == '[' || p[-1] == ' ') && (p[n] == ' ' || p[n] == ']'))
+         return true;
+   }
+   return false;
+}
+
+static bool
+check_flags(const char *line, const struct sgx_isa_instr *I, char *err,
+            size_t errsize)
+{
+   struct asm_ctx c = {err, errsize};
+   char buf[512], *s;
+
+   snprintf(buf, sizeof(buf), "%s", line);
+   if ((s = strchr(buf, ';')))
+      *s = '\0';
+   s = trim(buf);
+   char *lb = strrchr(s, '[');
+   if (!lb || lb == s || lb[-1] != ' ' || s[strlen(s) - 1] != ']')
+      return true;
+   *lb = '\0';
+   char *items = lb + 1;
+   items[strlen(items) - 1] = '\0';
+
+   char *tok[32];
+   unsigned n = 0;
+   for (char *t = strtok(items, " \t"); t && n < ARRAY_LEN(tok);
+        t = strtok(NULL, " \t"))
+      tok[n++] = t;
+
+   uint64_t w = sgx_isa_encode(I, NULL);
+   char dis[512];
+   if (!sgx_disasm_one(w, NULL, dis, sizeof(dis)))
+      dis[0] = '\0';
+   for (unsigned i = 0; i < n; i++) {
+      if (strchr(tok[i], '=') || has_item(dis, tok[i]))
+         continue;
+      char without[512], e[128];
+      size_t len = snprintf(without, sizeof(without), "%s [", s);
+      for (unsigned j = 0; j < n && len < sizeof(without); j++) {
+         if (strcmp(tok[j], tok[i]))
+            len +=
+               snprintf(without + len, sizeof(without) - len, "%s ", tok[j]);
+      }
+      if (len < sizeof(without))
+         snprintf(without + len, sizeof(without) - len, "]");
+
+      struct sgx_isa_instr J;
+      if (parse_line(without, &J, e, sizeof(e)) &&
+          sgx_isa_encode(&J, NULL) == w)
+         return fail(&c, "'%s' isn't encoded by this form", tok[i]);
+   }
+   return true;
+}
+
+/*
+ * i<n> in a slot without the i bank reads back as r(124 + n), and a negative
+ * immediate as its two's complement in the field's width.
+ */
+static bool
+same_opnd(const struct sgx_isa_src *a, const struct sgx_isa_src *b)
+{
+   uint32_t num = a->num;
+   if (a->file == SGX_ISA_FILE_I && b->file == SGX_ISA_FILE_R)
+      num += a->fmt != SGX_ISA_FMT_NONE ? 60 : 124;
+   else if (a->file != b->file)
+      return false;
+   if (a->file == SGX_ISA_FILE_IMM && (int32_t)num < 0) {
+      static const unsigned widths[] = {7, 14, 16};
+      for (unsigned i = 0; i < ARRAY_LEN(widths); i++) {
+         if ((num & ((1u << widths[i]) - 1)) == b->num)
+            num = b->num;
+      }
+   }
+   return num == b->num && a->half == b->half && a->ixbank == b->ixbank &&
+          a->ixreg == b->ixreg && a->lane == b->lane;
+}
+
+/*
+ * The encoder keeps only the bits a field has, so a number too wide for its
+ * field would be dropped silently. Every number must read back from the
+ * word's disassembly unchanged.
+ */
+static const char *
+misfit(const struct sgx_isa_instr *I, const struct sgx_isa_fc *fc)
+{
+   struct sgx_isa_instr J;
+   char dis[512];
+
+   if (!sgx_disasm_one(sgx_isa_encode(I, fc), fc, dis, sizeof(dis)) ||
+       !parse_line(dis, &J, NULL, 0))
+      return "the word";
+
+   if (!same_opnd(&I->dst, &J.dst))
+      return "the destination";
+   for (unsigned k = 0; k < 3; k++) {
+      if (!same_opnd(&I->src[k], &J.src[k]))
+         return k == 0 ? "src0" : k == 1 ? "src1" : "src2";
+   }
+   if ((I->has_nodst ? I->nodst : 0x280) != (J.has_nodst ? J.nodst : 0x280))
+      return "nodst";
+   if ((I->has_unused2 ? I->unused2 : 0x300) !=
+       (J.has_unused2 ? J.unused2 : 0x300))
+      return "unused2";
+#define FIT(f)                                                                 \
+   do {                                                                        \
+      if (I->f != J.f)                                                         \
+         return #f;                                                            \
+   } while (0)
+   FIT(mask);
+   FIT(drc);
+   FIT(chan);
+   FIT(a3f);
+   FIT(dmask);
+   FIT(rot);
+   FIT(path);
+   FIT(n);
+   FIT(imm);
+   FIT(rate);
+   FIT(wait);
+   FIT(target);
+   FIT(temps4);
+   FIT(cp[0]);
+   FIT(cp[1]);
+   FIT(a[0]);
+   FIT(a[1]);
+   FIT(f2_15);
+   FIT(x39);
+   FIT(a5);
+   FIT(coef);
+   FIT(shift);
+   FIT(a8);
+   FIT(hi);
+#undef FIT
+   static const char *const vn[] = {"the first value", "the second value",
+                                    "the third value", "the fourth value"};
+   for (unsigned k = 0; k < 4; k++) {
+      if (I->v[k] != J.v[k])
+         return vn[k];
+      if (I->am4[k] != J.am4[k])
+         return "am";
+   }
+   for (unsigned k = 0; k < 3; k++) {
+      if (I->lim[k] != J.lim[k])
+         return "lim";
+   }
+   if ((I->rpt ? I->rpt : 1) != (J.rpt ? J.rpt : 1))
+      return "rpt";
+   return NULL;
+}
+
+/*
+ * Format control isn't in the line, so a number has to fit under one of its
+ * four states.
+ */
+static bool
+check_fit(const struct sgx_isa_instr *I, char *err, size_t errsize)
+{
+   struct asm_ctx c = {err, errsize};
+   const char *what = misfit(I, NULL);
+
+   for (unsigned f = 0; what && f < 4; f++) {
+      struct sgx_isa_fc fc = {.f16 = f & 1, .c10 = f >> 1};
+      if (!misfit(I, &fc))
+         what = NULL;
+   }
+   return !what || fail(&c, "%s doesn't fit its field", what);
+}
+
+bool
+sgx_isa_asm_line(const char *line, struct sgx_isa_instr *I, char *err,
+                 size_t errsize)
+{
+   return parse_line(line, I, err, errsize) &&
+          check_flags(line, I, err, errsize) && check_fit(I, err, errsize);
+}
