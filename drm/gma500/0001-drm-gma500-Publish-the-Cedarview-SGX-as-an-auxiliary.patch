diff --git a/drivers/gpu/drm/gma500/mmu.c b/drivers/gpu/drm/gma500/mmu.c
index 4fbc22a..bd89879 100644
--- a/drivers/gpu/drm/gma500/mmu.c
+++ b/drivers/gpu/drm/gma500/mmu.c
@@ -71,7 +71,7 @@ static void psb_mmu_flush_pd_locked(struct psb_mmu_driver *driver, int force)
 	struct drm_device *dev = driver->dev;
 	struct drm_psb_private *dev_priv = to_drm_psb_private(dev);
 
-	if (atomic_read(&driver->needs_tlbflush) || force) {
+	if ((atomic_read(&driver->needs_tlbflush) || force) && !gma_sgx_owned(dev_priv)) {
 		uint32_t val = PSB_RSGX32(PSB_CR_BIF_CTRL);
 		PSB_WSGX32(val | _PSB_CB_CTRL_INVALDC, PSB_CR_BIF_CTRL);
 
@@ -101,6 +101,11 @@ void psb_mmu_flush(struct psb_mmu_driver *driver)
 	uint32_t val;
 
 	down_write(&driver->sem);
+	if (gma_sgx_owned(dev_priv)) {
+		atomic_set(&driver->needs_tlbflush, 0);
+		up_write(&driver->sem);
+		return;
+	}
 	val = PSB_RSGX32(PSB_CR_BIF_CTRL);
 	if (atomic_read(&driver->needs_tlbflush))
 		PSB_WSGX32(val | _PSB_CB_CTRL_INVALDC, PSB_CR_BIF_CTRL);
@@ -128,7 +133,8 @@ void psb_mmu_set_pd_context(struct psb_mmu_pd *pd, int hw_context)
 			  PSB_CR_BIF_DIR_LIST_BASE1 + hw_context * 4;
 
 	down_write(&pd->driver->sem);
-	PSB_WSGX32(page_to_pfn(pd->p) << PAGE_SHIFT, offset);
+	if (!gma_sgx_owned(dev_priv))
+		PSB_WSGX32(page_to_pfn(pd->p) << PAGE_SHIFT, offset);
 	wmb();
 	psb_mmu_flush_pd_locked(pd->driver, 1);
 	pd->hw_context = hw_context;
@@ -238,7 +244,7 @@ void psb_mmu_free_pagedir(struct psb_mmu_pd *pd)
 	int i;
 
 	down_write(&driver->sem);
-	if (pd->hw_context != -1) {
+	if (pd->hw_context != -1 && !gma_sgx_owned(dev_priv)) {
 		PSB_WSGX32(0, PSB_CR_BIF_DIR_LIST_BASE0 + pd->hw_context * 4);
 		psb_mmu_flush_pd_locked(driver, 1);
 	}
