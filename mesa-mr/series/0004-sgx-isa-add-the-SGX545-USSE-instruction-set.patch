+++ b/src/sgx/isa/sgx.xml
@@ -0,0 +1,4287 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+Copyright © 2026 Joseph Telaak
+SPDX-License-Identifier: MIT
+-->
+
+<!--
+SGX545 USSE instruction set.
+
+Bit numbering: bit n < 32 is l<n> (bit n of the low word), bit 32 + n is
+h<n> (bit n of the high word). An instruction is stored low word first.
+
+The display strings are the USSE text notation (README.md). Trailing
+"[...]" items are fields whose display starts with a space; sgx_disasm()
+drops an empty "[]" and the space after "[".
+
+Operands: a register operand's number, bank and extension bits are spread
+over the word, so each slot is rebuilt as a derived value
+(number | bank << 7 | extension << 9) and decoded by an operand hierarchy
+whose leaf patterns are the bank codes (#dst, #src, #src0 below). MODE
+tells the operand how its number reads:
+
+  0  plain: 7-bit numbers
+  1  format select, F16 (float classes h22, test h18 on float ALU ops)
+  2  format select, C10 (test h18 on the group-2 ALU ops)
+  3  format control, C10 (setfc a1; sop2/sop3/sopwm/dot/ima8/fpma)
+  4  format control, F16 (setfc a0; efo)
+
+Format control is program state, not in the word: the encoder takes it from
+struct encode_state and the disassembler tracks setfc (sgx_disasm.c).
+
+ISA_GPU_ID() (the encoder's s->gen, the decoder's gpu_id) is
+core * 100 + format control: the core's number (545) in the hundreds, the
+format-control bits in the low digits (sgx_isa_gpu_id()). <gen> ranges
+select cores, e.g. min="54500" max="54599" for SGX545; expressions read
+the core as ISA_GPU_ID() / 100 and format control as ISA_GPU_ID() % 100.
+Everything here is SGX545's (the root's <gen>); a field another core
+encodes differently gets a <gen> range or an override on the core.
+
+What isaspec cannot express directly, and how it is handled here:
+  - split fields (h6-8 + h24, limm's three-piece immediate, operands):
+    one field per piece plus a <derived> field that joins them;
+  - modal state (format control, MOE state): outside the word, see above;
+  - "this value, unless that bit": overrides, or derived enums that fold
+    the deciding bit into the value (#rm0/#rm1/#rm15, #pck-l18).
+-->
+
+<isa>
+
+<!-- ===================================================================== -->
+<!-- Shared expressions                                                     -->
+<!-- ===================================================================== -->
+
+<expr name="#zero">0</expr>
+<expr name="#m-sel">({MODE} == 1) || ({MODE} == 2)</expr>
+<expr name="#m-sel-f16">({MODE} == 1) &amp;&amp; {F}</expr>
+<expr name="#m-sel-c10">({MODE} == 2) &amp;&amp; {F}</expr>
+<expr name="#m-half">(({MODE} == 1) || ({MODE} == 4)) &amp;&amp; {F}</expr>
+<expr name="#m-c10">(({MODE} == 2) || ({MODE} == 3)) &amp;&amp; {F}</expr>
+<expr name="#m-g">{NUM} &gt;= 64</expr>
+
+<!-- ===================================================================== -->
+<!-- Small enums                                                            -->
+<!-- ===================================================================== -->
+
+<enum name="#pred3">
+	<value val="0" display=""/>
+	<value val="1" display="(p0) "/>
+	<value val="2" display="(p1) "/>
+	<value val="3" display="(p2) "/>
+	<value val="4" display="(p3) "/>
+	<value val="5" display="(!p0) "/>
+	<value val="6" display="(!p1) "/>
+	<value val="7" display="(pn) "/>
+</enum>
+
+<enum name="#pred2">
+	<value val="0" display=""/>
+	<value val="1" display="(p0) "/>
+	<value val="2" display="(p1) "/>
+	<value val="3" display="(!p0) "/>
+</enum>
+
+<enum name="#half">
+	<value val="0" display="lo"/>
+	<value val="1" display="hi"/>
+</enum>
+
+<enum name="#ibank">
+	<value val="0" display="r"/>
+	<value val="1" display="o"/>
+	<value val="2" display="pa"/>
+	<value val="3" display="sa"/>
+</enum>
+
+<enum name="#rpt4">
+	<value val="0" display=""/>
+	<value val="1" display=" rpt=2"/>
+	<value val="2" display=" rpt=3"/>
+	<value val="3" display=" rpt=4"/>
+</enum>
+
+<enum name="#rpt2">
+	<value val="0" display=""/>
+	<value val="1" display=" rpt=2"/>
+</enum>
+
+<enum name="#drc">
+	<value val="0" display=""/>
+	<value val="1" display=" drc=1"/>
+</enum>
+
+<enum name="#pn">
+	<value val="0" display="p0"/>
+	<value val="1" display="p1"/>
+	<value val="2" display="p2"/>
+	<value val="3" display="p3"/>
+</enum>
+
+<enum name="#chan4">
+	<value val="0" display=""/>
+	<value val="1" display=" chan=1"/>
+	<value val="2" display=" chan=2"/>
+	<value val="3" display=" chan=3"/>
+</enum>
+
+<enum name="#chan8">
+	<value val="0" display=""/>
+	<value val="1" display=" chan=1"/>
+	<value val="2" display=" chan=2"/>
+	<value val="3" display=" chan=3"/>
+	<value val="4" display=" chan=4"/>
+	<value val="5" display=" chan=5"/>
+	<value val="6" display=" chan=6"/>
+	<value val="7" display=" chan=7"/>
+</enum>
+
+<enum name="#cp">
+	<value val="0" display="cp0"/>
+	<value val="1" display="cp1"/>
+	<value val="2" display="cp2"/>
+	<value val="3" display="cp3"/>
+	<value val="4" display="cp4"/>
+	<value val="5" display="cp5"/>
+	<value val="6" display="cp6"/>
+	<value val="7" display="cp7"/>
+</enum>
+
+<enum name="#i01">
+	<value val="0" display="i0"/>
+	<value val="1" display="i1"/>
+</enum>
+
+<enum name="#swz0">
+	<doc>fmad16 src0 swizzle</doc>
+	<value val="0" display=""/>
+	<value val="1" display=" swz0=ll"/>
+	<value val="2" display=" swz0=hh"/>
+	<value val="3" display=" swz0=f32"/>
+</enum>
+<enum name="#swz1">
+	<doc>fmad16 src1 swizzle</doc>
+	<value val="0" display=""/>
+	<value val="1" display=" swz1=ll"/>
+	<value val="2" display=" swz1=hh"/>
+	<value val="3" display=" swz1=f32"/>
+</enum>
+<enum name="#swz2">
+	<doc>fmad16 src2 swizzle</doc>
+	<value val="0" display=""/>
+	<value val="1" display=" swz2=ll"/>
+	<value val="2" display=" swz2=hh"/>
+	<value val="3" display=" swz2=f32"/>
+</enum>
+
+<enum name="#movc-cond">
+	<value val="0" display=".z"/>
+	<value val="1" display=".nz"/>
+	<value val="2" display=".ltz"/>
+	<value val="3" display=".gez"/>
+</enum>
+
+<enum name="#movc-type">
+	<value val="1" display=".u8"/>
+	<value val="2" display=".i16"/>
+	<value val="3" display=".i32"/>
+	<value val="4" display=".f32"/>
+	<value val="5" display=".c10"/>
+</enum>
+
+<enum name="#pck-fmt">
+	<value val="0" display=".u8"/>
+	<value val="1" display=".s8"/>
+	<value val="2" display=".o8"/>
+	<value val="3" display=".u16"/>
