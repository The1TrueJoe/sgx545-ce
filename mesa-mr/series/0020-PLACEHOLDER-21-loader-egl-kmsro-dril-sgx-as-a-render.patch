+
+/* (their sysfs part, for a sysfs tree at sysfs: the device of the node
+ * maj:min; the nodes /sys/class/drm has that libdrm's list doesn't) */
+struct _drmDevice *
+loader_drm_device_from_sysfs(const char *sysfs, unsigned maj, unsigned min);
+
+int
+loader_drm_add_sysfs_devices(const char *sysfs, struct _drmDevice *devices[],
+                             int n, int max_devices);
+
 bool
 loader_is_device_render_capable(int fd);
 
