# SGX545 shader compiler: NIR -> USSE (in a DDK 1.7 USP container).
# usse_forms.h is generated by tools/usc/gen_forms.py from tools/isa/hw.py
# (checked in; regenerate when the ISA tables change).

libsgx545_compiler = static_library(
  'sgx545_compiler',
  files('usse.c', 'sgx_nir.c', 'sgx_compile.c', 'sgx_usp.c'),
  include_directories : [inc_include, inc_src, inc_mesa, inc_gallium, inc_gallium_aux],
  c_args : [no_override_init_args, '-Wno-missing-prototypes'],
  dependencies : [idep_nir, idep_mesautil],
  gnu_symbol_visibility : 'hidden',
  build_by_default : false,
)

idep_sgx545_compiler = declare_dependency(
  link_with : libsgx545_compiler,
  include_directories : include_directories('.'),
)
