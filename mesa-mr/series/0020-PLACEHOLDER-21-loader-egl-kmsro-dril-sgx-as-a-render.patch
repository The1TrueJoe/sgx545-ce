diff --git a/src/loader/tests/cedarview_sysfs_test.c b/src/loader/tests/cedarview_sysfs_test.c
new file mode 100644
index 0000000..a12f0f0
--- /dev/null
+++ b/src/loader/tests/cedarview_sysfs_test.c
@@ -0,0 +1,222 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ *
+ * The loader on the sysfs layout of a real Cedarview (D2500) with gma500 and
+ * powervr_sgx: the display's card0 on the PCI function 0000:00:02.0
+ * (8086:0be1, subsystem 1558:2100, rev 0b), the SGX's card1 and renderD128 on
+ * gma500's auxiliary device gma500_gfx.sgx.16, beside ACPI's
+ * acpi.video_bus.0.  libdrm describes no auxiliary device (drmGetDevice2
+ * fails on renderD128), so the loader describes it as the PCI function:
+ *  - kmsro's pick: card0's child render node is renderD128;
+ *  - loader_drm_device_from_sysfs: renderD128 and card1 are a PCI device
+ *    0000:00:02.0, 8086:0be1, with nodes /dev/dri/card1 and
+ *    /dev/dri/renderD128; card0 (the PCI function's own node) is left to
+ *    libdrm;
+ *  - loader_drm_add_sysfs_devices: libdrm's list (gma500 alone, no render
+ *    node) gets the SGX added once, which is the EGLDevice that X11, gbm and
+ *    surfaceless displays find.
+ */
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "loader.h"
+#include "util/libdrm.h"
+
+static char root[PATH_MAX];
+static int failures;
+
+#define CHECK(cond)                                                            \
+   do {                                                                        \
+      if (!(cond)) {                                                           \
+         fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #cond);            \
+         failures++;                                                           \
+      }                                                                        \
+   } while (0)
+
+static void
+mkdirs(const char *rel)
+{
+   char p[PATH_MAX];
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel);
+   for (char *s = p + strlen(root) + 1; *s; s++) {
+      if (*s == '/') {
+         *s = 0;
+         mkdir(p, 0755);
+         *s = '/';
+      }
+   }
+   mkdir(p, 0755);
+}
+
+static void
+link_at(const char *target, const char *rel)
+{
+   char p[PATH_MAX];
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel);
+   if (symlink(target, p)) {
+      perror(p);
+      exit(1);
+   }
+}
+
+static void
+file_at(const char *rel, const char *text)
+{
+   char p[PATH_MAX];
+   FILE *f;
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel);
+   if (!(f = fopen(p, "w"))) {
+      perror(p);
+      exit(1);
+   }
+   fputs(text, f);
+   fclose(f);
+}
+
+/* a device directory (rel, from the sysfs root) on bus */
+static void
+device(const char *rel, const char *bus)
+{
+   char p[PATH_MAX], target[PATH_MAX];
+   int depth = 0;
+
+   mkdirs(rel);
+   snprintf(p, sizeof(p), "bus/%s", bus);
+   mkdirs(p);
+   for (const char *s = rel; *s; s++)
+      depth += *s == '/';
+   target[0] = 0;
+   for (int i = 0; i <= depth; i++)
+      strcat(target, "../");
+   strcat(target, p);
+   snprintf(p, sizeof(p), "%s/subsystem", rel);
+   link_at(target, p);
+}
+
+/* a DRM node maj:min under device rel_dev: its directory, its dev file, and
+ * its /sys/class/drm and /sys/dev/char links, as the kernel lays them out */
+static void
+node(const char *rel_dev, const char *name, unsigned maj, unsigned min)
+{
+   char rel[PATH_MAX], target[PATH_MAX], text[32];
+
+   snprintf(rel, sizeof(rel), "%s/drm/%s", rel_dev, name);
+   mkdirs(rel);
+   snprintf(rel, sizeof(rel), "%s/drm/%s/device", rel_dev, name);
+   link_at("../..", rel);
+   snprintf(rel, sizeof(rel), "%s/drm/%s/dev", rel_dev, name);
+   snprintf(text, sizeof(text), "%u:%u\n", maj, min);
+   file_at(rel, text);
+   snprintf(target, sizeof(target), "../../%s/drm/%s", rel_dev, name);
+   snprintf(rel, sizeof(rel), "class/drm/%s", name);
+   link_at(target, rel);
+   snprintf(rel, sizeof(rel), "dev/char/%u:%u", maj, min);
+   link_at(target, rel);
+}
+
+/* a libdrm-made device with only a primary node, as drmGetDevices2 lists
+ * gma500 */
+static drmDevicePtr
+primary_only(const char *path)
+{
+   drmDevicePtr d = calloc(1, sizeof(*d) + DRM_NODE_MAX * sizeof(char *));
+
+   d->nodes = (char **)(d + 1);
+   d->nodes[DRM_NODE_PRIMARY] = strdup(path);
+   d->available_nodes = 1 << DRM_NODE_PRIMARY;
+   d->bustype = DRM_BUS_PCI;
+   return d;
+}
+
+int
+main(void)
+{
+   const char *pci = "devices/pci0000:00/0000:00:02.0";
+   const char *aux = "devices/pci0000:00/0000:00:02.0/gma500_gfx.sgx.16";
+   char parent[PATH_MAX], p[PATH_MAX], name[32] = "";
+   drmDevicePtr d, list[4];
+   int n;
+
+   snprintf(root, sizeof(root), "%s/cedarview-sysfs-XXXXXX",
+            getenv("TMPDIR") ? getenv("TMPDIR") : "/tmp");
+   if (!mkdtemp(root)) {
+      perror("mkdtemp");
+      return 1;
+   }
+   mkdirs("class/drm");
+   mkdirs("dev/char");
+
+   device(pci, "pci");
+   file_at("devices/pci0000:00/0000:00:02.0/vendor", "0x8086\n");
+   file_at("devices/pci0000:00/0000:00:02.0/device", "0x0be1\n");
+   file_at("devices/pci0000:00/0000:00:02.0/subsystem_vendor", "0x1558\n");
+   file_at("devices/pci0000:00/0000:00:02.0/subsystem_device", "0x2100\n");
+   file_at("devices/pci0000:00/0000:00:02.0/revision", "0x0b\n");
+   node(pci, "card0", 226, 0);
+   device(aux, "auxiliary");
+   node(aux, "card1", 226, 1);
+   node(aux, "renderD128", 226, 128);
+   /* ACPI's video bus, the other auxiliary device in eddy's auxiliary.txt */
+   device("devices/pci0000:00/acpi.video_bus.0", "auxiliary");
+
+   /* kmsro: card0's device has renderD128 as its child's render node */
+   snprintf(p, sizeof(p), "%s/%s", root, pci);
+   CHECK(realpath(p, parent));
+   snprintf(p, sizeof(p), "%s/class/drm", root);
+   CHECK(loader_find_child_render_node(p, parent, name, sizeof(name)));
+   CHECK(!strcmp(name, "renderD128"));
+
+   /* the SGX's nodes are described as the PCI function */
+   for (unsigned min = 1; min <= 128; min += 127) {
+      d = loader_drm_device_from_sysfs(root, 226, min);
+      CHECK(d);
+      if (!d)
+         continue;
+      CHECK(d->bustype == DRM_BUS_PCI);
+      CHECK(d->businfo.pci->domain == 0 && d->businfo.pci->bus == 0 &&
+            d->businfo.pci->dev == 2 && d->businfo.pci->func == 0);
+      CHECK(d->deviceinfo.pci->vendor_id == 0x8086 &&
+            d->deviceinfo.pci->device_id == 0x0be1);
+      CHECK(d->deviceinfo.pci->subvendor_id == 0x1558 &&
+            d->deviceinfo.pci->subdevice_id == 0x2100 &&
+            d->deviceinfo.pci->revision_id == 0x0b);
+      CHECK(d->available_nodes ==
+            ((1 << DRM_NODE_PRIMARY) | (1 << DRM_NODE_RENDER)));
+      CHECK(!strcmp(d->nodes[DRM_NODE_PRIMARY], "/dev/dri/card1"));
+      CHECK(!strcmp(d->nodes[DRM_NODE_RENDER], "/dev/dri/renderD128"));
+      drmFreeDevice(&d);
+   }
+   /* the display's own node is libdrm's */
+   CHECK(!loader_drm_device_from_sysfs(root, 226, 0));
+   CHECK(!loader_drm_device_from_sysfs(root, 226, 2));
+
+   /* libdrm lists gma500 alone: the SGX is added, once */
+   list[0] = primary_only("/dev/dri/card0");
+   CHECK(loader_drm_add_sysfs_devices(root, NULL, 1, 0) == 2);
+   n = loader_drm_add_sysfs_devices(root, list, 1, 4);
+   CHECK(n == 2);
+   if (n == 2) {
+      CHECK(list[1]->available_nodes & (1 << DRM_NODE_RENDER));
+      CHECK(!strcmp(list[1]->nodes[DRM_NODE_RENDER], "/dev/dri/renderD128"));
+      /* a later libdrm that knows the device: not added twice */
+      CHECK(loader_drm_add_sysfs_devices(root, list, 2, 4) == 2);
+      drmFreeDevice(&list[1]);
+   }
+   /* no room: not added */
+   CHECK(loader_drm_add_sysfs_devices(root, list, 1, 1) == 1);
+   free(list[0]->nodes[DRM_NODE_PRIMARY]);
+   drmFreeDevice(&list[0]);
+
+   if (!failures)
+      printf("cedarview sysfs: all passed\n");
+   return failures != 0;
+}
diff --git a/src/loader/tests/child_render_node_test.c b/src/loader/tests/child_render_node_test.c
new file mode 100644
index 0000000..8bc0155
--- /dev/null
+++ b/src/loader/tests/child_render_node_test.c
@@ -0,0 +1,123 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ *
+ * loader_find_child_render_node on fake sysfs trees: a render node on an
+ * auxiliary device of the display's PCI function is found, render nodes of
+ * other devices are not.
+ */
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "loader.h"
+
+static char root[PATH_MAX];
+static int failures;
+
+static void
+mkdirs(const char *rel)
+{
+   char p[PATH_MAX];
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel);
+   for (char *s = p + strlen(root) + 1; *s; s++) {
+      if (*s == '/') {
+         *s = 0;
+         mkdir(p, 0755);
+         *s = '/';
+      }
+   }
+   mkdir(p, 0755);
+}
+
+static void
+link_at(const char *target, const char *rel)
+{
+   char p[PATH_MAX];
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel);
+   if (symlink(target, p)) {
+      perror(p);
+      exit(1);
+   }
+}
+
+/* a DRM node under device dir rel_dev, and its /sys/class/drm link */
+static void
+node(const char *rel_dev, const char *name)
+{
+   char rel[PATH_MAX], target[PATH_MAX];
+
+   snprintf(rel, sizeof(rel), "%s/drm/%s", rel_dev, name);
+   mkdirs(rel);
+   snprintf(rel, sizeof(rel), "%s/drm/%s/device", rel_dev, name);
+   link_at("../..", rel);
+   snprintf(target, sizeof(target), "../../%s/drm/%s", rel_dev, name);
+   snprintf(rel, sizeof(rel), "class/drm/%s", name);
+   link_at(target, rel);
+}
+
+static void
+expect(const char *rel_parent, const char *want)
+{
+   char parent[PATH_MAX], p[PATH_MAX], name[32] = "";
+   bool found;
+
+   snprintf(p, sizeof(p), "%s/%s", root, rel_parent);
+   if (!realpath(p, parent)) {
+      perror(p);
+      exit(1);
+   }
+   snprintf(p, sizeof(p), "%s/class/drm", root);
+   found = loader_find_child_render_node(p, parent, name, sizeof(name));
+   if (want ? !found || strcmp(name, want) != 0 : found) {
+      fprintf(stderr, "%s: got %s, want %s\n", rel_parent,
+              found ? name : "none", want ? want : "none");
+      failures++;
+   }
+}
+
+int
+main(void)
+{
+   const char *gma = "devices/pci0000:00/0000:00:02.0";
+   const char *other = "devices/pci0000:00/0000:00:03.0";
+   const char *plat = "devices/platform/simple-framebuffer.0";
+
+   snprintf(root, sizeof(root), "%s/child-render-XXXXXX",
+            getenv("TMPDIR") ? getenv("TMPDIR") : "/tmp");
+   if (!mkdtemp(root)) {
+      perror("mkdtemp");
+      return 1;
+   }
+   mkdirs("class/drm");
+
+   /* gma500: the display (card0) on the PCI function, the SGX's render node
+    * on its auxiliary device */
+   node(gma, "card0");
+   node("devices/pci0000:00/0000:00:02.0/gma500_gfx.sgx.0", "card1");
+   node("devices/pci0000:00/0000:00:02.0/gma500_gfx.sgx.0", "renderD129");
+   /* another PCI GPU with a render node of its own, and a platform display */
+   node(other, "card2");
+   node(other, "renderD128");
+   node(plat, "card3");
+
+   expect(gma, "renderD129");
+   /* a GPU's own render node is no child of its device */
+   expect(other, NULL);
+   expect(plat, NULL);
+
+   /* two children: the lowest numbered */
+   node("devices/pci0000:00/0000:00:02.0/second.0", "renderD200");
+   node("devices/pci0000:00/0000:00:02.0/third.0", "renderD130");
+   expect(gma, "renderD129");
+
+   if (!failures)
+      printf("loader_find_child_render_node: all passed\n");
+   return failures != 0;
+}
