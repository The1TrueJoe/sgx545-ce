config DRM_POWERVR_SGX
	tristate "PowerVR SGX5xx (SGX545: Intel CE5300, Cedarview)"
	depends on DRM && PCI && MMU && X86
	select DRM_EXEC
	select DRM_GEM_SHMEM_HELPER
	select DRM_GPUVM
	select DRM_SCHED
	select CRC32
	select FW_LOADER
	select WANT_DEV_COREDUMP
	help
	  Render-only DRM driver for PowerVR SGX5xx GPUs. It supports the
	  SGX545 of the Intel Atom CE5300 media processors, where the GPU is
	  its own PCI function (8086:089b), and of Cedarview (GMA3600/3650,
	  with DRM_POWERVR_SGX_GMA500). The GPU runs a microkernel loaded
	  with request_firmware().

	  Not compatible with the vendor services driver (SGX545_CE): bind one
	  or the other.

	  If M is selected the module will be called powervr_sgx.

config DRM_POWERVR_SGX_GMA500
	bool "Cedarview SGX545, behind gma500"
	depends on DRM_POWERVR_SGX && DRM_GMA500
	select AUXILIARY_BUS
	help
	  Bind to the SGX545 of the Atom D2000/N2000 (Cedarview) GPU, which
	  gma500 publishes as an auxiliary device next to its display driver.

config DRM_POWERVR_SGX_DDK_COMPAT
	bool "Run the vendor microkernel too (testing)"
	depends on DRM_POWERVR_SGX
	help
	  Also load the vendor (DDK 1.7) SGX545 microkernel, for A/B testing
	  against the open one. That microkernel runs client work under the
	  client's own page directory, so every client can then reach the
	  firmware's memory. Without this option only an open microkernel that
	  declares secure mode is loaded.

	  If unsure, say N.

config DRM_POWERVR_SGX_KUNIT_TEST
	tristate "KUnit tests for the PowerVR SGX545 driver" if !KUNIT_ALL_TESTS
	depends on DRM_POWERVR_SGX && KUNIT
	default KUNIT_ALL_TESTS
	help
	  Unit tests of the driver's firmware file checks. For developers;
	  if unsure, say N.
