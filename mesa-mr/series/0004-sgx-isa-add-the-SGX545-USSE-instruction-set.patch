+<!-- hw 10: sop2 -->
+<bitset name="sop2" extends="#int-c10">
+	<doc>
+		dst.rgb = (src1 * c1) cop (src2 * c2), dst.a = (src1.a * a1) aop
+		(src2.a * a2). No src0: l14-20 hold the alpha controls.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {C1} {C2} {COP} {CS1C} {A1} {A2} {AOP} {AS1C} {ANEG}]
+	</display>
+	<field name="ANEG" pos="14" type="bool" display=" aneg"/>
+	<field name="AS1C" pos="15" type="bool" display=" as1c"/>
+	<field name="AOP" low="16" high="17" type="#aop4"/>
+	<field name="COP" low="18" high="19" type="#cop4"/>
+	<field name="CS1C" pos="20" type="bool" display=" cs1c"/>
+	<field name="A2C" pos="34" type="uint"/>
+	<field name="C2SEL" low="35" high="37" type="uint"/>
+	<field name="C1SEL" low="38" high="40" type="uint"/>
+	<field name="A2SEL" low="41" high="42" type="uint"/>
+	<field name="A1C" pos="43" type="uint"/>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<field name="C2C" pos="47" type="uint"/>
+	<field name="A1SEL" low="52" high="53" type="uint"/>
+	<field name="C1C" pos="56" type="uint"/>
+	<pattern low="59" high="63">10000</pattern>
+	<derived name="C1" type="#sop2-c1"><expr>{C1SEL} | ({C1C} &lt;&lt; 3)</expr></derived>
+	<derived name="C2" type="#sop2-c2"><expr>{C2SEL} | ({C2C} &lt;&lt; 3)</expr></derived>
+	<derived name="A1" type="#sop2-a1"><expr>{A1SEL} | ({A1C} &lt;&lt; 2)</expr></derived>
+	<derived name="A2" type="#sop2-a2"><expr>{A2SEL} | ({A2C} &lt;&lt; 2)</expr></derived>
+</bitset>
+
+<!-- hw 12: sopwm -->
+<bitset name="sopwm" extends="#int-c10">
+	<doc>
+		dst = (src1 * c1) cop (src2 * c2) per byte, with a write mask whose
+		bits 0-3 are stored in h12, h13, h14, h11. No repeat.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {SRC1}, {SRC2} [{INT_FLAGS} {MASK} {C1} {C2} {COP} {AOP}]
+	</display>
+	<pattern low="14" high="20">0000000</pattern>
+	<pattern pos="34">0</pattern>
+	<field name="C2SEL" low="35" high="37" type="uint"/>
+	<field name="C1SEL" low="38" high="40" type="uint"/>
+	<field name="AOP" low="41" high="42" type="#aop4"/>
+	<field name="M3" pos="43" type="uint"/>
+	<field name="M012" low="44" high="46" type="uint"/>
+	<field name="C2C" pos="47" type="uint"/>
+	<field name="COP" low="52" high="53" type="#cop4"/>
+	<field name="C1C" pos="56" type="uint"/>
+	<pattern low="59" high="63">10010</pattern>
+	<derived name="MASK" type="#rm15"><expr>{M012} | ({M3} &lt;&lt; 3)</expr></derived>
+	<derived name="C1" type="#sopwm-c1"><expr>{C1SEL} | ({C1C} &lt;&lt; 3)</expr></derived>
+	<derived name="C2" type="#sopwm-c2"><expr>{C2SEL} | ({C2C} &lt;&lt; 3)</expr></derived>
+</bitset>
+
+<!-- hw 11: sop3 family -->
+<bitset name="#sop3" extends="#int-c10">
+	<doc>
+		dst, src0 (r/pa), src1, src2; c1/c2 selects h6-8 + h24, h3-5 + h15;
+		h21 picks the color op, h10 the coissued alpha op. No repeat.
+	</doc>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="C2SEL" low="35" high="37" type="uint"/>
+	<field name="C1SEL" low="38" high="40" type="uint"/>
+	<field name="C2C" pos="47" type="uint"/>
+	<field name="C1C" pos="56" type="uint"/>
+	<pattern low="59" high="63">10001</pattern>
+	<derived name="C1" type="#sop3-c1"><expr>{C1SEL} | ({C1C} &lt;&lt; 3)</expr></derived>
+	<derived name="C2" type="#sop3-c2"><expr>{C2SEL} | ({C2C} &lt;&lt; 3)</expr></derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="sop3" extends="#sop3">
+	<display>
+		{PRED}{NAME} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {C1} {C2} {COP} {A} {AOP} {AREV}]
+	</display>
+	<field name="AOP" pos="41" type="#aop2"/>
+	<pattern pos="42">0</pattern>
+	<field name="AREV" pos="43" type="bool" display=" arev"/>
+	<field name="ASEL" low="44" high="45" type="uint"/>
+	<field name="AC" pos="46" type="uint"/>
+	<field name="COP" pos="52" type="#cop2"/>
+	<pattern pos="53">0</pattern>
+	<derived name="A" type="#sop3-a"><expr>{ASEL} | ({AC} &lt;&lt; 2)</expr></derived>
+</bitset>
+
+<bitset name="sop3l" extends="#sop3">
+	<display>
+		{PRED}{NAME} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {C1} {C2} {COP} {A1} {A2} {CNEG}]
+	</display>
+	<field name="A1C" pos="41" type="uint"/>
+	<pattern pos="42">1</pattern>
+	<field name="CNEG" pos="43" type="bool" display=" cneg"/>
+	<field name="A2SEL" pos="44" type="uint"/>
+	<field name="A1SEL" pos="45" type="uint"/>
+	<field name="A2C" pos="46" type="uint"/>
+	<field name="COP" pos="52" type="#cop2"/>
+	<pattern pos="53">0</pattern>
+	<derived name="A1" type="#sop3-a1"><expr>{A1SEL} | ({A1C} &lt;&lt; 1)</expr></derived>
+	<derived name="A2" type="#sop3-a2"><expr>{A2SEL} | ({A2C} &lt;&lt; 1)</expr></derived>
+</bitset>
+
+<bitset name="lrp1" extends="#sop3">
+	<display>
+		{PRED}{NAME} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {L1} {L2} {LCS} {C1} {C2} {AOP}]
+	</display>
+	<field name="AOP" pos="41" type="#aop2"/>
+	<pattern pos="42">0</pattern>
+	<field name="LCS" pos="43" type="#lrp1-cs"/>
+	<field name="L2SEL" pos="44" type="uint"/>
+	<field name="L1SEL" pos="45" type="uint"/>
+	<field name="L2C" pos="46" type="uint"/>
+	<field name="L1C" pos="52" type="uint"/>
+	<pattern pos="53">1</pattern>
+	<derived name="L1" type="#lrp1-l1"><expr>{L1SEL} | ({L1C} &lt;&lt; 1)</expr></derived>
+	<derived name="L2" type="#lrp1-l2"><expr>{L2SEL} | ({L2C} &lt;&lt; 1)</expr></derived>
+</bitset>
+
+<bitset name="sop3x" extends="#sop3">
+	<display>
+		{PRED}{NAME} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {C1} {C2} {P} {A1} {A2}]
+	</display>
+	<field name="A1C" pos="41" type="uint"/>
+	<pattern pos="42">1</pattern>
+	<field name="P0" pos="43" type="uint"/>
+	<field name="A2SEL" pos="44" type="uint"/>
+	<field name="A1SEL" pos="45" type="uint"/>
+	<field name="A2C" pos="46" type="uint"/>
+	<field name="P1" pos="52" type="uint"/>
+	<pattern pos="53">1</pattern>
+	<derived name="P" type="#sop3x-p"><expr>{P0} | ({P1} &lt;&lt; 1)</expr></derived>
+	<derived name="A1" type="#sop3-a1"><expr>{A1SEL} | ({A1C} &lt;&lt; 1)</expr></derived>
+	<derived name="A2" type="#sop3-a2"><expr>{A2SEL} | ({A2C} &lt;&lt; 1)</expr></derived>
+</bitset>
+
+<!-- hw 18: dot3 / dot4 -->
+<bitset name="#dot" extends="#int-c10">
+	<doc>
+		h24 = 4-vector; h5 = a coissued alpha op with src0 (dot3s/dot4s);
+		cs h7-8 color scale; src1/src2 complement h11/h15.
+	</doc>
+	<field name="A2C" pos="35" type="uint"/>
+	<field name="F4" pos="36" type="bool" display=" f4"/>
+	<field name="F6" pos="38" type="bool" display=" f6"/>
+	<field name="DCS" low="39" high="40" type="#dot-cs"/>
+	<field name="A2SEL" low="41" high="42" type="uint"/>
+	<field name="S1C" pos="43" type="bool" display=" s1c"/>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<field name="S2C" pos="47" type="bool" display=" s2c"/>
+	<field name="A1SEL" low="52" high="53" type="uint"/>
+	<pattern low="59" high="63">11000</pattern>
+	<derived name="A2" type="#dot-a2"><expr>{A2SEL} | ({A2C} &lt;&lt; 2)</expr></derived>
+</bitset>
+
+<bitset name="#dot-noalpha" extends="#dot">
+	<display>
+		{PRED}{NAME} {DST}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {DCS} {DAS} {A1} {A2} {S1C} {S2C} {S1AC} {F4} {F6}]
+	</display>
+	<pattern pos="14">0</pattern>
+	<field name="S1AC" pos="15" type="bool" display=" s1ac"/>
+	<field name="DAS" low="16" high="17" type="#dot-as"/>
+	<pattern low="18" high="20">000</pattern>
+	<field name="A1C" pos="34" type="uint"/>
+	<pattern pos="37">0</pattern>
+	<derived name="A1" type="#dot-a1"><expr>{A1SEL} | ({A1C} &lt;&lt; 2)</expr></derived>
+</bitset>
+
+<bitset name="#dot-s" extends="#dot">
+	<display>
+		{PRED}{NAME} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {DCS} {A1} {A2} {S1C} {S2C} {F4} {F6}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<pattern pos="37">1</pattern>
+	<derived name="A1" type="#dot-a1"><expr>{A1SEL}</expr></derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="dot3" extends="#dot-noalpha">
+	<pattern pos="56">0</pattern>
+</bitset>
+<bitset name="dot4" extends="#dot-noalpha">
+	<pattern pos="56">1</pattern>
+</bitset>
+<bitset name="dot3s" extends="#dot-s">
+	<pattern pos="56">0</pattern>
+</bitset>
+<bitset name="dot4s" extends="#dot-s">
+	<pattern pos="56">1</pattern>
+</bitset>
+
+<!-- hw 13 ima8, hw 19 fpma -->
+<bitset name="#ima8" extends="#int-c10">
+	<doc>
+		dst = c0 * c1 + c2 per channel, alpha = a0 * s1a + s2a; src0 (r/pa)
+		negate h3.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {S0NEG}{SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {C0} {C1} {C2} {A0} {A1C} {A2C} {SAT}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="S0NEG" pos="35" type="bool" display="-"/>
+	<field name="C2SEL" pos="36" type="uint"/>
+	<field name="C1SEL" pos="37" type="uint"/>
+	<field name="A0C" pos="38" type="uint"/>
+	<field name="A1C" pos="39" type="bool" display=" a1c"/>
+	<field name="A2C" pos="40" type="bool" display=" a2c"/>
+	<field name="A0SEL" pos="41" type="uint"/>
+	<field name="C0C" pos="42" type="uint"/>
+	<field name="SAT" pos="43" type="bool" display=" sat"/>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<field name="C2C" pos="47" type="uint"/>
+	<field name="C0SEL" low="52" high="53" type="uint"/>
+	<field name="C1C" pos="56" type="uint"/>
+	<derived name="C0" type="#ima8-c0"><expr>{C0SEL} | ({C0C} &lt;&lt; 2)</expr></derived>
+	<derived name="C1" type="#ima8-c1"><expr>{C1SEL} | ({C1C} &lt;&lt; 1)</expr></derived>
+	<derived name="C2" type="#ima8-c2"><expr>{C2SEL} | ({C2C} &lt;&lt; 1)</expr></derived>
+	<derived name="A0" type="#ima8-a0"><expr>{A0SEL} | ({A0C} &lt;&lt; 1)</expr></derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="ima8" extends="#ima8">
+	<pattern low="59" high="63">10011</pattern>
+</bitset>
+<bitset name="fpma" extends="#ima8">
+	<pattern low="59" high="63">11001</pattern>
+</bitset>
+
+<!-- hw 14: ima16 -->
+<bitset name="ima16" extends="#int-plain">
+	<doc>dst = src0 * src1 + src2, 16-bit; src0 r/pa.</doc>
+	<display>
+		{PRED}{NAME}{SGN} {DST}, {SRC0}, {SRC1}, {S2NEG}{SRC2} [{INT_FLAGS} {RPT} {F1} {F2} {S1HI} {S2HI} {SAT} {F2_15} {DFLAG1}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="F2_15" low="35" high="36" type="custom"/>
+	<field name="S2HI" pos="37" type="bool" display=" s2hi"/>
+	<field name="F1" low="38" high="39" type="#ima16-f1"/>
+	<field name="F2" low="40" high="41" type="#ima16-f2"/>
+	<field name="SAT" pos="42" type="bool" display=" sat"/>
+	<field name="SGN" pos="43" type="bool" display=".sgn"/>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<pattern pos="47">0</pattern>
+	<field name="S1HI" pos="52" type="bool" display=" s1hi"/>
+	<field name="S2NEG" pos="53" type="bool" display="-"/>
+	<field name="DFLAG1" pos="56" type="bool" display=" dflag1"/>
+	<pattern low="59" high="63">10100</pattern>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<!-- hw 15: imae -->
+<bitset name="imae" extends="#int-plain">
+	<doc>dst = src0 * src1 + src2: 16x16 + 32 with carry; src0 r/pa.</doc>
+	<display>
+		{PRED}{NAME}{SGN} {DST}, {SRC0}, {SRC1}, {SRC2} [{INT_FLAGS} {RPT} {T2} {S0HI} {S1HI} {S2HI} {COUT} {CIN} {CI} {SAT} {F2_15}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="F2_15" low="35" high="37" type="custom"/>
+	<field name="T2" low="38" high="39" type="#imae-t2"/>
+	<field name="COUT" pos="40" type="bool" display=" cout"/>
+	<field name="CIN" pos="41" type="bool" display=" cin"/>
+	<field name="SAT" pos="42" type="bool" display=" sat"/>
+	<field name="SGN" pos="43" type="bool" display=".sgn"/>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<field name="CI" pos="47" type="#imae-ci"/>
+	<field name="S2HI" pos="52" type="bool" display=" s2hi"/>
+	<field name="S1HI" pos="53" type="bool" display=" s1hi"/>
+	<field name="S0HI" pos="56" type="bool" display=" s0hi"/>
+	<pattern low="59" high="63">10101</pattern>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<!-- hw 1a: ima32 (h20 = 0), op1adrc (h20 = 1) -->
+<bitset name="ima32" extends="#int-plain">
+	<doc>
+		dst = src0 * src1 + src2, 32-bit; the high word to i0-i2 (hi), carry
+		in from i0-i2 (cin); src0 r/pa/o/sa with extension h15.
+	</doc>
+	<display>
+		{PRED}{NAME}{SGN} {DST}, {SRC0}, {SRC1}, {S2NEG}{SRC2} [{INT_FLAGS} {RPT} {HI} {CIN} {NEGP}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<pattern pos="35">0</pattern>
+	<field name="HI" low="36" high="38" type="#ima32-hi"/>
+	<field name="S2NEG" pos="39" type="bool" display="-"/>
+	<field name="NEGP" pos="40" type="bool" display=" negp"/>
+	<field name="SGN" pos="41" type="bool" display=".sgn"/>
+	<field name="CIN" low="42" high="43" type="#ima32-cin"/>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<field name="S0E" pos="47" type="uint"/>
+	<pattern low="52" high="53">00</pattern>
+	<pattern pos="56">0</pattern>
+	<pattern low="59" high="63">11010</pattern>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7) | ({S0E} &lt;&lt; 8)</expr>
+		<param name="IMODE" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="CIN">src->cin3</map>
+		<map name="S0E">SGX_SRC0(0) &gt;&gt; 8</map>
+	</encode>
+</bitset>
+
+<bitset name="op1adrc" extends="#instruction">
+	<doc>
+		dest r/pa (h7), raw number; drc h0; sources src1, src2. Never emitted
+		for SGX545; the operation is unknown.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {END} {DRC} {RPT}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<pattern low="14" high="20">0000000</pattern>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DRC" pos="32" type="#drc"/>
+	<pattern low="33" high="38">000000</pattern>
+	<field name="DB" pos="39" type="uint"/>
+	<pattern low="40" high="43">0000</pattern>
+	<field name="RPT" low="44" high="46" type="#rpt8"/>
+	<pattern pos="47">0</pattern>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<pattern pos="51">0</pattern>
+	<pattern pos="52">1</pattern>
+	<pattern pos="53">0</pattern>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<pattern pos="56">0</pattern>
+	<field name="PRED" low="57" high="58" type="#pred2"/>
+	<pattern low="59" high="63">11010</pattern>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst1" width="8">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="DN">SGX_DST1() &amp; 0x7f</map>
+		<map name="DB">SGX_DST1() &gt;&gt; 7</map>
+		<map name="RPT">sgx_isa_rpt(src)</map>
+	</encode>
+</bitset>
+
+<!-- hw 16: adif / adifsum / op16s1 / bilin / ssum16 / ssum16i -->
+<bitset name="#hw16" extends="#int-plain">
