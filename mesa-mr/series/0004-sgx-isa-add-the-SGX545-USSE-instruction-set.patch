diff --git a/src/sgx/isa/sgx_isa_asm_int.c b/src/sgx/isa/sgx_isa_asm_int.c
new file mode 100644
index 0000000..3d1d03c
--- /dev/null
+++ b/src/sgx/isa/sgx_isa_asm_int.c
@@ -0,0 +1,495 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Text notation of the integer / fixed-point / dual-issue classes. */
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sgx_isa_asm.h"
+
+#define ARRAY_LEN(a) (sizeof(a) / sizeof((a)[0]))
+
+static int
+lookup(const char *const *names, unsigned n, const char *s)
+{
+   for (unsigned i = 0; i < n; i++) {
+      if (names[i] && !strcmp(names[i], s))
+         return i;
+   }
+   return -1;
+}
+
+#define LOOKUP(tbl, s) lookup(tbl, ARRAY_LEN(tbl), s)
+
+/* A select: a name from the table, or "1-name" (one = 1-zero, zero = 1-one). */
+static bool
+parse_sel(const char *const *names, unsigned n, const char *s, uint8_t *v,
+          bool *comp)
+{
+   int i;
+   char *end;
+   long long num = strtoll(s, &end, 0);
+   *comp = false;
+   if (*s && !*end) {
+      /* a number is the stored field value, complement bit included */
+      unsigned bits = 0;
+      while ((1u << bits) < n)
+         bits++;
+      if (num < 0 || num >= (2ll << bits))
+         return false;
+      *v = num & ((1u << bits) - 1);
+      *comp = num >> bits;
+      return true;
+   }
+   if (!strcmp(s, "one"))
+      s = "1-zero";
+   if (!strncmp(s, "1-", 2)) {
+      *comp = true;
+      s += 2;
+   }
+   if (!strcmp(s, "zero") || (s[0] == 'x' && s[1] >= '0' && s[1] <= '9')) {
+      long long x = strcmp(s, "zero") ? strtoll(s + 1, &end, 10) : 0;
+      if (strcmp(s, "zero") && (*end || x >= (long long)n))
+         return false;
+      i = !strcmp(s, "zero") ? lookup(names, n, "zero") : (int)x;
+      if (i < 0)
+         return false;
+   } else {
+      i = lookup(names, n, s);
+   }
+   if (i < 0 || i >= (int)n)
+      return false;
+   *v = i;
+   return true;
+}
+
+#define SEL(tbl, s, v, c) parse_sel(tbl, ARRAY_LEN(tbl), s, v, c)
+
+static const char *const sop2_c1[] = {"zero", "s1",   "s2",  "s1a",
+                                      "s2a",  "asat", "k18", NULL};
+static const char *const sop2_c2[] = {"zero", "s1",   "s2",  "s1a",
+                                      "s2a",  "asat", "k19", NULL};
+static const char *const sop2_a1[] = {"zero", "s1a", "s2a", "k18"};
+static const char *const sop2_a2[] = {"zero", "s1a", "s2a", "k19"};
+static const char *const sopwm_c[] = {"zero", "asat", "s1", "s1a",
+                                      NULL,   NULL,   "s2", "s2a"};
+static const char *const sop3_c[] = {"zero", "asat", "s1", "s1a",
+                                     "s0",   "s0a",  "s2", "s2a"};
+static const char *const sop3_a[] = {"zero", "s0a", "s1a", "s2a"};
+static const char *const sop3_a1[] = {"zero", "s1a"};
+static const char *const sop3_a2[] = {"zero", "s2a"};
+static const char *const lrp1_l1[] = {"zero", "s1"};
+static const char *const lrp1_l2[] = {"zero", "s2"};
+static const char *const lrp1_cs[] = {"s0", "s0a"};
+static const char *const sop3x_p[] = {"s1.s2", "s1.1-s2", "one.s2", "1-s1.s2"};
+static const char *const dot_a[] = {"zero", "s1a", "s2a", "x3"};
+static const char *const dot_scale[] = {"x1", "x2", "x4", "x8"};
+static const char *const ima8_c0[] = {"s0", "s1", "s0a", "s1a"};
+static const char *const ima8_c1[] = {"s1", "s1a"};
+static const char *const ima8_c2[] = {"s2", "s2a"};
+static const char *const ima8_a0[] = {"s0a", "s1a"};
+static const char *const ops4[] = {"add", "sub", "min", "max"};
+static const char *const efo_d[] = {"i0", "i1", "a0", "a1"};
+static const char *const efo_i[] = {"a0/a1", "a1/a0", "m0/m1", "a0/m1"};
+static const char *const efo_a[] = {"m0+m1/i1+i0", "m0+s0/i1+i0", "m0+i0/i1+m1",
+                                    "s0+s2/s1+s2"};
+static const char *const efo_m[] = {"s0*s2/s1*s2", "s2*s1/s2*s2", "s1*s0/s2*s2",
+                                    "s1*i0/s2*i1"};
+static const char *const fmt8[] = {"u8", "s8", "o8", "x3"};
+static const char *const imae_t2[] = {"u16", "s16", "u32", "x3"};
+static const char *const ii01[] = {"i0", "i1"};
+static const char *const fdual_pri[] = {"fmad", "mov",     "fadm",  "fmsa",
+                                        "fddp", "fminmax", "ima32", "fssq"};
+static const char *const fdual_sec[] = {
+   "fmad",  "fmad16", "fmsa", "fsubflr", "fmaxmin", "frcp", "frsq",  "fexp2",
+   "flog2", "fsin",   "fcos", "fadd",    "fsub",    "fmul", "ima32", "mov"};
+static const char *const fdual_sd[] = {"i0", "i1", "i2", "i0s0"};
+static const char *const fdual_sb[] = {"i0", "i1", "i2", "src1"};
+static const char *const fdual_sc[] = {"i0", "i1", "i2", "src2"};
+static const char *const fdual_msrc[] = {"i0",   "i1",   "i2",   "x3",
+                                         "src0", "src1", "src2", "x7"};
+
+static const struct {
+   const char *name;
+   enum sgx_isa_opc opc;
+   const char *ops;
+   uint8_t mask;
+} forms[] = {
+   {"efo", SGX_ISA_OPC_EFO, "D012"},
+   {"sop2", SGX_ISA_OPC_SOP2, "D12"},
+   {"sopwm", SGX_ISA_OPC_SOPWM, "D12", 15},
+   {"sop3", SGX_ISA_OPC_SOP3, "D012"},
+   {"sop3l", SGX_ISA_OPC_SOP3L, "D012"},
+   {"lrp1", SGX_ISA_OPC_LRP1, "D012"},
+   {"sop3x", SGX_ISA_OPC_SOP3X, "D012"},
+   {"dot3", SGX_ISA_OPC_DOT3, "D12"},
+   {"dot4", SGX_ISA_OPC_DOT4, "D12"},
+   {"dot3s", SGX_ISA_OPC_DOT3S, "D012"},
+   {"dot4s", SGX_ISA_OPC_DOT4S, "D012"},
+   {"ima8", SGX_ISA_OPC_IMA8, "D012"},
+   {"fpma", SGX_ISA_OPC_FPMA, "D012"},
+   {"ima16", SGX_ISA_OPC_IMA16, "D012"},
+   {"imae", SGX_ISA_OPC_IMAE, "D012"},
+   {"ima32", SGX_ISA_OPC_IMA32, "D012"},
+   {"op1adrc", SGX_ISA_OPC_OP1ADRC, "D12"},
+   {"adif", SGX_ISA_OPC_ADIF, "D12"},
+   {"adifsum", SGX_ISA_OPC_ADIFSUM, "D012"},
+   {"op16s1", SGX_ISA_OPC_OP16S1, "D012"},
+   {"bilin", SGX_ISA_OPC_BILIN, "D012"},
+   {"ssum16", SGX_ISA_OPC_SSUM16, "D012"},
+   {"ssum16i", SGX_ISA_OPC_SSUM16I, "D02"},
+   {"firv", SGX_ISA_OPC_FIRV, "D012"},
+   {"firh", SGX_ISA_OPC_FIRH, "D012"},
+};
+
+bool
+sgx_isa_asm_mnemonic_int(struct sgx_isa_instr *I, char **parts, unsigned nparts,
+                         unsigned nops, const char **pat)
+{
+   if (!strcmp(parts[0], "fdual")) {
+      int p = nparts == 3 ? LOOKUP(fdual_pri, parts[1]) : -1;
+      int s = nparts == 3 ? LOOKUP(fdual_sec, parts[2]) : -1;
+      /* sec 3 is fsubflr; fadm and ffrc are other names for it */
+      if (nparts == 3 &&
+          (!strcmp(parts[2], "fadm") || !strcmp(parts[2], "ffrc")))
+         s = 3;
+      if (p < 0 || s < 0)
+         return false;
+      I->opc = SGX_ISA_OPC_FDUAL;
+      I->pri = p;
+      I->sec = s;
+      *pat = "D012";
+      return true;
+   }
+
+   for (unsigned i = 0; i < ARRAY_LEN(forms); i++) {
+      if (strcmp(parts[0], forms[i].name))
+         continue;
+      enum sgx_isa_opc opc = forms[i].opc;
+      bool fmtx = opc == SGX_ISA_OPC_BILIN || opc == SGX_ISA_OPC_SSUM16 ||
+                  opc == SGX_ISA_OPC_FIRV || opc == SGX_ISA_OPC_FIRH;
+      if (nparts == 2 && !strcmp(parts[1], "sgn") &&
+          (opc == SGX_ISA_OPC_IMA16 || opc == SGX_ISA_OPC_IMAE ||
+           opc == SGX_ISA_OPC_IMA32)) {
+         I->sgn = true;
+      } else if (nparts == 2 && fmtx) {
+         /* the format as a suffix: bilin.s8, ssum16.o8, firh.s8; ssum16's
+          * picks the form */
+         static const char *const sfx[] = {"u8", "s8", "o8", "fmt3"};
+         int f = LOOKUP(sfx, parts[1]);
+         if (f <= 0 || (f == 3 && opc == SGX_ISA_OPC_SSUM16))
+            return false;
+         I->ifmt = f;
+         if (opc == SGX_ISA_OPC_SSUM16)
+            opc = f == 1 ? SGX_ISA_OPC_SSUM16_S8 : SGX_ISA_OPC_SSUM16_O8;
+      } else if (nparts != 1) {
+         return false;
+      }
+      I->opc = opc;
+      I->mask = forms[i].mask;
+      *pat = forms[i].ops;
+      return true;
+   }
+   return false;
+}
+
+static bool
+set_sel(const char *const *tbl, unsigned n, const char *v, uint8_t *sel,
+        bool *comp)
+{
+   return v && parse_sel(tbl, n, v, sel, comp);
+}
+
+#define SET_SEL(tbl, sel, comp)                                                \
+   set_sel(tbl, ARRAY_LEN(tbl), value, &I->sel, &I->comp)
+
+static bool
+set_enum(const char *const *tbl, unsigned n, const char *v, uint8_t *out)
+{
+   char *end;
+   if (v && *v) {
+      long long num = strtoll(v, &end, 0);
+      if (!*end) {
+         if (num < 0 || num >= (long long)n)
+            return false;
+         *out = num;
+         return true;
+      }
+   }
+   int i = v ? lookup(tbl, n, v) : -1;
+   if (i < 0)
+      return false;
+   *out = i;
+   return true;
+}
+
+#define SET_ENUM(tbl, field) set_enum(tbl, ARRAY_LEN(tbl), value, &I->field)
+
+static bool
+set_num(const char *v, uint8_t *out)
+{
+   char *end;
+   if (!v || !*v)
+      return false;
+   long long n = strtoll(v, &end, 0);
+   if (*end || n < 0 || n > UINT8_MAX)
+      return false;
+   *out = n;
+   return true;
+}
+
+/*
+ * efo's i, a and m in their long spelling, "i0=m0,i1=m1", into the table's
+ * "m0/m1"; NULL if it isn't that form.
+ */
+static const char *
+efo_pair(const char *v, char *buf, size_t size)
+{
+   const char *comma = v ? strchr(v, ',') : NULL;
+   const char *e0 = v ? strchr(v, '=') : NULL;
+   const char *e1 = comma ? strchr(comma, '=') : NULL;
+
+   if (!comma || !e0 || e0 > comma || !e1)
+      return NULL;
+   snprintf(buf, size, "%.*s/%s", (int)(comma - e0 - 1), e0 + 1, e1 + 1);
+   return buf;
+}
+
+bool
+sgx_isa_asm_item_int(struct sgx_isa_instr *I, const char *name,
+                     const char *value)
+{
+   enum sgx_isa_opc o = I->opc;
+   bool sop2 = o == SGX_ISA_OPC_SOP2, sopwm = o == SGX_ISA_OPC_SOPWM;
+   bool sop3 = o == SGX_ISA_OPC_SOP3 || o == SGX_ISA_OPC_SOP3L ||
+               o == SGX_ISA_OPC_LRP1 || o == SGX_ISA_OPC_SOP3X;
+   bool dot = o == SGX_ISA_OPC_DOT3 || o == SGX_ISA_OPC_DOT4 ||
+              o == SGX_ISA_OPC_DOT3S || o == SGX_ISA_OPC_DOT4S;
+   bool ima8 = o == SGX_ISA_OPC_IMA8 || o == SGX_ISA_OPC_FPMA;
+   bool dummy;
+
+   /* plain flags */
+   static const struct {
+      const char *name;
+      size_t off;
+   } flags[] = {
+#define F(n) {#n, offsetof(struct sgx_isa_instr, n)}
+      F(cs1c), F(as1c), F(aneg),   F(arev),   F(cneg),   F(f4),    F(f6),
+      F(s1c),  F(s2c),  F(s1ac),   F(sat),    F(dflag1), F(s0hi),  F(s1hi),
+      F(s2hi), F(cout), F(negp),   F(ileave), F(src23),  F(dst23), F(x1b),
+      F(x1c),  F(x1d),  F(nf16),   F(s8),     F(x38),    F(s0f13), F(f2_27),
+      F(wi0),  F(wi1),  F(a0lneg), F(a0rneg), F(f3_10),
+#undef F
+   };
+   /* fdual's src1 / src2 negates as bracket flags (or -x on the operand) */
+   if (o == SGX_ISA_OPC_FDUAL && !value &&
+       (!strcmp(name, "neg1") || !strcmp(name, "neg2"))) {
+      I->src[name[3] - '0'].neg = true;
+      return true;
+   }
+   if (!value) {
+      for (unsigned i = 0; i < ARRAY_LEN(flags); i++) {
+         if (!strcmp(name, flags[i].name)) {
+            *(bool *)((char *)I + flags[i].off) = true;
+            return true;
+         }
+      }
+      if (!strcmp(name, "cin") && o == SGX_ISA_OPC_IMAE)
+         return I->cin = true;
+      if (!strcmp(name, "rnd") && o == SGX_ISA_OPC_BILIN)
+         return I->irnd = true;
+      if (!strcmp(name, "a1c") && ima8)
+         return I->a1c = true;
+      if (!strcmp(name, "a2c") && ima8)
+         return I->a2c = true;
+      return false;
+   }
+
+   if (!strcmp(name, "c1")) {
+      if (sop2)
+         return SET_SEL(sop2_c1, c1, c1c);
+      if (sopwm)
+         return SET_SEL(sopwm_c, c1, c1c);
+      if (sop3)
+         return SET_SEL(sop3_c, c1, c1c);
+      if (ima8)
+         return SET_SEL(ima8_c1, c1, c1c);
+   }
+   if (!strcmp(name, "c2")) {
+      if (sop2)
+         return SET_SEL(sop2_c2, c2, c2c);
+      if (sopwm)
+         return SET_SEL(sopwm_c, c2, c2c);
+      if (sop3)
+         return SET_SEL(sop3_c, c2, c2c);
+      if (ima8)
+         return SET_SEL(ima8_c2, c2, c2c);
+   }
+   if (!strcmp(name, "c0") && ima8)
+      return SET_SEL(ima8_c0, c0, c0c);
+   if (!strcmp(name, "a0") && ima8)
+      return SET_SEL(ima8_a0, a0, a0c);
+   if (!strcmp(name, "a1")) {
+      if (sop2)
+         return SET_SEL(sop2_a1, a1, a1c);
+      if (sop3)
+         return SET_SEL(sop3_a1, a1, a1c);
+      if (dot)
+         return SET_SEL(dot_a, a1, a1c);
+   }
+   if (!strcmp(name, "a2")) {
+      if (sop2)
+         return SET_SEL(sop2_a2, a2, a2c);
+      if (sop3)
+         return SET_SEL(sop3_a2, a2, a2c);
+      if (dot)
+         return SET_SEL(dot_a, a2, a2c);
+   }
+   if (!strcmp(name, "a") && sop3)
+      return SET_SEL(sop3_a, asel, aselc);
+   if (!strcmp(name, "l1"))
+      return SET_SEL(lrp1_l1, l1, l1c);
+   if (!strcmp(name, "l2"))
+      return SET_SEL(lrp1_l2, l2, l2c);
+   if (!strcmp(name, "cs")) {
+      if (o == SGX_ISA_OPC_LRP1)
+         return SET_ENUM(lrp1_cs, lcs);
+      /* dot's scales: x4, or cx4 / ax2 */
+      if (dot && value && value[0] == 'c' && value[1] == 'x')
+         value++;
+      if (dot)
+         return SET_ENUM(dot_scale, dcs);
+   }
+   if (!strcmp(name, "as") && dot) {
+      if (value && value[0] == 'a' && value[1] == 'x')
+         value++;
+      return SET_ENUM(dot_scale, das);
+   }
+   if (!strcmp(name, "p") && o == SGX_ISA_OPC_SOP3X)
+      return SET_ENUM(sop3x_p, p);
+   if (!strcmp(name, "cop"))
+      return SET_ENUM(ops4, cop);
+   if (!strcmp(name, "aop"))
+      return SET_ENUM(ops4, aop);
+   if (!strcmp(name, "d") && o == SGX_ISA_OPC_EFO)
+      return SET_ENUM(efo_d, efo_d);
+   if (o == SGX_ISA_OPC_EFO &&
+       (!strcmp(name, "i") || !strcmp(name, "a") || !strcmp(name, "m"))) {
+      char buf[64];
+      const char *pair = efo_pair(value, buf, sizeof(buf));
+
+      if (pair)
+         value = pair;
+      if (!strcmp(name, "i"))
+         return SET_ENUM(efo_i, efo_i);
+      if (!strcmp(name, "a"))
+         return SET_ENUM(efo_a, efo_a);
+      return SET_ENUM(efo_m, efo_m);
+   }
+   if (!strcmp(name, "f1"))
+      return set_enum(fmt8, 3, value, &I->f1) && ++I->f1;
+   if (!strcmp(name, "f2"))
+      return set_enum(fmt8, 3, value, &I->f2) && ++I->f2;
+   if (!strcmp(name, "t2"))
+      return SET_ENUM(imae_t2, t2);
+   if (!strcmp(name, "i") && o == SGX_ISA_OPC_OP16S1)
+      return SET_ENUM(ii01, ii);
+   if (!strcmp(name, "ci")) {
+      uint8_t v;
+      if (!SET_ENUM(ii01, ii))
+         return false;
+      v = I->ii;
+      I->ii = 0;
+      if (o == SGX_ISA_OPC_OP16S1)
+         I->ii = v;
+      else
+         I->ci = v;
+      return true;
+   }
+   if (!strcmp(name, "hi") && o == SGX_ISA_OPC_IMA32) {
+      static const char *const hi[] = {NULL, NULL, NULL, NULL,
+                                       "i0", "i1", "i2"};
+      return SET_ENUM(hi, hi) || set_num(value, &I->hi);
+   }
+   if (!strcmp(name, "cin") && o == SGX_ISA_OPC_IMA32) {
+      static const char *const cin[] = {NULL, "i0", "i1", "i2"};
+      return SET_ENUM(cin, cin3);
+   }
+   if (!strcmp(name, "fmt") && o == SGX_ISA_OPC_SSUM16) {
+      /* ssum16's format picks the form (fmt 3 is ssum16i) */
+      static const enum sgx_isa_opc f[] = {
+         SGX_ISA_OPC_SSUM16, SGX_ISA_OPC_SSUM16_S8, SGX_ISA_OPC_SSUM16_O8};
+      if (!set_enum(fmt8, 3, value, &I->ifmt))
+         return false;
+      I->opc = f[I->ifmt];
+      return true;
+   }
+   if (!strcmp(name, "fmt"))
+      return SET_ENUM(fmt8, ifmt);
+   if (!strcmp(name, "sd"))
+      return SET_ENUM(fdual_sd, sd);
+   if (!strcmp(name, "sb"))
+      return SET_ENUM(fdual_sb, sb);
+   if (!strcmp(name, "sc"))
+      return SET_ENUM(fdual_sc, sc);
+   if (!strcmp(name, "msrc"))
+      return SET_ENUM(fdual_msrc, msrc);
+   if (!strcmp(name, "f2_15"))
+      return set_num(value, &I->f2_15);
+   if (!strcmp(name, "x39"))
+      return set_num(value, &I->x39);
+   if (!strcmp(name, "a5"))
+      return set_num(value, &I->a5);
+   if (!strcmp(name, "coef"))
+      return set_num(value, &I->coef);
+   if (!strcmp(name, "shift"))
+      return set_num(value, &I->shift);
+   if (!strcmp(name, "a8"))
+      return set_num(value, &I->a8);
+   (void)dummy;
+   return false;
+}
+
+bool
+sgx_isa_asm_pred2_int(enum sgx_isa_opc opc)
+{
+   switch (opc) {
+   case SGX_ISA_OPC_EFO:
+   case SGX_ISA_OPC_FDUAL:
+   case SGX_ISA_OPC_SOP2:
+   case SGX_ISA_OPC_SOPWM:
+   case SGX_ISA_OPC_SOP3:
+   case SGX_ISA_OPC_SOP3L:
+   case SGX_ISA_OPC_LRP1:
+   case SGX_ISA_OPC_SOP3X:
+   case SGX_ISA_OPC_DOT3:
+   case SGX_ISA_OPC_DOT4:
+   case SGX_ISA_OPC_DOT3S:
+   case SGX_ISA_OPC_DOT4S:
+   case SGX_ISA_OPC_IMA8:
+   case SGX_ISA_OPC_FPMA:
+   case SGX_ISA_OPC_IMA16:
+   case SGX_ISA_OPC_IMAE:
+   case SGX_ISA_OPC_IMA32:
+   case SGX_ISA_OPC_OP1ADRC:
+   case SGX_ISA_OPC_ADIF:
+   case SGX_ISA_OPC_ADIFSUM:
+   case SGX_ISA_OPC_OP16S1:
+   case SGX_ISA_OPC_BILIN:
+   case SGX_ISA_OPC_SSUM16:
+   case SGX_ISA_OPC_SSUM16_S8:
+   case SGX_ISA_OPC_SSUM16_O8:
+   case SGX_ISA_OPC_SSUM16I:
+   case SGX_ISA_OPC_FIRV:
+   case SGX_ISA_OPC_FIRH:
+      return true;
+   default:
+      return false;
+   }
+}
diff --git a/src/sgx/isa/sgx_isa_coissue.c b/src/sgx/isa/sgx_isa_coissue.c
new file mode 100644
index 0000000..7f8c3a9
--- /dev/null
+++ b/src/sgx/isa/sgx_isa_coissue.c
@@ -0,0 +1,147 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * What a compiler needs to pair operations with efo and fdual: which
+ * internal registers and slots each half reads and writes, and the same-word
+ * hazards.
+ */
+
+#include "sgx_isa.h"
+
+#define SLOT(k) (1u << (k))
+
+/* an operand as an internal register: i<n>, or r124-r127 (the alias) */
+static int
+internal(const struct sgx_isa_src *o)
+{
+   if (o->file == SGX_ISA_FILE_I)
+      return o->num;
+   if (o->file == SGX_ISA_FILE_R && o->num >= 124 && o->num <= 127)
+      return o->num - 124;
+   return -1;
+}
+
+static void
+read_sel(struct sgx_isa_fdual_use *u, unsigned sel, unsigned slot)
+{
+   /* a select: i0-i2, or 3 = the slot */
+   if (sel < 3)
+      u->sec_reads_i |= 1u << sel;
+   else
+      u->sec_reads_slots |= SLOT(slot);
+}
+
+bool
+sgx_isa_fdual_use(const struct sgx_isa_instr *instr,
+                  struct sgx_isa_fdual_use *u)
+{
+   unsigned sd = instr->sd & 3;
+
+   *u = (struct sgx_isa_fdual_use){.settled = true};
+   if (instr->opc != SGX_ISA_OPC_FDUAL)
+      return false;
+
+   /* the secondary writes the internal register sd names (i0s0: i0) */
+   u->sec_writes_i = 1u << (sd == 3 ? 0 : sd);
+
+   switch (instr->sec) {
+   case 0: /* fmad: sd * sb + sc */
+   case 2: /* fmsa: sd * sd + sb * sc */
+   case 4: /* fmaxmin: sb and sc, and maybe sd (not drawn yet) */
+      if (sd == 3)
+         u->sec_reads_slots |= SLOT(0);
+      else
+         u->sec_reads_i |= 1u << sd;
+      read_sel(u, instr->sb, 1);
+      read_sel(u, instr->sc, 2);
+      u->settled = instr->sec != 4;
+      break;
+   case 3: /* fsubflr: sb - floor(sc) */
+   case 11:
+   case 12:
+   case 13: /* fadd, fsub, fmul: sb op sc */
+      read_sel(u, instr->sb, 1);
+      read_sel(u, instr->sc, 2);
+      break;
+   case 5:
+   case 6:
+   case 7:
+   case 8:
+   case 9:
+   case 10: /* op(sb) */
+      read_sel(u, instr->sb, 1);
+      break;
+   case 15: /* mov: msrc (0-2 i0-i2, 4-6 the src0-src2 slot) */
+      if (instr->msrc < 3)
+         u->sec_reads_i |= 1u << instr->msrc;
+      else if (instr->msrc >= 4 && instr->msrc <= 6)
+         u->sec_reads_slots |= SLOT(instr->msrc - 4);
+      else
+         u->settled = false;
+      break;
+   default: /* fmad16, ima32: F16 / integer meaning not drawn */
+      if (sd == 3)
+         u->sec_reads_slots |= SLOT(0);
+      else
+         u->sec_reads_i |= 1u << sd;
+      read_sel(u, instr->sb, 1);
+      read_sel(u, instr->sc, 2);
+      u->settled = false;
+      break;
+   }
+
+   switch (instr->pri) {
+   case 1: /* mov: src1 */
+      u->pri_reads_slots = SLOT(1);
+      break;
+   case 7: /* fssq: src1^2 + src2^2 */
+      u->pri_reads_slots = SLOT(1) | SLOT(2);
+      break;
+   case 4: /* fddp: also leaves src0 * src2 in an internal register (i0
+            * seen; whether it follows sd is not drawn) */
+      u->pri_reads_slots = SLOT(0) | SLOT(1) | SLOT(2);
+      u->pri_writes_i = 1u << 0;
+      u->settled = false;
+      break;
+   default: /* fmad, fadm, fmsa, fminmax, ima32: all three slots */
+      u->pri_reads_slots = SLOT(0) | SLOT(1) | SLOT(2);
+      u->settled &= instr->pri != 6;
+      break;
+   }
+   for (unsigned k = 0; k < 3; k++) {
+      int i = internal(&instr->src[k]);
+      if ((u->pri_reads_slots & SLOT(k)) && i >= 0)
+         u->pri_reads_i |= 1u << i;
+   }
+   int d = internal(&instr->dst);
+   if (d >= 0)
+      u->pri_writes_i |= 1u << d;
+   return true;
+}
+
+const char *
+sgx_isa_coissue_hazard(const struct sgx_isa_instr *instr)
+{
+   if (instr->opc == SGX_ISA_OPC_FDUAL) {
+      struct sgx_isa_fdual_use u;
+
+      sgx_isa_fdual_use(instr, &u);
+      /* the secondary reads before the primary writes (fine); the primary
+       * reading what the secondary writes is a race */
+      if (u.pri_reads_i & u.sec_writes_i)
+         return "the primary reads an internal register the secondary "
+                "writes in the same word";
+      return NULL;
+   }
+   if (instr->opc == SGX_ISA_OPC_EFO) {
+      /* d=i0 while the word writes I0 is a race; d=i1 with wi1 reads the
+       * old I1 (a mat4 * v chain stores the previous chain's result so) */
+      if (instr->efo_d == 0 && instr->wi0)
+         return "efo's d names I0 while the same word writes it";
+      return NULL;
+   }
+   return NULL;
+}
diff --git a/src/sgx/isa/sgx_isa_disasm.c b/src/sgx/isa/sgx_isa_disasm.c
new file mode 100644
index 0000000..78ec157
--- /dev/null
+++ b/src/sgx/isa/sgx_isa_disasm.c
@@ -0,0 +1,160 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The disassembler: isaspec's generated decoder plus what the XML leaves
+ * to C:
+ *  - "custom" fields, printed only when they differ from their default;
+ *  - format control, tracked through setfc and handed to the XML's
+ *    expressions in ISA_GPU_ID() with the core (sgx_isa_gpu_id());
+ *  - tidying the trailing "[...]" (empty brackets, leading spaces).
+ */
+
+#include <ctype.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sgx-isa.h"
+#include "sgx_isa.h"
+
+static void
+print_custom(struct isa_print_state *print, const char *name, uint64_t v)
+{
+   /* Numbers print in decimal. */
+   if (!strcmp(name, "NODST")) {
+      if (v != 0x280)
+         isa_print(print, " nodst=%" PRIu64, v);
+   } else if (!strcmp(name, "UNUSED2")) {
+      if (v != 0x300)
+         isa_print(print, " unused2=%" PRIu64, v);
+   } else if (!strcmp(name, "IMM16") || !strcmp(name, "LIMM")) {
+      isa_print(print, "#%" PRIu64, v);
+   } else if (!strncmp(name, "SL", 2)) {
+      /* smlsi operand: bit 8 = swizzle, else a signed 8-bit increment */
+      if (v & 0x100) {
+         isa_print(print, "#0.");
+         for (unsigned i = 0; i < 4; i++)
+            isa_print(print, "%c", "xyzw"[(v >> (2 * i)) & 3]);
+      } else {
+         isa_print(print, "#%d", (int)(int8_t)(v & 0xff));
+      }
+   } else if (v) {
+      static const struct {
+         const char *field, *text;
+      } names[] = {
+         {"ROT", "rot"},   {"PATH", "path"}, {"EN", "n"},     {"AM0", "am0"},
+         {"AM1", "am1"},   {"AM2", "am2"},   {"AM3", "am3"},  {"LIM0", "lim0"},
+         {"LIM1", "lim1"}, {"LIM2", "lim2"}, {"EIMM", "imm"},
+      };
+      for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+         if (!strcmp(name, names[i].field)) {
+            isa_print(print, " %s=%" PRIu64, names[i].text, v);
+            return;
+         }
+      }
+      isa_print(print, " ");
+      for (const char *c = name; *c; c++)
+         isa_print(print, "%c", tolower((unsigned char)*c));
+      isa_print(print, "=%" PRIu64, v);
+   }
+}
+
+/* setfc: hw 1f, MOE control (h20-22 = 1), op 5; a0 = l0, a1 = l8. */
+bool
+sgx_isa_setfc(uint64_t w, struct sgx_isa_fc *fc)
+{
+   uint32_t hi = w >> 32;
+
+   if ((hi >> 27) != 0x1f || ((hi >> 20) & 7) != 1 || ((hi >> 24) & 7) != 5)
+      return false;
+   fc->f16 = w & 1;
+   fc->c10 = (w >> 8) & 1;
+   return true;
+}
+
+/*
+ * The XML separates bracket items with spaces whether or not they print:
+ * collapse the runs, trim inside the brackets, drop an empty " []".
+ */
+static void
+tidy(char *s)
+{
+   char *d = s, *e;
+
+   for (char *p = s; *p; p++) {
+      if (*p == '\n' || *p == '\t')
+         *p = ' ';
+   }
+   e = s + strlen(s);
+   while (e > s && e[-1] == ' ')
+      *--e = '\0';
+
+   char *lb = strrchr(s, '[');
+   if (!lb || e == s || e[-1] != ']' || (lb > s && lb[-1] != ' '))
+      return;
+
+   d = lb + 1;
+   bool space = false;
+   for (char *p = lb + 1; *p; p++) {
+      if (*p == ' ') {
+         space = true;
+         continue;
+      }
+      if (space && d > lb + 1 && *p != ']')
+         *d++ = ' ';
+      space = false;
+      *d++ = *p;
+   }
+   *d = '\0';
+   if (!strcmp(lb, "[]")) {
+      lb[-1] = '\0';
+   }
+}
+
+bool
+sgx_disasm_one(uint64_t word, const struct sgx_isa_fc *fc, char *buf,
+               size_t size)
+{
+   struct sgx_isa_fc f = fc ? *fc : SGX_ISA_FC_START;
+   uint32_t words[2] = {(uint32_t)word, (uint32_t)(word >> 32)};
+   char *text = NULL;
+   size_t len = 0;
+   FILE *out = open_memstream(&text, &len);
+
+   if (!out)
+      return false;
+
+   sgx_isa_disasm(words, sizeof(words), out,
+                  &(struct isa_decode_options){
+                     .gpu_id = sgx_isa_gpu_id(&f),
+                     .show_errors = true,
+                     .field_print_cb = print_custom,
+                  });
+   fclose(out);
+
+   tidy(text);
+   bool ok = !strstr(text, "no match") && !strstr(text, "unexpected bits") &&
+             !strstr(text, "dontcare");
+   snprintf(buf, size, "%s", text);
+   free(text);
+   return ok;
+}
+
+void
+sgx_disasm(const uint32_t *words, unsigned n, FILE *out,
+           const struct sgx_isa_fc *fc)
+{
+   struct sgx_isa_fc f = fc ? *fc : SGX_ISA_FC_START;
+   char line[512];
+
+   for (unsigned i = 0; i < n; i++) {
+      uint64_t w = words[2 * i] | (uint64_t)words[2 * i + 1] << 32;
+
+      sgx_disasm_one(w, &f, line, sizeof(line));
+      fprintf(out, "%08x %08x  %s\n", words[2 * i], words[2 * i + 1], line);
+      sgx_isa_setfc(w, &f);
+   }
+}
diff --git a/src/sgx/isa/sgx_isa_encode.c b/src/sgx/isa/sgx_isa_encode.c
new file mode 100644
index 0000000..08abeb5
--- /dev/null
+++ b/src/sgx/isa/sgx_isa_encode.c
@@ -0,0 +1,206 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Glue for the encoder isaspec generates from sgx.xml: the leaf
+ * selection for each bitset hierarchy, and the helpers the XML's <map>
+ * expressions use. Everything about bit positions lives in the XML.
+ */
+
+#include "sgx_isa.h"
+
+#include "util/macros.h"
+
+/* gen is what the XML's expressions read as ISA_GPU_ID() (sgx_isa_gpu_id()). */
+struct encode_state {
+   uint32_t gen;
+};
+
+static inline enum sgx_isa_opc
+__instruction_case(struct encode_state *s, const struct sgx_isa_instr *instr)
+{
+   return instr->opc;
+}
+
+static inline enum sgx_isa_case_dst
+__dst_case(struct encode_state *s, const struct sgx_isa_src *o)
+{
+   switch (o->file) {
+   case SGX_ISA_FILE_R:
+      return SGX_DST_R;
+   case SGX_ISA_FILE_O:
+      return SGX_DST_O;
+   case SGX_ISA_FILE_PA:
+      return SGX_DST_PA;
+   case SGX_ISA_FILE_SA:
+      return SGX_DST_SA;
+   case SGX_ISA_FILE_IX:
+      return SGX_DST_IX;
+   case SGX_ISA_FILE_C:
+   case SGX_ISA_FILE_G:
+      return SGX_DST_G;
+   case SGX_ISA_FILE_IDX:
+      return SGX_DST_IDX;
+   case SGX_ISA_FILE_I:
+      return SGX_DST_I;
+   default:
+      return SGX_DST__NONE;
+   }
+}
+
+static inline enum sgx_isa_case_src
+__src_case(struct encode_state *s, const struct sgx_isa_src *o)
+{
+   switch (o->file) {
+   case SGX_ISA_FILE_R:
+      return SGX_SRC_R;
+   case SGX_ISA_FILE_O:
+      return SGX_SRC_O;
+   case SGX_ISA_FILE_PA:
+      return SGX_SRC_PA;
+   case SGX_ISA_FILE_SA:
+      return SGX_SRC_SA;
+   case SGX_ISA_FILE_IX:
+      return SGX_SRC_IX;
+   case SGX_ISA_FILE_C:
+   case SGX_ISA_FILE_G:
+      return SGX_SRC_C;
+   case SGX_ISA_FILE_IMM:
+      return SGX_SRC_IMM;
+   case SGX_ISA_FILE_I:
+      return SGX_SRC_I;
+   default:
+      return SGX_SRC__NONE;
+   }
+}
+
+/* src0 slots have no internal bank: i<n> is r(124 + n). */
+static inline enum sgx_isa_case_src0
+__src0_case(struct encode_state *s, const struct sgx_isa_src *o)
+{
+   switch (o->file) {
+   case SGX_ISA_FILE_R:
+   case SGX_ISA_FILE_I:
+      return SGX_SRC0_R;
+   case SGX_ISA_FILE_O:
+      return SGX_SRC0_O;
+   case SGX_ISA_FILE_PA:
+      return SGX_SRC0_PA;
+   case SGX_ISA_FILE_SA:
+      return SGX_SRC0_SA;
+   default:
+      return SGX_SRC0__NONE;
+   }
+}
+
+static inline enum sgx_isa_case_dst1
+__dst1_case(struct encode_state *s, const struct sgx_isa_src *o)
+{
+   switch (o->file) {
+   case SGX_ISA_FILE_R:
+   case SGX_ISA_FILE_I:
+      return SGX_DST1_R;
+   case SGX_ISA_FILE_PA:
+      return SGX_DST1_PA;
+   default:
+      return SGX_DST1__NONE;
+   }
+}
+
+/*
+ * The number field: g<n> is n + 0x40 on the c/g bank, i<n> in an r slot is
+ * 124 + n, a negative immediate its 7-bit two's complement (the signed
+ * immediates of ima16, imae, ...).
+ */
+static inline uint32_t
+sgx_isa_opnd_num(const struct sgx_isa_src *o)
+{
+   switch (o->file) {
+   case SGX_ISA_FILE_G:
+      return o->num + 0x40;
+   case SGX_ISA_FILE_IMM:
+      return (int32_t)o->num < 0 ? o->num & 0x7f : o->num;
+   default:
+      return o->num;
+   }
+}
+
+static inline uint32_t
+sgx_isa_reg_num(const struct sgx_isa_src *o)
+{
+   return o->file == SGX_ISA_FILE_I ? 124 + o->num : o->num;
+}
+
+static inline const struct sgx_isa_src *
+sgx_isa_noext(const struct sgx_isa_src *o, struct sgx_isa_src *tmp)
+{
+   if (o->file != SGX_ISA_FILE_I)
+      return o;
+   *tmp = *o;
+   tmp->file = SGX_ISA_FILE_R;
+   tmp->num = 124 + o->num;
+   return tmp;
+}
+
+static inline unsigned
+sgx_isa_rpt(const struct sgx_isa_instr *instr)
+{
+   return instr->rpt ? instr->rpt - 1 : 0;
+}
+
+/*
+ * Operand helpers for the <map>s: encode an operand through its slot's
+ * hierarchy and return NUM | BANK << 7 | EXT << 9 (src0: EXT << 8).
+ */
+#define SGX_OPND(root, m, o)                                                   \
+   ((uint32_t)bitmask_to_uint64_t(                                             \
+      encode_##root(s, &(struct bitset_params){.MODE = (m)}, (o))))
+#define SGX_DST(m)    SGX_OPND(_dst, m, &src->dst)
+#define SGX_SRC(n, m) SGX_OPND(_src, m, &src->src[n])
+#define SGX_SRC0(m)   SGX_OPND(_src0, m, &src->src[0])
+#define SGX_DST1()    SGX_OPND(_dst1, 0, &src->dst)
+/* Slots without an extension bit: i<n> is r(124 + n) there. */
+#define SGX_DSTX(m)                                                            \
+   SGX_OPND(_dst, m, sgx_isa_noext(&src->dst, &(struct sgx_isa_src){0}))
+#define SGX_SRCX(n, m)                                                         \
+   SGX_OPND(_src, m, sgx_isa_noext(&src->src[n], &(struct sgx_isa_src){0}))
+#define SGX_IS_IMM(n) (src->src[n].file == SGX_ISA_FILE_IMM)
+/* Without a destination, test's dst field holds nodst (default 0x280). */
+#define SGX_TDST(m)                                                            \
+   (src->dst.file != SGX_ISA_FILE_NONE                                         \
+       ? SGX_DST(m)                                                            \
+       : (src->has_nodst ? src->nodst : 0x280))
+/* rlp's src2 slot as one 10-bit value (default 0x300, the unused pattern) */
+#define SGX_UNUSED2() (src->has_unused2 ? src->unused2 : 0x300)
+/* A named <expr> of the #instruction hierarchy: SGX_EXPR(__float_smode). */
+#define SGX_EXPR(n) __instruction_expr_##n(s, p, src)
+
+#include "sgx-isa-encode.h"
+
+uint64_t
+sgx_isa_encode(const struct sgx_isa_instr *instr, const struct sgx_isa_fc *fc)
+{
+   struct sgx_isa_fc f = fc ? *fc : SGX_ISA_FC_START;
+   struct encode_state s = {
+      .gen = sgx_isa_gpu_id(&f),
+   };
+
+   return bitmask_to_uint64_t(
+      encode__instruction(&s, NULL, (struct sgx_isa_instr *)instr));
+}
+
+bool
+sgx_isa_core_supported(unsigned core)
+{
+   return core == 0 || core == SGX_ISA_CORE_SGX545;
+}
+
+uint32_t
+sgx_isa_gpu_id(const struct sgx_isa_fc *fc)
+{
+   unsigned core = fc->core ? fc->core : SGX_ISA_CORE_SGX545;
+
+   return core * 100 + (fc->c10 ? 1 : 0) + (fc->f16 ? 2 : 0);
+}
diff --git a/src/sgx/isa/sgx_isa_enums.py b/src/sgx/isa/sgx_isa_enums.py
new file mode 100644
index 0000000..de561ca
--- /dev/null
+++ b/src/sgx/isa/sgx_isa_enums.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+# Copyright © 2026 Joseph Telaak
+# SPDX-License-Identifier: MIT
+
+"""Generate the C enums the encoder and its callers need from an isaspec XML
+(sgx.xml, ../pds/sgx_pds.xml): the opcode and operand-kind enums (one
+value per encodable leaf, named as isaspec's encoder expects) and the
+field-value enums a compiler uses."""
+
+import argparse
+import os
+import re
+import sys
+
+sys.path.append(os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                                              '..', '..', 'compiler', 'isaspec')))
+from isa import ISA
+
+# Field-value enums worth a C name. Their XML displays name the values.
+VALUE_ENUMS = [
+    '#pred3', '#pred2', '#movc-cond', '#movc-type', '#pck-fmt', '#rnd',
+    '#test-alu', '#test-cond', '#testmask-type', '#swz0', '#smp-dim',
+    '#smp-lod', '#ld-am', '#ld-size', '#emit-tgt',
+]
+
+
+def c_ident(s):
+    s = s.strip().replace('!', 'n').replace('=', '_')
+    s = re.sub(r'[^A-Za-z0-9_]', '', s)
+    return s.upper()
+
+
+def leaf_case_name(root, leaf):
+    return root.encode.case_prefix + \
+        leaf.name.upper().replace('.', '_').replace('-', '_').replace('#', '')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--xml', required=True)
+    parser.add_argument('--out-h', required=True)
+    parser.add_argument('--prefix', default='sgx_isa',
+                        help='C prefix of the enums (sgx_isa_opc, ...)')
+    parser.add_argument('--values', default=','.join(VALUE_ENUMS),
+                        help='field-value enums to emit, comma-separated')
+    args = parser.parse_args()
+    prefix = args.prefix
+    guard = re.sub(r'[^A-Za-z0-9]', '_', os.path.basename(args.out_h)).upper()
+
+    isa = ISA(args.xml)
+    out = []
+    out.append('/* Generated from %s by sgx_isa_enums.py. */\n' % os.path.basename(args.xml))
+    out.append('#ifndef %s' % guard)
+    out.append('#define %s\n' % guard)
+
+    for root in isa.roots.values():
+        if root.encode is None or root.encode.case_prefix is None:
+            continue
+        cname = prefix + '_opc' if root.name == '#instruction' else \
+            prefix + '_case_' + root.name.strip('#').replace('-', '_')
+        names = sorted(leaf_case_name(root, l)
+                       for leafs in isa.leafs.values() for l in leafs
+                       if l.get_root() is root)
+        out.append('enum %s {' % cname)
+        cp = root.encode.case_prefix
+        if root.name == '#instruction':
+            out.append('   %sNONE = 0,' % cp)
+        else:
+            out.append('   %s%s__NONE = 0,' % (cp, root.name.strip('#').upper().replace('-', '_')))
+        for n in names:
+            out.append('   %s,' % n)
+        if root.name == '#instruction':
+            out.append('   %sCOUNT,' % cp)
+        out.append('};\n')
+
+    for name in filter(None, args.values.split(',')):
+        e = isa.enums[name]
+        base = prefix.upper() + '_' + c_ident(name.strip('#').replace('-', '_'))
+        out.append('enum %s_%s {' % (prefix, name.strip('#').replace('-', '_')))
+        seen = set()
+        for val, v in e.values.items():
+            label = c_ident(v.get_name()) or 'NONE'
+            if label in seen:
+                label = '%s_%s' % (label, val)
+            seen.add(label)
+            out.append('   %s_%s = %s,' % (base, label, val))
+        out.append('};\n')
+
+    out.append('#endif')
+    with open(args.out_h, 'w', encoding='utf-8') as f:
+        f.write('\n'.join(out) + '\n')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/src/sgx/isa/tests/coissue.txt b/src/sgx/isa/tests/coissue.txt
new file mode 100644
index 0000000..deb2ecb
--- /dev/null
+++ b/src/sgx/isa/tests/coissue.txt
@@ -0,0 +1,108 @@
+# Copyright © 2026 Joseph Telaak
+# SPDX-License-Identifier: MIT
+#
+# efo and fdual. The efo lines are known control words on r0-r3:
+# the low word is the operands, the high word 0x38000000 | the control word.
+
+efo r0, r1, r2, r3 [d=a0 i=m0/m1 a=s0+s2/s1+s2 wi0 wi1] ; 00004103 382b0600
+efo r0, r1, r2, r3 [d=a0 a=s0+s2/s1+s2 wi0 wi1] ; 00004103 38230600
+efo r0, r1, r2, r3 [d=i1 i=m0/m1 wi0 wi1] ; 00004103 38180600
+efo r0, r1, r2, r3 [a=m0+i0/i1+m1 wi0 wi1] ; 00004103 38020600
+efo r0, r1, r2, r3 [d=a0 a=m0+i0/i1+m1 wi1] ; 00004103 38220200
+efo r0, r1, r2, r3 [d=a0 i=a0/m1 a=m0+s0/i1+i0 wi0 wi1 a0rneg] ; 00004103 3c2d0600
+efo r0, r1, r2, r3 [d=a1 i=a0/m1 a=m0+s0/i1+i0 wi0 wi1 a0rneg] ; 00004103 3c3d0600
+efo r0, r1, r2, r3 [a=m0+s0/i1+i0 m=s2*s1/s2*s2 wi0 wi1] ; 00004103 38014600
+efo r0, r1, r2, r3 [d=a0] ; 00004103 38200000
+efo r0, r1, r2, r3 [d=a0 i=m0/m1 a=s0+s2/s1+s2 m=s1*s0/s2*s2 wi0 wi1] ; 00004103 382b8600
+
+# efo's i, a and m in their long spelling, and the enum fields at 0 written out
+efo r0, r1, r2, r3 [d=a0 i=i0=m0,i1=m1 a=a0=s0+s2,a1=s1+s2 wi0 wi1] == efo r0, r1, r2, r3 [d=a0 i=m0/m1 a=s0+s2/s1+s2 wi0 wi1]
+efo r0, r1, r2, r3 [d=i0 i=i0=a0,i1=a1 a=a0=m0+m1,a1=i1+i0 m=m0=s0*s2,m1=s1*s2] == efo r0, r1, r2, r3
+efo r0, r1, r2, r3 [m=m0=s1*s0,m1=s2*s2] == efo r0, r1, r2, r3 [m=s1*s0/s2*s2]
+efo r0, r1, r2, r3 [d=2 i=2 a=3 m=0] == efo r0, r1, r2, r3 [d=a0 i=m0/m1 a=s0+s2/s1+s2]
+
+# fdual: a vector-normalize pair, every select, and the other spellings
+fdual.fssq.mov o0, pa2, pa0, pa1 [sd=i2 msrc=src0]
+fdual.mov.fmad o3, r0, c52, o0 [sd=i2 sb=i2 sc=src2]
+fdual.fmad.fsub r0, r1, r2, r3 [sd=i0s0 sb=i1 sc=i2]
+fdual.fadm.frsq r4, pa1, pa2, sa3 [sd=i1 sb=src1 sc=i0]
+fdual.fmsa.fmad16 r0, r1, r2, r3 [sd=i2 sb=i0 sc=src2]
+fdual.fddp.fmaxmin r0, r1, r2, r3 [sd=i0 sb=i1 sc=i1]
+fdual.mov.mov r0, r1, r2, r3 [sd=i1 msrc=src2]
+fdual.mov.mov r0, r1, r2, r3 [sd=i1 msrc=src1]
+fdual.mov.mov r0, r1, r2, r3 [sd=i0 msrc=i2]
+fdual.fmad.fexp2 r0, r1, r2, r3 [sd=i0 sb=i1 sc=i0]
+fdual.fmad.flog2 r0, r1, r2, r3 [sd=i0 sb=i1 sc=i0]
+fdual.fmad.fsin r0, r1, r2, r3 [sd=i0 sb=i1 sc=i0]
+fdual.fmad.fcos r0, r1, r2, r3 [sd=i0 sb=i1 sc=i0]
+fdual.fmad.fmul r0, r1, r2, r3 [sd=i0 sb=i1 sc=i0]
+fdual.ima32.ima32 r0, r1, r2, r3 [sd=i0 sb=i1 sc=i0]
+(p1) fdual.fmad.fadd r0, r1, -r2, -r3 [skipinv rpt=2 sd=i0 sb=src1 sc=i1]
+fdual.fmad.fadd r0, r1, r2, r3 [neg1 neg2 sd=i0 sb=src1 sc=i1] == fdual.fmad.fadd r0, r1, -r2, -r3 [sd=i0 sb=src1 sc=i1]
+fdual.fmad.fadd r0, r1, r2, r3 [sd=3 sb=3 sc=3] == fdual.fmad.fadd r0, r1, r2, r3 [sd=i0s0 sb=src1 sc=src2]
+fdual.mov.mov r0, r1, r2, r3 [msrc=4] == fdual.mov.mov r0, r1, r2, r3 [msrc=src0]
+
+# dot's scales as cx<n> / ax<n>
+dot3 r0, r1, r2 [cs=cx4 as=ax2] == dot3 r0, r1, r2 [cs=x4 as=x2]
+
+# hw 1's f16 (h7) and c10 (h8) are separate bits; both may be set
+frcp r0, r1 [f16 c10 chan=2] ; 00000080 08000190
+fsin r0, r1 [c10 chan=1 f16d]
+fsin r0, r1  [c10 chan=1 f16d]
+
+# Same-word hazards: an fdual primary
+# reading the internal register its secondary writes is a race, and so is
+# efo's d naming I0 while the word writes I0.
+hazard fdual.mov.fexp2 r3, r0, r124, r2 [sd=i0 sb=i1 sc=i0]
+hazard fdual.fmad.fsin pa1, r126, r1, r2 [sd=i2 sb=i1 sc=i0]
+hazard fdual.fssq.mov r3, r0, i1, r2 [sd=i1 msrc=i0]
+hazard efo r0, r1, r2, r3 [d=i0 wi0]
+# not hazards: the secondary reads before the primary writes; both halves
+# read one slot; neg1/neg2 are the primary's; a slot the primary doesn't read;
+# efo's d=i1 with wi1 reads the old I1
+safe fdual.fmad.mov r125, r0, r1, r2 [sd=i0 msrc=i1]
+safe fdual.fmad.fmad r3, r0, -r1, -r2 [sd=i0 sb=src1 sc=src2]
+safe fdual.mov.fexp2 r3, r124, r1, r2 [sd=i0 sb=i1 sc=i0]
+safe fdual.fmad.fadd r3, r0, r1, r2 [sd=i1 sb=i0 sc=i2]
+safe efo r0, r1, r2, r3 [d=a0 i=m0/m1 a=s0+s2/s1+s2 wi0 wi1]
+safe efo r0, r1, r2, r3 [d=i1 wi0]
+safe efo r0, r1, r2, r3 [d=i1 i=m0/m1 wi1]
+safe efo r0, r1, r2, r3 [d=i1 i=m0/m1 wi0 wi1]
+
+# sec 3 is fsubflr; fadm and ffrc are other names for it
+fdual.mov.fsubflr r0, r1, r2, r3 [sd=i0 sb=i1 sc=i2]
+fdual.mov.fadm r0, r1, r2, r3 [sd=i0 sb=i1 sc=i2] == fdual.mov.fsubflr r0, r1, r2, r3 [sd=i0 sb=i1 sc=i2]
+fdual.mov.ffrc r0, r1, r2, r3 [sd=i0 sb=i1 sc=i1] == fdual.mov.fsubflr r0, r1, r2, r3 [sd=i0 sb=i1 sc=i1]
+
+# bilin/ssum16/firv/firh's fmt is a mnemonic suffix; [fmt=s8] means the same
+firh.s8 i1, r1, r2, r3 [rpt=6 coef=1 shift=31]
+firh.o8 i2, r1, r2, r3
+firv.fmt3 r0, r1, r2, r3
+ssum16.s8 r0, r1, r2, r3
+bilin r0, r1, r2, r3 [fmt=s8 ileave] == bilin.s8 r0, r1, r2, r3 [ileave]
+firh i1, r1, r2, r3 [fmt=o8] == firh.o8 i1, r1, r2, r3
+ssum16 r0, sa4, sa5, r3 [fmt=o8] == ssum16.o8 r0, sa4, sa5, r3
+
+# rlp's src2 slot as one 10-bit value: unused2, written when it isn't 0x300
+rlp r0, r1, p2 [unused2=5]
+rlp r0, r1, p2 [unused2=768] == rlp r0, r1, p2
+rlp r0, r1, p2 [unused2=0x3ff] == rlp r0, r1, p2 [unused2=1023]
+
+# A signed 7-bit immediate is its two's complement: imae's src2 for any t2
+# but 0; the text shows the raw 7-bit value
+imae o72, pa36, r58, #-63 [skipinv rpt=7 f2_15=3 t2=u32 s2hi] == imae o72, pa36, r58, #65 [skipinv rpt=7 f2_15=3 t2=u32 s2hi]
+(!p0) imae pa0, r44, r6, #-52 [skipinv nosched rpt=4 f2_15=1 t2=x3 s1hi s2hi] == (!p0) imae pa0, r44, r6, #76 [skipinv nosched rpt=4 f2_15=1 t2=x3 s1hi s2hi]
+# ldr/str's address immediate is 14 bits
+ldr r21, #1503 [drc=1]
+str #3654, r20 [skipinv nosched]
+# ld/st size 3 is .q; an idx destination's bare .f16 under format select
+# sets bit 6, number not halved
+ld.a.q r0, sa1, #2
+ld.l.q pa3, r1, r2
+test.fdsx.s0z2o p0, idx16.f16, pa0.f16.hi, r[idx2+1].f16 [nosched chan=2 fmt f2_0] ; 8a12e0c9 486d1222
+# any format suffix sets fmt
+test.fdsx.s0z2o p0, idx16.f16, pa0.f16.hi, r[idx2+1].f16 [nosched f2_0 chan=2] == test.fdsx.s0z2o p0, idx16.f16, pa0.f16.hi, r[idx2+1].f16 [nosched f2_0 fmt chan=2]
+fmad r0, pa0.f16.lo, c52, c48 == fmad r0, pa0.f16.lo, c52, c48 [fmt]
+
+# testmask's unnamed type 3 is .tm3
+testmask.fsubflr.s3z1o.tm3 r0, r1, r2
