+# Copyright © 2026 Joseph Telaak
+# SPDX-License-Identifier: MIT
+
+# SGX545 shader compiler: NIR -> USSE, encoded through the isaspec
+# encoder in ../isa.
+
+libsgx_compiler = static_library(
+  'sgx_compiler',
+  files('sgx_forms.c', 'sgx_nir.c'),
+  include_directories : [inc_include, inc_src, inc_mesa, inc_gallium, inc_gallium_aux],
+  c_args : [no_override_init_args],
+  dependencies : [idep_nir, idep_mesautil, idep_sgx_isa],
+  gnu_symbol_visibility : 'hidden',
+  build_by_default : false,
+)
+
+idep_sgx_compiler = declare_dependency(
+  link_with : [libsgx_compiler, libsgx_isa],
+  include_directories : include_directories('.'),
+)
+
diff --git a/src/sgx/compiler/sgx_compiler.h b/src/sgx/compiler/sgx_compiler.h
new file mode 100644
index 0000000..d442a22
--- /dev/null
+++ b/src/sgx/compiler/sgx_compiler.h
@@ -0,0 +1,316 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * SGX545 shader compiler: NIR in, USSE code out, plus what the driver needs
+ * to run it (constants, iterations, texture samples, branches). No
+ * container format is written here: the caller packages struct sgx_shader.
+ *
+ * The input/output conventions:
+ *  - uniforms: one 32-bit constant per component, constant k of the driver's
+ *    constant buffer loaded into sa[base + k] (fragment base 9, vertex 10);
+ *  - fragment varyings: iterated by the PDS into pa, F32, one register per
+ *    component, in the order of USP list A; a varying's iterator is its
+ *    texture coordinate set + 1;
+ *  - fragment colour: packed BGRA8 in a pa register (USP header 0x66-0x6c);
+ *  - vertex attributes: attribute slot k at pa[4k..4k+3];
+ *  - vertex outputs: position o0-o3, then the texture coordinate sets in
+ *    order, each its size, then the point size.
+ * Constant numbers, attribute slots and sampler units are the caller's to
+ * choose (sgx_compile_options.layout).
+ */
+#ifndef SGX_COMPILER_H
+#define SGX_COMPILER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct nir_shader;
+struct nir_shader_compiler_options;
+
+#define SGX_MAX_SETS 10
+
+enum sgx_layout_kind {
+   SGX_LAYOUT_UNIFORM, /* -> first constant number (rows/elements at +4 each) */
+   SGX_LAYOUT_ATTRIB,  /* -> attribute slot (pa 4*slot) */
+   SGX_LAYOUT_SAMPLER, /* -> texture unit */
+};
+
+/* Where the caller wants things. place() is asked for each uniform
+ * variable, struct member ("s.f") and constant array element ("a[2]"), each
+ * vertex input and each sampler, and returns a number or -1 for the
+ * compiler's own: uniforms vec4-aligned in declaration order, attributes in
+ * declaration order, samplers in order of first use, each from first_free()
+ * on. */
+struct sgx_layout {
+   int (*place)(void *data, enum sgx_layout_kind kind, const char *name);
+   unsigned (*first_free)(void *data, enum sgx_layout_kind kind);
+   void *data;
+};
+
+struct sgx_compile_options {
+   const struct sgx_layout *layout; /* NULL: the compiler's own numbering */
+   bool verbose;
+   /* mediump/lowp arithmetic in F16 (NIR from Mesa's precision lowering):
+    * F16 iteration, fmad16, F16/C10 uniforms */
+   bool f16;
+   /* gl_FrontFacing = ((g16 ^ sa[front_sa]) & 1) != 0: g16 bit 0 is the
+    * primitive's winding in memory, and the
+    * driver loads this SA register with what makes that winding front.
+    * 0: constant true */
+   unsigned front_sa;
+   /* the driver loads constant formats the USP has no list C kind for
+    * (sgx_const_map fmt 0x10 / 0x11): a lowp vector's xyz pre-converted
+    * to F16 and literal constants, loaded rather than computed per draw */
+   bool driver_consts;
+   /* (with f16) every float of a fragment program is mediump, texture
+    * coordinates excepted: for programs without precision qualifiers whose
+    * results only need the framebuffer's precision (st's fixed-function
+    * fragment programs); off by default */
+   bool fs_mediump;
+   /* vertex shader: what the PDS leaves in PA[4 * driver_location] for each
+    * attribute (enum sgx_vtx_fmt); 0, f32 x 4, is the default */
+   uint8_t vtx_fmt[16];
+   /* fragment shader: bit n set, texture unit n's texels arrive with red and
+    * blue swapped (an RGBA8 view sampled as T1 0x0d):
+    * byte 0 is blue, 2 red, the colour output's order. A texel that is the
+    * colour as it is then needs no instruction; other reads unpack zyxw */
+   uint32_t tex_bgra;
+   /* fragment shader: bit n set, texture unit n's texel is one F32 value in
+    * the first register (a depth texture), read as (d, 0, 0, 1) */
+   uint32_t tex_f32;
+   /* fragment shader: the driver's PDS samples a non-dependent texture from
+    * the coordinate set itself, so a varying only such samples read needs no
+    * plain iteration of its own (one PDS sample, no iteration).
+    * Off when other code may read that iteration */
+   bool pds_samples_alone;
+   /* fragment shader: the driver can have a non-dependent sample return F16
+    * (the T3 word's F16-return bits):
+    * a texel read at mediump then arrives as F16, two channels per register
+    * (sgx_sample_info.f16), and is not unpacked */
+   bool f16_samples;
+   /* fragment shader with a discard: split it at the visibility feedback.
+    * Phase 0 (code)
+    * runs for every rasterized fragment and computes only the discard test,
+    * ending in the feedback nop; phase 1 (code1) runs for visible pixels
+    * only and computes the colour from the inputs again. Only PA carries
+    * over: both phases share one iteration list and one constant map.
+    * Straight-line programs with one discard and a colour store; others stay
+    * one block (n_code1 = 0) */
+   bool split_phases;
+   /* with f16_samples: the driver also sets the F16-return T3 bits in a
+    * dependent sample's state words (sgx_sample_info.f16), so a mediump
+    * texel a dependent smp reads arrives as F16 in two registers (the
+    * result format is the state's) */
+   bool dep_f16_samples;
+};
+
+/* a vertex attribute's raw format in PA, unpacked by the shader. Components
+ * a format doesn't hold read as 0, 0, 1 (y, z, w) */
+enum sgx_vtx_fmt {
+   SGX_VF_F32_4 = 0,
+   SGX_VF_F32_1,
+   SGX_VF_F32_2,
+   SGX_VF_F32_3,
+   SGX_VF_UNORM8_4,    /* one dword, x in the low byte, each / 255 */
+   SGX_VF_SSCALED16_2, /* one dword, x the signed low half, y the high one, not
+                          normalised */
+};
+
+/* varying -> texture coordinate set (sgx_assign_varyings) */
+struct sgx_varying {
+   char name[64];
+   unsigned set;  /* first set (one per row) */
+   unsigned comp; /* first component in its sets: varyings may share a set */
+   unsigned rows, comps;
+   unsigned precision; /* GLSL: 0 none, 1 high, 2 medium, 3 low */
+};
+
+struct sgx_varyings {
+   unsigned n;
+   struct sgx_varying v[32];
+   /* set 0 reserved (vertex shaders that write gl_PointSize) */
+   bool point_size;
+   /* set 0 is the TA's vertex colour (output select b11): four F32
+    * components after the position, iterated by the PDS as the colour source
+    * into one register as BGRA8 (B in byte 0, R in byte 2),
+    * the one source it iterates flat */
+   bool colour;
+   unsigned set_comps[SGX_MAX_SETS];
+};
+
+/* where the driver puts what the program reads (the USP's lists, decoded) */
+#define SGX_SLOT_NONE     0xffff
+#define SGX_MAX_CONST_MAP (1024 + 32) /* every constant number and literal */
+
+struct sgx_const_map {
+   uint16_t k; /* constant number: uniform component (sgx_nir.c's numbering) */
+   uint16_t slot; /* sa[sa_base + slot]; SGX_SLOT_NONE: in memory only */
+   uint16_t mem;  /* word of the constant memory block (mem_dwords), 0 none */
+   uint8_t shift; /* bit offset in the slot: F16 0/16, C10 0/10/20 */
+   /* 1 f32, 2 F16 (round to nearest), 3 C10 (round(v * 255), signed 10
+    * bits); with driver_consts: 0x10 F16 of the C10 value c (fmt 3's rule):
+    * c / 255 rounded to nearest F16, as pck.f16.c10 [scale] gives it
+    * (hardware, tests/c10); 0x11 a literal: k = 0xffff, value (32 bits) ORed
+    * into the slot at shift; 0x12 the vec4 at constants k..k+3 as packed
+    * BGRA8, A << 24 | R << 16 | G << 8 | B, each channel clamped to [0, 1]
+    * and rounded to nearest (the whole slot, shift 0) */
+   uint8_t fmt;
+   uint32_t value; /* fmt 0x11 */
+};
+
+struct sgx_iter_info {
+   uint8_t set; /* texture coordinate set (DOUTI source = set + 1) */
+   uint8_t comps;
+   uint8_t pa;     /* first PA register */
+   uint8_t regs;   /* PA registers it fills */
+   uint8_t f16;    /* iterated as F16 (two components per register) */
+   uint8_t sample; /* a non-dependent sample: the raw RGBA8 texel lands in pa */
+   uint8_t proj;   /* ... with a projected coordinate (x/w, y/w) */
+   uint8_t sampler;    /* ... of this sampler */
+   uint8_t pointcoord; /* gl_PointCoord (set 0) */
+   /* not interpolated: every varying in the set is flat, the provoking
+    * vertex's value (DOUTI b25-26 = 2; 3 interpolates) */
+   uint8_t flat;
+};
+
+/* A texture sample. A
+ * non-dependent one is the PDS's: the raw RGBA8 texel lands in pa `reg`. A
+ * dependent one is an smp the driver puts in before code[at], with the
+ * sampler's state words as its src1, writing the raw texel to temporary
+ * `reg`; the program unpacks it from there. */
+struct sgx_sample_info {
+   unsigned at; /* dependent: index in code[] it goes before */
+   uint16_t id;
+   uint8_t sampler;
+   uint8_t set; /* non-dependent: the coordinate's set */
+   uint8_t dim; /* 2 = 2D, 3 = cube or volume (smp.3d) */
+   uint8_t dependent, proj;
+   uint8_t reg; /* the raw texel: pa (non-dependent), r (dependent) */
+   /* non-dependent: the coordinate's plain iteration, -1 none */
+   int16_t coord_pa;
+   uint8_t phase; /* dependent, split program: at indexes code1 */
+   /* non-dependent, f16_samples: the texel returns F16 into reg (R lo, G hi)
+    * and reg + 1 (B lo, A hi), not RGBA8 into reg; RGBA order for a
+    * tex_bgra unit too (the TAG converts by channel) */
+   uint8_t f16;
+   uint64_t smp; /* dependent: the smp, destination r0, texture state #0 */
+};
+
+/* The program's structure, in order: runs of code, labels, branches, the
+ * discard feedback point and texture samples. A driver needs only the
+ * branches (to move their offsets when it inserts code) and the samples;
+ * the USP writer needs all of it. */
+enum sgx_block_kind {
+   SGX_BLOCK_CODE,     /* code[at .. at + n) */
+   SGX_BLOCK_LABEL,    /* label */
+   SGX_BLOCK_BRANCH,   /* code[at] branches to label (offset resolved) */
+   SGX_BLOCK_FEEDBACK, /* code[at] is the discard feedback nop */
+   SGX_BLOCK_SAMPLE,   /* samples[at] */
+};
+
+struct sgx_block {
+   uint8_t kind;
+   uint16_t label;
+   unsigned at, n;
+};
+
+#define SGX_MAX_SAMPLES 16
+
+struct sgx_shader {
+   unsigned stage; /* MESA_SHADER_VERTEX / _FRAGMENT */
+   /* what the program reads and writes */
+   /* first SA register of the constants (9 fragment, 10 vertex) */
+   unsigned sa_base;
+   unsigned n_consts;
+   struct sgx_const_map consts[SGX_MAX_CONST_MAP];
+   unsigned n_iters; /* fragment: PDS iterations, in PA order */
+   struct sgx_iter_info iters[16];
+   unsigned colour_pa; /* fragment: packed BGRA8 colour register */
+   bool discards; /* fragment: p1 = keep at the feedback nop (USP labels 4/5) */
+   /* fragment: gl_FragDepth, clamped to [0, 1], is in pa<depth_pa> at the
+    * feedback nop, for a depthf there (predicated on p1 when it discards
+    * too); not in the USP */
+   bool writes_depth;
+   unsigned depth_pa;
+   /* vertex: PA registers read (attribute slot k = pa 4k..4k+3) */
+   uint32_t in_mask[4];
+   /* vertex: output set sizes (o4 on); 0 = unused */
+   unsigned set_comps[SGX_MAX_SETS];
+   bool point_size; /* vertex: writes the point size (f32), after the sets */
+   unsigned n_out_regs; /* vertex: o registers written */
+   /* vertex: user clip distances 0..n_clip-1, plane p's in o<clip_o + p>
+    * through fdpc into cp<p>; the driver enables planes 0..n_clip-1 in the
+    * TA's output select (b0-5) and counts n_clip more output dwords */
+   unsigned n_clip, clip_o;
+   /* SA registers used from sa_base on (constants and the compiler's own) */
+   unsigned sa_slots;
+   /* Constants past sa127 (counting 4 per dependent sample of a fragment
+    * program after sa_slots): the most-used stay in SA, every constant gets
+    * a word of a memory block the driver fills per draw like the SA ones,
+    * and the program loads the others from it (ld.a.d). Word 0 is unused.
+    * The driver loads SA slot mem_base_slot[j] with the block's address +
+    * 512 * j. 0: no block */
+   unsigned mem_dwords;
+   unsigned n_mem_bases;
+   uint8_t mem_base_slot[8];
+   /* fragment: reads sa[front_sa], so it must be loaded */
+   bool uses_front_face;
+   uint64_t *code; /* main program, flat (branch targets resolved) */
+   unsigned n_code;
+   unsigned n_samples;
+   struct sgx_sample_info samples[SGX_MAX_SAMPLES];
+   struct sgx_block *blocks;
+   unsigned n_blocks;
+   /* split_phases: phase 1's program and its blocks (0: one block) */
+   uint64_t *code1;
+   unsigned n_code1;
+   struct sgx_block *blocks1;
+   unsigned n_blocks1;
+   unsigned n_alu, n_tex, n_flow; /* instruction counts */
+   unsigned n_temps;
+   unsigned n_pa; /* PA registers: inputs and colour */
+   char *log;     /* listing / errors (malloc'd) */
+};
+
+const struct nir_shader_compiler_options *sgx_nir_options(void);
+
+/* GLSL ES varyings to texture coordinate sets; call on each stage's NIR
+ * before linking removes unused ones */
+void sgx_assign_varyings(struct nir_shader *nir, bool vertex,
+                         struct sgx_varyings *out);
+
+/* Varyings whose sets go past the ten (or past a set's four components):
+ * re-placed in their order, sharing sets
+ * (sgx_varying.comp); set_comps follows. Deterministic in the list, so two
+ * stages with the same list agree. Anything that already fits is left as it
+ * is. False: more than 10 x 4 components */
+bool sgx_pack_varyings(struct sgx_varyings *v);
+
+/* GL user clip planes per pixel: discard where any plane in ucp_enables
+ * has a negative distance. The distances are the vertex shader's clip
+ * distances (nir_lower_clip_vs: vec4 outputs clipdist_0 / clipdist_1 at
+ * VARYING_SLOT_CLIP_DIST0 / 1), read here as inputs of the same names and
+ * slots, which the driver places as it places other built-in varyings.
+ * Call on the fragment shader before sgx_compile. Not for lines: a
+ * discarding program breaks a lines draw. */
+bool sgx_lower_clip_fs(struct nir_shader *fs, unsigned ucp_enables);
+
+/* lower and compile; 0 on success */
+int sgx_compile(struct nir_shader *nir, const struct sgx_compile_options *opts,
+                const struct sgx_varyings *vary, struct sgx_shader *out);
+
+void sgx_shader_free(struct sgx_shader *s);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/sgx/compiler/sgx_forms.c b/src/sgx/compiler/sgx_forms.c
new file mode 100644
index 0000000..a4e30ca
--- /dev/null
+++ b/src/sgx/compiler/sgx_forms.c
@@ -0,0 +1,368 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The compiler's instruction forms as struct sgx_isa_instr: opcode, fixed
+ * fields and operand slots, by instruction class.
+ */
+#include "sgx_forms.h"
+
+#include "util/macros.h"
+
+#define F(x) SGX_FILE_BIT(SGX_ISA_FILE_##x)
+
+/* the generic destination and source slots */
+#define DST_FILES (F(R) | F(O) | F(PA) | F(IX) | F(SA) | F(G) | F(IDX) | F(I))
+#define SRC_FILES                                                              \
+   (F(R) | F(O) | F(PA) | F(SA) | F(IX) | F(C) | F(G) | F(IMM) | F(I))
+/* src0 without an extension bit, and with one (smp, ld) */
+#define SRC0_FILES  (F(R) | F(PA))
+#define SRC0X_FILES (F(R) | F(PA) | F(O) | F(SA))
+/* one-bit destination bank (smp, ld) */
+#define DST1_FILES (F(R) | F(PA))
+
+#define D   {SGX_ROLE_DST, DST_FILES}
+#define D1  {SGX_ROLE_DST, DST1_FILES}
+#define S0  {SGX_ROLE_SRC0, SRC0_FILES}
+#define S0X {SGX_ROLE_SRC0, SRC0X_FILES}
+#define S1  {SGX_ROLE_SRC1, SRC_FILES}
+#define S2  {SGX_ROLE_SRC2, SRC_FILES}
+#define IMM {SGX_ROLE_IMM, F(IMM)}
+/* float: modifiers, format select */
+#define S0A {SGX_ROLE_SRC0, SRC0_FILES, false, true, true}
+#define S1M {SGX_ROLE_SRC1, SRC_FILES, true, true, true}
+#define S2M {SGX_ROLE_SRC2, SRC_FILES, true, true, true}
+/* hw 1 and fmad16: modifiers, no format select */
+#define S0Ah {SGX_ROLE_SRC0, SRC0_FILES, false, true, false}
+#define S1Mh {SGX_ROLE_SRC1, SRC_FILES, true, true, false}
+#define S2Mh {SGX_ROLE_SRC2, SRC_FILES, true, true, false}
+/* test / testmask: format select, no modifiers */
+#define S1T {SGX_ROLE_SRC1, SRC_FILES, false, false, true}
+#define S2T {SGX_ROLE_SRC2, SRC_FILES, false, false, true}
+#define PD  {SGX_ROLE_PDST, SGX_FILE_BIT(SGX_FILE_PRED)}
+/* ima16's src2 negate */
+#define S2N {SGX_ROLE_SRC2, SRC_FILES, true}
+/* efo: no extension bit on dst and src1; i<n> in dst, src0 and
+ * src1 is r(124 + n); negates on all three sources, no format select */
+#define EFO_D  {SGX_ROLE_DST, F(R) | F(O) | F(PA) | F(IX) | F(I)}
+#define EFO_S0 {SGX_ROLE_SRC0, SRC0X_FILES | F(I), true}
+#define EFO_S1 {SGX_ROLE_SRC1, F(R) | F(O) | F(PA) | F(SA) | F(I), true}
+#define EFO_S2 {SGX_ROLE_SRC2, SRC_FILES, true}
+/* fdual (dual issue): dst without extension bit, the float classes'
+ * src0, src1/src2 negates; format select as in the float classes */
+#define FD_S0 {SGX_ROLE_SRC0, SRC0_FILES | F(I), false, false, true}
+#define FD_S1 {SGX_ROLE_SRC1, SRC_FILES, true, false, true}
+#define FD_S2 {SGX_ROLE_SRC2, SRC_FILES, true, false, true}
+
+#define FLOAT3(op)                                                             \
+   [SGX_OP_##op] = {#op, SGX_ISA_OPC_##op, 4, {D, S0A, S1M, S2M}}
+#define FLOAT2(op) [SGX_OP_##op] = {#op, SGX_ISA_OPC_##op, 3, {D, S1M, S2M}}
+#define SCALAR(op) [SGX_OP_##op] = {#op, SGX_ISA_OPC_##op, 2, {D, S1Mh}}
+#define PCK(d, s)                                                              \
+   [SGX_OP_PCK_##d##_##                                                        \
+      s] = {"PCK_" #d "_" #s, SGX_ISA_OPC_PCK,     3,                          \
+            {D, S1, S2},      SGX_ISA_PCK_FMT_##d, SGX_ISA_PCK_FMT_##s}
+
+static const struct sgx_form_info {
+   const char *name;
+   enum sgx_isa_opc opc;
+   uint8_t nops;
+   struct sgx_slot slot[SGX_MAX_OPS];
+   uint8_t dfmt, sfmt; /* pck */
+} forms[SGX_OP_COUNT] = {
+   FLOAT3(FMAD),
+   FLOAT3(FADM),
+   FLOAT3(FMSA),
+   FLOAT3(FMAXMIN),
+   FLOAT3(FMINMAX),
+   FLOAT2(FSUBFLR),
+   FLOAT2(FDP),
+   FLOAT2(FDPC),
+   FLOAT2(FDSX),
+   FLOAT2(FDSY),
+   SCALAR(FRCP),
+   SCALAR(FRSQ),
+   SCALAR(FLOG2),
+   SCALAR(FEXP2),
+   SCALAR(FSQRT),
+   SCALAR(FSIN),
+   SCALAR(FCOS),
+   [SGX_OP_FMAD16] = {"FMAD16", SGX_ISA_OPC_FMAD16, 4, {D, S0Ah, S1Mh, S2Mh}},
+   [SGX_OP_MOV] = {"MOV", SGX_ISA_OPC_MOV, 2, {D, S1}},
+   [SGX_OP_MOVC_F32] = {"MOVC_F32", SGX_ISA_OPC_MOVC_F32, 4, {D, S0, S1, S2}},
+   [SGX_OP_MOVC_I32] = {"MOVC_I32", SGX_ISA_OPC_MOVC_I32, 4, {D, S0, S1, S2}},
+   PCK(F16, F32),
+   PCK(F16, F16),
+   PCK(F16, U8),
+   PCK(F16, C10),
+   PCK(F32, F16),
+   PCK(F32, U8),
+   PCK(U8, F32),
+   PCK(U8, F16),
+   PCK(U8, U8),
+   PCK(S16, F32),
+   PCK(C10, F32),
+   PCK(C10, C10),
+   PCK(F32, S16),
+   [SGX_OP_TEST] = {"TEST", SGX_ISA_OPC_TEST, 3, {PD, S1T, S2T}},
+   [SGX_OP_TESTMASK] = {"TESTMASK", SGX_ISA_OPC_TESTMASK, 3, {D, S1T, S2T}},
+   [SGX_OP_AND] = {"AND", SGX_ISA_OPC_AND, 3, {D, S1, S2}},
+   [SGX_OP_OR] = {"OR", SGX_ISA_OPC_OR, 3, {D, S1, S2}},
+   [SGX_OP_XOR] = {"XOR", SGX_ISA_OPC_XOR, 3, {D, S1, S2}},
+   [SGX_OP_SOPWM] = {"SOPWM", SGX_ISA_OPC_SOPWM, 3, {D, S1, S2}},
+   [SGX_OP_SOP3] = {"SOP3", SGX_ISA_OPC_SOP3, 4, {D, S0, S1, S2}},
+   [SGX_OP_SOP3L] = {"SOP3L", SGX_ISA_OPC_SOP3L, 4, {D, S0, S1, S2}},
+   [SGX_OP_IMA16] = {"IMA16", SGX_ISA_OPC_IMA16, 4, {D, S0, S1, S2N}},
+   [SGX_OP_IMAE] = {"IMAE", SGX_ISA_OPC_IMAE, 4, {D, S0, S1, S2}},
+   [SGX_OP_SMP] = {"SMP", SGX_ISA_OPC_SMP, 4, {D1, S0X, S1, S2}},
+   [SGX_OP_LD] = {"LD", SGX_ISA_OPC_LD, 3, {D1, S0X, S1}},
+   [SGX_OP_LIMM] = {"LIMM", SGX_ISA_OPC_LIMM, 2, {D, IMM}},
+   [SGX_OP_WDF] = {"WDF", SGX_ISA_OPC_WDF, 0},
+   [SGX_OP_BR] = {"BR", SGX_ISA_OPC_BR, 1, {IMM}},
+   [SGX_OP_NOP] = {"NOP", SGX_ISA_OPC_NOP, 0},
+   [SGX_OP_EFO] = {"EFO", SGX_ISA_OPC_EFO, 4, {EFO_D, EFO_S0, EFO_S1, EFO_S2}},
+   [SGX_OP_FDUAL] = {"FDUAL",
+                     SGX_ISA_OPC_FDUAL,
+                     4,
+                     {EFO_D, FD_S0, FD_S1, FD_S2}},
+};
+
+const struct sgx_slot *
+sgx_form_slot(unsigned form, unsigned k)
+{
+   if (form >= SGX_OP_COUNT || k >= forms[form].nops)
+      return NULL;
+   return &forms[form].slot[k];
+}
+
+const char *
+sgx_form_name(unsigned form)
+{
+   return form < SGX_OP_COUNT && forms[form].name ? forms[form].name : "?";
+}
+
+void
+sgx_form_init(struct sgx_isa_instr *instr, unsigned form)
+{
+   const struct sgx_form_info *f = &forms[form];
+
+   /* the write mask's default: the first channel, all four in sopwm */
+   *instr = (struct sgx_isa_instr){.opc = f->opc,
+                                   .mask = form == SGX_OP_SOPWM ? 0xf : 1};
+   if (f->opc == SGX_ISA_OPC_PCK) {
+      instr->dfmt = f->dfmt;
+      instr->sfmt = f->sfmt;
+      instr->dmask = 0xf;
+   }
+   /* without a LOD / range source, src2 is the unused pattern #0 */
+   if (form == SGX_OP_SMP || form == SGX_OP_LD)
+      instr->src[2] = (struct sgx_isa_src){.file = SGX_ISA_FILE_IMM};
+}
+
+void
+sgx_form_set(struct sgx_isa_instr *instr, unsigned form, unsigned id, int32_t v)
+{
+   switch (id) {
+   case SGX_FLD_SKIPINV:
+      instr->skipinv = v;
+      break;
+   case SGX_FLD_PRED:
+      instr->pred = v;
+      break;
+   case SGX_FLD_NOSCHED:
+      instr->nosched = v;
+      break;
+   case SGX_FLD_RPT:
+      instr->rpt = v;
+      break;
+   case SGX_FLD_RCNT:
+      instr->rcnt = v;
+      break;
+   case SGX_FLD_MASK:
+      instr->mask = v;
+      break;
+   case SGX_FLD_MOE:
+      instr->moe = v;
+      break;
+   case SGX_FLD_INC0:
+      instr->inc[0] = v;
+      break;
+   case SGX_FLD_INC1:
+      instr->inc[1] = v;
+      break;
+   case SGX_FLD_INC2:
+      instr->inc[2] = v;
+      break;
+   case SGX_FLD_FMT:
+      instr->fmt = v;
+      break;
+   case SGX_FLD_F16:
+      instr->sf16 = v;
+      break;
+   case SGX_FLD_C10:
+      instr->sc10 = v;
+      break;
+   case SGX_FLD_CHAN:
+      instr->chan = v;
+      break;
+   case SGX_FLD_F16D:
+      instr->f16d = v;
+      break;
+   case SGX_FLD_SWZ0:
+      instr->swz[0] = v;
+      break;
+   case SGX_FLD_SWZ1:
+      instr->swz[1] = v;
+      break;
+   case SGX_FLD_SWZ2:
+      instr->swz[2] = v;
+      break;
+   case SGX_FLD_COND:
+      if (form == SGX_OP_TEST || form == SGX_OP_TESTMASK)
+         instr->tcond = v;
+      else
+         instr->cond = v;
+      break;
+   case SGX_FLD_ALU:
+      instr->alu = v;
+      break;
+   case SGX_FLD_TYPE:
+      instr->ttype = v;
+      break;
+   case SGX_FLD_DMASK:
+      instr->dmask = v;
+      break;
+   case SGX_FLD_SCALE:
+      instr->scale = v;
+      break;
+   case SGX_FLD_SGN:
+      instr->sgn = v;
+      break;
+   case SGX_FLD_F1:
+      instr->f1 = v;
+      break;
+   case SGX_FLD_F2:
+      instr->f2 = v;
+      break;
+   case SGX_FLD_T2:
+      instr->t2 = v;
+      break;
+   case SGX_FLD_COP:
+      instr->cop = v;
+      break;
+   case SGX_FLD_AOP:
+      instr->aop = v;
+      break;
+   case SGX_FLD_C1:
+      instr->c1 = v & 7;
+      instr->c1c = v >> 3;
+      break;
+   case SGX_FLD_C2:
+      instr->c2 = v & 7;
+      instr->c2c = v >> 3;
+      break;
+   case SGX_FLD_A:
+      instr->asel = v & 3;
+      instr->aselc = v >> 2;
+      break;
+   case SGX_FLD_A1:
+      instr->a1 = v & 1;
+      instr->a1c = v >> 1;
+      break;
+   case SGX_FLD_A2:
+      instr->a2 = v & 1;
+      instr->a2c = v >> 1;
+      break;
+   case SGX_FLD_CP:
+      instr->cp[0] = v;
+      break;
+   case SGX_FLD_DIM:
+      instr->dim = v;
+      break;
+   case SGX_FLD_LOD:
+      instr->lod = v;
+      break;
+   case SGX_FLD_CFMT:
+      instr->cfmt = v;
+      break;
+   case SGX_FLD_EFO_D:
+      instr->efo_d = v;
+      break;
+   case SGX_FLD_EFO_I:
+      instr->efo_i = v;
+      break;
+   case SGX_FLD_EFO_A:
+      instr->efo_a = v;
+      break;
+   case SGX_FLD_EFO_M:
+      instr->efo_m = v;
+      break;
+   case SGX_FLD_WI0:
+      instr->wi0 = v;
+      break;
+   case SGX_FLD_WI1:
+      instr->wi1 = v;
+      break;
+   case SGX_FLD_A0LNEG:
+      instr->a0lneg = v;
+      break;
+   case SGX_FLD_A0RNEG:
+      instr->a0rneg = v;
+      break;
+   case SGX_FLD_PRI:
+      instr->pri = v;
+      break;
+   case SGX_FLD_SEC:
+      instr->sec = v;
+      break;
+   case SGX_FLD_SD:
+      instr->sd = v;
+      break;
+   case SGX_FLD_SB:
+      instr->sb = v;
+      break;
+   case SGX_FLD_SC:
+      instr->sc = v;
+      break;
+   case SGX_FLD_MSRC:
+      instr->msrc = v;
+      break;
+   default:
+      UNREACHABLE("unknown field");
+   }
+}
+
+void
+sgx_form_opd(struct sgx_isa_instr *instr, unsigned form, unsigned k,
+             const struct sgx_isa_src *o)
+{
+   const struct sgx_slot *s = sgx_form_slot(form, k);
+
+   switch (s ? s->role : SGX_ROLE_NONE) {
+   case SGX_ROLE_DST:
+      instr->dst = *o;
+      break;
+   case SGX_ROLE_SRC0:
+      instr->src[0] = *o;
+      break;
+   case SGX_ROLE_SRC1:
+      instr->src[1] = *o;
+      break;
+   case SGX_ROLE_SRC2:
+      instr->src[2] = *o;
+      break;
+   case SGX_ROLE_PDST:
+      instr->pdst = o->num;
+      break;
+   case SGX_ROLE_IMM:
+      if (form == SGX_OP_BR)
+         instr->target = o->num;
+      else
+         instr->imm = o->num;
+      break;
+   default:
+      break;
+   }
+}
diff --git a/src/sgx/compiler/sgx_forms.h b/src/sgx/compiler/sgx_forms.h
new file mode 100644
index 0000000..9c0e677
--- /dev/null
+++ b/src/sgx/compiler/sgx_forms.h
@@ -0,0 +1,190 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The instruction forms the compiler emits, on top of the isaspec encoder
+ * (src/sgx/isa). A form is an opcode plus the fields the compiler fixes
+ * for it; its operands are the IR's op[] in assembly text order, and
+ * sgx_form_slot() says which slot each one lands in and what that slot can
+ * hold.
+ */
+#ifndef SGX_FORMS_H
+#define SGX_FORMS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "sgx_isa.h"
+
+#define SGX_MAX_OPS 4
+
+enum sgx_form {
+   SGX_OP_NONE,
+   /* hw 0, 2-4: float */
+   SGX_OP_FMAD,
+   SGX_OP_FADM,
+   SGX_OP_FMSA,
+   SGX_OP_FSUBFLR,
+   SGX_OP_FDP,
+   SGX_OP_FDPC, /* fdp plus a clip-plane result into cp<n> */
+   SGX_OP_FMAXMIN,
+   SGX_OP_FMINMAX,
+   SGX_OP_FDSX,
+   SGX_OP_FDSY,
+   /* hw 1: scalar functions, one source */
+   SGX_OP_FRCP,
+   SGX_OP_FRSQ,
+   SGX_OP_FLOG2,
+   SGX_OP_FEXP2,
+   SGX_OP_FSQRT,
+   SGX_OP_FSIN,
+   SGX_OP_FCOS,
+   /* hw 6 */
+   SGX_OP_FMAD16,
+   /* hw 5 */
+   SGX_OP_MOV,
+   SGX_OP_MOVC_F32,
+   SGX_OP_MOVC_I32,
+   /* hw 8: pck.<dst>.<src> */
+   SGX_OP_PCK_F16_F32,
+   SGX_OP_PCK_F16_F16,
+   SGX_OP_PCK_F16_U8,
+   SGX_OP_PCK_F16_C10,
+   SGX_OP_PCK_F32_F16,
+   SGX_OP_PCK_F32_U8,
+   SGX_OP_PCK_U8_F32,
+   SGX_OP_PCK_U8_F16,
+   SGX_OP_PCK_U8_U8,
+   SGX_OP_PCK_S16_F32,
+   SGX_OP_PCK_C10_F32,
+   SGX_OP_PCK_C10_C10,
+   SGX_OP_PCK_F32_S16,
+   /* hw 9, f, a-b */
+   SGX_OP_TEST,
+   SGX_OP_TESTMASK,
+   SGX_OP_AND,
+   SGX_OP_OR,
+   SGX_OP_XOR,
+   /* hw 11, 12: colour */
+   SGX_OP_SOPWM,
+   SGX_OP_SOP3,
+   SGX_OP_SOP3L,
+   /* hw 14, 15: integer */
+   SGX_OP_IMA16,
+   SGX_OP_IMAE,
+   /* hw 1c, 1d, 1f */
+   SGX_OP_SMP,
+   SGX_OP_LD,
+   SGX_OP_LIMM,
+   SGX_OP_WDF,
+   SGX_OP_BR,
+   SGX_OP_NOP,
+   /* hw 07, 1b: co-issue */
+   SGX_OP_EFO,
+   SGX_OP_FDUAL,
+   SGX_OP_COUNT,
+};
+
+/*
+ * Fields the compiler sets on a form, by name (sgx.xml). A select
+ * (c1, c2, a, a1, a2) is its value with the complement as the next bit up.
+ */
+enum sgx_field {
+   SGX_FLD_SKIPINV,
+   SGX_FLD_PRED,
+   SGX_FLD_NOSCHED,
+   SGX_FLD_RPT,
+   SGX_FLD_RCNT,
+   SGX_FLD_MASK,
+   SGX_FLD_MOE,
+   SGX_FLD_INC0,
+   SGX_FLD_INC1,
+   SGX_FLD_INC2,
+   SGX_FLD_FMT,  /* format select */
+   SGX_FLD_F16,  /* hw 1: F16 source */
+   SGX_FLD_C10,  /* hw 1: C10 source */
+   SGX_FLD_CHAN, /* hw 1: half / channel */
+   SGX_FLD_F16D, /* hw 1: F16 destination */
+   SGX_FLD_SWZ0, /* fmad16 source swizzles */
+   SGX_FLD_SWZ1,
+   SGX_FLD_SWZ2,
+   SGX_FLD_COND,  /* movc condition, test condition */
+   SGX_FLD_ALU,   /* test ALU op */
+   SGX_FLD_TYPE,  /* testmask width */
+   SGX_FLD_DMASK, /* pck byte mask */
+   SGX_FLD_SCALE, /* pck scale */
+   SGX_FLD_SGN,   /* ima16 / imae */
+   SGX_FLD_F1,    /* ima16 src1 / src2 formats */
+   SGX_FLD_F2,
+   SGX_FLD_T2,  /* imae src2 type */
+   SGX_FLD_COP, /* sop colour / alpha ops and selects */
+   SGX_FLD_AOP,
+   SGX_FLD_C1,
+   SGX_FLD_C2,
+   SGX_FLD_A,
+   SGX_FLD_A1,
+   SGX_FLD_A2,
+   SGX_FLD_CP,  /* fdpc clip plane */
+   SGX_FLD_DIM, /* smp */
+   SGX_FLD_LOD,
+   SGX_FLD_CFMT,
+   SGX_FLD_EFO_D, /* efo: what the destination gets, the internal */
+   SGX_FLD_EFO_I, /* writes, the adder and multiplier inputs */
+   SGX_FLD_EFO_A,
+   SGX_FLD_EFO_M,
+   SGX_FLD_WI0, /* efo: write i0 / i1 */
+   SGX_FLD_WI1,
+   SGX_FLD_A0LNEG, /* efo: negate A0's left / right input */
+   SGX_FLD_A0RNEG,
+   SGX_FLD_PRI, /* fdual: the primary and secondary ops */
+   SGX_FLD_SEC,
+   SGX_FLD_SD, /* fdual: the secondary's selects */
+   SGX_FLD_SB,
+   SGX_FLD_SC,
+   SGX_FLD_MSRC,
+   SGX_FLD_COUNT,
+};
+
+enum sgx_role {
+   SGX_ROLE_NONE,
+   SGX_ROLE_DST,
+   SGX_ROLE_SRC0,
+   SGX_ROLE_SRC1,
+   SGX_ROLE_SRC2,
+   SGX_ROLE_PDST, /* test's predicate */
+   SGX_ROLE_IMM,  /* limm's value, br's target */
+};
+
+#define SGX_FILE_BIT(f) (1u << (f))
+/* a predicate operand: not a register file of the encoder */
+#define SGX_FILE_PRED 15
+
+struct sgx_slot {
+   uint8_t role;   /* enum sgx_role */
+   uint16_t files; /* SGX_FILE_BIT(enum sgx_isa_file) the slot encodes */
+   bool neg, abs;
+   bool fmt; /* follows format select (F16 numbers count halves) */
+};
+
+static inline bool
+sgx_form_is_scalar(unsigned form)
+{
+   return form >= SGX_OP_FRCP && form <= SGX_OP_FCOS;
+}
+
+/* operand k of form f, NULL past its operands */
+const struct sgx_slot *sgx_form_slot(unsigned form, unsigned k);
+const char *sgx_form_name(unsigned form);
+
+/* the instruction for form f with its fixed fields */
+void sgx_form_init(struct sgx_isa_instr *instr, unsigned form);
+/* set field id of form f's instruction */
+void sgx_form_set(struct sgx_isa_instr *instr, unsigned form, unsigned id,
+                  int32_t v);
+/* operand k of form f into its slot */
+void sgx_form_opd(struct sgx_isa_instr *instr, unsigned form, unsigned k,
+                  const struct sgx_isa_src *o);
+
+#endif
diff --git a/src/sgx/compiler/sgx_nir.c b/src/sgx/compiler/sgx_nir.c
new file mode 100644
index 0000000..f3b89c5
--- /dev/null
+++ b/src/sgx/compiler/sgx_nir.c
@@ -0,0 +1,2231 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * SGX545 compiler: NIR options, varying set allocation, I/O assignment and
+ * the NIR lowering pipeline that runs before instruction selection.
+ */
+#include <assert.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "nir.h"
+#include "nir_builder.h"
+#include "nir_deref.h"
+#include "nir_legacy.h"
+
+#include "sgx_priv.h"
+
+static int place(const struct sgx_compile_options *o, enum sgx_layout_kind k,
+                 const char *name);
+static unsigned first_free(const struct sgx_compile_options *o,
+                           enum sgx_layout_kind k);
+
+static const nir_shader_compiler_options options = {
+   .lower_fdiv = true,
+   .lower_flrp32 = true,
+   .lower_fpow = true,
+   .lower_fmod = true,
+   .lower_fsign = true,
+   /* (integers are floats by then: a clamp to [-1, 1] stays imin/imax,
+    * which nir_lower_int_to_float takes, not isign, which it doesn't) */
+   .lower_isign = true,
+   .lower_fceil = true,
+   .lower_ftrunc = true,
+   .lower_fround_even = true,
+   .lower_fdph = true,
+   .lower_bitops = true,
+   .lower_extract_byte = true,
+   .lower_extract_word = true,
+   .lower_insert_byte = true,
+   .lower_insert_word = true,
+   /* fmad: the product is rounded before the add (not fused: checked on
+      hardware) */
+   .float_mul_add32 =
+      nir_float_muladd_support_has_fmad | nir_float_muladd_support_fuse,
+   /* fmad16: a mediump a * b + c, one rounding (checked on hardware) */
+   .float_mul_add16 =
+      nir_float_muladd_support_has_fmad | nir_float_muladd_support_fuse,
+   .no_integers = true,
+   .max_unroll_iterations = 8, /* (a 16-trip loop with a break unrolled to
+                                  125 instructions) */
+   .lower_int64_options = ~0,
+   /* (not lower_doubles_options = ~0: GLSL ES has no doubles, and with it
+    * 144 dEQP fragment loops came out wrong on hardware) */
+   .force_indirect_unrolling = nir_var_all,
+   .force_indirect_unrolling_sampler = true,
+   /* the PDS reads a texture with a varying in a whole vec4 slot from
+    * component 0: the linker mustn't pack another varying in front of it */
+   .io_options = nir_io_dont_optimize_varyings,
+};
+
+const nir_shader_compiler_options *
+sgx_nir_options(void)
+{
+   return &options;
+}
+
+/* ------------------------------------------------------------------------
+ * varyings -> texture coordinate sets: by type mat4, mat2, vec4,
+ * mat3, vec3, vec2, float; within a type the largest array first, then
+ * declaration order; one set per row while sets last.
+ */
+static int
+type_rank(const struct glsl_type *t)
+{
+   t = glsl_without_array(t);
+   unsigned c = glsl_get_vector_elements(t), m = glsl_get_matrix_columns(t);
+   if (m > 1)
+      return m == 4 ? 0 : m == 2 ? 1 : 3;
+   return c == 4 ? 2 : c == 3 ? 4 : c == 2 ? 5 : 6;
+}
+
+/* is the variable read (or written) anywhere? Works on deref and on
+ * lowered I/O (Mesa's GLSL compiler hands over either) */
+static bool
+var_used(nir_shader *nir, nir_variable *var, bool store)
+{
+   unsigned slots = glsl_count_vec4_slots(var->type, false, false);
+   nir_foreach_function_impl (impl, nir) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            switch (in->intrinsic) {
+            case nir_intrinsic_store_deref:
+            case nir_intrinsic_load_deref:
+            case nir_intrinsic_interp_deref_at_centroid:
+               if ((in->intrinsic == nir_intrinsic_store_deref) == store &&
+                   nir_deref_instr_get_variable(nir_src_as_deref(in->src[0])) ==
+                      var)
+                  return true;
+               break;
+            case nir_intrinsic_copy_deref:
+               if (nir_deref_instr_get_variable(
+                      nir_src_as_deref(in->src[store ? 0 : 1])) == var)
+                  return true;
+               break;
+            case nir_intrinsic_store_output:
+            case nir_intrinsic_load_input:
+            case nir_intrinsic_load_interpolated_input: {
+               if ((in->intrinsic == nir_intrinsic_store_output) != store)
+                  break;
+               int loc = nir_intrinsic_io_semantics(in).location;
+               if (loc >= var->data.location &&
+                   loc < var->data.location + (int)slots)
+                  return true;
+               break;
+            }
+            default:
+               break;
+            }
+         }
+      }
+   }
+   return false;
+}
+
+bool
+sgx_lower_clip_fs(nir_shader *fs, unsigned ucp_enables)
+{
+   ucp_enables &= 0xff;
+   if (fs->info.stage != MESA_SHADER_FRAGMENT || !ucp_enables)
+      return false;
+   nir_variable *in[2] = {NULL, NULL};
+   for (unsigned h = 0; h < 2; h++) {
+      if (!(ucp_enables & (0xfu << (4 * h))))
+         continue;
+      gl_varying_slot slot = VARYING_SLOT_CLIP_DIST0 + h;
+      in[h] = nir_find_variable_with_location(fs, nir_var_shader_in, slot);
+      if (!in[h]) {
+         char name[16];
+         snprintf(name, sizeof(name), "clipdist_%u", h);
+         in[h] =
+            nir_variable_create(fs, nir_var_shader_in, glsl_vec4_type(), name);
+         in[h]->data.location = slot;
+         in[h]->data.interpolation = INTERP_MODE_NONE;
+      }
+   }
+   nir_function_impl *impl = nir_shader_get_entrypoint(fs);
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *d[2] = {NULL, NULL}, *out = NULL;
+   for (unsigned h = 0; h < 2; h++)
+      if (in[h])
+         d[h] = nir_load_var(&b, in[h]);
+   u_foreach_bit (p, ucp_enables) {
+      nir_def *neg = nir_flt_imm(&b, nir_channel(&b, d[p / 4], p % 4), 0.0);
+      out = out ? nir_ior(&b, out, neg) : neg;
+   }
+   nir_discard_if(&b, out);
+   fs->info.fs.uses_discard = true;
+   return nir_progress(true, impl, nir_metadata_none);
+}
+
+void
+sgx_assign_varyings(nir_shader *nir, bool vertex, struct sgx_varyings *out)
+{
+   nir_variable *vars[32];
+   unsigned n = 0;
+   nir_variable_mode mode = vertex ? nir_var_shader_out : nir_var_shader_in;
+
+   memset(out, 0, sizeof(*out));
+   nir_foreach_variable_with_modes (var, nir, mode) {
+      /* (before linking, user varyings have no location yet) */
+      bool builtin =
+         !strncmp(var->name, "gl_", 3) ||
+         (var->data.location >= 0 && var->data.location < VARYING_SLOT_VAR0);
+      if (vertex && builtin &&
+          (var->data.location == VARYING_SLOT_PSIZ ||
+           !strcmp(var->name, "gl_PointSize")) &&
+          var_used(nir, var, true))
+         out->point_size = true;
+      /* the point-sprite coordinate is iterated from set 0, the set a vertex
+       * shader that writes gl_PointSize reserves (gl_PointCoord = list A
+       * iterator 1) */
+      if (!vertex && builtin &&
+          (var->data.location == VARYING_SLOT_PNTC ||
+           !strcmp(var->name, "gl_PointCoord")) &&
+          var_used(nir, var, false))
+         out->point_size = true;
+      if (builtin || n >= 32)
+         continue;
+      if (!var_used(nir, var, vertex))
+         continue;
+      vars[n++] = var;
+   }
+   /* stable sort: rank, then larger arrays first */
+   for (unsigned i = 1; i < n; i++) {
+      for (unsigned j = i; j > 0; j--) {
+         nir_variable *a = vars[j - 1], *b = vars[j];
+         int ra = type_rank(a->type), rb = type_rank(b->type);
+         unsigned la =
+            glsl_type_is_array(a->type) ? glsl_get_length(a->type) : 1;
+         unsigned lb =
+            glsl_type_is_array(b->type) ? glsl_get_length(b->type) : 1;
+         if (ra < rb || (ra == rb && la >= lb))
+            break;
+         vars[j - 1] = b;
+         vars[j] = a;
+      }
+   }
+   unsigned set = 0;
+   if (out->point_size) {
+      out->set_comps[0] = 2;
+      set = 1;
+   }
+   for (unsigned i = 0; i < n; i++) {
+      nir_variable *var = vars[i];
+      const struct glsl_type *e = glsl_without_array(var->type);
+      unsigned len =
+         glsl_type_is_array(var->type) ? glsl_get_length(var->type) : 1;
+      unsigned cols = glsl_get_matrix_columns(e);
+      struct sgx_varying *v = &out->v[out->n++];
+      snprintf(v->name, sizeof v->name, "%s", var->name);
+      v->rows = len * cols;
+      v->comps = glsl_get_vector_elements(e);
+      v->precision = var->data.precision;
+      v->set = set;
+      for (unsigned r = 0; r < v->rows; r++, set++)
+         if (set < SGX_MAX_SETS)
+            out->set_comps[set] = v->comps;
+   }
+   sgx_pack_varyings(out);
+}
+
+bool
+sgx_pack_varyings(struct sgx_varyings *out)
+{
+   bool fits = true;
+   for (unsigned i = 0; i < out->n; i++)
+      fits &= out->v[i].set + out->v[i].rows <= SGX_MAX_SETS &&
+              out->v[i].comp + out->v[i].comps <= 4;
+   if (fits)
+      return true;
+
+   /* a set per row while sets remain, then rows into free components of
+    * earlier sets. It packs by
+    * precision too, but a varying's precision may differ between the stages,
+    * each placed on its own, so not here (a mixed set is iterated in f32). A
+    * sprite's set 0 is the point coordinate's alone. */
+   uint8_t used[SGX_MAX_SETS] = {0};
+   unsigned next = out->point_size ? 1 : 0;
+   memset(out->set_comps, 0, sizeof(out->set_comps));
+   if (out->point_size) {
+      used[0] = 0xf;
+      out->set_comps[0] = 2;
+   }
+   for (unsigned i = 0; i < out->n; i++) {
+      struct sgx_varying *v = &out->v[i];
+      unsigned mask = (1u << v->comps) - 1;
+      bool placed = false;
+      if (next + v->rows <= SGX_MAX_SETS) {
+         v->set = next;
+         v->comp = 0;
+         next += v->rows;
+         placed = true;
+      }
+      for (unsigned st = 0; st + v->rows <= next && !placed; st++) {
+         for (unsigned c = 0; c + v->comps <= 4 && !placed; c++) {
+            bool ok = true;
+            for (unsigned r = 0; r < v->rows && ok; r++)
+               ok = !(used[st + r] & mask << c);
+            if (ok) {
+               v->set = st;
+               v->comp = c;
+               placed = true;
+            }
+         }
+      }
+      if (!placed)
+         return false;
+      for (unsigned r = 0; r < v->rows; r++) {
+         used[v->set + r] |= mask << v->comp;
+         out->set_comps[v->set + r] =
+            MAX2(out->set_comps[v->set + r], v->comp + v->comps);
+      }
+   }
+   return true;
+}
+
+/* ------------------------------------------------------------------------
+ * sin/cos: the hardware's fsin/fcos take quarter turns and are accurate
+ * only on [-2, 2) (measured), so reduce: t = 4 * fract(x / 2pi + c) - 2, and
+ * sin(x) = fsin(t) for c = 0.5, cos(x) = fsin(t) for c = 0.75.
+ * fsin_agx is NIR's sin(t * pi / 2).
+ */
+static bool
+lower_sincos_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   if (alu->op != nir_op_fsin && alu->op != nir_op_fcos)
+      return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *x = nir_ssa_for_alu_src(b, alu, 0);
+   /* (a mediump argument reduced in f32: F16 would keep few bits of the
+    * fraction of a larger angle) */
+   if (x->bit_size == 16)
+      x = nir_f2f32(b, x);
+   double c = alu->op == nir_op_fsin ? 0.5 : 0.75;
+   nir_def *u = nir_ffract(
+      b, nir_fmad(b, x, nir_imm_float(b, 0.5 / M_PI), nir_imm_float(b, c)));
+   nir_def *t = nir_fmad(b, u, nir_imm_float(b, 4.0), nir_imm_float(b, -2.0));
+   nir_def *r = nir_fsin_agx(b, t);
+   if (alu->def.bit_size == 16)
+      r = nir_f2f16(b, r);
+   nir_def_replace(&alu->def, r);
+   return true;
+}
+
+static bool
+lower_sincos(nir_shader *s)
+{
+   return nir_shader_alu_pass(s, lower_sincos_instr, nir_metadata_control_flow,
+                              NULL);
+}
+
+/* sampler derefs -> texture/sampler indices: the caller's unit for the
+ * sampler, else its binding */
+struct tex_ctx {
+   struct sgx_ctx *c;
+};
+
+static unsigned
+sampler_number(struct tex_ctx *t, nir_variable *var)
+{
+   int pinned = place(t->c->opts, SGX_LAYOUT_SAMPLER, var->name);
+   return pinned >= 0 ? (unsigned)pinned : var->data.binding;
+}
+
+static bool
+lower_tex_derefs_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   struct tex_ctx *tc = data;
+   if (instr->type != nir_instr_type_tex)
+      return false;
+   nir_tex_instr *tex = nir_instr_as_tex(instr);
+   bool progress = false;
+   for (int i = tex->num_srcs - 1; i >= 0; i--) {
+      nir_tex_src_type t = tex->src[i].src_type;
+      if (t != nir_tex_src_texture_deref && t != nir_tex_src_sampler_deref)
+         continue;
+      nir_variable *var =
+         nir_deref_instr_get_variable(nir_src_as_deref(tex->src[i].src));
+      unsigned unit = var ? sampler_number(tc, var) : 0;
+      if (t == nir_tex_src_texture_deref)
+         tex->texture_index = unit;
+      else
+         tex->sampler_index = unit;
+      nir_tex_instr_remove_src(tex, i);
+      progress = true;
+   }
+   return progress;
+}
+
+static bool
+lower_tex_derefs(nir_shader *s, struct sgx_ctx *c)
+{
+   struct tex_ctx t = {.c = c};
+   return nir_shader_instructions_pass(s, lower_tex_derefs_instr,
+                                       nir_metadata_control_flow, &t);
+}
+
+/* a texel of a tex_f32 unit: its first component, the rest (0, 0, 1) */
+static bool
+lower_f32_texel(nir_builder *b, nir_instr *instr, void *data)
+{
+   uint32_t units = *(const uint32_t *)data;
+   if (instr->type != nir_instr_type_tex)
+      return false;
+   nir_tex_instr *tex = nir_instr_as_tex(instr);
+   if (tex->texture_index >= 32 || !(units >> tex->texture_index & 1) ||
+       tex->def.num_components != 4 || nir_tex_instr_is_query(tex))
+      return false;
+   unsigned bits = tex->def.bit_size;
+   b->cursor = nir_after_instr(instr);
+   nir_def *v =
+      nir_vec4(b, nir_channel(b, &tex->def, 0), nir_imm_floatN_t(b, 0, bits),
+               nir_imm_floatN_t(b, 0, bits), nir_imm_floatN_t(b, 1, bits));
+   nir_def_rewrite_uses_after(&tex->def, v);
+   return true;
+}
+
+/* gl_FrontFacing as the constant true (see sgx_compile_options.front_sa) */
+static bool
+front_true_instr(nir_builder *b, nir_intrinsic_instr *in, void *data)
+{
+   if ((in->intrinsic != nir_intrinsic_load_input &&
+        in->intrinsic != nir_intrinsic_load_front_face) ||
+       (in->intrinsic == nir_intrinsic_load_input &&
+        nir_intrinsic_io_semantics(in).location != VARYING_SLOT_FACE))
+      return false;
+   b->cursor = nir_before_instr(&in->instr);
+   nir_def_replace(&in->def, nir_imm_intN_t(b, ~0ull, in->def.bit_size));
+   return true;
+}
+
+/* The 32-bit value of component comp of a 16-bit integer that a conversion
+ * made (f2i16(x), i2i16(y), b2i16(c), a constant), through moves and vectors;
+ * NULL when it isn't one */
+static nir_def *
+int16_as_32(nir_builder *b, nir_def *d, unsigned comp)
+{
+   if (nir_def_is_const(d) && d->bit_size == 16)
+      return nir_imm_int(b, nir_src_comp_as_int(nir_src_for_ssa(d), comp));
+   nir_alu_instr *p = nir_def_as_alu_or_null(d);
+   if (!p)
+      return NULL;
+   if (nir_op_is_vec(p->op))
+      return int16_as_32(b, p->src[comp].src.ssa, p->src[comp].swizzle[0]);
+   nir_def *x = p->src[0].src.ssa;
+   unsigned xc = p->src[0].swizzle[comp];
+   switch (p->op) {
+   case nir_op_mov:
+      return int16_as_32(b, x, xc);
+   case nir_op_f2i16:
+   case nir_op_f2u16: {
+      nir_def *f = nir_channel(b, x, xc);
+      if (f->bit_size != 32)
+         f = nir_f2f32(b, f);
+      return p->op == nir_op_f2i16 ? nir_f2i32(b, f) : nir_f2u32(b, f);
+   }
+   case nir_op_i2i16:
+   case nir_op_u2u16:
+      return x->bit_size == 32 ? nir_channel(b, x, xc) : int16_as_32(b, x, xc);
+   case nir_op_b2i16:
+      return nir_b2i32(b, nir_channel(b, x, xc));
+   case nir_op_bcsel: {
+      nir_def *t = int16_as_32(b, p->src[1].src.ssa, p->src[1].swizzle[comp]);
+      nir_def *e = int16_as_32(b, p->src[2].src.ssa, p->src[2].swizzle[comp]);
+      return t && e ? nir_bcsel(b, nir_channel(b, x, xc), t, e) : NULL;
+   }
+   default:
+      return NULL;
+   }
+}
+
+/* What nir_lower_bit_size leaves of 16-bit integers (mediump int in F16
+ * mode) are conversions at the edges: read them from the 32-bit value */
+static bool
+int16_conv_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   if ((alu->op == nir_op_i2i32 || alu->op == nir_op_u2u32) &&
+       nir_src_bit_size(alu->src[0].src) == 32) {
+      /* (what's left of a 16-bit round trip) */
+      b->cursor = nir_before_instr(&alu->instr);
+      nir_def_replace(&alu->def, nir_ssa_for_alu_src(b, alu, 0));
+      return true;
+   }
+   if (nir_op_infos[alu->op].num_inputs != 1 ||
+       nir_src_bit_size(alu->src[0].src) != 16)
+      return false;
+   if (alu->op != nir_op_i2i32 && alu->op != nir_op_u2u32 &&
+       alu->op != nir_op_i2f32 && alu->op != nir_op_u2f32 &&
+       alu->op != nir_op_i2f16 && alu->op != nir_op_u2f16)
+      return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *xs[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned k = 0; k < alu->def.num_components; k++) {
+      xs[k] = int16_as_32(b, alu->src[0].src.ssa, alu->src[0].swizzle[k]);
+      if (!xs[k])
+         return false;
+   }
+   nir_def *x = nir_vec(b, xs, alu->def.num_components);
+   nir_def *r = x;
+   if (alu->op == nir_op_i2f32 || alu->op == nir_op_i2f16)
+      r = nir_i2f32(b, x);
+   else if (alu->op == nir_op_u2f32 || alu->op == nir_op_u2f16)
+      r = nir_u2f32(b, x);
+   if (alu->def.bit_size == 16)
+      r = nir_f2f16(b, r);
+   nir_def_replace(&alu->def, r);
+   return true;
+}
+
+/* float(i) for a mediump result: nir_lower_int_to_float only takes 32-bit
+ * conversions, so the i2f32 it turns into a move, then f2f16 */
+static bool
+i2f16_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   if ((alu->op != nir_op_i2f16 && alu->op != nir_op_u2f16) ||
+       nir_src_bit_size(alu->src[0].src) != 32)
+      return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *x = nir_ssa_for_alu_src(b, alu, 0);
+   nir_def_replace(&alu->def,
+                   nir_f2f16(b, alu->op == nir_op_i2f16 ? nir_i2f32(b, x)
+                                                        : nir_u2f32(b, x)));
+   return true;
+}
+
+static bool
+csel16_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   if (alu->op != nir_op_bcsel || alu->def.bit_size != 16)
+      return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *cond = nir_b2f32(b, nir_ssa_for_alu_src(b, alu, 0));
+   nir_def_replace(&alu->def,
+                   nir_b32csel(b, cond, nir_ssa_for_alu_src(b, alu, 1),
+                               nir_ssa_for_alu_src(b, alu, 2)));
+   return true;
+}
+
+/* An f32 op exact under rounding (select, min, max, saturate, negate, abs,
+ * move, vec) that only f2f16 reads, over values that are F16 underneath: done
+ * in F16, so chains (if / return selects of mediump values) and the uniforms
+ * under them stay F16 instead of widening and narrowing again. */
+static bool
+narrow16_op(nir_op op)
+{
+   return op == nir_op_bcsel || op == nir_op_fmin || op == nir_op_fmax ||
+          op == nir_op_fsat || op == nir_op_fneg || op == nir_op_fabs ||
+          nir_op_is_vec_or_mov(op);
+}
+
+/* an f32 value whose F16 costs nothing: the f2f32 of one, a constant, a
+ * uniform (an F16 constant then), or such an op over them */
+static bool
+f16_free(nir_def *d, unsigned depth)
+{
+   nir_instr *p = nir_def_instr(d);
+   if (p->type == nir_instr_type_load_const)
+      return true;
+   if (p->type == nir_instr_type_intrinsic)
+      return nir_instr_as_intrinsic(p)->intrinsic == nir_intrinsic_load_uniform;
+   if (p->type != nir_instr_type_alu || depth > 8)
+      return false;
+   nir_alu_instr *a = nir_instr_as_alu(p);
+   if (a->op == nir_op_f2f32)
+      return nir_src_bit_size(a->src[0].src) == 16;
+   if (!narrow16_op(a->op))
+      return false;
+   for (unsigned j = a->op == nir_op_bcsel ? 1 : 0;
+        j < nir_op_infos[a->op].num_inputs; j++)
+      if (!f16_free(a->src[j].src.ssa, depth + 1))
+         return false;
+   return true;
+}
+
+static bool
+narrow16_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   nir_op op = alu->op;
+   if (alu->def.bit_size != 32 || !narrow16_op(op))
+      return false;
+   for (unsigned j = op == nir_op_bcsel ? 1 : 0;
+        j < nir_op_infos[op].num_inputs; j++)
+      if (!f16_free(alu->src[j].src.ssa, 0))
+         return false;
+   if (list_is_empty(&alu->def.uses))
+      return false;
+   nir_foreach_use_including_if (use, &alu->def) {
+      nir_instr *u = nir_src_is_if(use) ? NULL : nir_src_use_instr(use);
+      if (!u || u->type != nir_instr_type_alu ||
+          (nir_instr_as_alu(u)->op != nir_op_f2f16 &&
+           nir_instr_as_alu(u)->op != nir_op_f2fmp))
+         return false;
+   }
+   b->cursor = nir_before_instr(&alu->instr);
+   unsigned n = nir_op_infos[op].num_inputs;
+   /* (each source's f2f16 takes its swizzle: no new 32-bit move to narrow) */
+   nir_alu_instr *h = nir_alu_instr_create(b->shader, op);
+   for (unsigned j = 0; j < n; j++) {
+      if (op == nir_op_bcsel && j == 0) {
+         nir_alu_src_copy(&h->src[0], &alu->src[0]);
+         continue;
+      }
+      nir_alu_instr *cv = nir_alu_instr_create(b->shader, nir_op_f2f16);
+      nir_alu_src_copy(&cv->src[0], &alu->src[j]);
+      nir_def_init(&cv->instr, &cv->def,
+                   nir_ssa_alu_instr_src_components(alu, j), 16);
+      nir_builder_instr_insert(b, &cv->instr);
+      h->src[j].src = nir_src_for_ssa(&cv->def);
+      for (unsigned k = 0; k < NIR_MAX_VEC_COMPONENTS; k++)
+         h->src[j].swizzle[k] = k;
+   }
+   nir_def_init(&h->instr, &h->def, alu->def.num_components, 16);
+   nir_builder_instr_insert(b, &h->instr);
+   nir_foreach_use_safe (use, &alu->def) {
+      nir_alu_instr *cv = nir_instr_as_alu(nir_src_use_instr(use));
+      b->cursor = nir_before_instr(&cv->instr);
+      unsigned swz[NIR_MAX_VEC_COMPONENTS];
+      for (unsigned j = 0; j < cv->def.num_components; j++)
+         swz[j] = cv->src[0].swizzle[j];
+      nir_def_rewrite_uses(
+         &cv->def, nir_swizzle(b, &h->def, swz, cv->def.num_components));
+   }
+   return true;
+}
+
+static bool
+narrow16(nir_shader *s)
+{
+   bool progress = false, p = true;
+   for (unsigned round = 0; p && round < 64; round++) {
+      p = false;
+      NIR_PASS(p, s, nir_shader_alu_pass, narrow16_instr,
+               nir_metadata_control_flow, NULL);
+      if (p) {
+         NIR_PASS(_, s, nir_opt_algebraic);
+         NIR_PASS(_, s, nir_opt_constant_folding);
+         NIR_PASS(_, s, nir_opt_dce);
+      }
+      progress |= p;
+   }
+   return progress;
+}
+
+static nir_alu_instr *
+alu_of(nir_src s)
+{
+   nir_instr *i = nir_def_instr(s.ssa);
+   return i->type == nir_instr_type_alu ? nir_instr_as_alu(i) : NULL;
+}
+
+/* The colour is packed to U8 with pck's saturation: a clamp to [0, 1] of
+ * what is stored there is the pack's own */
+static bool
+colour_sat_instr(nir_builder *b, nir_intrinsic_instr *in, void *data)
+{
+   if (in->intrinsic != nir_intrinsic_store_output)
+      return false;
+   unsigned loc = nir_intrinsic_io_semantics(in).location;
+   if (loc != FRAG_RESULT_COLOR && loc != FRAG_RESULT_DATA0)
+      return false;
+   nir_alu_instr *a = alu_of(in->src[0]);
+   nir_alu_instr *cv = NULL;
+   if (a && a->op == nir_op_f2f32) {
+      cv = a;
+      a = alu_of(a->src[0].src);
+   }
+   if (!a || a->op != nir_op_fsat)
+      return false;
+   b->cursor = nir_before_instr(&in->instr);
+   nir_def *x = nir_ssa_for_alu_src(b, a, 0);
+   if (cv) {
+      nir_alu_instr *w = nir_alu_instr_create(b->shader, nir_op_f2f32);
+      w->src[0].src = nir_src_for_ssa(x);
+      for (unsigned k = 0; k < NIR_MAX_VEC_COMPONENTS; k++)
+         w->src[0].swizzle[k] = cv->src[0].swizzle[k];
+      nir_def_init(&w->instr, &w->def, cv->def.num_components, 32);
+      nir_builder_instr_insert(b, &w->instr);
+      x = &w->def;
+   }
+   nir_src_rewrite(&in->src[0], x);
+   return true;
+}
+
+/* ------------------------------------------------------------------------
+ * fs_mediump: inputs, texels and uniforms that no texture coordinate needs
+ * become F16, then every float op over F16 values is rebuilt in F16 (what
+ * Mesa's precision lowering does for mediump GLSL), until nothing changes. */
+
+static bool
+feeds_coord(nir_def *d, unsigned depth)
+{
+   nir_foreach_use_including_if (use, d) {
+      if (nir_src_is_if(use))
+         continue;
+      nir_instr *u = nir_src_use_instr(use);
+      if (u->type == nir_instr_type_tex)
+         return true;
+      if (u->type == nir_instr_type_alu && depth < 4 &&
+          nir_op_is_vec_or_mov(nir_instr_as_alu(u)->op) &&
+          feeds_coord(&nir_instr_as_alu(u)->def, depth + 1))
+         return true;
+   }
+   return false;
+}
+
+static bool
+demote_op(nir_op op)
+{
+   switch (op) {
+   case nir_op_fadd:
+   case nir_op_fmul:
+   case nir_op_ffma:
+   case nir_op_flrp:
+   case nir_op_fneg:
+   case nir_op_fabs:
+   case nir_op_fsat:
+   case nir_op_fmin:
+   case nir_op_fmax:
+   case nir_op_frcp:
+   case nir_op_frsq:
+   case nir_op_fsqrt:
+   case nir_op_fexp2:
+   case nir_op_flog2:
+   case nir_op_ffloor:
+   case nir_op_ffract:
+   case nir_op_fdot2:
+   case nir_op_fdot3:
+   case nir_op_fdot4:
+   case nir_op_bcsel:
+   case nir_op_mov:
+   case nir_op_vec2:
+   case nir_op_vec3:
+   case nir_op_vec4:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* the F16 value an op source is underneath (the f2f32 of one, a constant),
+ * through the source's swizzle; NULL if it isn't one */
+static nir_def *
+src16(nir_builder *b, nir_alu_instr *alu, unsigned j)
+{
+   unsigned nc = nir_ssa_alu_instr_src_components(alu, j);
+   unsigned swz[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned k = 0; k < nc; k++)
+      swz[k] = alu->src[j].swizzle[k];
+   if (nir_src_is_const(alu->src[j].src)) {
+      /* (the f2f16 takes the swizzle: a 32-bit move of it would be
+       * demoted again, forever) */
+      nir_alu_instr *cv = nir_alu_instr_create(b->shader, nir_op_f2f16);
+      nir_alu_src_copy(&cv->src[0], &alu->src[j]);
+      nir_def_init(&cv->instr, &cv->def, nc, 16);
+      nir_builder_instr_insert(b, &cv->instr);
+      return &cv->def;
+   }
+   nir_alu_instr *p = alu_of(alu->src[j].src);
+   if (!p || p->op != nir_op_f2f32 || nir_src_bit_size(p->src[0].src) != 16)
+      return NULL;
+   for (unsigned k = 0; k < nc; k++)
+      swz[k] = p->src[0].swizzle[swz[k]];
+   return nir_swizzle(b, p->src[0].src.ssa, swz, nc);
+}
+
+/* every use reads d as a float (through moves, vecs and selects) */
+static bool
+float_uses(nir_def *d, unsigned depth)
+{
+   nir_foreach_use_including_if (use, d) {
+      if (nir_src_is_if(use))
+         return false;
+      nir_instr *u = nir_src_use_instr(use);
+      if (u->type == nir_instr_type_intrinsic) {
+         nir_intrinsic_instr *in = nir_instr_as_intrinsic(u);
+         if (in->intrinsic == nir_intrinsic_store_output &&
+             nir_alu_type_get_base_type(nir_intrinsic_src_type(in)) ==
+                nir_type_float)
+            continue;
+         return false;
+      }
+      if (u->type != nir_instr_type_alu)
+         return false;
+      nir_alu_instr *a = nir_instr_as_alu(u);
+      unsigned j = container_of(use, nir_alu_src, src) - a->src;
+      if (nir_op_is_vec_or_mov(a->op) || (a->op == nir_op_bcsel && j > 0)) {
+         if (depth >= 4 || !float_uses(&a->def, depth + 1))
+            return false;
+      } else if (nir_alu_type_get_base_type(
+                    nir_op_infos[a->op].input_types[j]) != nir_type_float) {
+         return false;
+      }
+   }
+   return true;
+}
+
+/* every constant operand (bcsel's condition aside) is an F16 value exactly */
+static bool
+consts_f16_exact(nir_alu_instr *alu)
+{
+   for (unsigned j = 0; j < nir_op_infos[alu->op].num_inputs; j++) {
+      if ((alu->op == nir_op_bcsel && j == 0) ||
+          !nir_src_is_const(alu->src[j].src))
+         continue;
+      for (unsigned k = 0; k < nir_ssa_alu_instr_src_components(alu, j); k++) {
+         float f =
+            nir_src_comp_as_float(alu->src[j].src, alu->src[j].swizzle[k]);
+         if (_mesa_half_to_float(_mesa_float_to_half(f)) != f)
+            return false;
+      }
+   }
+   return true;
+}
+
+static bool
+demote_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   nir_op op = alu->op;
+   if (alu->def.bit_size != 32 || !demote_op(op) || feeds_coord(&alu->def, 0))
+      return false;
+   /* at least one operand F16 underneath, or constants that are F16 values
+    * read as floats: constants alone don't say the value is a float
+    * (bcsel(b, 3, 0) over ints, a 32-bit loop bound), nor that F16 holds
+    * them (a highp atan's -pi/2) */
+   unsigned n = nir_op_infos[op].num_inputs, f16 = 0;
+   for (unsigned j = 0; j < n; j++) {
+      if (op == nir_op_bcsel && j == 0)
+         continue;
+      nir_alu_instr *p = alu_of(alu->src[j].src);
+      if (p && p->op == nir_op_f2f32 && nir_src_bit_size(p->src[0].src) == 16)
+         f16++;
+      else if (!nir_src_is_const(alu->src[j].src))
+         return false;
+   }
+   if (!f16 && !(consts_f16_exact(alu) && float_uses(&alu->def, 0)))
+      return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *x[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned j = 0; j < n; j++)
+      x[j] = op == nir_op_bcsel && j == 0 ? nir_ssa_for_alu_src(b, alu, 0)
+                                          : src16(b, alu, j);
+   nir_def *h = nir_build_alu_src_arr(b, op, x);
+   nir_def_replace(&alu->def, nir_f2f32(b, h));
+   return true;
+}
+
+/* an f32 value d is F16 from here on: its float users read f2f32(f2f16(d)) */
+static void
+seed16(nir_builder *b, nir_def *d)
+{
+   b->cursor = nir_after_instr(nir_def_instr(d));
+   nir_def *w = nir_f2f32(b, nir_f2f16(b, d));
+   nir_def_rewrite_uses_after(d, w);
+}
+
+static bool
+low_prec(unsigned p)
+{
+   return p == GLSL_PRECISION_MEDIUM || p == GLSL_PRECISION_LOW;
+}
+
+/* the precision a texel has: its sampler's */
+static unsigned
+tex_prec(nir_tex_instr *t)
+{
+   int i = nir_tex_instr_src_index(t, nir_tex_src_texture_deref);
+   if (i < 0)
+      return 0;
+   nir_variable *v =
+      nir_deref_instr_get_variable(nir_src_as_deref(t->src[i].src));
+   return v ? v->data.precision : 0;
+}
+
+/* a load or texel that is a float (an int or bool uniform or input, 32 bits
+ * as st hands them over, must not go through F16) */
+static bool
+float_value(nir_instr *instr)
+{
+   if (instr->type == nir_instr_type_tex)
+      return nir_alu_type_get_base_type(nir_instr_as_tex(instr)->dest_type) ==
+             nir_type_float;
+   nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+   if (in->intrinsic == nir_intrinsic_load_deref) {
+      const struct glsl_type *t =
+         glsl_without_array_or_matrix(nir_src_as_deref(in->src[0])->type);
+      return glsl_get_base_type(t) == GLSL_TYPE_FLOAT ||
+             glsl_get_base_type(t) == GLSL_TYPE_FLOAT16;
+   }
+   return nir_intrinsic_has_dest_type(in) &&
+          nir_alu_type_get_base_type(nir_intrinsic_dest_type(in)) ==
+             nir_type_float;
+}
+
+struct mediump_ctx {
+   bool all;
+   struct set *coord; /* input variables a texture coordinate reads */
+};
+
+/* a load or texel mediump makes F16: f2f16 at its definition */
+static bool
+mediump_seed_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   const struct mediump_ctx *m = data;
+   bool progress = false;
+   nir_def *d = NULL;
+   if (instr->type == nir_instr_type_tex) {
+      nir_tex_instr *t = nir_instr_as_tex(instr);
+      if ((t->op == nir_texop_tex || t->op == nir_texop_txb ||
+           t->op == nir_texop_txl) &&
+          (m->all || low_prec(tex_prec(t))))
+         d = &t->def;
+   } else if (instr->type == nir_instr_type_intrinsic) {
+      nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+      if (in->intrinsic == nir_intrinsic_load_deref) {
+         nir_variable *v =
+            nir_deref_instr_get_variable(nir_src_as_deref(in->src[0]));
+         if (v && v->data.mode == nir_var_shader_in &&
+             v->data.location >= VARYING_SLOT_VAR0 &&
+             (m->all ? !_mesa_set_search(m->coord, v)
+                     : low_prec(v->data.precision)))
+            d = &in->def;
+         else if (v && v->data.mode == nir_var_uniform &&
+                  (m->all || low_prec(v->data.precision)))
+            d = &in->def;
+      } else if ((in->intrinsic == nir_intrinsic_load_interpolated_input ||
+                  in->intrinsic == nir_intrinsic_load_input) &&
+                 nir_intrinsic_io_semantics(in).location >= VARYING_SLOT_VAR0) {
+         nir_io_semantics sem = nir_intrinsic_io_semantics(in);
+         if (m->all && !feeds_coord(&in->def, 0) && !sem.medium_precision) {
+            sem.medium_precision = 1;
+            nir_intrinsic_set_io_semantics(in, sem);
+            progress = true;
+         }
+         if (sem.medium_precision)
+            d = &in->def;
+      } else if (in->intrinsic == nir_intrinsic_load_uniform && m->all) {
+         d = &in->def;
+      }
+   }
+   if (d && d->bit_size == 32 && !list_is_empty(&d->uses) &&
+       float_value(instr) &&
+       (instr->type != nir_instr_type_tex || !feeds_coord(d, 0))) {
+      seed16(b, d);
+      progress = true;
+   }
+   return progress;
+}
+
+/* all: fs_mediump, every input, texel and uniform no coordinate needs (and
+ * their variables become mediump); otherwise those the program declares
+ * mediump or lowp. Ops whose operands are all F16 then run in F16: GLSL ES
+ * gives an operation its operands' highest precision. */
+static bool
+lower_mediump(nir_shader *s, bool all)
+{
+   struct mediump_ctx m = {.all = all, .coord = _mesa_pointer_set_create(NULL)};
+   if (all) {
+      /* inputs: a variable none of whose loads is a coordinate is mediump */
+      nir_foreach_function_impl (impl, s) {
+         nir_foreach_block (blk, impl) {
+            nir_foreach_instr (instr, blk) {
+               if (instr->type != nir_instr_type_intrinsic)
+                  continue;
+               nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+               if (in->intrinsic == nir_intrinsic_load_deref) {
+                  nir_variable *v =
+                     nir_deref_instr_get_variable(nir_src_as_deref(in->src[0]));
+                  if (v && v->data.mode == nir_var_shader_in &&
+                      feeds_coord(&in->def, 0))
+                     _mesa_set_add(m.coord, v);
+               }
+            }
+         }
+      }
+      nir_foreach_shader_in_variable (var, s)
+         if (var->data.location >= VARYING_SLOT_VAR0 &&
+             !_mesa_set_search(m.coord, var))
+            var->data.precision = GLSL_PRECISION_MEDIUM;
+      nir_foreach_variable_with_modes (var, s, nir_var_uniform)
+         if (!glsl_type_is_sampler(glsl_without_array(var->type)))
+            var->data.precision = GLSL_PRECISION_MEDIUM;
+   }
+   bool progress = false;
+   NIR_PASS(progress, s, nir_shader_instructions_pass, mediump_seed_instr,
+            nir_metadata_control_flow, &m);
+   _mesa_set_destroy(m.coord, NULL);
+   bool p = true;
+   for (unsigned round = 0; p && round < 64; round++) {
+      p = false;
+      NIR_PASS(p, s, nir_shader_alu_pass, demote_instr,
+               nir_metadata_control_flow, NULL);
+      progress |= p;
+   }
+   NIR_PASS(progress, s, nir_opt_constant_folding);
+   NIR_PASS(progress, s, nir_opt_dce);
+   return progress;
+}
+
+/* A 16-bit min / max / saturate of values that are f32 underneath (an f2f16,
+ * or a dot product, which has no F16 form and is computed in f32): done in
+ * f32 and rounded once. Rounding commutes with them, so the result is the
+ * same, one conversion fewer (max(dot(n, l), 0.0)). */
+static nir_def *
+f32_of(nir_builder *b, nir_alu_instr *alu, unsigned j)
+{
+   unsigned nc = alu->def.num_components;
+   nir_alu_instr *p = alu_of(alu->src[j].src);
+   if (nir_src_is_const(alu->src[j].src))
+      return nir_f2f32(b, nir_ssa_for_alu_src(b, alu, j));
+   if (!p || !list_is_singular(&p->def.uses))
+      return NULL;
+   if ((p->op == nir_op_f2f16 || p->op == nir_op_f2fmp) &&
+       nir_src_bit_size(p->src[0].src) == 32) {
+      unsigned swz[NIR_MAX_VEC_COMPONENTS];
+      for (unsigned k = 0; k < nc; k++)
+         swz[k] = p->src[0].swizzle[alu->src[j].swizzle[k]];
+      return nir_swizzle(b, p->src[0].src.ssa, swz, nc);
+   }
+   if ((p->op == nir_op_fdot2 || p->op == nir_op_fdot3 ||
+        p->op == nir_op_fdot4) &&
+       nc == 1) {
+      nir_def *a = nir_f2f32(b, nir_ssa_for_alu_src(b, p, 0));
+      nir_def *c = nir_f2f32(b, nir_ssa_for_alu_src(b, p, 1));
+      return nir_build_alu2(b, p->op, a, c);
+   }
+   return NULL;
+}
+
+static bool
+minmax32_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   if ((alu->op != nir_op_fmin && alu->op != nir_op_fmax &&
+        alu->op != nir_op_fsat) ||
+       alu->def.bit_size != 16)
+      return false;
+   unsigned n = nir_op_infos[alu->op].num_inputs;
+   bool any = false;
+   for (unsigned j = 0; j < n; j++) {
+      nir_alu_instr *p = alu_of(alu->src[j].src);
+      any |= p && !nir_src_is_const(alu->src[j].src);
+   }
+   if (!any)
+      return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *x[2] = {NULL, NULL};
+   for (unsigned j = 0; j < n; j++) {
+      /* (checked before anything is built) */
+      nir_alu_instr *p = alu_of(alu->src[j].src);
+      if (!nir_src_is_const(alu->src[j].src) &&
+          !(p && list_is_singular(&p->def.uses) &&
+            (((p->op == nir_op_f2f16 || p->op == nir_op_f2fmp) &&
+              nir_src_bit_size(p->src[0].src) == 32) ||
+             ((p->op == nir_op_fdot2 || p->op == nir_op_fdot3 ||
+               p->op == nir_op_fdot4) &&
+              alu->def.num_components == 1))))
+         return false;
+   }
+   for (unsigned j = 0; j < n; j++)
+      x[j] = f32_of(b, alu, j);
+   nir_def *r = n == 1 ? nir_build_alu1(b, alu->op, x[0])
+                       : nir_build_alu2(b, alu->op, x[0], x[1]);
+   nir_def_replace(&alu->def, nir_f2f16(b, r));
+   return true;
+}
+
+/* ------------------------------------------------------------------------
+ * float16 (mediump, from Mesa's precision lowering): comparisons of 16-bit
+ * values become comparisons of their f2f32 (the backend reads the F16
+ * halves directly as format-select operands), so booleans stay 32-bit */
+static bool
+widen_cmp16_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   /* (float compares only: an integer one is widened as an integer, by
+    * int16_to_32) */
+   if (!nir_alu_instr_is_comparison(alu) ||
+       nir_src_bit_size(alu->src[0].src) != 16 ||
+       nir_alu_type_get_base_type(nir_op_infos[alu->op].input_types[0]) !=
+          nir_type_float)
+      return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   for (unsigned i = 0; i < nir_op_infos[alu->op].num_inputs; i++) {
+      nir_def *w = nir_f2f32(b, nir_ssa_for_alu_src(b, alu, i));
+      nir_src_rewrite(&alu->src[i].src, w);
+      for (unsigned c = 0; c < NIR_MAX_VEC_COMPONENTS; c++)
+         alu->src[i].swizzle[c] = c < w->num_components ? c : 0;
+   }
+   return true;
+}
+
+/* 16-bit integer ALU (mediump ints) back to 32-bit: GLES2 ints become floats */
+static unsigned
+int16_to_32(const nir_instr *instr, void *data)
+{
+   if (instr->type == nir_instr_type_phi) {
+      /* a 16-bit integer phi (a mediump loop counter): an integer op feeds
+       * it */
+      nir_phi_instr *phi = nir_instr_as_phi((nir_instr *)instr);
+      if (phi->def.bit_size != 16)
+         return 0;
+      nir_foreach_phi_src (src, phi) {
+         nir_alu_instr *p = nir_def_as_alu_or_null(src->src.ssa);
+         if (p && p->op != nir_op_mov && !nir_op_is_vec(p->op) &&
+             p->op != nir_op_bcsel) {
+            nir_alu_type t =
+               nir_alu_type_get_base_type(nir_op_infos[p->op].output_type);
+            if (t == nir_type_int || t == nir_type_uint)
+               return 32;
+         }
+      }
+      return 0;
+   }
+   if (instr->type != nir_instr_type_alu)
+      return 0;
+   const nir_alu_instr *alu = nir_instr_as_alu(instr);
+   const nir_op_info *info = &nir_op_infos[alu->op];
+   /* moves, vectors and selects carry data of any type; a conversion from
+    * or to 32 bits (f2i16 of an f32) changes the size itself */
+   if (alu->op == nir_op_mov || nir_op_is_vec(alu->op) ||
+       alu->op == nir_op_bcsel)
+      return 0;
+   for (unsigned i = 0; i < info->num_inputs; i++)
+      if (!nir_alu_type_get_type_size(info->input_types[i]) &&
+          nir_src_bit_size(alu->src[i].src) >= 32)
+         return 0;
+   bool int16 = alu->def.bit_size == 16 &&
+                nir_alu_type_get_base_type(info->output_type) != nir_type_float;
+   for (unsigned i = 0; i < info->num_inputs; i++)
+      int16 |=
+         nir_src_bit_size(alu->src[i].src) == 16 &&
+         nir_alu_type_get_base_type(info->input_types[i]) != nir_type_float;
+   return int16 ? 32 : 0;
+}
+
+static bool
+vec_cmp_instr(const nir_instr *instr, const void *data)
+{
+   if (instr->type != nir_instr_type_alu)
+      return false;
+   switch (nir_instr_as_alu(instr)->op) {
+   case nir_op_ball_fequal2:
+   case nir_op_ball_fequal3:
+   case nir_op_ball_fequal4:
+   case nir_op_ball_iequal2:
+   case nir_op_ball_iequal3:
+   case nir_op_ball_iequal4:
+   case nir_op_bany_fnequal2:
+   case nir_op_bany_fnequal3:
+   case nir_op_bany_fnequal4:
+   case nir_op_bany_inequal2:
+   case nir_op_bany_inequal3:
+   case nir_op_bany_inequal4:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+vec_to_regs_32(const nir_instr *instr, unsigned wrmask, const void *data)
+{
+   return nir_instr_as_alu(instr)->def.bit_size == 32;
+}
+
+/* ------------------------------------------------------------------------
+ * uniforms -> load_uniform with base = the constant number of the first
+ * component. Each deref step adds vec4-aligned offsets (array elements,
+ * struct members, matrix columns), unless the caller numbered that member
+ * itself (sgx_compile_options.layout can pin a struct's members one by
+ * one). */
+
+static unsigned
+slots4(const struct glsl_type *t)
+{
+   return 4 * glsl_count_vec4_slots(t, false, false);
+}
+
+struct unif_ctx {
+   struct sgx_ctx *c;
+   bool failed;
+};
+
+static bool
+lower_uniform_instr(nir_builder *b, nir_intrinsic_instr *in, void *data)
+{
+   struct unif_ctx *u = data;
+   if (in->intrinsic != nir_intrinsic_load_deref)
+      return false;
+   nir_deref_instr *d = nir_src_as_deref(in->src[0]);
+   if (!nir_deref_mode_is(d, nir_var_uniform))
+      return false;
+   nir_deref_path path;
+   nir_deref_path_init(&path, d, NULL);
+   nir_variable *var = path.path[0]->var;
+   if (glsl_type_is_sampler(glsl_without_array(var->type))) {
+      nir_deref_path_finish(&path);
+      return false;
+   }
+   char name[256];
+   snprintf(name, sizeof name, "%s", var->name);
+   unsigned k = var->data.driver_location;
+   nir_def *dyn = NULL; /* a dynamic offset in components (one level) */
+   unsigned dyn_range = 0;
+   b->cursor = nir_before_instr(&in->instr);
+   unsigned prec = var->data.precision;
+   const struct glsl_type *t = var->type;
+   for (unsigned i = 1; path.path[i]; i++) {
+      nir_deref_instr *p = path.path[i];
+      if (p->deref_type == nir_deref_type_struct) {
+         prec = glsl_get_struct_field_data(t, p->strct.index)->precision;
+         for (unsigned f = 0; f < p->strct.index; f++)
+            k += slots4(glsl_get_struct_field(t, f));
+         size_t l = strlen(name);
+         snprintf(name + l, sizeof name - l, ".%s",
+                  glsl_get_struct_elem_name(t, p->strct.index));
+         int pinned = place(u->c->opts, SGX_LAYOUT_UNIFORM, name);
+         if (pinned >= 0)
+            k = pinned;
+         t = glsl_get_struct_field(t, p->strct.index);
+      } else if (p->deref_type == nir_deref_type_array &&
+                 nir_src_is_const(p->arr.index)) {
+         const struct glsl_type *e = glsl_type_is_matrix(t)
+                                        ? glsl_get_column_type(t)
+                                        : glsl_get_array_element(t);
+         k += nir_src_as_uint(p->arr.index) * slots4(e);
+         size_t l = strlen(name);
+         snprintf(name + l, sizeof name - l, "[%u]",
+                  (unsigned)nir_src_as_uint(p->arr.index));
+         int pinned = place(u->c->opts, SGX_LAYOUT_UNIFORM, name);
+         if (pinned >= 0)
+            k = pinned;
+         t = e;
+      } else if (p->deref_type == nir_deref_type_array && !dyn) {
+         /* a[i]: the offset is computed at run time; the whole array is
+          * laid out (f32, contiguous) and read through an index register */
+         const struct glsl_type *e = glsl_type_is_matrix(t)
+                                        ? glsl_get_column_type(t)
+                                        : glsl_get_array_element(t);
+         unsigned len = glsl_type_is_matrix(t) ? glsl_get_matrix_columns(t)
+                                               : glsl_get_length(t);
+         nir_def *i = nir_u2u32(b, p->arr.index.ssa);
+         dyn = nir_imul_imm(b, i, slots4(e));
+         dyn_range = len * slots4(e);
+         t = e;
+      } else {
+         u->failed = true;
+         nir_deref_path_finish(&path);
+         return false;
+      }
+   }
+   nir_deref_path_finish(&path);
+   if (dyn) {
+      unsigned n = in->def.num_components;
+      for (unsigned j = 0; j < dyn_range && k + j < ARRAY_SIZE(u->c->const_fmt);
+           j++)
+         u->c->const_fmt[k + j] = 1;
+      nir_def *v =
+         nir_load_uniform(b, n, 32, dyn, .base = k, .range = dyn_range,
+                          .dest_type = nir_type_float32);
+      if (in->def.bit_size == 16)
+         v = nir_f2f16(b, v);
+      nir_def_replace(&in->def, v);
+      return true;
+   }
+   /* the constants' format in SA: F16 pairs for
+    * mediump (16-bit loads), C10 for lowp vectors used as F16, else f32 */
+   unsigned n = in->def.num_components, fmt = in->def.bit_size == 16 ? 2 : 1;
+   if (u->c->opts->verbose)
+      fprintf(stderr, "uniform %s: constant %u, %u x %u bits, precision %u\n",
+              name, k, n, in->def.bit_size, prec);
+   if (fmt == 1 && u->c->p16 && prec == GLSL_PRECISION_LOW && !(k & 3) &&
+       !u->c->opts->driver_consts) {
+      /* every use an f2f16, and what those are read for at most xyz */
+      bool all16 = true;
+      unsigned read = 0;
+      nir_foreach_use_including_if (use, &in->def) {
+         nir_instr *ui = nir_src_is_if(use) ? NULL : nir_src_use_instr(use);
+         if (!ui || ui->type != nir_instr_type_alu ||
+             (nir_instr_as_alu(ui)->op != nir_op_f2f16 &&
+              nir_instr_as_alu(ui)->op != nir_op_f2fmp)) {
+            all16 = false;
+            break;
+         }
+         nir_alu_instr *cv = nir_instr_as_alu(ui);
+         unsigned r16 = nir_def_components_read(&cv->def);
+         for (unsigned j = 0; j < cv->def.num_components; j++)
+            if (r16 >> j & 1)
+               read |= 1u << cv->src[0].swizzle[j];
+      }
+      if (all16 && !(read & ~7u))
+         fmt = 3;
+   }
+   if (fmt == 2 && u->c->p16 && prec == GLSL_PRECISION_LOW && !(k & 3) &&
+       n >= 3 && !(nir_def_components_read(&in->def) & ~7u)) {
+      /* a lowp vector loaded 16-bit (a frontend that lowers precision) and
+       * read for xyz: C10 as loaded, then to F16 where read; or with
+       * driver_consts the F16 of its C10 value from the upload */
+      fmt = u->c->opts->driver_consts ? 5 : 3;
+   }
+   for (unsigned j = 0; j < n && k + j < ARRAY_SIZE(u->c->const_fmt); j++)
+      u->c->const_fmt[k + j] = fmt == 3 && j == 3   ? 1
+                               : fmt == 5 && j == 3 ? 2
+                                                    : fmt;
+   for (unsigned j = 0; j < n && k + j < ARRAY_SIZE(u->c->const_prec); j++)
+      u->c->const_prec[k + j] = prec;
+   if (fmt == 2 && prec == GLSL_PRECISION_LOW && n == 4 && !(k & 3) &&
+       k + 3 < ARRAY_SIZE(u->c->const_lowp))
+      u->c->const_lowp[k] = 1;
+   /* (a bool is a 32-bit value, true when nonzero) */
+   unsigned bits = in->def.bit_size == 1 ? 32 : in->def.bit_size;
+   nir_def *v = nir_load_uniform(
+      b, n, bits, nir_imm_int(b, 0), .base = k, .range = n,
+      .dest_type = bits == 16 ? nir_type_float16 : nir_type_float32);
+   if (in->def.bit_size == 1)
+      v = nir_ine_imm(b, v, 0);
+   nir_def_replace(&in->def, v);
+   return true;
+}
+
+static bool
+lower_uniforms(nir_shader *s, struct sgx_ctx *c)
+{
+   struct unif_ctx u = {c, false};
+   bool p = nir_shader_intrinsics_pass(s, lower_uniform_instr,
+                                       nir_metadata_control_flow, &u);
+   if (u.failed)
+      sgx_fail(c, "indirectly indexed uniform (not supported yet)");
+   return p;
+}
+
+/* the precision of the uniform component at comp, from the variables (for a
+ * driver that hands over load_uniform already lowered; assign_uniforms has
+ * numbered them in components, the numbering such a driver's loads use) */
+static unsigned
+type_prec_at(const struct glsl_type *t, unsigned prec, unsigned comp)
+{
+   if (glsl_type_is_struct(t)) {
+      for (unsigned f = 0; f < glsl_get_length(t); f++) {
+         const struct glsl_type *ft = glsl_get_struct_field(t, f);
+         unsigned n = 4 * glsl_count_vec4_slots(ft, false, false);
+         if (comp < n) {
+            unsigned fp = glsl_get_struct_field_data(t, f)->precision;
+            return type_prec_at(ft, fp ? fp : prec, comp);
+         }
+         comp -= n;
+      }
+      return 0;
+   }
+   if (glsl_type_is_array(t)) {
+      const struct glsl_type *e = glsl_get_array_element(t);
+      unsigned n = 4 * glsl_count_vec4_slots(e, false, false);
+      return n ? type_prec_at(e, prec, comp % n) : 0;
+   }
+   return prec;
+}
+
+static unsigned
+uniform_prec(struct sgx_ctx *c, unsigned k)
+{
+   if (c->opts->fs_mediump && c->nir->info.stage == MESA_SHADER_FRAGMENT)
+      return GLSL_PRECISION_MEDIUM;
+   if (k < ARRAY_SIZE(c->const_prec) && c->const_prec[k])
+      return c->const_prec[k];
+   nir_foreach_variable_with_modes (var, c->nir, nir_var_uniform) {
+      if (glsl_type_is_sampler(glsl_without_array(var->type)))
+         continue;
+      unsigned base = var->data.driver_location,
+               n = 4 * glsl_count_vec4_slots(var->type, false, false);
+      if (k >= base && k < base + n)
+         return type_prec_at(var->type, var->data.precision, k - base);
+   }
+   return 0;
+}
+
+/* f32 uniforms that F16 math reads (every use an f2f16), in the format the
+ * driver loads such a constant in: mediump as F16 constants (list C kind 2,
+ * rounded at upload), a lowp vector's xyz as C10 (kind 3), highp left f32
+ * (converted where read with pck.f16.f32, which truncates). A frontend
+ * that lowers precision loads mediump uniforms 16-bit already; the gallium
+ * driver's arrive as f32 load_uniform. */
+static bool
+uniform_format_instr(nir_builder *b, nir_intrinsic_instr *in, void *data)
+{
+   struct sgx_ctx *c = data;
+   bool no_const = sgx_debug(c, SGX_DBG_NO_F16_CONST);
+   if (in->intrinsic == nir_intrinsic_load_uniform && in->def.bit_size == 16 &&
+       no_const) {
+      /* (nof16const: an f32 load converted in the shader) */
+      b->cursor = nir_before_instr(&in->instr);
+      nir_def *v = nir_load_uniform(
+         b, in->def.num_components, 32, in->src[0].ssa,
+         .base = nir_intrinsic_base(in), .range = nir_intrinsic_range(in),
+         .dest_type = nir_type_float32);
+      unsigned k = nir_intrinsic_base(in);
+      unsigned range = nir_src_is_const(in->src[0]) ? in->def.num_components
+                                                    : nir_intrinsic_range(in);
+      for (unsigned j = 0; j < range && k + j < ARRAY_SIZE(c->const_fmt); j++)
+         c->const_fmt[k + j] = 1;
+      nir_def_replace(&in->def, nir_f2f16(b, v));
+      return true;
+   }
+   if (in->intrinsic == nir_intrinsic_load_uniform && in->def.bit_size == 16) {
+      /* a 16-bit load the frontend made (a driver with 16-bit loads):
+       * F16 constants */
+      unsigned k = nir_intrinsic_base(in);
+      unsigned range = nir_src_is_const(in->src[0]) ? in->def.num_components
+                                                    : nir_intrinsic_range(in);
+      for (unsigned j = 0; j < range && k + j < ARRAY_SIZE(c->const_fmt); j++)
+         if (!c->const_fmt[k + j])
+            c->const_fmt[k + j] = 2;
+      return false;
+   }
+   if (no_const || in->intrinsic != nir_intrinsic_load_uniform ||
+       in->def.bit_size != 32 || !nir_src_is_const(in->src[0]) ||
+       nir_src_as_uint(in->src[0]) != 0 ||
+       nir_alu_type_get_base_type(nir_intrinsic_dest_type(in)) !=
+          nir_type_float)
+      return false;
+   unsigned k = nir_intrinsic_base(in), n = in->def.num_components;
+   if (k + n > ARRAY_SIZE(c->const_fmt))
+      return false;
+   bool ok = true;
+   unsigned read = 0;
+   for (unsigned j = 0; j < n; j++)
+      ok &= c->const_fmt[k + j] <= 1;
+   nir_foreach_use_including_if (use, &in->def) {
+      nir_instr *u = nir_src_is_if(use) ? NULL : nir_src_use_instr(use);
+      if (!u || u->type != nir_instr_type_alu ||
+          (nir_instr_as_alu(u)->op != nir_op_f2f16 &&
+           nir_instr_as_alu(u)->op != nir_op_f2fmp)) {
+         ok = false;
+         break;
+      }
+      nir_alu_instr *cv = nir_instr_as_alu(u);
+      unsigned r16 = nir_def_components_read(&cv->def);
+      for (unsigned j = 0; j < cv->def.num_components; j++)
+         if (r16 >> j & 1)
+            read |= 1u << cv->src[0].swizzle[j];
+   }
+   if (!ok)
+      return false;
+   unsigned prec = uniform_prec(c, k);
+   bool c10 = prec == GLSL_PRECISION_LOW && !(k & 3) && !(read & ~7u);
+   if (c10 && !c->opts->driver_consts) {
+      for (unsigned j = 0; j < n; j++)
+         c->const_fmt[k + j] = j == 3 ? 1 : 3;
+      return false;
+   }
+   if (prec != GLSL_PRECISION_MEDIUM && prec != GLSL_PRECISION_LOW)
+      return false;
+   /* F16 constants; a C10 vector's xyz as the F16 of its C10 value (the
+    * driver converts at upload) */
+   b->cursor = nir_after_instr(&in->instr);
+   nir_def *h = nir_load_uniform(b, n, 16, in->src[0].ssa, .base = k,
+                                 .range = n, .dest_type = nir_type_float16);
+   nir_foreach_use_safe (use, &in->def) {
+      nir_alu_instr *cv = nir_instr_as_alu(nir_src_use_instr(use));
+      b->cursor = nir_before_instr(&cv->instr);
+      unsigned swz[NIR_MAX_VEC_COMPONENTS];
+      for (unsigned j = 0; j < cv->def.num_components; j++)
+         swz[j] = cv->src[0].swizzle[j];
+      nir_def_rewrite_uses(&cv->def,
+                           nir_swizzle(b, h, swz, cv->def.num_components));
+   }
+   for (unsigned j = 0; j < n; j++)
+      c->const_fmt[k + j] = c10 && j < 3 ? 5 : 2;
+   /* a whole lowp vec4: a C10 expression may read it (find_c10) */
+   if (prec == GLSL_PRECISION_LOW && n == 4 && !(k & 3))
+      c->const_lowp[k] = 1;
+   return true;
+}
+
+static bool
+uniform_formats(nir_shader *s, struct sgx_ctx *c)
+{
+   return nir_shader_intrinsics_pass(s, uniform_format_instr,
+                                     nir_metadata_control_flow, c);
+}
+
+/* ------------------------------------------------------------------------ */
+
+static unsigned
+type_size_vec4(const struct glsl_type *type, bool bindless)
+{
+   return glsl_count_vec4_slots(type, false, bindless);
+}
+
+/* uniforms: offsets in components, every vec4 slot 4 components */
+static unsigned
+type_size_comps(const struct glsl_type *type, bool bindless)
+{
+   return 4 * glsl_count_vec4_slots(type, false, bindless);
+}
+
+/* the caller's layout (sgx_compile_options.layout), if it has one */
+static int
+place(const struct sgx_compile_options *o, enum sgx_layout_kind k,
+      const char *name)
+{
+   return o->layout && o->layout->place
+             ? o->layout->place(o->layout->data, k, name)
+             : -1;
+}
+
+static unsigned
+first_free(const struct sgx_compile_options *o, enum sgx_layout_kind k)
+{
+   return o->layout && o->layout->first_free
+             ? o->layout->first_free(o->layout->data, k)
+             : 0;
+}
+
+/* A loop that can leave early (a break besides its trip count, or one the
+ * frontend merged into it, so the trip count isn't exact) stays a loop:
+ * unrolled, its exits become a select tree that holds every
+ * iteration's value to the end (eight vec4 sums with a break: 31 temporaries,
+ * 4 as a loop). Loops that index arrays are still unrolled. */
+static bool
+keep_early_exit_loops_cf(struct exec_list *list)
+{
+   bool progress = false;
+   foreach_list_typed (nir_cf_node, node, node, list) {
+      switch (node->type) {
+      case nir_cf_node_if: {
+         nir_if *nif = nir_cf_node_as_if(node);
+         progress |= keep_early_exit_loops_cf(&nif->then_list);
+         progress |= keep_early_exit_loops_cf(&nif->else_list);
+         break;
+      }
+      case nir_cf_node_loop: {
+         nir_loop *loop = nir_cf_node_as_loop(node);
+         progress |= keep_early_exit_loops_cf(&loop->body);
+         if (loop->control == nir_loop_control_none && loop->info &&
+             !loop->info->force_unroll &&
+             (list_length(&loop->info->loop_terminator_list) > 1 ||
+              !loop->info->exact_trip_count_known)) {
+            loop->control = nir_loop_control_dont_unroll;
+            progress = true;
+         }
+         break;
+      }
+      default:
+         break;
+      }
+   }
+   return progress;
+}
+
+static bool
+keep_early_exit_loops(nir_shader *s)
+{
+   bool progress = false;
+   nir_foreach_function_impl (impl, s) {
+      nir_metadata_require(impl, nir_metadata_loop_analysis,
+                           s->options->force_indirect_unrolling,
+                           (int)s->options->force_indirect_unrolling_sampler);
+      progress |= keep_early_exit_loops_cf(&impl->body);
+      nir_progress(true, impl, nir_metadata_all);
+   }
+   return progress;
+}
+
+/* An if on a uniform condition takes one way for every instance of a draw:
+ * a branch over the side not taken costs a test and a br, where flattening
+ * computes both sides on every pixel (glamor's composite programs branch on
+ * their repeat-mode uniforms: 100-200 instructions as selects). So such ifs,
+ * with more than a few instructions inside, stay branches. */
+static unsigned
+cf_size(struct exec_list *list)
+{
+   unsigned n = 0;
+   foreach_list_typed (nir_cf_node, node, node, list) {
+      switch (node->type) {
+      case nir_cf_node_block:
+         nir_foreach_instr (i, nir_cf_node_as_block(node))
+            n++;
+         break;
+      case nir_cf_node_if: {
+         nir_if *f = nir_cf_node_as_if(node);
+         n += 1 + cf_size(&f->then_list) + cf_size(&f->else_list);
+         break;
+      }
+      case nir_cf_node_loop:
+         n += 16 * cf_size(&nir_cf_node_as_loop(node)->body);
+         break;
+      default:
+         break;
+      }
+   }
+   return n;
+}
+
+static bool
+keep_uniform_ifs_cf(struct exec_list *list)
+{
+   bool progress = false;
+   foreach_list_typed (nir_cf_node, node, node, list) {
+      if (node->type == nir_cf_node_if) {
+         nir_if *f = nir_cf_node_as_if(node);
+         if (!nir_src_is_divergent(&f->condition) &&
+             f->control == nir_selection_control_none &&
+             cf_size(&f->then_list) + cf_size(&f->else_list) > 4) {
+            f->control = nir_selection_control_dont_flatten;
+            progress = true;
+         }
+         progress |= keep_uniform_ifs_cf(&f->then_list);
+         progress |= keep_uniform_ifs_cf(&f->else_list);
+      } else if (node->type == nir_cf_node_loop) {
+         progress |= keep_uniform_ifs_cf(&nir_cf_node_as_loop(node)->body);
+      }
+   }
+   return progress;
+}
+
+static bool
+keep_uniform_ifs(nir_shader *s)
+{
+   bool progress = false;
+   nir_divergence_analysis(s);
+   nir_foreach_function_impl (impl, s) {
+      bool p = keep_uniform_ifs_cf(&impl->body);
+      nir_progress(p, impl, nir_metadata_all);
+      progress |= p;
+   }
+   return progress;
+}
+
+/* A derivative of a value that is the same for every pixel (a uniform, or
+ * math over uniforms and constants) is 0: no fds on it */
+static bool
+uniform_derivative_instr(nir_builder *b, nir_intrinsic_instr *in, void *data)
+{
+   switch (in->intrinsic) {
+   case nir_intrinsic_ddx:
+   case nir_intrinsic_ddx_fine:
+   case nir_intrinsic_ddx_coarse:
+   case nir_intrinsic_ddy:
+   case nir_intrinsic_ddy_fine:
+   case nir_intrinsic_ddy_coarse:
+      break;
+   default:
+      return false;
+   }
+   if (nir_src_is_divergent(&in->src[0]))
+      return false;
+   b->cursor = nir_before_instr(&in->instr);
+   nir_def_replace(&in->def,
+                   nir_imm_zero(b, in->def.num_components, in->def.bit_size));
+   return true;
+}
+
+static bool
+uniform_derivatives(nir_shader *s)
+{
+   if (s->info.stage != MESA_SHADER_FRAGMENT)
+      return false;
+   nir_divergence_analysis(s);
+   return nir_shader_intrinsics_pass(s, uniform_derivative_instr,
+                                     nir_metadata_control_flow, NULL);
+}
+
+static void
+optimize(nir_shader *s)
+{
+   bool progress;
+   do {
+      progress = false;
+      NIR_PASS(progress, s, nir_lower_vars_to_ssa);
+      NIR_PASS(progress, s, nir_opt_copy_prop_vars);
+      NIR_PASS(progress, s, nir_opt_dead_write_vars);
+      NIR_PASS(progress, s, nir_opt_copy_prop);
+      NIR_PASS(progress, s, nir_opt_remove_phis);
+      NIR_PASS(progress, s, nir_opt_dce);
+      NIR_PASS(progress, s, nir_opt_dead_cf);
+      NIR_PASS(progress, s, nir_opt_cse);
+      /* components nothing reads (mat4 * v of which only .z is used); not a
+       * load's leading ones: their offset would be added in bytes, ours count
+       * components */
+      NIR_PASS(progress, s, nir_opt_shrink_vectors, false);
+      NIR_PASS(progress, s, nir_opt_peephole_select,
+               &(nir_opt_peephole_select_options){.limit = 200,
+                                                  .indirect_load_ok = true,
+                                                  .expensive_alu_ok = true,
+                                                  .discard_ok = true});
+      NIR_PASS(progress, s, nir_opt_algebraic);
+      NIR_PASS(progress, s, nir_opt_constant_folding);
+      NIR_PASS(progress, s, nir_opt_undef);
+      NIR_PASS(progress, s, nir_opt_loop_unroll);
+      NIR_PASS(progress, s, nir_opt_if, nir_opt_if_optimize_phi_true_false);
+   } while (progress);
+}
+
+static void
+optimize_late(nir_shader *s)
+{
+   bool progress;
+   do {
+      progress = false;
+      NIR_PASS(progress, s, nir_opt_algebraic_late);
+      if (progress) {
+         NIR_PASS(_, s, nir_opt_constant_folding);
+         NIR_PASS(_, s, nir_opt_copy_prop);
+         NIR_PASS(_, s, nir_opt_dce);
+         NIR_PASS(_, s, nir_opt_cse);
+      }
+   } while (progress);
+}
+
+/* the varyings a (possibly linker-packed) variable holds: "packed:a,b" */
+static unsigned
+var_names(nir_variable *var, char names[][64], unsigned max)
+{
+   const char *n = var->name;
+   unsigned k = 0;
+   if (!strncmp(n, "packed:", 7))
+      n += 7;
+   while (*n && k < max) {
+      const char *e = strchr(n, ',');
+      size_t len = e ? (size_t)(e - n) : strlen(n);
+      snprintf(names[k++], 64, "%.*s", (int)MIN2(len, 63), n);
+      n += len + (e ? 1 : 0);
+   }
+   return k;
+}
+
+static const struct sgx_varying *
+find_varying(const struct sgx_varyings *v, const char *name)
+{
+   for (unsigned i = 0; i < v->n; i++)
+      if (!strcmp(v->v[i].name, name))
+         return &v->v[i];
+   return NULL;
+}
+
+/* per component of a varying variable, the register: base[set] + the
+ * varying's component in the set */
+static void
+map_varying(int *tab, nir_variable *var, const struct sgx_varyings *vary,
+            const int *set_base)
+{
+   char names[8][64];
+   unsigned n = var_names(var, names, 8);
+   unsigned comp = var->data.location_frac;
+   for (unsigned i = 0; i < n; i++) {
+      const struct sgx_varying *vy = find_varying(vary, names[i]);
+      if (!vy)
+         continue;
+      for (unsigned r = 0; r < vy->rows; r++) {
+         if (vy->set + r >= SGX_MAX_SETS || set_base[vy->set + r] < 0)
+            continue;
+         for (unsigned j = 0; j < vy->comps && comp + j < 4; j++) {
+            unsigned at = (var->data.location + r) * 4 + comp + j;
+            if (at < 512)
+               tab[at] = set_base[vy->set + r] + vy->comp + j;
+         }
+      }
+      comp += vy->rows == 1 ? vy->comps : 0;
+   }
+}
+
+/* Assign I/O registers (c->in_reg / c->out_reg, per component). */
+static void
+assign_io(struct sgx_ctx *c)
+{
+   nir_shader *s = c->nir;
+   const struct sgx_compile_options *o = c->opts;
+
+   for (unsigned i = 0; i < 512; i++)
+      c->in_reg[i] = c->out_reg[i] = -1;
+   if (s->info.stage == MESA_SHADER_VERTEX) {
+      unsigned next_attr = first_free(o, SGX_LAYOUT_ATTRIB);
+      nir_foreach_shader_in_variable (var, s) {
+         int a = place(o, SGX_LAYOUT_ATTRIB, var->name);
+         unsigned rows = type_size_vec4(var->type, false);
+         /* st splits a matrix attribute into one variable per column, all
+          * with the matrix's name: a column goes after the earlier ones */
+         if (a >= 0 && var->name) {
+            nir_foreach_shader_in_variable (prev, s) {
+               if (prev == var)
+                  break;
+               if (prev->name && !strcmp(prev->name, var->name))
+                  a += type_size_vec4(prev->type, false);
+            }
+         }
+         if (a < 0) {
+            a = next_attr;
+            next_attr += rows;
+         }
+         for (unsigned r = 0; r < rows; r++)
+            for (unsigned j = 0; j < 4; j++)
+               if ((var->data.location + r) * 4 + j < 512)
+                  c->in_reg[(var->data.location + r) * 4 + j] = 4 * (a + r) + j;
+      }
+      /* outputs: o0-o3 position, then the sets, then the point size */
+      int obase[SGX_MAX_SETS];
+      unsigned k = 4;
+      for (unsigned i = 0; i < SGX_MAX_SETS; i++) {
+         obase[i] = c->vary->set_comps[i] ? (int)k : -1;
+         k += c->vary->set_comps[i];
+      }
+      c->psize_reg = k;
+      c->n_out_regs = k + (c->vary->point_size ? 1 : 0);
+      for (unsigned j = 0; j < 4; j++)
+         c->out_reg[VARYING_SLOT_POS * 4 + j] = j;
+      if (c->vary->point_size)
+         c->out_reg[VARYING_SLOT_PSIZ * 4] = c->psize_reg;
+      /* the clip distances (nir_lower_clip_vs: planes 0..n-1, a disabled one
+       * below the last 0.0) after everything else, one o register each */
+      unsigned nclip = 0;
+      nir_foreach_shader_out_variable (var, s) {
+         if (var->data.location == VARYING_SLOT_CLIP_DIST0 ||
+             var->data.location == VARYING_SLOT_CLIP_DIST1) {
+            const struct glsl_type *e = glsl_without_array(var->type);
+            unsigned n = glsl_get_aoa_size(var->type);
+            n = (n ? n : 1) * glsl_get_vector_elements(e);
+            nclip =
+               MAX2(nclip,
+                    MIN2((var->data.location - VARYING_SLOT_CLIP_DIST0) * 4 + n,
+                         8u));
+         }
+      }
+      if (s->info.clip_distance_array_size)
+         nclip = MIN2(nclip, s->info.clip_distance_array_size);
+      c->n_clip = nclip;
+      c->clip_o = c->n_out_regs;
+      for (unsigned p = 0; p < nclip; p++)
+         c->out_reg[VARYING_SLOT_CLIP_DIST0 * 4 + p] = c->clip_o + p;
+      c->n_out_regs += nclip;
+      nir_foreach_shader_out_variable (var, s)
+         if (var->data.location >= VARYING_SLOT_VAR0)
+            map_varying(c->out_reg, var, c->vary, obase);
+   } else {
+      /* in F16 mode, a varying every load of which is mediump is iterated as
+       * F16 (list A format 2: two components per register) */
+      bool hp[128] = {0}, mp[128] = {0};
+      nir_foreach_function_impl (impl, s) {
+         nir_foreach_block (b, impl) {
+            nir_foreach_instr (instr, b) {
+               /* (lowered inputs are interpolated loads; the gallium
+                * driver's are still derefs here, before nir_lower_io: their
+                * variable's precision says) */
+               if (instr->type == nir_instr_type_intrinsic &&
+                   nir_instr_as_intrinsic(instr)->intrinsic ==
+                      nir_intrinsic_load_deref) {
+                  nir_deref_instr *d =
+                     nir_src_as_deref(nir_instr_as_intrinsic(instr)->src[0]);
+                  nir_variable *v = nir_deref_instr_get_variable(d);
+
+                  if (v && v->data.mode == nir_var_shader_in &&
+                      v->data.location >= 0 && v->data.location < 128)
+                     ((v->data.precision == GLSL_PRECISION_MEDIUM ||
+                       v->data.precision == GLSL_PRECISION_LOW)
+                         ? mp
+                         : hp)[v->data.location] = true;
+                  continue;
+               }
+               if (instr->type != nir_instr_type_intrinsic ||
+                   (nir_instr_as_intrinsic(instr)->intrinsic !=
+                       nir_intrinsic_load_interpolated_input &&
+                    nir_instr_as_intrinsic(instr)->intrinsic !=
+                       nir_intrinsic_load_input))
+                  continue;
+               nir_io_semantics sem =
+                  nir_intrinsic_io_semantics(nir_instr_as_intrinsic(instr));
+               if (sem.location < 128)
+                  (sem.medium_precision ? mp : hp)[sem.location] = true;
+            }
+         }
+      }
+      /* (a set is F16 when every varying in it is) */
+      bool set16[SGX_MAX_SETS] = {0}, not16[SGX_MAX_SETS] = {0};
+      /* (nof16iter: every varying iterated in F32, F16 math kept) */
+      if (c->p16 && !sgx_debug(c, SGX_DBG_NO_F16_ITER)) {
+         nir_foreach_shader_in_variable (var, s) {
+            char names[8][64];
+            unsigned l = var->data.location, n = var_names(var, names, 8);
+            if (l < VARYING_SLOT_VAR0 || l >= 128)
+               continue;
+            for (unsigned i = 0; i < n; i++) {
+               const struct sgx_varying *vy = find_varying(c->vary, names[i]);
+               if (!vy)
+                  continue;
+               bool ok = mp[l] && !hp[l] && n == 1 && vy->rows == 1;
+               for (unsigned r = 0; r < vy->rows && vy->set + r < SGX_MAX_SETS;
+                    r++)
+                  (ok ? set16 : not16)[vy->set + r] = true;
+            }
+         }
+         for (unsigned set = 0; set < SGX_MAX_SETS; set++)
+            set16[set] &= !not16[set];
+      }
+      /* (a set is flat when every varying in it is: the linker packs flat
+       * ones apart) */
+      bool flat[SGX_MAX_SETS] = {0}, smooth[SGX_MAX_SETS] = {0};
+      nir_foreach_shader_in_variable (var, s) {
+         char names[8][64];
+         unsigned l = var->data.location, n = var_names(var, names, 8);
+         if (l < VARYING_SLOT_VAR0 || l >= 128)
+            continue;
+         bool f = var->data.interpolation == INTERP_MODE_FLAT;
+         for (unsigned i = 0; i < n; i++) {
+            const struct sgx_varying *vy = find_varying(c->vary, names[i]);
+            if (!vy)
+               continue;
+            for (unsigned r = 0; r < vy->rows && vy->set + r < SGX_MAX_SETS;
+                 r++)
+               (f ? flat : smooth)[vy->set + r] = true;
+         }
+      }
+      /* gl_FragCoord first (list A iterator 14, F32),
+       * then the sets in order; gl_PointCoord is set 0 */
+      int pbase[SGX_MAX_SETS];
+      unsigned pa = 0;
+      bool fragcoord = false, pointcoord = false;
+      nir_foreach_shader_in_variable (var, s) {
+         fragcoord |= var->data.location == VARYING_SLOT_POS;
+         pointcoord |= var->data.location == VARYING_SLOT_PNTC;
+      }
+      if (fragcoord) {
+         struct sgx_iter *it = &c->iters[c->n_iters++];
+         it->set = SGX_ITER_FRAGCOORD - 1;
+         it->comps = 4;
+         it->pa = pa;
+         for (unsigned j = 0; j < 4; j++)
+            c->in_reg[VARYING_SLOT_POS * 4 + j] = pa + j;
+         pa += 4;
+      }
+      for (unsigned set = 0; set < SGX_MAX_SETS; set++) {
+         pbase[set] = -1;
+         if (set == 0 && pointcoord && c->vary->point_size) {
+            struct sgx_iter *it = &c->iters[c->n_iters++];
+            it->set = 0;
+            it->comps = 2;
+            it->pa = pa;
+            it->f16 = c->p16;
+            it->pointcoord = true;
+            for (unsigned j = 0; j < 2; j++)
+               c->in_reg[VARYING_SLOT_PNTC * 4 + j] =
+                  it->f16 ? (int)(SGX_IN_HALF | (2 * pa + j)) : (int)(pa + j);
+            pa += it->f16 ? 1 : 2;
+            continue;
+         }
+         /* one iteration per set, of every varying in it */
+         unsigned comps = 0;
+         for (unsigned v = 0; v < c->vary->n; v++) {
+            const struct sgx_varying *vy = &c->vary->v[v];
+            if (set >= vy->set && set < vy->set + vy->rows)
+               comps = MAX2(comps, vy->comp + vy->comps);
+         }
+         if (!comps)
+            continue;
+         struct sgx_iter *it = &c->iters[c->n_iters++];
+         it->set = set;
+         /* (the colour source: four components packed BGRA8 in one
+          * register) */
+         it->colour = c->vary->colour && set == 0;
+         it->comps = it->colour ? 4 : MIN2(comps, 4);
+         it->pa = pa;
+         it->f16 = set16[set] && !it->colour;
+         it->flat = flat[set] && !smooth[set];
+         /* F16: in_reg holds SGX_IN_HALF | the half index */
+         pbase[set] = it->colour ? (int)(SGX_IN_U8 | 4 * pa)
+                      : it->f16  ? (int)(SGX_IN_HALF | 2 * pa)
+                                 : (int)pa;
+         pa += it->colour ? 1 : it->f16 ? (it->comps + 1) / 2 : it->comps;
+      }
+      c->n_pa_inputs = pa;
+      nir_foreach_shader_in_variable (var, s)
+         if (var->data.location >= VARYING_SLOT_VAR0)
+            map_varying(c->in_reg, var, c->vary, pbase);
+   }
+
+   /* uniforms: constant numbers */
+   unsigned next = ALIGN_POT(first_free(o, SGX_LAYOUT_UNIFORM), 4);
+   nir_foreach_uniform_variable (var, s) {
+      if (glsl_type_is_sampler(glsl_without_array(var->type)))
+         continue; /* lower_tex_derefs */
+      int k = place(o, SGX_LAYOUT_UNIFORM, var->name);
+      if (k < 0) {
+         /* an array or matrix pinned element by element: its base */
+         char e0[80];
+         snprintf(e0, sizeof e0, "%s[0]", var->name);
+         k = place(o, SGX_LAYOUT_UNIFORM, e0);
+      }
+      if (k < 0) {
+         k = next;
+         next += ALIGN_POT(type_size_comps(var->type, false), 4);
+      }
+      var->data.driver_location = k;
+   }
+}
+
+/* ior source s is x & mask with a constant mask: the iand and x's index */
+static nir_alu_instr *
+masked(nir_alu_instr *ior, unsigned s, uint32_t mask, unsigned *xi)
+{
+   nir_alu_instr *a = nir_src_as_alu(ior->src[s].src);
+   if (!a || a->op != nir_op_iand)
+      return NULL;
+   for (unsigned j = 0; j < 2; j++) {
+      nir_alu_src *m = &a->src[j];
+      if (!nir_src_is_const(m->src))
+         continue;
+      bool all = true;
+      for (unsigned k = 0; k < a->def.num_components; k++)
+         all &= nir_src_comp_as_uint(m->src, m->swizzle[k]) == mask;
+      if (all) {
+         *xi = 1 - j;
+         return a;
+      }
+   }
+   return NULL;
+}
+
+/* the float x of ior source s = x & mask, in the ior's components */
+static nir_def *
+masked_x(nir_builder *b, nir_alu_instr *ior, unsigned s, nir_alu_instr *a,
+         unsigned xi)
+{
+   unsigned sw[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned k = 0; k < ior->def.num_components; k++)
+      sw[k] = a->src[xi].swizzle[ior->src[s].swizzle[k]];
+   return nir_swizzle(b, a->src[xi].src.ssa, sw, ior->def.num_components);
+}
+
+/* copysign as the GLSL frontend builds it for a driver with integers
+ * ((a & 0x7fffffff) | (b & 0x80000000), atan's result; 0x7fff / 0x8000 in
+ * mediump): the float form
+ * nir_copysign uses without them */
+static bool
+copysign_instr(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   unsigned bits = alu->def.bit_size;
+   if (alu->op != nir_op_ior || (bits != 32 && bits != 16))
+      return false;
+   uint32_t sign = 1u << (bits - 1);
+   for (unsigned s = 0; s < 2; s++) {
+      unsigned mi, si;
+      nir_alu_instr *m = masked(alu, s, sign - 1, &mi),
+                    *g = masked(alu, 1 - s, sign, &si);
+      if (!m || !g)
+         continue;
+      b->cursor = nir_before_instr(&alu->instr);
+      nir_def *abs = nir_fabs(b, masked_x(b, alu, s, m, mi));
+      nir_def *neg = nir_flt_imm(b, masked_x(b, alu, 1 - s, g, si), 0.0);
+      nir_def_replace(&alu->def, nir_bcsel(b, neg, nir_fneg(b, abs), abs));
+      return true;
+   }
+   return false;
+}
+
+/* A shift by a constant as the integer arithmetic nir_lower_int_to_float
+ * takes (GLSL before 1.30 has no shifts: they come from the front end's
+ * lowering, e.g. a division by a power of two as a shift of iabs): ishl a
+ * multiply, ushr a division, ishr a division rounded down. */
+static bool
+lower_int_shift(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   if ((alu->op != nir_op_ishl && alu->op != nir_op_ushr &&
+        alu->op != nir_op_ishr) ||
+       alu->def.bit_size != 32 || !nir_src_is_const(alu->src[1].src))
+      return false;
+   unsigned n = nir_alu_src_as_uint(alu->src[1]) & 31;
+   if (n > 23)
+      return false; /* past F32's exact integers */
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *x = nir_ssa_for_alu_src(b, alu, 0);
+   nir_def *p = nir_imm_int(b, 1 << n), *r;
+   if (alu->op == nir_op_ishl) {
+      r = nir_imul(b, x, p);
+   } else if (alu->op == nir_op_ushr) {
+      r = nir_idiv(b, x, p);
+   } else {
+      /* (x + (x < 0 ? 1 - 2^n : 0)) / 2^n, truncated: floor(x / 2^n) */
+      nir_def *adj = nir_bcsel(b, nir_ilt_imm(b, x, 0),
+                               nir_imm_int(b, 1 - (1 << n)), nir_imm_int(b, 0));
+      r = nir_idiv(b, nir_iadd(b, x, adj), p);
+   }
+   nir_def_replace(&alu->def, r);
+   return true;
+}
+
+/* an integer op nir_lower_int_to_float has no float for (it asserts) */
+static bool
+int_to_float_takes(nir_op op)
+{
+   switch (op) {
+   case nir_op_mov:
+   case nir_op_vec2:
+   case nir_op_vec3:
+   case nir_op_vec4:
+   case nir_op_bcsel:
+   case nir_op_b2i32:
+   case nir_op_i2f32:
+   case nir_op_u2f32:
+   case nir_op_f2i32:
+   case nir_op_f2u32:
+   case nir_op_iadd:
+   case nir_op_isub:
+   case nir_op_imul:
+   case nir_op_idiv:
+   case nir_op_iabs:
+   case nir_op_ineg:
+   case nir_op_imax:
+   case nir_op_imin:
+   case nir_op_umax:
+   case nir_op_umin:
+   case nir_op_i32csel_gt:
+   case nir_op_i32csel_ge:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+check_int_ops(struct sgx_ctx *c, nir_shader *s)
+{
+   nir_foreach_function_impl (impl, s) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_alu)
+               continue;
+            nir_alu_instr *alu = nir_instr_as_alu(instr);
+            nir_alu_type t = nir_op_infos[alu->op].output_type;
+            if (alu->def.bit_size == 1 || int_to_float_takes(alu->op) ||
+                (nir_alu_type_get_base_type(t) != nir_type_int &&
+                 nir_alu_type_get_base_type(t) != nir_type_uint))
+               continue;
+            sgx_fail(c, "unsupported integer op %s",
+                     nir_op_infos[alu->op].name);
+            return false;
+         }
+      }
+   }
+   return true;
+}
+
+void
+sgx_lower(struct sgx_ctx *c)
+{
+   nir_shader *s = c->nir;
+
+   /* the caller creates the shader with sgx_nir_options() */
+   assert(s->options == &options);
+   NIR_PASS(_, s, nir_shader_alu_pass, copysign_instr,
+            nir_metadata_control_flow, NULL);
+   if (c->p16 && s->info.stage == MESA_SHADER_FRAGMENT &&
+       (c->opts->fs_mediump || !sgx_debug(c, SGX_DBG_NO_MEDIUMP)))
+      NIR_PASS(_, s, lower_mediump, c->opts->fs_mediump);
+   assign_io(c);
+   NIR_PASS(_, s, nir_lower_io_vars_to_temporaries,
+            nir_shader_get_entrypoint(s), nir_var_shader_out);
+   NIR_PASS(_, s, nir_lower_global_vars_to_local);
+   NIR_PASS(_, s, nir_split_var_copies);
+   NIR_PASS(_, s, nir_lower_var_copies);
+   NIR_PASS(_, s, nir_lower_vars_to_ssa);
+   if (!sgx_debug(c, SGX_DBG_UNROLL_EXITS))
+      NIR_PASS(_, s, keep_early_exit_loops);
+   if (!sgx_debug(c, SGX_DBG_FLATTEN_UNIFORM)) {
+      NIR_PASS(_, s, nir_opt_copy_prop);
+      NIR_PASS(_, s, keep_uniform_ifs);
+   }
+   NIR_PASS(_, s, uniform_derivatives);
+   optimize(s);
+   if (s->info.stage == MESA_SHADER_FRAGMENT &&
+       nir_shader_intrinsics_pass(s, colour_sat_instr,
+                                  nir_metadata_control_flow, NULL))
+      optimize(s);
+   /* indexing of temporaries that unrolling didn't remove (a loop bounded by
+    * a uniform): if / else trees over the elements */
+   bool ind = false;
+   NIR_PASS(ind, s, nir_lower_indirect_derefs_to_if_else_trees,
+            nir_var_function_temp, UINT32_MAX);
+   if (ind) {
+      NIR_PASS(_, s, nir_lower_vars_to_ssa);
+      optimize(s);
+   }
+   /* (Mesa's GLSL linker hands over I/O already lowered: keep the
+    * variables, they name the varyings) */
+   NIR_PASS(_, s, nir_remove_dead_variables, nir_var_function_temp, NULL);
+   /* st's lowering sets flrp_lowered, which makes this a no-op: a flrp the
+    * driver adds after it (a filter in the shader) would reach the backend */
+   s->info.flrp_lowered = false;
+   NIR_PASS(_, s, nir_lower_flrp, 32, false);
+   NIR_PASS(_, s, lower_tex_derefs, c);
+   if (s->info.stage == MESA_SHADER_FRAGMENT && c->opts->tex_f32)
+      NIR_PASS(_, s, nir_shader_instructions_pass, lower_f32_texel,
+               nir_metadata_control_flow, (void *)&c->opts->tex_f32);
+   if (s->info.stage == MESA_SHADER_FRAGMENT && !c->opts->front_sa)
+      NIR_PASS(_, s, nir_shader_intrinsics_pass, front_true_instr,
+               nir_metadata_control_flow, NULL);
+
+   NIR_PASS(_, s, nir_lower_io, nir_var_shader_in | nir_var_shader_out,
+            type_size_vec4, 0);
+   NIR_PASS(_, s, lower_uniforms, c);
+   if (c->p16 && s->info.stage == MESA_SHADER_FRAGMENT) {
+      /* a mediump read of a texel: the texture's result in F16 (the
+       * finalizer's unpack, pck.f16.u8), not f32 then converted */
+      nir_opt_16bit_tex_image_options t16 = {
+         .rounding_mode = nir_rounding_mode_undef,
+         .opt_tex_dest_types = nir_type_float,
+      };
+      NIR_PASS(_, s, nir_opt_16bit_tex_image, &t16);
+      if (!sgx_debug(c, SGX_DBG_NO_NARROW16))
+         NIR_PASS(_, s, narrow16);
+      NIR_PASS(_, s, uniform_formats, c);
+   }
+   NIR_PASS(_, s, nir_opt_dce);
+   NIR_PASS(_, s, lower_sincos);
+   optimize(s);
+
+   optimize_late(s);
+
+   if (c->p16 && !sgx_debug(c, SGX_DBG_NO_MINMAX32)) {
+      NIR_PASS(_, s, nir_shader_alu_pass, minmax32_instr,
+               nir_metadata_control_flow, NULL);
+      NIR_PASS(_, s, nir_opt_dce);
+   }
+   /* all() / any() of vector compares (dEQP's isOk): scalar compares and
+    * iand / ior, which the bool lowering takes */
+   NIR_PASS(_, s, nir_lower_alu_to_scalar, vec_cmp_instr, NULL);
+   NIR_PASS(_, s, nir_shader_alu_pass, widen_cmp16_instr,
+            nir_metadata_control_flow, NULL);
+   NIR_PASS(_, s, nir_lower_bit_size, int16_to_32, NULL);
+   NIR_PASS(_, s, nir_opt_constant_folding);
+   NIR_PASS(_, s, nir_opt_dce);
+   NIR_PASS(_, s, nir_shader_alu_pass, int16_conv_instr,
+            nir_metadata_control_flow, NULL);
+   NIR_PASS(_, s, nir_shader_alu_pass, i2f16_instr, nir_metadata_control_flow,
+            NULL);
+   NIR_PASS(_, s, nir_shader_alu_pass, lower_int_shift,
+            nir_metadata_control_flow, NULL);
+   NIR_PASS(_, s, nir_opt_dce);
+   if (!check_int_ops(c, s))
+      return;
+   NIR_PASS(_, s, nir_lower_int_to_float);
+   NIR_PASS(_, s, nir_opt_copy_prop);
+   /* (a 16-bit bcsel would become fcsel, an f32-only opcode: b32csel takes
+    * any size, on the condition as a float) */
+   NIR_PASS(_, s, nir_shader_alu_pass, csel16_instr, nir_metadata_control_flow,
+            NULL);
+   NIR_PASS(_, s, nir_lower_bool_to_float, true);
+   NIR_PASS(_, s, nir_opt_copy_prop);
+   NIR_PASS(_, s, nir_opt_constant_folding);
+   NIR_PASS(_, s, nir_opt_cse);
+   NIR_PASS(_, s, nir_opt_dce);
+
+   NIR_PASS(_, s, nir_convert_from_ssa, true, false);
+   /* 16-bit vectors stay vecN: the backend packs F16 halves itself */
+   NIR_PASS(_, s, nir_lower_vec_to_regs, vec_to_regs_32, NULL);
+   NIR_PASS(_, s, nir_opt_dce);
+   NIR_PASS(_, s, nir_legacy_trivialize, true);
+   nir_index_ssa_defs(nir_shader_get_entrypoint(s));
+}
diff --git a/src/sgx/compiler/sgx_priv.h b/src/sgx/compiler/sgx_priv.h
new file mode 100644
index 0000000..7fc2139
--- /dev/null
+++ b/src/sgx/compiler/sgx_priv.h
@@ -0,0 +1,323 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * SGX545 compiler internals: the backend IR between NIR and USSE words.
+ *
+ * One sgx_ins is one USSE instruction (a form from sgx_forms.h) over up to
+ * `rpt` iterations; operands are sgx_refs that become USSE operands after
+ * register allocation. Virtual registers (vregs) are runs of consecutive
+ * temporaries, so a vector op can be one instruction with a repeat.
+ */
+#ifndef SGX_PRIV_H
+#define SGX_PRIV_H
+
+#include "util/list.h"
+#include "util/macros.h"
+#include "util/u_dynarray.h"
+
+#include "sgx_compiler.h"
+#include "sgx_forms.h"
+
+struct nir_shader;
+struct nir_def;
+
+enum sgx_file {
+   SGX_F_NONE,
+   SGX_F_V, /* vreg: n = vreg, comp = component */
+   SGX_F_R, /* physical temporary */
+   SGX_F_PA,
+   SGX_F_SA,
+   SGX_F_O,
+   SGX_F_C, /* hardware constant */
+   SGX_F_G, /* special register */
+   SGX_F_I, /* internal register */
+   SGX_F_IMM,
+   SGX_F_U,     /* uniform constant number (becomes sa after layout) */
+   SGX_F_P,     /* predicate */
+   SGX_F_USLOT, /* the absolute SA number of uniform constant n (an immediate,
+                   after layout) */
+   SGX_F_IXSA,  /* sa[idx1 + n] */
+   SGX_F_IDX,   /* index register n (destination) */
+   /* literal constant n (driver_consts: an SA slot the driver fills) */
+   SGX_F_LIT,
+};
+
+struct sgx_ref {
+   uint8_t file;
+   uint8_t comp;
+   uint8_t neg : 1, abs : 1;
+   /* steps by one per iteration (else the same every iteration) */
+   uint8_t step : 1;
+   /* an F16 half: n (comp for vregs) counts halves, 2 * reg + half */
+   uint8_t h16 : 1;
+   uint8_t c10 : 1; /* a C10 operand of the colour classes (format control) */
+   uint8_t lane;    /* pck .l<n> */
+   uint32_t n;
+};
+
+enum sgx_ins_kind {
+   SGX_INS_ALU, /* any encoded instruction */
+   SGX_INS_LABEL,
+   SGX_INS_BR,       /* br to label; pred */
+   SGX_INS_FEEDBACK, /* discard: the nop between the feedback and phase-1 labels
+                      */
+   SGX_INS_SAMPLE,   /* a USP texture sample (block 5) + unpack (block 6) */
+};
+
+#define SGX_MAX_FLD 10
+
+struct sgx_sample;
+
+struct sgx_ins {
+   struct list_head link;
+   uint8_t kind;
+   uint16_t form;
+   uint8_t pred; /* PRED3 code: 0 always, 1 p0, 2 p1, 5 !p0, 6 !p1 */
+   uint8_t rpt;  /* iterations (1-16) */
+   uint8_t ndst; /* leading operands that are written */
+   uint8_t nops;
+   uint8_t writes_pred; /* test: predicate number + 1 */
+   bool noskip;         /* runs on helper instances too (skipinv clear) */
+   uint8_t nfld;
+   struct sgx_ref op[SGX_MAX_OPS];
+   struct {
+      uint16_t id;
+      int32_t v;
+   } fld[SGX_MAX_FLD];
+   unsigned label; /* LABEL, BR */
+   unsigned ip;    /* index in the linear order (liveness) */
+   struct sgx_sample *smp;
+};
+
+struct sgx_vreg {
+   unsigned size; /* registers, or halves for a 16-bit vreg */
+   bool half;
+   bool pa; /* phys is a PA register (place_in_pa) */
+   bool o;  /* ... an output register (place_in_o) */
+   int phys;
+   int first, last; /* live range in ins ips, -1 = unused */
+};
+
+struct sgx_iter {
+   unsigned set, comps, pa;
+   bool sample;     /* non-dependent sample entry (list A) */
+   bool proj;       /* ... iterated projected (x/w, y/w) */
+   bool f16;        /* iterated as F16 (mediump), two components per register */
+   bool pointcoord; /* gl_PointCoord (set 0) */
+   bool flat;       /* every varying in the set flat */
+   /* the TA's vertex colour (source 0x20): one register, BGRA8 */
+   bool colour;
+   unsigned sampler;
+};
+
+struct sgx_sample {
+   unsigned id;
+   unsigned sampler;
+   bool dependent, proj;
+   unsigned dim; /* 2 = 2D, 3 = cube */
+   unsigned set; /* non-dependent: the coordinate's texture coordinate set */
+   int coord_pa; /* ... and its plain iteration, -1 none */
+   /* where the PDS leaves the raw texel (RGBA8, unpacked in place) */
+   unsigned pa;
+   unsigned lod; /* dependent: 0 none, 1 bias, 2 replace */
+   /* unpacked to F16 (two channels per register), else left as RGBA8 */
+   bool f16;
+   bool f16coord; /* dependent: F16 coordinates, two per register (smp .f16) */
+   bool f16_return; /* returns F16 pairs: pa, pa + 1; dependent: its two
+                       destination registers */
+   /* dependent: the SAMPLE pseudo-instruction (dst raw, coord, lod) */
+   struct sgx_ins *ins;
+};
+
+struct sgx_ctx {
+   uint64_t debug; /* enum sgx_debug */
+   struct nir_shader *nir;
+   const struct sgx_compile_options *opts;
+   const struct sgx_varyings *vary;
+   unsigned stage;
+   char *log;
+   size_t log_len, log_cap;
+   bool failed;
+
+   /* I/O */
+   /* register per I/O component: [location * 4 + component] (VARYING_SLOT_* /
+    * VERT_ATTRIB_*), -1 none */
+   int in_reg[512], out_reg[512];
+#define SGX_IN_HALF                                                            \
+   0x10000 /* in_reg: an F16-iterated component, low bits = its half */
+#define SGX_IN_U8                                                              \
+   0x20000 /* in_reg: a vertex colour component, low bits = 4 * pa + it */
+#define SGX_ITER_FRAGCOORD 14 /* list A iterator of gl_FragCoord */
+   struct sgx_iter iters[16];
+   unsigned n_iters;
+   unsigned n_pa_inputs;
+   unsigned psize_reg, n_out_regs;
+   /* vertex: user clip distances 0..n_clip-1, one fdpc each into
+    * o<clip_o + p> and cp<p> */
+   unsigned n_clip, clip_o;
+
+   /* NIR def -> value */
+   struct sgx_val *vals;
+   struct util_dynarray vregs; /* struct sgx_vreg */
+   struct list_head ins;
+   unsigned n_labels;
+
+   /* uniforms */
+   uint8_t const_used[1024];
+   /* 1 f32 (list C kind 1), 2 f16 (kind 2), 3 c10 (kind 3) */
+   uint8_t const_fmt[1024];
+   int const_slot[1024];
+   /* bit offset in the slot (f16 0/16, c10 0/10/20) */
+   uint8_t const_shift[1024];
+   /* the first of a lowp vec4 uniform (C10 candidate) */
+   uint8_t const_lowp[1024];
+   /* GLSL precision of the uniform behind constant k (0 unknown) */
+   uint8_t const_prec[1024];
+   /* dynamically indexed arrays: first constant, constants it spans */
+   struct {
+      uint16_t k, range;
+   } ix_arr[64];
+   unsigned n_ix_arr;
+   unsigned n_sa; /* slots (constants, then literals) */
+   unsigned sa_base;
+   /* where the slots live (place_constants): SA slot from sa_base, -1 memory
+    * only; with mem_dwords every slot is also block word slot + 1 */
+   int slot_sa[1024 + 32];
+   unsigned n_sa_phys; /* SA slots used: kept slots, then the bases */
+   unsigned mem_dwords;
+   unsigned n_mem_bases;
+   uint8_t mem_base_sa[8]; /* SA slot holding block address + 512 * j */
+   uint32_t lit_bits[32];  /* driver_consts: literal slots' values */
+   /* ... or, >= 0, the slot is constants k..k+3 packed to BGRA8 (0x12) */
+   int lit_packed_k[32];
+   int lit_slot[32];
+   unsigned n_lits;
+   bool lit_off; /* while a register is needed (fmad16 src0) */
+
+   /* fragment */
+   struct sgx_ref color[4];
+   unsigned color_mask; /* the channels of color[] a store wrote */
+   bool has_color;
+   struct sgx_ref depth; /* gl_FragDepth */
+   bool has_depth;
+   bool depth_done; /* emit_depth ran */
+   unsigned depth_pa;
+   int keep_vreg; /* discard: 1.0 = keep, -1 none */
+   bool discards;
+   bool keep_pred; /* the single discard wrote p1 (= keep) itself */
+   bool p16;       /* mediump in F16 */
+   /* emit_alu writes its def, never the register NIR stores it to */
+   bool def_dest;
+   int face_vreg; /* gl_FrontFacing as made at entry; -1 none */
+   bool face_int; /* ... as (g16 ^ sa) & 1, read only by selects */
+   int face_f32;  /* ... as 1.0 / 0.0 (face_int: made when a select needs it) */
+   struct sgx_ins *face_and; /* the and that makes face_int */
+   unsigned colour_pa;
+   struct sgx_sample *samples[16];
+   unsigned n_samples;
+
+   struct set *skip;        /* NIR instructions the backend doesn't emit */
+   struct set *shadow_regs; /* decl_regs read as aliases (find_shadow_regs) */
+   /* the colour as a lowp C10 expression (emit_c10) */
+   struct nir_def *c10_root;
+   /* the colour is a texel or a vec4 uniform as it is, through conversions
+    * (find_colour_source): the def the store reads, the texel, the
+    * uniform's constant number (-1 none) */
+   struct nir_def *colour_end;
+   struct nir_tex_instr *colour_tex;
+   int colour_k;
+   /* emit_color: the raw RGBA8 texel register / the packed literal slot */
+   bool has_colour_raw, has_colour_packed;
+   bool colour_raw_bgra; /* ... already in the colour's byte order */
+   struct sgx_ref colour_raw;
+   /* the one discard's comparison (p1 directly) */
+   struct nir_alu_instr *discard_cmp;
+   struct hash_table *proj; /* nir_tex_instr -> its projected varying load */
+   struct hash_table *efo; /* nir_alu_instr (a chain's root) -> its efo_chain */
+   /* nir_if -> the comparison it alone reads, tested into p0 directly */
+   struct hash_table *if_cmp;
+   /* a varying load only non-dependent samples read -> its set + 1 */
+   struct hash_table *sample_set;
+   /* nir_tex_instr -> its sgx_sample (a split program's phase 1 reuses a
+    * non-dependent one) */
+   struct hash_table *tex_sample;
+   /* split_phases: the NIR instructions this pass emits (NULL all), and
+    * whether it is phase 1's (no feedback nop) */
+   struct set *emit_filter;
+   bool phase1;
+
+   /* results */
+   unsigned n_temps, n_pa;
+   struct util_dynarray words; /* flat main program (uint64_t) */
+};
+
+void sgx_lower(struct sgx_ctx *c);
+void sgx_logf(struct sgx_ctx *c, const char *fmt, ...);
+void sgx_fail(struct sgx_ctx *c, const char *fmt, ...);
+int sgx_finish_program(struct sgx_ctx *c, struct sgx_shader *out);
+int sgx_encode_ins(struct sgx_ctx *c, const struct sgx_ins *i, uint64_t *w);
+
+static inline struct sgx_vreg *
+sgx_vreg(struct sgx_ctx *c, unsigned i)
+{
+   return util_dynarray_element(&c->vregs, struct sgx_vreg, i);
+}
+
+/* the SA register of uniform constant k / literal i (kept in SA) */
+/* SGX_COMPILER_DEBUG flags (sgx_compile.c): each no* flag turns one
+ * optimization off, to bisect a miscompile without rebuilding */
+enum sgx_debug {
+   SGX_DBG_NO_PA = BITFIELD64_BIT(0),
+   SGX_DBG_NO_OUT = BITFIELD64_BIT(1),
+   SGX_DBG_NO_COALESCE = BITFIELD64_BIT(2),
+   SGX_DBG_NO_SPLIT = BITFIELD64_BIT(3),
+   SGX_DBG_NO_FOLD = BITFIELD64_BIT(4),
+   SGX_DBG_NO_SELFMOV = BITFIELD64_BIT(5),
+   SGX_DBG_NO_LIT32 = BITFIELD64_BIT(6),
+   SGX_DBG_NO_NARROW16 = BITFIELD64_BIT(7),
+   SGX_DBG_NO_MEDIUMP = BITFIELD64_BIT(8),
+   SGX_DBG_NO_MINMAX32 = BITFIELD64_BIT(9),
+   SGX_DBG_NO_CONDMASK = BITFIELD64_BIT(10),
+   SGX_DBG_NO_CSEL1 = BITFIELD64_BIT(11),
+   SGX_DBG_NO_CSEL32 = BITFIELD64_BIT(12),
+   SGX_DBG_NO_COISSUE = BITFIELD64_BIT(13),
+   SGX_DBG_NO_F16_CONST = BITFIELD64_BIT(14),
+   SGX_DBG_NO_F16_ITER = BITFIELD64_BIT(15),
+   SGX_DBG_UNROLL_EXITS = BITFIELD64_BIT(18),
+   SGX_DBG_NO_MASK_BOOL = BITFIELD64_BIT(19),
+   SGX_DBG_NO_IF_TEST = BITFIELD64_BIT(20),
+   SGX_DBG_KEEP_COORD_ITERS = BITFIELD64_BIT(21),
+   SGX_DBG_NO_EFO_CHAIN = BITFIELD64_BIT(22),
+   SGX_DBG_NO_F16_SAMPLES = BITFIELD64_BIT(23),
+   SGX_DBG_NO_PHASES = BITFIELD64_BIT(24),
+   SGX_DBG_NO_CONST_SWAP = BITFIELD64_BIT(25),
+   SGX_DBG_NO_PROJ_ALONE = BITFIELD64_BIT(26),
+   SGX_DBG_NO_DEP_F16 = BITFIELD64_BIT(27),
+   SGX_DBG_NO_INTERLEAVE = BITFIELD64_BIT(28),
+   SGX_DBG_FLATTEN_UNIFORM = BITFIELD64_BIT(29),
+   SGX_DBG_NO_TEX_COLOR = BITFIELD64_BIT(16),
+   SGX_DBG_NO_PACKED_COLOR = BITFIELD64_BIT(17),
+};
+
+static inline bool
+sgx_debug(const struct sgx_ctx *c, uint64_t flag)
+{
+   return (c->debug & flag) != 0;
+}
+
+static inline unsigned
+sgx_const_sa(const struct sgx_ctx *c, unsigned k)
+{
+   return c->sa_base + c->slot_sa[c->const_slot[k]];
+}
+
+static inline unsigned
+sgx_lit_sa(const struct sgx_ctx *c, unsigned i)
+{
+   return c->sa_base + c->slot_sa[c->lit_slot[i]];
+}
+
+#endif
