Out-of-tree: let powervr_sgx run the vendor (DDK 1.7) SGX545 microkernel too,
for A/B tests on the CE5300 boards. Never upstream: that microkernel needs every
client page directory to map the firmware's heaps. Applied by drm/ci/ce5300-kernel.sh.

diff -ruN powervr_sgx.orig/Kconfig powervr_sgx/Kconfig
--- a/drm/powervr_sgx/Kconfig	2026-11-08 17:50:22
+++ b/drm/powervr_sgx/Kconfig	2026-11-08 17:50:23
@@ -35,6 +35,18 @@
 
 	  Say Y if this kernel runs on a Cedarview machine.
 
+config DRM_POWERVR_SGX_DDK_COMPAT
+	bool "Run the vendor microkernel too (testing)"
+	depends on DRM_POWERVR_SGX
+	help
+	  Also load the vendor (DDK 1.7) SGX545 microkernel, for A/B testing
+	  against the open one. That microkernel runs client work under the
+	  client's own page directory, so every client can then reach the
+	  firmware's memory. Without this option only an open microkernel that
+	  declares secure mode is loaded.
+
+	  If unsure, say N.
+
 config DRM_POWERVR_SGX_KUNIT_TEST
 	tristate "KUnit tests for the PowerVR SGX5xx driver" if !KUNIT_ALL_TESTS
 	depends on DRM_POWERVR_SGX && KUNIT
