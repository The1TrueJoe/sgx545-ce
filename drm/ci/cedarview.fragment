# Cedarview test kernel: gma500 drives the display, powervr_sgx the SGX545.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DRM=y
CONFIG_DRM_GMA500=m
CONFIG_DRM_POWERVR_SGX=m
CONFIG_DRM_POWERVR_SGX_GMA500=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DEBUG_FS=y
CONFIG_FW_LOADER=y
CONFIG_DEV_COREDUMP=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y

# The tester kit boots from a USB stick with no initramfs: root on the stick.
CONFIG_BLK_DEV_SD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CP437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EFI_PARTITION=y
# Root = squashfs + a tmpfs overlay on the stick; console on the firmware
# framebuffer (simpledrm) until gma500 takes over; never resume from a disk.
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_VT=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_HIBERNATION is not set
