+<!-- ===================================================================== -->
+<!-- hw 0a-0e: bitwise                                                      -->
+<!-- ===================================================================== -->
+
+<expr name="#bw-imm">({S2B} == 2) &amp;&amp; {S2E}</expr>
+
+<bitset name="#bitwise" extends="#instruction">
+	<doc>
+		An immediate src2 (bank 2 + extension) is 16 bits: l0-6, l14-20,
+		h4-5; rot (h6-10) rotates it left, inv (h11) inverts it.
+	</doc>
+	<override expr="#bw-imm">
+		<display>
+			{PRED}{NAME}{INV} {DST}, {SRC1}, {IMM16} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM} {PARTIAL} {ROT}]
+		</display>
+		<field name="IM1" low="14" high="20" type="uint"/>
+		<field name="IM2" low="36" high="37" type="uint"/>
+		<derived name="IMM16" type="custom" width="16">
+			<expr>{S2N} | ({IM1} &lt;&lt; 7) | ({IM2} &lt;&lt; 14)</expr>
+		</derived>
+	</override>
+	<display>
+		{PRED}{NAME}{INV} {DST}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM} {PARTIAL} {ROT}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<assert low="14" high="20">0000000</assert>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="PARTIAL" pos="34" type="bool" display=" partial"/>
+	<assert low="36" high="37">00</assert>
+	<field name="ROT" low="38" high="42" type="custom"/>
+	<field name="INV" pos="43" type="bool" display=".inv"/>
+	<field name="RPTMASK" low="44" high="47" type="uint"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="RCNT" pos="53" type="bool"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<derived name="RM" type="#rm1">
+		<expr>{RPTMASK} | ({RCNT} &lt;&lt; 4)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="PARTIAL">src->partial</map>
+		<map name="ROT">src->rot</map>
+		<map name="INV">src->inv</map>
+		<map name="S2N">SGX_IS_IMM(2) ? (src->src[2].num &amp; 0x7f) : (SGX_SRC(2, 0) &amp; 0x7f)</map>
+		<map name="S2B">SGX_IS_IMM(2) ? 2 : ((SGX_SRC(2, 0) &gt;&gt; 7) &amp; 3)</map>
+		<map name="S2E">SGX_IS_IMM(2) ? 1 : (SGX_SRC(2, 0) &gt;&gt; 9)</map>
+		<map name="IM1">(src->src[2].num &gt;&gt; 7) &amp; 0x7f</map>
+		<map name="IM2">src->src[2].num &gt;&gt; 14</map>
+	</encode>
+</bitset>
+
+<bitset name="and" extends="#bitwise">
+	<pattern pos="35">0</pattern>
+	<pattern low="59" high="63">01010</pattern>
+</bitset>
+<bitset name="or" extends="#bitwise">
+	<pattern pos="35">1</pattern>
+	<pattern low="59" high="63">01010</pattern>
+</bitset>
+<bitset name="xor" extends="#bitwise">
+	<pattern pos="35">0</pattern>
+	<pattern low="59" high="63">01011</pattern>
+</bitset>
+<bitset name="shl" extends="#bitwise">
+	<pattern pos="35">0</pattern>
+	<pattern low="59" high="63">01100</pattern>
+</bitset>
+<bitset name="rol" extends="#bitwise">
+	<pattern pos="35">1</pattern>
+	<pattern low="59" high="63">01100</pattern>
+</bitset>
+<bitset name="shr" extends="#bitwise">
+	<pattern pos="35">0</pattern>
+	<pattern low="59" high="63">01101</pattern>
+</bitset>
+<bitset name="asr" extends="#bitwise">
+	<pattern pos="35">1</pattern>
+	<pattern low="59" high="63">01101</pattern>
+</bitset>
+
+<bitset name="rlp" extends="#instruction">
+	<doc>
+		rlp dst, src1, pN: the predicate in l14-15. src2's slot read as one
+		10-bit value is unused2, 0x300 (the unused pattern) by default.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {SRC1}, {PN} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM} {PARTIAL} {UNUSED2}]
+	</display>
+	<field name="U2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="PN" low="14" high="15" type="#pn"/>
+	<pattern low="16" high="20">00000</pattern>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="U2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="PARTIAL" pos="34" type="bool" display=" partial"/>
+	<pattern low="35" high="43">000000000</pattern>
+	<field name="RPTMASK" low="44" high="47" type="uint"/>
+	<field name="U2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="RCNT" pos="53" type="bool"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<pattern low="59" high="63">01110</pattern>
+	<derived name="RM" type="#rm1">
+		<expr>{RPTMASK} | ({RCNT} &lt;&lt; 4)</expr>
+	</derived>
+	<derived name="UNUSED2" type="custom" width="10">
+		<expr>{U2N} | ({U2B} &lt;&lt; 7) | ({U2E} &lt;&lt; 9)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="PN">src->pdst</map>
+		<map name="PARTIAL">src->partial</map>
+		<map name="U2N">SGX_UNUSED2() &amp; 0x7f</map>
+		<map name="U2B">(SGX_UNUSED2() &gt;&gt; 7) &amp; 3</map>
+		<map name="U2E">SGX_UNUSED2() &gt;&gt; 9</map>
+	</encode>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 1c: smp                                                             -->
+<!-- ===================================================================== -->
+
+<bitset name="#smp" extends="#instruction">
+	<doc>
+		smp.&lt;dim&gt;[.bias|.lod|.grad][.f16|.c10][.pcf|.pcf16][.rdata|.rinfo]
+		dst, coord, state[, lod]. h12-15 is the write mask (or count - 1
+		with rcnt); ret is ORed into its bits 2-3, so the text's mask is
+		bits 0-1 when ret is set.
+	</doc>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="CN" low="14" high="20" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DRC" pos="32" type="#drc"/>
+	<pattern pos="33">0</pattern>
+	<field name="CB0" pos="34" type="uint"/>
+	<field name="CFMT" low="35" high="36" type="#smp-cfmt"/>
+	<field name="PCF" low="37" high="38" type="#smp-pcf"/>
+	<field name="DB" pos="39" type="uint"/>
+	<field name="LOD" low="40" high="41" type="#smp-lod"/>
+	<field name="DIM" low="42" high="43" type="#smp-dim"/>
+	<field name="RPTMASK" low="44" high="47" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="CB1" pos="50" type="uint"/>
+	<pattern pos="51">0</pattern>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="RCNT" pos="53" type="bool"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<pattern low="59" high="63">11100</pattern>
+	<derived name="RM" type="#rm1">
+		<expr>{RCNT} ? ({RPTMASK} | 16) : ({RPTMASK} &amp; 3)</expr>
+	</derived>
+	<derived name="RET" type="#smp-ret">
+		<expr>{RCNT} ? 0 : ({RPTMASK} &gt;&gt; 2)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst1" width="8">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+	</derived>
+	<derived name="COORD" type="#src0" width="9">
+		<expr>{CN} | ({CB0} &lt;&lt; 7) | ({CB1} &lt;&lt; 8)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="CN">SGX_SRC0(0) &amp; 0x7f</map>
+		<map name="CB0">(SGX_SRC0(0) &gt;&gt; 7) &amp; 1</map>
+		<map name="CB1">SGX_SRC0(0) &gt;&gt; 8</map>
+		<map name="DN">SGX_DST1() &amp; 0x7f</map>
+		<map name="DB">SGX_DST1() &gt;&gt; 7</map>
+		<map name="CFMT">src->cfmt</map>
+		<map name="PCF">src->pcf</map>
+		<map name="LOD">src->lod</map>
+		<map name="DIM">src->dim</map>
+		<map name="RPTMASK">src->rcnt ? sgx_isa_rpt(src) : (src->mask | (src->ret &lt;&lt; 2))</map>
+	</encode>
+</bitset>
+
+<bitset name="smp" extends="#smp">
+	<override>
+		<expr>{LOD} == 0</expr>
+		<display>
+			{PRED}{NAME}{DIM}{RET}{PCF}{CFMT}{LOD} {DST}, {COORD}, {SRC1} [{SKIPINV} {NOSCHED} {SYNCS} {DRC} {RM}]
+		</display>
+		<assert low="0" high="6">0000000</assert>
+		<assert low="28" high="29">10</assert>
+		<assert pos="48">1</assert>
+	</override>
+	<display>
+		{PRED}{NAME}{DIM}{RET}{PCF}{CFMT}{LOD} {DST}, {COORD}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {DRC} {RM}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 1d ld / eld, hw 1e st                                               -->
+<!-- ===================================================================== -->
+
+<bitset name="#ldst" extends="#instruction">
+	<doc>
+		Address mode h10-11, size h4-5, base in the src0 slot (bank h2,
+		extension h18), offset in src1, range (ld) or data (st) in src2.
+	</doc>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="BN" low="14" high="20" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="F2_2" pos="33" type="bool" display=" f2_2"/>
+	<field name="BB0" pos="34" type="uint"/>
+	<field name="F2_9" pos="35" type="bool" display=" f2_9"/>
+	<field name="SIZE" low="36" high="37" type="#ld-size"/>
+	<field name="RANGE" pos="38" type="bool" display=" range"/>
+	<field name="PREINC" pos="40" type="bool" display=" preinc"/>
+	<field name="POSTINC" pos="41" type="bool" display=" postinc"/>
+	<field name="AM" low="42" high="43" type="#ld-am"/>
+	<field name="RPT" low="44" high="47" type="#rpt16"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="BB1" pos="50" type="uint"/>
+	<field name="F2_3" pos="51" type="bool" display=" f2_3"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="MOE" pos="53" type="bool" display=" moe"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="BASE" type="#src0" width="9">
+		<expr>{BN} | ({BB0} &lt;&lt; 7) | ({BB1} &lt;&lt; 8)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="BN">SGX_SRC0(0) &amp; 0x7f</map>
+		<map name="BB0">(SGX_SRC0(0) &gt;&gt; 7) &amp; 1</map>
+		<map name="BB1">SGX_SRC0(0) &gt;&gt; 8</map>
+		<map name="DN">SGX_DST1() &amp; 0x7f</map>
+		<map name="DB">SGX_DST1() &gt;&gt; 7</map>
+		<map name="F2_2">src->f2_2</map>
+		<map name="F2_3">src->f2_3</map>
+		<map name="F2_9">src->f2_9</map>
+		<map name="SIZE">src->size</map>
+		<map name="RANGE">src->range</map>
+		<map name="PREINC">src->preinc</map>
+		<map name="POSTINC">src->postinc</map>
+		<map name="AM">src->am</map>
+		<map name="F3_13">src->f3_13</map>
+	</encode>
+</bitset>
+
+<template name="LDST_FLAGS">{SKIPINV} {NOSCHED} {SYNCS} {DRC} {PREINC} {POSTINC} {RANGE} {MOE} {RPT} {F2_2} {F2_3} {F2_9}</template>
+
+<bitset name="ld" extends="#ldst">
+	<override>
+		<expr>!{RANGE}</expr>
+		<display>
+			{PRED}{NAME}{AM}{SIZE} {DST}, {BASE}, {SRC1} [{LDST_FLAGS}]
+		</display>
+		<assert low="0" high="6">0000000</assert>
+		<assert low="28" high="29">10</assert>
+		<assert pos="48">1</assert>
+	</override>
+	<display>
+		{PRED}{NAME}{AM}{SIZE} {DST}, {BASE}, {SRC1}, {SRC2} [{LDST_FLAGS}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="DRC" pos="32" type="#drc"/>
+	<field name="DB" pos="39" type="uint"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<pattern pos="54">0</pattern>
+	<pattern low="59" high="63">11101</pattern>
+	<derived name="NOSCHED" expr="#zero" type="bool" display=""/>
+	<derived name="DST" type="#dst1" width="8">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="st" extends="#ldst">
+	<doc>No destination; h0 = f3_13 instead of a DRC; h22 = nosched.</doc>
+	<display>
+		{PRED}{NAME}{AM}{SIZE} {BASE}, {SRC1}, {SRC2} [{LDST_FLAGS} {F3_13}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<pattern low="21" high="27">0000000</pattern>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="F3_13" pos="32" type="bool" display=" f3_13"/>
+	<pattern pos="39">0</pattern>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<pattern low="59" high="63">11110</pattern>
+	<derived name="DRC" expr="#zero" type="#drc"/>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="#eld" extends="#instruction">
+	<doc>
+		eld.&lt;d|q&gt; dst, src1, src0, #imm11, src2. The immediate takes h5-11
+		(low 7 bits) and h16-19 (high 4), so no source has an extension bit.
+	</doc>
+	<display>
+		{PRED}eld{SIZE} {DST}, {SRC1}, {SRC0}, #{IMM}, {SRC2} [{SKIPINV} {SYNCS} {DRC} {RPT} {F2_2} {F2_3}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DRC" pos="32" type="#drc"/>
+	<field name="F2_2" pos="33" type="bool" display=" f2_2"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="DB" pos="36" type="uint"/>
+	<field name="IMMLO" low="37" high="43" type="uint"/>
+	<field name="RPT" low="44" high="47" type="#rpt16"/>
+	<field name="IMMHI" low="48" high="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="F2_3" pos="53" type="bool" display=" f2_3"/>
+	<pattern pos="54">1</pattern>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<pattern low="59" high="63">11101</pattern>
+	<derived name="IMM" type="uint">
+		<expr>{IMMLO} | ({IMMHI} &lt;&lt; 7)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst1" width="8">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+	</derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="DN">SGX_DST1() &amp; 0x7f</map>
+		<map name="DB">SGX_DST1() &gt;&gt; 7</map>
+		<map name="F2_2">src->f2_2</map>
+		<map name="F2_3">src->f2_3</map>
+		<map name="S1N">SGX_SRCX(1, 0) &amp; 0x7f</map>
+		<map name="S1B">(SGX_SRCX(1, 0) &gt;&gt; 7) &amp; 3</map>
+		<map name="S2N">SGX_SRCX(2, 0) &amp; 0x7f</map>
+		<map name="S2B">(SGX_SRCX(2, 0) &gt;&gt; 7) &amp; 3</map>
+		<map name="IMMLO">src->imm &amp; 0x7f</map>
+		<map name="IMMHI">src->imm &gt;&gt; 7</map>
+		<map name="SIZE">src->size</map>
+	</encode>
+</bitset>
+
+<bitset name="eld.d" extends="#eld">
+	<derived name="SIZE" type="#eld-size"><expr>0</expr></derived>
+	<pattern pos="35">0</pattern>
+</bitset>
+<bitset name="eld.q" extends="#eld">
+	<derived name="SIZE" type="#eld-size"><expr>1</expr></derived>
+	<pattern pos="35">1</pattern>
+</bitset>
+
+<!--
+1-bit-bank destination (smp, ld, eld, ldr): number l21-27, bank r = 0,
+pa = 1.
+-->
+<bitset name="#dst1" size="8">
+	<encode type="struct sgx_isa_src *" case-prefix="SGX_">
+		<map name="NUM">sgx_isa_reg_num(src)</map>
+	</encode>
+</bitset>
+<bitset name="#dst1.r" extends="#dst1">
+	<display>r{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+	<pattern pos="7">0</pattern>
+</bitset>
+<bitset name="#dst1.pa" extends="#dst1">
+	<display>pa{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+	<pattern pos="7">1</pattern>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 1f: special. h20-22 splits it: 0 flow control, 1 MOE control,     -->
+<!-- x10 other, x11 visibility test, 100 phase.                            -->
+<!-- ===================================================================== -->
+
+<bitset name="#flow" extends="#instruction">
+	<doc>Flow control: op in h6-8, predicate h24-26.</doc>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<pattern low="52" high="54">000</pattern>
+	<pattern low="59" high="63">11111</pattern>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<encode>
+		<map name="SYNCEND">src->syncend</map>
+		<map name="XSYNCEND">src->xsyncend</map>
+		<map name="LINK">src->link</map>
+		<map name="F1_22">src->f1_22</map>
+		<map name="TARGET">src->target</map>
+		<map name="F2_26">src->f2_26</map>
+		<map name="F3_5">src->f3_5</map>
+		<map name="DN">SGX_DSTX(0) &amp; 0x7f</map>
+		<map name="DB">(SGX_DSTX(0) &gt;&gt; 7) &amp; 3</map>
+	</encode>
+</bitset>
+
+<template name="BR_FLAGS">{NOSCHED} {SYNCEND} {XSYNCEND} {LINK} {F1_22}</template>
+
+<bitset name="#branch" extends="#flow">
+	<pattern low="18" high="31">00000000000000</pattern>
+	<pattern low="32" high="37">000000</pattern>
+	<field name="LINK" pos="41" type="bool" display=" link"/>
+	<field name="F1_22" pos="42" type="bool" display=" f1_22"/>
+	<field name="XSYNCEND" pos="44" type="bool" display=" xsyncend"/>
+	<pattern low="45" high="50">000000</pattern>
+	<pattern pos="51">0</pattern>
+	<field name="SYNCEND" pos="55" type="bool" display=" syncend"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+</bitset>
+
+<bitset name="ba" extends="#branch">
+	<doc>Absolute target: the instruction index from the USE code base.</doc>
+	<display>
+		{PRED}{NAME} #{TARGET} [{BR_FLAGS}]
+	</display>
+	<field name="TARGET" low="0" high="17" type="uint"/>
+	<pattern low="38" high="40">000</pattern>
+</bitset>
+
+<bitset name="br" extends="#branch">
+	<doc>Relative target: this instruction + n, signed 18 bits.</doc>
+	<display>
+		{PRED}{NAME} #{TARGET} [{BR_FLAGS}]
+	</display>
+	<field name="TARGET" low="0" high="17" type="int"/>
+	<pattern low="38" high="40">001</pattern>
+</bitset>
+
+<bitset name="#flow-noarg" extends="#flow">
+	<pattern low="32" high="37">000000</pattern>
+	<pattern low="41" high="42">00</pattern>
+	<field name="XSYNCEND" pos="44" type="bool" display=" xsyncend"/>
+	<pattern low="45" high="51">0000000</pattern>
+	<field name="SYNCEND" pos="55" type="bool" display=" syncend"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+</bitset>
+
+<bitset name="lapc" extends="#flow-noarg">
+	<display>
+		{PRED}{NAME} [{NOSCHED} {SYNCEND} {XSYNCEND}]
+	</display>
+	<pattern low="0" high="31">00000000000000000000000000000000</pattern>
+	<pattern low="38" high="40">010</pattern>
+</bitset>
+
+<bitset name="setl" extends="#flow">
+	<doc>Set the link address from the src1 slot.</doc>
+	<display>
+		{PRED}{NAME} {SRC1} [{NOSCHED} {SYNCEND} {XSYNCEND}]
+	</display>
+	<pattern low="0" high="6">0000000</pattern>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<pattern low="14" high="29">0000000000000000</pattern>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<pattern low="32" high="37">000000</pattern>
+	<pattern low="38" high="40">011</pattern>
+	<pattern low="41" high="42">00</pattern>
+	<field name="XSYNCEND" pos="44" type="bool" display=" xsyncend"/>
+	<pattern low="45" high="48">0000</pattern>
+	<field name="S1E" pos="49" type="uint"/>
+	<pattern low="50" high="51">00</pattern>
+	<field name="SYNCEND" pos="55" type="bool" display=" syncend"/>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+</bitset>
+
+<bitset name="savl" extends="#flow">
+	<doc>Save the link address to the destination slot (no extension bit).</doc>
+	<display>
+		{PRED}{NAME} {DST} [{NOSCHED} {SYNCEND} {XSYNCEND}]
+	</display>
+	<pattern low="0" high="20">000000000000000000000</pattern>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<pattern low="28" high="31">0000</pattern>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<pattern low="34" high="37">0000</pattern>
+	<pattern low="38" high="40">100</pattern>
+	<pattern low="41" high="42">00</pattern>
+	<field name="XSYNCEND" pos="44" type="bool" display=" xsyncend"/>
+	<pattern low="45" high="51">0000000</pattern>
+	<field name="SYNCEND" pos="55" type="bool" display=" syncend"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+</bitset>
+
+<bitset name="nop" extends="#flow">
+	<doc>h23 sync-start, h18 end, l0 = f2_26, l1 = f3_5.</doc>
+	<display>
+		{NAME} [{NOSCHED} {SYNCS} {END} {F2_26} {F3_5}]
+	</display>
+	<field name="F2_26" pos="0" type="bool" display=" f2_26"/>
+	<field name="F3_5" pos="1" type="bool" display=" f3_5"/>
+	<pattern low="2" high="31">000000000000000000000000000000</pattern>
+	<pattern low="32" high="37">000000</pattern>
+	<pattern low="38" high="40">101</pattern>
+	<pattern low="41" high="42">00</pattern>
+	<pattern low="44" high="49">000000</pattern>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<pattern pos="51">0</pattern>
+	<field name="SYNCS" pos="55" type="bool" display=" syncs"/>
+	<pattern low="56" high="58">000</pattern>
+</bitset>
+
+<bitset name="op0x98" extends="#flow">
+	<doc>h6-8 = 0, h9 = 1, h19 = 1; no arguments; meaning unknown.</doc>
+	<display>
+		{NAME} [{NOSCHED} {SYNCEND} {XSYNCEND}]
+	</display>
+	<pattern low="0" high="31">00000000000000000000000000000000</pattern>
+	<pattern low="32" high="37">000000</pattern>
+	<pattern low="38" high="40">000</pattern>
+	<pattern pos="41">1</pattern>
+	<pattern pos="42">0</pattern>
+	<field name="XSYNCEND" pos="44" type="bool" display=" xsyncend"/>
+	<pattern low="45" high="50">000000</pattern>
+	<pattern pos="51">1</pattern>
+	<field name="SYNCEND" pos="55" type="bool" display=" syncend"/>
+	<pattern low="56" high="58">000</pattern>
+</bitset>
+
+<!-- MOE control (h20-22 = 1): op h24-26, h18 nosched, h19 register form -->
+
+<bitset name="#moe" extends="#instruction">
+	<field name="NOSCHED" pos="50" type="bool" display=" nosched"/>
+	<pattern low="52" high="54">001</pattern>
+	<pattern low="59" high="63">11111</pattern>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<encode>
+		<map name="V0">src->v[0]</map>
+		<map name="V1">src->v[1]</map>
+		<map name="V2">src->v[2]</map>
+		<map name="V3">src->v[3]</map>
+		<map name="V0LO">src->v[0] &amp; 3</map>
+		<map name="V0HI">(src->v[0] &gt;&gt; 2) &amp; 0xff</map>
+		<map name="V1LO">src->v[1] &amp; 0xff</map>
+		<map name="V1HI">(src->v[1] &gt;&gt; 8) &amp; 0xf</map>
+		<map name="AM0">src->am4[0]</map>
+		<map name="AM1">src->am4[1]</map>
+		<map name="AM2">src->am4[2]</map>
+		<map name="AM3">src->am4[3]</map>
+		<map name="SW0">src->swzf[0]</map>
+		<map name="SW1">src->swzf[1]</map>
+		<map name="SW2">src->swzf[2]</map>
+		<map name="SW3">src->swzf[3]</map>
+		<map name="LIM0">src->lim[0]</map>
+		<map name="LIM1">src->lim[1]</map>
+		<map name="LIM2">src->lim[2]</map>
+		<map name="A0">src->a[0]</map>
+		<map name="A1">src->a[1]</map>
+		<map name="NVAL">src->n</map>
+	</encode>
+</bitset>
+
+<bitset name="smoa" extends="#moe">
+	<doc>Four signed 10-bit values and four 2-bit modes.</doc>
+	<display>
+		{NAME} #{V0}, #{V1}, #{V2}, #{V3} [{NOSCHED} {AM0} {AM1} {AM2} {AM3}]
+	</display>
+	<field name="V3" low="0" high="9" type="int"/>
+	<field name="V2" low="10" high="19" type="int"/>
+	<field name="V1" low="20" high="29" type="int"/>
+	<field name="V0LO" low="30" high="31" type="uint"/>
+	<field name="V0HI" low="32" high="39" type="uint"/>
+	<field name="AM3" low="40" high="41" type="custom"/>
+	<field name="AM2" low="42" high="43" type="custom"/>
+	<field name="AM1" low="44" high="45" type="custom"/>
+	<field name="AM0" low="46" high="47" type="custom"/>
+	<pattern low="48" high="49">00</pattern>
+	<pattern pos="51">0</pattern>
+	<pattern pos="55">0</pattern>
+	<pattern low="56" high="58">000</pattern>
+	<derived name="V0" type="int" width="10">
+		<expr>{V0LO} | ({V0HI} &lt;&lt; 2)</expr>
+	</derived>
+</bitset>
+
+<bitset name="#moe12" extends="#moe">
+	<doc>smr / smbo / imo: four 12-bit values.</doc>
+	<display>
+		{NAME} #{V0}, #{V1}, #{V2}, #{V3} [{NOSCHED}]
+	</display>
+	<field name="V1LO" low="24" high="31" type="uint"/>
+	<field name="V1HI" low="32" high="35" type="uint"/>
+	<pattern low="48" high="49">00</pattern>
+	<pattern pos="51">0</pattern>
+	<pattern pos="55">0</pattern>
+</bitset>
+
+<bitset name="smr" extends="#moe12">
+	<field name="V3" low="0" high="11" type="uint"/>
+	<field name="V2" low="12" high="23" type="uint"/>
+	<field name="V0" low="36" high="47" type="uint"/>
+	<derived name="V1" type="uint">
+		<expr>{V1LO} | ({V1HI} &lt;&lt; 8)</expr>
+	</derived>
+	<pattern low="56" high="58">001</pattern>
+</bitset>
+
+<bitset name="smbo" extends="#moe12">
+	<field name="V3" low="0" high="11" type="uint"/>
+	<field name="V2" low="12" high="23" type="uint"/>
+	<field name="V0" low="36" high="47" type="uint"/>
+	<derived name="V1" type="uint">
+		<expr>{V1LO} | ({V1HI} &lt;&lt; 8)</expr>
+	</derived>
+	<pattern low="56" high="58">011</pattern>
+</bitset>
+
+<bitset name="imo" extends="#moe12">
+	<field name="V3" low="0" high="11" type="int"/>
+	<field name="V2" low="12" high="23" type="int"/>
+	<field name="V0" low="36" high="47" type="int"/>
+	<derived name="V1" type="int" width="12">
+		<expr>{V1LO} | ({V1HI} &lt;&lt; 8)</expr>
+	</derived>
+	<pattern low="56" high="58">100</pattern>
+</bitset>
+
+<bitset name="smlsi" extends="#moe">
+	<doc>
+		Per operand (dst, src0, src1, src2) an 8-bit value; its flag
+		(h3/h2/h1/h0) set makes it a swizzle, clear a signed increment.
+		lim0-2 are stored as given (multiples of 4).
+	</doc>
+	<display>
+		{NAME} {SL0}, {SL1}, {SL2}, {SL3} [{NOSCHED} {LIM0} {LIM1} {LIM2}]
+	</display>
+	<field name="V3" low="0" high="7" type="uint"/>
+	<field name="V2" low="8" high="15" type="uint"/>
+	<field name="V1" low="16" high="23" type="uint"/>
+	<field name="V0" low="24" high="31" type="uint"/>
+	<field name="SW3" pos="32" type="uint"/>
+	<field name="SW2" pos="33" type="uint"/>
+	<field name="SW1" pos="34" type="uint"/>
+	<field name="SW0" pos="35" type="uint"/>
+	<field name="LIM2" low="36" high="39" type="custom"/>
+	<field name="LIM1" low="40" high="43" type="custom"/>
+	<field name="LIM0" low="44" high="47" type="custom"/>
+	<pattern low="48" high="49">00</pattern>
+	<pattern pos="51">0</pattern>
+	<pattern pos="55">0</pattern>
+	<pattern low="56" high="58">010</pattern>
+	<derived name="SL0" type="custom" width="9"><expr>{V0} | ({SW0} &lt;&lt; 8)</expr></derived>
+	<derived name="SL1" type="custom" width="9"><expr>{V1} | ({SW1} &lt;&lt; 8)</expr></derived>
+	<derived name="SL2" type="custom" width="9"><expr>{V2} | ({SW2} &lt;&lt; 8)</expr></derived>
+	<derived name="SL3" type="custom" width="9"><expr>{V3} | ({SW3} &lt;&lt; 8)</expr></derived>
+</bitset>
+
+<bitset name="#moe-reg" extends="#moe">
+	<doc>Register forms of ops 0-3: values from the src1 and src2 slots.</doc>
+	<display>
+		{NAME} {SRC1}, {SRC2} [{NOSCHED}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<pattern low="14" high="27">00000000000000</pattern>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<pattern low="32" high="47">0000000000000000</pattern>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<pattern pos="51">1</pattern>
+	<pattern pos="55">0</pattern>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="smoa.r" extends="#moe-reg">
+	<pattern low="56" high="58">000</pattern>
+</bitset>
+<bitset name="smr.r" extends="#moe-reg">
+	<pattern low="56" high="58">001</pattern>
+</bitset>
+<bitset name="smlsi.r" extends="#moe-reg">
+	<pattern low="56" high="58">010</pattern>
+</bitset>
+<bitset name="smbo.r" extends="#moe-reg">
+	<pattern low="56" high="58">011</pattern>
+</bitset>
+
+<bitset name="setfc" extends="#moe">
+	<doc>
+		a0 (l0) = the efo F16 enable (off at program start), a1 (l8) = the
+		C10 enable of the color classes (on at program start).
+	</doc>
+	<display>
+		{NAME} #{A0}, #{A1} [{NOSCHED}]
+	</display>
+	<field name="A0" pos="0" type="uint"/>
+	<pattern low="1" high="7">0000000</pattern>
+	<field name="A1" pos="8" type="uint"/>
+	<pattern low="9" high="31">00000000000000000000000</pattern>
+	<pattern low="32" high="49">000000000000000000</pattern>
+	<pattern pos="51">0</pattern>
+	<pattern pos="55">0</pattern>
+	<pattern low="56" high="58">101</pattern>
+</bitset>
+
+<bitset name="op0xfd" extends="#moe">
+	<doc>dst in the destination slot, n h11-14; meaning unknown.</doc>
+	<display>
+		{NAME} {DST}, #{NVAL} [{SKIPINV} {NOSCHED}]
+	</display>
+	<pattern low="0" high="20">000000000000000000000</pattern>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<pattern low="28" high="31">0000</pattern>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<pattern low="34" high="42">000000000</pattern>
+	<field name="NVAL" low="43" high="46" type="uint"/>
+	<pattern low="47" high="49">000</pattern>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<pattern low="56" high="58">110</pattern>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<!-- other (h20-21 = 2): op h24-26, h11 nosched (limm: h22) -->
+
+<bitset name="#other" extends="#instruction">
+	<pattern low="52" high="53">10</pattern>
+	<pattern low="59" high="63">11111</pattern>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<encode>
+		<map name="PATH">src->path</map>
+		<map name="NVAL">src->n</map>
+		<map name="TGT">src->tgt</map>
+		<map name="F10">src->f10</map>
+		<map name="F12">src->f12</map>
+		<map name="F13">src->f13</map>
+		<map name="F3_20">src->f3_20</map>
+		<map name="F3_6">src->f3_6</map>
+		<map name="NLO">src->n &amp; 3</map>
+		<map name="NHI">src->n &gt;&gt; 2</map>
+		<map name="IMMA">src->imm &amp; 0x3f</map>
+		<map name="IMMB">(src->imm &gt;&gt; 6) &amp; 0x3f</map>
+		<map name="IMMC">src->imm &gt;&gt; 12</map>
+		<map name="I0">src->imm &amp; 0x1fffff</map>
+		<map name="I1">(src->imm &gt;&gt; 21) &amp; 0x1f</map>
+		<map name="I2">src->imm &gt;&gt; 26</map>
+	</encode>
+</bitset>
+
+<bitset name="#other-drc" extends="#other">
+	<display>
+		{NAME} [{NOSCHED} {DRC} {PATH}]
+	</display>
+	<pattern low="0" high="31">00000000000000000000000000000000</pattern>
+	<field name="DRC" pos="32" type="#drc"/>
+	<pattern low="33" high="42">0000000000</pattern>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<pattern low="44" high="45">00</pattern>
+	<pattern low="47" high="51">00000</pattern>
+	<pattern low="54" high="55">00</pattern>
+</bitset>
+
+<bitset name="idf" extends="#other-drc">
+	<field name="PATH" pos="46" type="custom"/>
+	<pattern low="56" high="58">000</pattern>
+</bitset>
+
+<bitset name="wdf" extends="#other-drc">
+	<derived name="PATH" expr="#zero" type="custom"/>
+	<pattern pos="46">0</pattern>
+	<pattern low="56" high="58">001</pattern>
+</bitset>
+
+<bitset name="op0xd7" extends="#other">
+	<display>
+		{NAME} #{NVAL} [{NOSCHED}]
+	</display>
+	<field name="NVAL" low="0" high="3" type="uint"/>
+	<pattern low="4" high="31">0000000000000000000000000000</pattern>
+	<pattern low="32" high="42">00000000000</pattern>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<pattern low="44" high="51">00000000</pattern>
+	<pattern low="54" high="55">00</pattern>
+	<pattern low="56" high="58">010</pattern>
+</bitset>
+
+<bitset name="emit" extends="#other">
+	<doc>
+		All three source slots exist (src0: bank h2, extension h19). n =
+		h0-1 + h9; the 14-bit immediate is l22-27, h3-8, h22-23.
+	</doc>
+	<display>
+		{NAME}{TGT} {SRC0}, {SRC1}, {SRC2} [{NOSCHED} {END} {EN} {F10} {F12} {F13} {F3_20} {EIMM}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="F3_20" pos="21" type="bool" display=" f3_20"/>
+	<field name="IMMA" low="22" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="NLO" low="32" high="33" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="IMMB" low="35" high="40" type="uint"/>
+	<field name="NHI" pos="41" type="uint"/>
+	<field name="F10" pos="42" type="bool" display=" f10"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="F12" pos="44" type="bool" display=" f12"/>
+	<field name="F13" pos="45" type="bool" display=" f13"/>
+	<field name="TGT" low="46" high="47" type="#emit-tgt"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="S0E" pos="51" type="uint"/>
+	<field name="IMMC" low="54" high="55" type="uint"/>
+	<pattern low="56" high="58">011</pattern>
+	<derived name="EN" type="custom" width="3">
+		<expr>{NLO} | ({NHI} &lt;&lt; 2)</expr>
+	</derived>
+	<derived name="EIMM" type="custom" width="14">
+		<expr>{IMMA} | ({IMMB} &lt;&lt; 6) | ({IMMC} &lt;&lt; 12)</expr>
+	</derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7) | ({S0E} &lt;&lt; 8)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="limm" extends="#other">
+	<doc>
+		dst = the destination slot; the 32-bit immediate is l0-20 (bits
+		0-20), h4-8 (21-25), h12-17 (26-31); predicate h9-11.
+	</doc>
+	<display>
+		{LPRED}{NAME} {DST}, {LIMM} [{SKIPINV} {NOSCHED} {END}]
+	</display>
+	<field name="I0" low="0" high="20" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<pattern low="28" high="31">0000</pattern>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<pattern low="34" high="35">00</pattern>
+	<field name="I1" low="36" high="40" type="uint"/>
+	<field name="LPRED" low="41" high="43" type="#pred3"/>
+	<field name="I2" low="44" high="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<pattern low="56" high="58">100</pattern>
+	<derived name="LIMM" type="custom" width="32">
+		<expr>{I0} | ({I1} &lt;&lt; 21) | ({I2} &lt;&lt; 26)</expr>
+	</derived>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="LPRED">src->pred</map>
+	</encode>
+</bitset>
+
+<bitset name="#lock" extends="#other">
+	<display>
+		{NAME} #{NVAL} [{NOSCHED}]
+	</display>
+	<pattern low="1" high="3">000</pattern>
+	<field name="NVAL" low="4" high="6" type="uint"/>
+	<pattern low="7" high="31">0000000000000000000000000</pattern>
+	<pattern low="32" high="42">00000000000</pattern>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<pattern low="44" high="51">00000000</pattern>
+	<pattern low="54" high="55">00</pattern>
+	<pattern low="56" high="58">101</pattern>
+</bitset>
+<bitset name="lock" extends="#lock">
+	<pattern pos="0">0</pattern>
+</bitset>
+<bitset name="release" extends="#lock">
+	<pattern pos="0">1</pattern>
+</bitset>
+
+<expr name="#ldr-imm">({A2B} == 2) &amp;&amp; {A2E}</expr>
+
+<bitset name="#ldrstr" extends="#other">
+	<doc>
+		addr = the src2 slot; as an immediate it has 14 bits, the high 7
+		in l14-20. h19 = str.
+	</doc>
+	<field name="A2N" low="0" high="6" type="uint"/>
+	<field name="A2B" low="28" high="29" type="uint"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="A2E" pos="48" type="uint"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<pattern low="56" high="58">110</pattern>
+	<derived name="ADDR" type="#src" width="10">
+		<expr>{A2N} | ({A2B} &lt;&lt; 7) | ({A2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="A2N">SGX_IS_IMM(2) ? (src->src[2].num &amp; 0x7f) : (SGX_SRC(2, 0) &amp; 0x7f)</map>
+		<map name="A2B">SGX_IS_IMM(2) ? 2 : ((SGX_SRC(2, 0) &gt;&gt; 7) &amp; 3)</map>
+		<map name="A2E">SGX_IS_IMM(2) ? 1 : (SGX_SRC(2, 0) &gt;&gt; 9)</map>
+		<map name="AHI">src->src[2].num &gt;&gt; 7</map>
+		<map name="DN">SGX_DST1() &amp; 0x7f</map>
+		<map name="DB">SGX_DST1() &gt;&gt; 7</map>
+	</encode>
+</bitset>
+
+<bitset name="ldr" extends="#ldrstr">
+	<override expr="#ldr-imm">
+		<display>
+			{NAME} {DST}, #{AIMM} [{SKIPINV} {NOSCHED} {DRC}]
+		</display>
+		<field name="AHI" low="14" high="20" type="uint"/>
+		<derived name="AIMM" type="uint">
+			<expr>{A2N} | ({AHI} &lt;&lt; 7)</expr>
+		</derived>
+	</override>
+	<display>
+		{NAME} {DST}, {ADDR} [{SKIPINV} {NOSCHED} {DRC}]
+	</display>
+	<pattern low="7" high="13">0000000</pattern>
+	<assert low="14" high="20">0000000</assert>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<pattern low="30" high="31">00</pattern>
+	<field name="DRC" pos="32" type="#drc"/>
+	<pattern low="33" high="38">000000</pattern>
+	<field name="DB" pos="39" type="uint"/>
+	<pattern low="40" high="42">000</pattern>
+	<pattern low="44" high="47">0000</pattern>
+	<pattern low="49" high="51">000</pattern>
+	<pattern pos="54">0</pattern>
+	<derived name="DST" type="#dst1" width="8">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+	</derived>
+</bitset>
+
+<bitset name="str" extends="#ldrstr">
+	<override expr="#ldr-imm">
+		<display>
+			{NAME} #{AIMM}, {SRC1} [{SKIPINV} {NOSCHED}]
+		</display>
+		<field name="AHI" low="14" high="20" type="uint"/>
+		<derived name="AIMM" type="uint">
+			<expr>{A2N} | ({AHI} &lt;&lt; 7)</expr>
+		</derived>
+	</override>
+	<display>
+		{NAME} {ADDR}, {SRC1} [{SKIPINV} {NOSCHED}]
+	</display>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<assert low="14" high="20">0000000</assert>
+	<pattern low="21" high="27">0000000</pattern>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<pattern low="32" high="42">00000000000</pattern>
+	<pattern low="44" high="47">0000</pattern>
+	<field name="S1E" pos="49" type="uint"/>
+	<pattern pos="50">0</pattern>
+	<pattern pos="51">1</pattern>
+	<pattern pos="54">0</pattern>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="op0xd6" extends="#other">
+	<display>
+		{NAME} #{NVAL} [{NOSCHED} {F3_6}]
+	</display>
+	<field name="NVAL" low="0" high="2" type="uint"/>
+	<field name="F3_6" pos="3" type="bool" display=" f3_6"/>
+	<pattern low="4" high="31">0000000000000000000000000000</pattern>
+	<pattern low="32" high="42">00000000000</pattern>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<pattern low="44" high="51">00000000</pattern>
+	<pattern low="54" high="55">00</pattern>
+	<pattern low="56" high="58">111</pattern>
+</bitset>
+
+<!-- visibility test (h20-21 = 3) -->
+
+<bitset name="#vis" extends="#instruction">
+	<doc>
+		src0 (bank h2, extension h19), src1, src2; int-source-select
+		flags sel36 h3, sel37 h4, sel34 h5; h23 = syncs.
+	</doc>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="SEL37" pos="36" type="bool" display=" sel37"/>
+	<field name="SEL34" pos="37" type="bool" display=" sel34"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="S0E" pos="51" type="uint"/>
+	<pattern low="52" high="53">11</pattern>
+	<field name="SYNCS" pos="55" type="bool" display=" syncs"/>
+	<pattern low="59" high="63">11111</pattern>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7) | ({S0E} &lt;&lt; 8)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="S0E">SGX_SRC0(0) &gt;&gt; 8</map>
+		<map name="SEL34">src->sel34</map>
+		<map name="SEL36">src->sel36</map>
+		<map name="SEL37">src->sel37</map>
+		<map name="PDST">src->pdst</map>
+		<map name="PW">src->pw</map>
+		<map name="F2_25">src->f2_25</map>
+		<map name="PRED2">src->pred</map>
+		<map name="DN">SGX_DSTX(0) &amp; 0x7f</map>
+		<map name="DB">(SGX_DSTX(0) &gt;&gt; 7) &amp; 3</map>
+	</encode>
+</bitset>
+
+<bitset name="pcoeff" extends="#vis">
+	<display>
+		{NAME} {SRC0}, {SRC1}, {SRC2} [{SYNCS} {NOSCHED} {END} {SEL34} {SEL36} {SEL37}]
+	</display>
+	<pattern low="21" high="27">0000000</pattern>
+	<pattern low="32" high="33">00</pattern>
+	<field name="SEL36" pos="35" type="bool" display=" sel36"/>
+	<pattern low="38" high="42">00000</pattern>
+	<pattern low="44" high="47">0000</pattern>
+	<pattern pos="54">0</pattern>
+	<pattern low="56" high="58">000</pattern>
+</bitset>
+
+<bitset name="ptoff" extends="#instruction">
+	<doc>pcoeff's op with h15 set and every source field 0.</doc>
+	<display>
+		{NAME} [{SYNCS} {NOSCHED} {END}]
+	</display>
+	<pattern low="0" high="31">00000000000000000000000000000000</pattern>
+	<pattern low="32" high="42">00000000000</pattern>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<pattern low="44" high="46">000</pattern>
+	<pattern pos="47">1</pattern>
+	<pattern low="48" high="49">00</pattern>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<pattern pos="51">0</pattern>
+	<pattern low="52" high="54">011</pattern>
+	<field name="SYNCS" pos="55" type="bool" display=" syncs"/>
+	<pattern low="56" high="58">000</pattern>
+	<pattern low="59" high="63">11111</pattern>
+</bitset>
+
+<bitset name="atst8" extends="#vis">
+	<doc>
+		atst8 dst, pdst, src0, src1, src2: dst without extension bit;
+		pdst h7-8, h6 = write it (clear prints .nw); h9-10 a PRED2
+		predicate: a false one kills the pixel.
+	</doc>
+	<display>
+		{PRED2}{NAME} {DST}, {PDST}{PW}, {SRC0}, {SRC1}, {SRC2} [{SYNCS} {NOSCHED} {END} {SEL34} {SEL36} {SEL37} {F2_25}]
+	</display>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="SEL36" pos="35" type="bool" display=" sel36"/>
+	<field name="PW" pos="38" type="bool_inv" display=".nw"/>
+	<field name="PDST" low="39" high="40" type="#pn"/>
+	<field name="PRED2" low="41" high="42" type="#pred2"/>
+	<pattern low="44" high="47">0000</pattern>
+	<field name="F2_25" pos="54" type="bool" display=" f2_25"/>
+	<pattern low="56" high="58">001</pattern>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="depthf" extends="#vis">
+	<display>
+		{PRED2}{NAME} {SRC0}, {SRC1}, {SRC2} [{SYNCS} {NOSCHED} {END} {SEL34} {SEL37}]
+	</display>
+	<pattern low="21" high="27">0000000</pattern>
+	<pattern low="32" high="33">00</pattern>
+	<pattern pos="35">0</pattern>
+	<pattern low="38" high="40">000</pattern>
+	<field name="PRED2" low="41" high="42" type="#pred2"/>
+	<pattern low="44" high="47">0000</pattern>
+	<pattern pos="54">0</pattern>
+	<pattern low="56" high="58">011</pattern>
+</bitset>
+
+<!-- phase (h20-22 = 4, h23 = 0) -->
+
+<bitset name="#phase" extends="#instruction">
+	<pattern low="52" high="55">0100</pattern>
+	<pattern low="59" high="63">11111</pattern>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<encode>
+		<map name="PC">src->target</map>
+		<map name="TEMPS4">src->temps4</map>
+		<map name="WAIT">src->wait</map>
+		<map name="RATE">src->rate</map>
+		<map name="SEL43">src->sel43</map>
+		<map name="NVAL">src->n</map>
+		<map name="F3_11">src->f3_11</map>
+		<map name="F3_12">src->f3_12</map>
+	</encode>
+</bitset>
+
+<bitset name="#phase-src" extends="#phase">
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<pattern low="14" high="27">00000000000000</pattern>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="phas" extends="#phase-src">
+	<display>
+		{NAME} {SRC1}, {SRC2} [{NOSCHED} {END}]
+	</display>
+	<pattern low="32" high="42">00000000000</pattern>
+	<pattern low="44" high="47">0000</pattern>
+	<pattern pos="50">0</pattern>
+	<field name="END" pos="51" type="bool" display=" end"/>
+	<pattern low="56" high="58">010</pattern>
+</bitset>
+
+<bitset name="phas.i" extends="#phase">
+	<doc>
+		pc l0-17 (absolute), temps4 h0-7 (temporaries / 4), wait h8-10,
+		rate h11-12, sel43 h13, end h19.
+	</doc>
+	<display>
+		{NAME} #{PC}, #{TEMPS4} [{END} {RATE} {WAIT} {SEL43}]
+	</display>
+	<field name="PC" low="0" high="17" type="uint"/>
+	<pattern low="18" high="31">00000000000000</pattern>
+	<field name="TEMPS4" low="32" high="39" type="uint"/>
+	<field name="WAIT" low="40" high="42" type="#phas-wait"/>
+	<field name="RATE" low="43" high="44" type="#phas-rate"/>
+	<field name="SEL43" pos="45" type="bool" display=" sel43"/>
+	<pattern low="46" high="49">0000</pattern>
+	<pattern pos="50">1</pattern>
+	<field name="END" pos="51" type="bool" display=" end"/>
+	<pattern low="56" high="58">010</pattern>
+</bitset>
+
+<bitset name="#opff" extends="#phase-src">
+	<display>
+		{NAME} {SRC1}, {SRC2}, #{NVAL} [{NOSCHED} {F3_11} {F3_12}]
+	</display>
+	<pattern low="32" high="39">00000000</pattern>
+	<field name="NVAL" low="40" high="41" type="uint"/>
+	<pattern pos="42">0</pattern>
+	<field name="F3_12" pos="46" type="bool" display=" f3_12"/>
+	<field name="F3_11" pos="47" type="bool" display=" f3_11"/>
+	<pattern low="50" high="51">00</pattern>
+	<pattern low="56" high="58">000</pattern>
+</bitset>
+<bitset name="op0xff" extends="#opff">
+	<pattern low="44" high="45">01</pattern>
+</bitset>
+<bitset name="op0xfe" extends="#opff">
+	<pattern low="44" high="45">10</pattern>
+</bitset>
+<bitset name="op0x100" extends="#opff">
+	<pattern low="44" high="45">11</pattern>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 07, 10-1a: integer, fixed point and multi-unit ops; hw 1b: fdual    -->
+<!-- ===================================================================== -->
+
+<!--
+Format control: the low digits of ISA_GPU_ID() carry it (bit 0 = setfc a1,
+the C10 enable; bit 1 = setfc a0, efo's F16 enable).
+-->
+<expr name="#fc-c10">(ISA_GPU_ID() % 100 &amp; 1) ? 3 : 0</expr>
+<expr name="#fc-f16">(ISA_GPU_ID() % 100 &amp; 2) ? 4 : 0</expr>
+
+<enum name="#rpt8">
+	<value val="0" display=""/>
+	<value val="1" display=" rpt=2"/>
+	<value val="2" display=" rpt=3"/>
+	<value val="3" display=" rpt=4"/>
+	<value val="4" display=" rpt=5"/>
+	<value val="5" display=" rpt=6"/>
+	<value val="6" display=" rpt=7"/>
+	<value val="7" display=" rpt=8"/>
+</enum>
+
