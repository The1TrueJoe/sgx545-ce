From: Joseph Telaak <joseph@telaak.dev>
Subject: [PATCH] drm/gma500: a switch for Cedarview's single-pipe memory self-refresh

Test kits only, never upstream. With one pipe on, cdv_update_wm()
programs fixed FIFO watermarks and turns memory self-refresh on; they
aren't computed from the mode or the memory's exit latency. On a D2500
laptop a dark boot differs from a good one only in pipe B's FIFO
underrun bit. gma500_gfx.cdv_sr=0 keeps self-refresh off, so a tester
can see whether the dark boots go with it.

Assisted-by: Claude:claude-opus-5-5
---
--- a/drivers/gpu/drm/gma500/cdv_intel_display.c
+++ b/drivers/gpu/drm/gma500/cdv_intel_display.c
@@ -8,6 +8,7 @@
 
 #include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/module.h>
 
 #include <drm/drm_crtc.h>
 #include <drm/drm_modeset_helper_vtables.h>
@@ -489,6 +490,14 @@
 
 }
 
+/*
+ * Test kits only, not upstream: memory self-refresh with one pipe on, which
+ * comes with fixed watermarks; off, to see whether it causes the underruns.
+ */
+static bool cdv_sr = true;
+module_param(cdv_sr, bool, 0444);
+MODULE_PARM_DESC(cdv_sr, "Memory self-refresh with a single pipe (test kits; default on)");
+
 void cdv_update_wm(struct drm_device *dev, struct drm_crtc *crtc)
 {
 	struct drm_psb_private *dev_priv = to_drm_psb_private(dev);
@@ -533,9 +542,11 @@
 		gma_wait_for_vblank(dev);
 
 		/* enable self-refresh for single pipe active */
-		REG_WRITE(FW_BLC_SELF, FW_BLC_SELF_EN);
-		REG_READ(FW_BLC_SELF);
-		gma_wait_for_vblank(dev);
+		if (cdv_sr) {
+			REG_WRITE(FW_BLC_SELF, FW_BLC_SELF_EN);
+			REG_READ(FW_BLC_SELF);
+			gma_wait_for_vblank(dev);
+		}
 
 	} else {
 
