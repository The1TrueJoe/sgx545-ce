+	</encode>
+</bitset>
+
+<bitset name="#src-reg" extends="#src">
+	<override expr="#m-half">
+		<display>{NAME}{REG}.f16.{HALF}</display>
+		<field name="HALF" pos="0" type="#half"/>
+		<field name="REG" low="1" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-c10">
+		<display>{NAME}{LNUM}.c10</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<display>{NAME}{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+</bitset>
+
+<bitset name="#src.r" extends="#src-reg" displayname="r">
+	<pattern low="7" high="9">000</pattern>
+</bitset>
+<bitset name="#src.o" extends="#src-reg" displayname="o">
+	<pattern low="7" high="9">001</pattern>
+</bitset>
+<bitset name="#src.pa" extends="#src-reg" displayname="pa">
+	<pattern low="7" high="9">010</pattern>
+</bitset>
+<bitset name="#src.sa" extends="#src-reg" displayname="sa">
+	<pattern low="7" high="9">011</pattern>
+</bitset>
+
+<bitset name="#src.ix" extends="#src">
+	<override expr="#m-sel-f16">
+		<display>{IB}[idx{KK}+{OFF}].f16</display>
+		<field name="OFF" low="0" high="2" type="uint"/>
+		<field name="K" pos="3" type="uint"/>
+		<field name="IB" low="4" high="5" type="#ibank"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-sel-c10">
+		<display>{IB}[idx{KK}+{OFF}].c10</display>
+		<field name="OFF" low="0" high="2" type="uint"/>
+		<field name="K" pos="3" type="uint"/>
+		<field name="IB" low="4" high="5" type="#ibank"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-sel">
+		<display>{IB}[idx{KK}+{OFF}]</display>
+		<field name="OFF" low="0" high="2" type="uint"/>
+		<field name="K" pos="3" type="uint"/>
+		<field name="IB" low="4" high="5" type="#ibank"/>
+	</override>
+	<display>{IB}[idx{KK}+{OFF}]</display>
+	<field name="OFF" low="0" high="3" type="uint"/>
+	<field name="K" pos="4" type="uint"/>
+	<field name="IB" low="5" high="6" type="#ibank"/>
+	<derived name="KK" type="uint">
+		<expr>{K} + 1</expr>
+	</derived>
+	<pattern low="7" high="9">100</pattern>
+</bitset>
+
+<bitset name="#src.c" extends="#src">
+	<doc>c&lt;n&gt; is n (0-63); g&lt;n&gt; is n + 0x40 on the same bank.</doc>
+	<override expr="#m-sel-f16">
+		<display>c{LNUM}.f16</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-sel-c10">
+		<display>c{LNUM}.c10</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-g">
+		<display>g{GNUM}</display>
+		<derived name="GNUM" type="uint">
+			<expr>{NUM} - 64</expr>
+		</derived>
+	</override>
+	<display>c{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+	<pattern low="7" high="9">101</pattern>
+</bitset>
+
+<bitset name="#src.imm" extends="#src">
+	<override expr="#m-sel-f16">
+		<display>#{LNUM}.f16</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-sel-c10">
+		<display>#{LNUM}.c10</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<display>#{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+	<pattern low="7" high="9">110</pattern>
+</bitset>
+
+<bitset name="#src.i" extends="#src">
+	<override expr="#m-half">
+		<display>i{LNUM}.f16</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-c10">
+		<display>i{LNUM}.c10</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<display>i{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+	<pattern low="7" high="9">111</pattern>
+</bitset>
+
+<!--
+src0 slot: number l14-20, bank h2, and an extension bit whose position
+depends on the class (none in the float classes). Rebuilt as
+NUM | BANK << 7 | EXT << 8.
+-->
+<bitset name="#src0" size="9">
+	<encode type="struct sgx_isa_src *" case-prefix="SGX_">
+		<map name="NUM">sgx_isa_reg_num(src)</map>
+		<map name="LNUM">src->num</map>
+		<map name="REG">src->num</map>
+		<map name="HALF">src->half</map>
+		<map name="F">src->fmt != SGX_ISA_FMT_NONE</map>
+	</encode>
+</bitset>
+
+<bitset name="#src0-reg" extends="#src0">
+	<override expr="#m-half">
+		<display>{NAME}{REG}.f16.{HALF}</display>
+		<field name="HALF" pos="0" type="#half"/>
+		<field name="REG" low="1" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<override expr="#m-c10">
+		<display>{NAME}{LNUM}.c10</display>
+		<field name="LNUM" low="0" high="5" type="uint"/>
+		<field name="F" pos="6" type="bool"/>
+	</override>
+	<display>{NAME}{NUM}</display>
+	<field name="NUM" low="0" high="6" type="uint"/>
+</bitset>
+
+<bitset name="#src0.r" extends="#src0-reg" displayname="r">
+	<pattern low="7" high="8">00</pattern>
+</bitset>
+<bitset name="#src0.pa" extends="#src0-reg" displayname="pa">
+	<pattern low="7" high="8">01</pattern>
+</bitset>
+<bitset name="#src0.o" extends="#src0-reg" displayname="o">
+	<pattern low="7" high="8">10</pattern>
+</bitset>
+<bitset name="#src0.sa" extends="#src0-reg" displayname="sa">
+	<pattern low="7" high="8">11</pattern>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- Instructions                                                           -->
+<!-- ===================================================================== -->
+
+<bitset name="#instruction" size="64">
+	<doc>
+		h27-31 (bits 59-63) is the hardware class; each class splits
+		further on its own sub-op bits.
+	</doc>
+	<gen min="54500" max="54599"/>
+	<encode type="struct sgx_isa_instr *" case-prefix="SGX_ISA_OPC_">
+		<map name="PRED">src->pred</map>
+		<map name="SKIPINV">src->skipinv</map>
+		<map name="NOSCHED">src->nosched</map>
+		<map name="SYNCS">src->syncs</map>
+		<map name="END">src->end</map>
+		<map name="FMT">src->fmt</map>
+		<map name="MOE">src->moe</map>
+		<map name="INC0">src->inc[0]</map>
+		<map name="INC1">src->inc[1]</map>
+		<map name="INC2">src->inc[2]</map>
+		<map name="RPT">sgx_isa_rpt(src)</map>
+		<map name="RCNT">src->rcnt</map>
+		<map name="RPTMASK">src->rcnt ? sgx_isa_rpt(src) : src->mask</map>
+
+		<map name="DN">SGX_DST(0) &amp; 0x7f</map>
+		<map name="DB">(SGX_DST(0) &gt;&gt; 7) &amp; 3</map>
+		<map name="DE">SGX_DST(0) &gt;&gt; 9</map>
+		<map name="S0N">SGX_SRC0(0) &amp; 0x7f</map>
+		<map name="S0B">(SGX_SRC0(0) &gt;&gt; 7) &amp; 1</map>
+		<map name="S0E">SGX_SRC0(0) &gt;&gt; 8</map>
+		<map name="S1N">SGX_SRC(1, 0) &amp; 0x7f</map>
+		<map name="S1B">(SGX_SRC(1, 0) &gt;&gt; 7) &amp; 3</map>
+		<map name="S1E">SGX_SRC(1, 0) &gt;&gt; 9</map>
+		<map name="S2N">SGX_SRC(2, 0) &amp; 0x7f</map>
+		<map name="S2B">(SGX_SRC(2, 0) &gt;&gt; 7) &amp; 3</map>
+		<map name="S2E">SGX_SRC(2, 0) &gt;&gt; 9</map>
+		<map name="S0NEG">src->src[0].neg</map>
+		<map name="S0ABS">src->src[0].abs</map>
+		<map name="S1NEG">src->src[1].neg</map>
+		<map name="S1ABS">src->src[1].abs</map>
+		<map name="S2NEG">src->src[2].neg</map>
+		<map name="S2ABS">src->src[2].abs</map>
+		<map name="L1">src->src[1].lane</map>
+		<map name="L2">src->src[2].lane</map>
+		<map name="DRC">src->drc</map>
+
+		<!-- integer / fixed-point / hw 16-17 fields -->
+		<map name="RPT">sgx_isa_rpt(src)</map>
+		<map name="C0SEL">src->c0 &amp; 3</map>
+		<map name="C0C">src->c0c</map>
+		<map name="C1SEL">src->c1</map>
+		<map name="C1C">src->c1c</map>
+		<map name="C2SEL">src->c2</map>
+		<map name="C2C">src->c2c</map>
+		<map name="A0SEL">src->a0</map>
+		<map name="A0C">src->a0c</map>
+		<map name="A1SEL">src->a1</map>
+		<map name="A1C">src->a1c</map>
+		<map name="A2SEL">src->a2</map>
+		<map name="A2C">src->a2c</map>
+		<map name="ASEL">src->asel</map>
+		<map name="AC">src->aselc</map>
+		<map name="COP">src->cop</map>
+		<map name="AOP">src->aop</map>
+		<map name="CS1C">src->cs1c</map>
+		<map name="AS1C">src->as1c</map>
+		<map name="ANEG">src->aneg</map>
+		<map name="AREV">src->arev</map>
+		<map name="CNEG">src->cneg</map>
+		<map name="L1SEL">src->l1</map>
+		<map name="L1C">src->l1c</map>
+		<map name="L2SEL">src->l2</map>
+		<map name="L2C">src->l2c</map>
+		<map name="LCS">src->lcs</map>
+		<map name="P0">src->p &amp; 1</map>
+		<map name="P1">src->p &gt;&gt; 1</map>
+		<map name="M012">src->mask &amp; 7</map>
+		<map name="M3">src->mask &gt;&gt; 3</map>
+		<map name="SAT">src->sat</map>
+		<map name="SGN">src->sgn</map>
+		<map name="F2_15">src->f2_15</map>
+		<map name="DFLAG1">src->dflag1</map>
+		<map name="F1">src->f1</map>
+		<map name="F2">src->f2</map>
+		<map name="S0HI">src->s0hi</map>
+		<map name="S1HI">src->s1hi</map>
+		<map name="S2HI">src->s2hi</map>
+		<map name="T2">src->t2</map>
+		<map name="COUT">src->cout</map>
+		<map name="CIN">src->cin</map>
+		<map name="CI">src->ci</map>
+		<map name="HI">src->hi</map>
+		<map name="NEGP">src->negp</map>
+		<map name="F6">src->f6</map>
+		<map name="F4">src->f4</map>
+		<map name="DCS">src->dcs</map>
+		<map name="DAS">src->das</map>
+		<map name="S1C">src->s1c</map>
+		<map name="S2C">src->s2c</map>
+		<map name="S1AC">src->s1ac</map>
+		<map name="FMTX">src->ifmt</map>
+		<map name="ILEAVE">src->ileave</map>
+		<map name="SRC23">src->src23</map>
+		<map name="DST23">src->dst23</map>
+		<map name="IRND">src->irnd</map>
+		<map name="X1B">src->x1b</map>
+		<map name="X1C">src->x1c</map>
+		<map name="X1D">src->x1d</map>
+		<map name="NF16">src->nf16</map>
+		<map name="S8">src->s8</map>
+		<map name="X38">src->x38</map>
+		<map name="X39">src->x39</map>
+		<map name="II">src->ii</map>
+		<map name="S0F13">src->s0f13</map>
+		<map name="A5">src->a5</map>
+		<map name="COEF">src->coef</map>
+		<map name="SH01">src->shift &amp; 3</map>
+		<map name="SH23">(src->shift &gt;&gt; 2) &amp; 3</map>
+		<map name="SH4">src->shift &gt;&gt; 4</map>
+		<map name="A8">src->a8</map>
+		<map name="F2_27">src->f2_27</map>
+		<map name="S0NEG">src->src[0].neg</map>
+		<map name="S2NEG">src->src[2].neg</map>
+	</encode>
+</bitset>
+
+
+<!-- ===================================================================== -->
+<!-- hw 00-04: float                                                        -->
+<!-- ===================================================================== -->
+
+<expr name="#float-smode">{FMT}</expr>
+
+<bitset name="#alu-float" extends="#instruction">
+	<doc>Fields common to hw 0, 2, 3 and 4 (the float classes).</doc>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="RPT" low="44" high="45" type="#rpt4"/>
+	<field name="INC1" pos="46" type="bool" display=" inc1"/>
+	<field name="INC0" pos="47" type="bool" display=" inc0"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="MOE" pos="53" type="bool" display=" moe"/>
+	<field name="FMT" pos="54" type="bool" display=" fmt"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<derived name="SMODE" expr="#float-smode" type="uint"/>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="SMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="SMODE" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="S0N">SGX_SRC0(SGX_EXPR(__float_smode)) &amp; 0x7f</map>
+		<map name="S0B">(SGX_SRC0(SGX_EXPR(__float_smode)) &gt;&gt; 7) &amp; 1</map>
+		<map name="S1N">SGX_SRC(1, SGX_EXPR(__float_smode)) &amp; 0x7f</map>
+		<map name="S1B">(SGX_SRC(1, SGX_EXPR(__float_smode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S1E">SGX_SRC(1, SGX_EXPR(__float_smode)) &gt;&gt; 9</map>
+		<map name="S2N">SGX_SRC(2, SGX_EXPR(__float_smode)) &amp; 0x7f</map>
+		<map name="S2B">(SGX_SRC(2, SGX_EXPR(__float_smode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S2E">SGX_SRC(2, SGX_EXPR(__float_smode)) &gt;&gt; 9</map>
+	</encode>
+</bitset>
+
+<template name="FLOAT_FLAGS">[{SKIPINV} {NOSCHED} {SYNCS} {END} {RPT} {MOE} {INC0} {INC1} {INC2} {FMT}]</template>
+<template name="FSRC1">{S1NEG}{S1ABS}{SRC1}{S1ABS}</template>
+<template name="FSRC2">{S2NEG}{S2ABS}{SRC2}{S2ABS}</template>
+
+<bitset name="#float-mod" extends="#alu-float">
+	<doc>Source modifiers: h3/h4 = -src2 / |src2|, h5/h6 = -src1 / |src1|.</doc>
+	<field name="S2NEG" pos="35" type="bool" display="-"/>
+	<field name="S2ABS" pos="36" type="bool" display="|"/>
+	<field name="S1NEG" pos="37" type="bool" display="-"/>
+	<field name="S1ABS" pos="38" type="bool" display="|"/>
+	<field name="INC2" pos="40" type="bool" display=" inc2"/>
+	<field name="DE" pos="51" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="#float-3src" extends="#float-mod">
+	<display>
+		{PRED}{NAME} {DST}, {S0ABS}{SRC0}{S0ABS}, {FSRC1}, {FSRC2} {FLOAT_FLAGS}
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="S0ABS" pos="39" type="bool" display="|"/>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="SMODE" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="#float-2src" extends="#float-mod">
+	<display>
+		{PRED}{NAME} {DST}, {FSRC1}, {FSRC2} {FLOAT_FLAGS}
+	</display>
+	<pattern low="14" high="20">0000000</pattern>
+	<pattern pos="34">0</pattern>
+	<pattern pos="39">0</pattern>
+</bitset>
+
+<bitset name="fmad" extends="#float-3src">
+	<pattern low="41" high="42">00</pattern>
+	<pattern low="59" high="63">00000</pattern>
+</bitset>
+<bitset name="fadm" extends="#float-3src">
+	<pattern low="41" high="42">01</pattern>
+	<pattern low="59" high="63">00000</pattern>
+</bitset>
+<bitset name="fmsa" extends="#float-3src">
+	<pattern low="41" high="42">10</pattern>
+	<pattern low="59" high="63">00000</pattern>
+</bitset>
+<bitset name="fsubflr" extends="#float-2src">
+	<pattern low="41" high="42">11</pattern>
+	<pattern low="59" high="63">00000</pattern>
+</bitset>
+
+<bitset name="fdp" extends="#float-2src">
+	<pattern low="41" high="42">00</pattern>
+	<pattern low="59" high="63">00010</pattern>
+</bitset>
+
+<bitset name="fdpc" extends="#float-mod">
+	<doc>fdp plus a clip-plane result cp0-7 in l15-17, l14 set.</doc>
+	<display>
+		{PRED}{NAME} {DST}, {CP}, {FSRC1}, {FSRC2} {FLOAT_FLAGS}
+	</display>
+	<pattern pos="14">1</pattern>
+	<field name="CP" low="15" high="17" type="#cp"/>
+	<pattern low="18" high="20">000</pattern>
+	<pattern pos="34">0</pattern>
+	<pattern pos="39">0</pattern>
+	<pattern low="41" high="42">00</pattern>
+	<pattern low="59" high="63">00010</pattern>
+	<encode>
+		<map name="CP">src->cp[0]</map>
+	</encode>
+</bitset>
+
+<bitset name="fmaxmin" extends="#float-3src">
+	<pattern low="41" high="42">00</pattern>
+	<pattern low="59" high="63">00011</pattern>
+</bitset>
+<bitset name="fminmax" extends="#float-3src">
+	<pattern low="41" high="42">01</pattern>
+	<pattern low="59" high="63">00011</pattern>
+</bitset>
+
+<bitset name="fdsx" extends="#float-2src">
+	<pattern low="41" high="42">00</pattern>
+	<pattern low="59" high="63">00100</pattern>
+</bitset>
+<bitset name="fdsy" extends="#float-2src">
+	<pattern low="41" high="42">01</pattern>
+	<pattern low="59" high="63">00100</pattern>
+</bitset>
+
+<bitset name="#float-ddp" extends="#alu-float">
+	<doc>
+		fddp/fddpc: two dot products, the second into i0/i1 (h19), so the
+		destination has no extension bit.
+	</doc>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="IDST" pos="51" type="#i01"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="SMODE" as="MODE"/>
+	</derived>
+	<pattern low="59" high="63">00010</pattern>
+	<encode>
+		<map name="IDST">src->idst</map>
+		<map name="DN">SGX_DSTX(0) &amp; 0x7f</map>
+		<map name="DB">(SGX_DSTX(0) &gt;&gt; 7) &amp; 3</map>
+	</encode>
+</bitset>
+
+<bitset name="fddp" extends="#float-ddp">
+	<display>
+		{PRED}{NAME} {DST}, {IDST}, {S0ABS}{SRC0}{S0ABS}, {FSRC1}, {FSRC2} {FLOAT_FLAGS}
+	</display>
+	<field name="S2NEG" pos="35" type="bool" display="-"/>
+	<field name="S2ABS" pos="36" type="bool" display="|"/>
+	<field name="S1NEG" pos="37" type="bool" display="-"/>
+	<field name="S1ABS" pos="38" type="bool" display="|"/>
+	<field name="S0ABS" pos="39" type="bool" display="|"/>
+	<field name="INC2" pos="40" type="bool" display=" inc2"/>
+	<pattern low="41" high="42">01</pattern>
+</bitset>
+
+<bitset name="fddpc" extends="#float-ddp">
+	<doc>
+		Clip planes in h3-5 and h6-8, no source modifiers. h8 is also inc2:
+		the word holds the OR of the two, so inc2 is folded into
+		CPB here.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {IDST}, {CPA}, {CPB}, {SRC0}, {SRC1}, {SRC2} {FLOAT_FLAGS}
+	</display>
+	<field name="CPA" low="35" high="37" type="#cp"/>
+	<field name="CPB" low="38" high="40" type="#cp"/>
+	<derived name="INC2" expr="#zero" type="bool" display=""/>
+	<pattern low="41" high="42">10</pattern>
+	<encode>
+		<map name="CPA">src->cp[0]</map>
+		<map name="CPB">src->cp[1] | (src->inc[2] &lt;&lt; 2)</map>
+	</encode>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 01: float scalar                                                    -->
+<!-- ===================================================================== -->
+
+<bitset name="#float-scalar" extends="#instruction">
+	<doc>
+		One source, in the src1 slot. h7 = F16 source (h3 picks the half),
+		h8 = C10 source (h3-4 the channel), h2 = F16 destination. h21 =
+		rcnt: h12-15 is count - 1 when set, else a write mask.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {S1NEG}{S1ABS}{SRC1}{S1ABS} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM} {F16} {C10} {CHAN} {F16D}]
+	</display>
+	<pattern low="0" high="6">0000000</pattern>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<pattern low="14" high="20">0000000</pattern>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<pattern low="28" high="29">00</pattern>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="F16D" pos="34" type="bool" display=" f16d"/>
+	<field name="CHAN" low="35" high="36" type="#chan4"/>
+	<field name="S1NEG" pos="37" type="bool" display="-"/>
+	<field name="S1ABS" pos="38" type="bool" display="|"/>
+	<field name="F16" pos="39" type="bool" display=" f16"/>
+	<field name="C10" pos="40" type="bool" display=" c10"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="RPTMASK" low="44" high="47" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="RCNT" pos="53" type="bool"/>
+	<pattern pos="54">0</pattern>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<pattern low="59" high="63">00001</pattern>
+	<derived name="RM" type="#rm0">
+		<expr>{RPTMASK} | ({RCNT} &lt;&lt; 4)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="F16D">src->f16d</map>
+		<map name="CHAN">src->chan</map>
+		<map name="F16">src->sf16</map>
+		<map name="C10">src->sc10</map>
+	</encode>
+</bitset>
+
+<!-- sub-op: h9-10 low bits, h16 bit 2 -->
+<bitset name="frcp" extends="#float-scalar">
+	<pattern low="41" high="42">00</pattern>
+	<pattern pos="48">0</pattern>
+</bitset>
+<bitset name="frsq" extends="#float-scalar">
+	<pattern low="41" high="42">01</pattern>
+	<pattern pos="48">0</pattern>
+</bitset>
+<bitset name="flog2" extends="#float-scalar">
+	<pattern low="41" high="42">10</pattern>
+	<pattern pos="48">0</pattern>
+</bitset>
+<bitset name="fexp2" extends="#float-scalar">
+	<pattern low="41" high="42">11</pattern>
+	<pattern pos="48">0</pattern>
+</bitset>
+<bitset name="fsqrt" extends="#float-scalar">
+	<pattern low="41" high="42">00</pattern>
+	<pattern pos="48">1</pattern>
+</bitset>
+<bitset name="fsin" extends="#float-scalar">
+	<pattern low="41" high="42">01</pattern>
+	<pattern pos="48">1</pattern>
+</bitset>
+<bitset name="fcos" extends="#float-scalar">
+	<pattern low="41" high="42">10</pattern>
+	<pattern pos="48">1</pattern>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 06: fmad16                                                          -->
+<!-- ===================================================================== -->
+
+<bitset name="fmad16" extends="#instruction">
+	<doc>
+		Every operand is a whole register holding an F16 pair. Swizzles:
+		src0 h9-10, src1 h13 + h18, src2 h21-22; repeat 1-2 in h12, with
+		explicit increments. No end bit.
+	</doc>
+	<display>
+		{PRED}{NAME} {DST}, {S0ABS}{SRC0}{S0ABS}, {S1NEG}{S1ABS}{SRC1}{S1ABS}, {S2NEG}{S2ABS}{SRC2}{S2ABS} [{SKIPINV} {NOSCHED} {SYNCS} {RPT} {INC0} {INC1} {INC2} {SW0} {SW1} {SW2}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<field name="S2NEG" pos="35" type="bool" display="-"/>
+	<field name="S2ABS" pos="36" type="bool" display="|"/>
+	<field name="S1NEG" pos="37" type="bool" display="-"/>
+	<field name="S1ABS" pos="38" type="bool" display="|"/>
+	<field name="S0ABS" pos="39" type="bool" display="|"/>
+	<field name="INC2" pos="40" type="bool" display=" inc2"/>
+	<field name="SW0" low="41" high="42" type="#swz0"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="RPT" pos="44" type="#rpt2"/>
+	<field name="SW1LO" pos="45" type="uint"/>
+	<field name="INC1" pos="46" type="bool" display=" inc1"/>
+	<field name="INC0" pos="47" type="bool" display=" inc0"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="SW1HI" pos="50" type="uint"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="SW2" low="53" high="54" type="#swz2"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<pattern low="59" high="63">00110</pattern>
+	<derived name="SW1" type="#swz1">
+		<expr>{SW1LO} | ({SW1HI} &lt;&lt; 1)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="SW0">src->swz[0]</map>
+		<map name="SW1LO">src->swz[1] &amp; 1</map>
+		<map name="SW1HI">src->swz[1] &gt;&gt; 1</map>
+		<map name="SW2">src->swz[2]</map>
+	</encode>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 05: moves                                                           -->
+<!-- ===================================================================== -->
+
+<bitset name="#move" extends="#instruction">
+	<doc>h8-10 picks the form; h21 rcnt, h12-15 count - 1 or write mask.</doc>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="NOSCHED" pos="43" type="bool" display=" nosched"/>
+	<field name="RPTMASK" low="44" high="47" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="RCNT" pos="53" type="bool"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<pattern low="59" high="63">00101</pattern>
+	<derived name="RM" type="#rm0">
+		<expr>{RPTMASK} | ({RCNT} &lt;&lt; 4)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+</bitset>
+
+<bitset name="mov" extends="#move">
+	<doc>src0's field is 0; src2 holds the unused-source pattern (#0).</doc>
+	<display>
+		{PRED}{NAME} {DST}, {SRC1} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM}]
+	</display>
+	<pattern low="0" high="6">0000000</pattern>
+	<pattern low="14" high="20">0000000</pattern>
+	<pattern low="28" high="29">10</pattern>
+	<pattern low="34" high="42">000000000</pattern>
+	<pattern pos="48">1</pattern>
+	<pattern pos="54">0</pattern>
+</bitset>
+
+<bitset name="#movc" extends="#move">
+	<doc>movc.&lt;cond&gt;.&lt;type&gt; d, s0, s1, s2: d = test(s0) ? s1 : s2.</doc>
+	<display>
+		{PRED}movc{COND}{TYPE} {DST}, {SRC0}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<pattern low="35" high="38">0000</pattern>
+	<field name="C0" pos="39" type="uint"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="C1" pos="54" type="uint"/>
+	<derived name="COND" type="#movc-cond">
+		<expr>{C0} | ({C1} &lt;&lt; 1)</expr>
+	</derived>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="C0">src->cond &amp; 1</map>
+		<map name="C1">src->cond &gt;&gt; 1</map>
+	</encode>
+</bitset>
+
+<bitset name="movc.u8" extends="#movc">
+	<derived name="TYPE" type="#movc-type"><expr>1</expr></derived>
+	<pattern low="40" high="42">001</pattern>
+</bitset>
+<bitset name="movc.i16" extends="#movc">
+	<derived name="TYPE" type="#movc-type"><expr>2</expr></derived>
+	<pattern low="40" high="42">010</pattern>
+</bitset>
+<bitset name="movc.i32" extends="#movc">
+	<derived name="TYPE" type="#movc-type"><expr>3</expr></derived>
+	<pattern low="40" high="42">011</pattern>
+</bitset>
+<bitset name="movc.f32" extends="#movc">
+	<derived name="TYPE" type="#movc-type"><expr>4</expr></derived>
+	<pattern low="40" high="42">100</pattern>
+</bitset>
+<bitset name="movc.c10" extends="#movc">
+	<derived name="TYPE" type="#movc-type"><expr>5</expr></derived>
+	<pattern low="40" high="42">101</pattern>
+</bitset>
+
+<bitset name="#op0xf3" extends="#move">
+	<doc>
+		op0xf3 (writes an output; never emitted by the compiler).
+		f1_1 = h7, f1_26 = h22, a3f = h5-6.
+	</doc>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<pattern low="35" high="36">00</pattern>
+	<field name="A3F" low="37" high="38" type="uint"/>
+	<field name="F1_1" pos="39" type="bool" display=" f1_1"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="F1_26" pos="54" type="bool" display=" f1_26"/>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="A3F">src->a3f</map>
+		<map name="F1_1">src->f1_1</map>
+		<map name="F1_26">src->f1_26</map>
+	</encode>
+</bitset>
+
+<bitset name="op0xf3.s6" extends="#op0xf3">
+	<display>
+		{PRED}{NAME} {DST}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM} {F1_1} {F1_26} a3f={A3F}]
+	</display>
+	<pattern low="14" high="20">0000000</pattern>
+	<pattern pos="34">0</pattern>
+	<pattern low="40" high="42">110</pattern>
+</bitset>
+
+<bitset name="op0xf3.s7" extends="#op0xf3">
+	<display>
+		{PRED}{NAME} {DST}, {SRC0}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM} {F1_1} {F1_26} a3f={A3F}]
+	</display>
+	<field name="S0N" low="14" high="20" type="uint"/>
+	<field name="S0B" pos="34" type="uint"/>
+	<derived name="SRC0" type="#src0" width="9">
+		<expr>{S0N} | ({S0B} &lt;&lt; 7)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<pattern low="40" high="42">111</pattern>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 08: pack / unpack                                                   -->
+<!-- ===================================================================== -->
+
+<bitset name="pck" extends="#instruction">
+	<doc>
+		pck.&lt;dst&gt;.&lt;src&gt; d, s1[.l&lt;n&gt;], s2[.l&lt;n&gt;]. The enabled bytes of dmask,
+		low to high, take src1, src2, src1, src2.
+	</doc>
+	<display>
+		{PRED}{NAME}{DFMT}{SFMT} {DST}, {SRC1}{L1}, {SRC2}{L2} [{SKIPINV} {NOSCHED} {SYNCS} {END} {RM} {DMASK} {SCALE} {RND}]
+	</display>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="L2" low="14" high="15" type="#lane"/>
+	<field name="L1" low="16" high="17" type="#lane"/>
+	<field name="L18" pos="18" type="uint"/>
+	<field name="RND" low="19" high="20" type="#rnd"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="DMASK" low="34" high="37" type="#dmask"/>
+	<field name="DFMT" low="38" high="40" type="#pck-fmt"/>
+	<field name="SFMT" low="41" high="43" type="#pck-fmt"/>
+	<field name="RPTMASK" low="44" high="47" type="uint"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="END" pos="50" type="bool" display=" end"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="RCNT" pos="53" type="bool"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<pattern low="59" high="63">01000</pattern>
+	<derived name="RM" type="#rm1">
+		<expr>{RPTMASK} | ({RCNT} &lt;&lt; 4)</expr>
+	</derived>
+	<derived name="SCALE" type="#pck-l18">
+		<expr>{L18} | ((({DFMT} == 5 || {DFMT} == 6) &amp;&amp; ({SFMT} == 5 || {SFMT} == 6)) &lt;&lt; 1)</expr>
+	</derived>
+	<derived name="MODE0" expr="#zero" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="MODE0" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="L18">src->scale</map>
+		<map name="RND">src->rnd</map>
+		<map name="DMASK">src->dmask</map>
+		<map name="DFMT">src->dfmt</map>
+		<map name="SFMT">src->sfmt</map>
+	</encode>
+</bitset>
+
+<!-- ===================================================================== -->
+<!-- hw 09 test, hw 0f testmask                                             -->
+<!-- ===================================================================== -->
+
+<!-- fmt (h18) numbers operands as F16 halves, or as C10 for the group-2 ALU ops -->
+<expr name="#test-mode">{FMT} ? ((({ALU} &gt;&gt; 4) == 2) ? 2 : 1) : 0</expr>
+
+<bitset name="#test" extends="#instruction">
+	<doc>
+		The ALU op (l14-19) runs, and the condition tests its result:
+		cond = sign (h10-11) | zero (h8-9) &lt;&lt; 2 | AND (h7) &lt;&lt; 4. l20
+		says there is a destination; without one the dst field holds
+		the raw value nodst (default 0x280).
+	</doc>
+	<field name="S2N" low="0" high="6" type="uint"/>
+	<field name="S1N" low="7" high="13" type="uint"/>
+	<field name="ALU" low="14" high="19" type="#test-alu"/>
+	<field name="DW" pos="20" type="bool"/>
+	<field name="DN" low="21" high="27" type="uint"/>
+	<field name="S2B" low="28" high="29" type="uint"/>
+	<field name="S1B" low="30" high="31" type="uint"/>
+	<field name="DB" low="32" high="33" type="uint"/>
+	<field name="COMB" pos="39" type="uint"/>
+	<field name="ZERO" low="40" high="41" type="uint"/>
+	<field name="SIGN" low="42" high="43" type="uint"/>
+	<field name="MASK" low="44" high="47" type="#rm1"/>
+	<field name="S2E" pos="48" type="uint"/>
+	<field name="S1E" pos="49" type="uint"/>
+	<field name="FMT" pos="50" type="bool" display=" fmt"/>
+	<field name="DE" pos="51" type="uint"/>
+	<field name="SYNCS" pos="52" type="bool" display=" syncs"/>
+	<field name="F2_0" pos="53" type="bool" display=" f2_0"/>
+	<field name="NOSCHED" pos="54" type="bool" display=" nosched"/>
+	<field name="SKIPINV" pos="55" type="bool" display=" skipinv"/>
+	<field name="PRED" low="56" high="58" type="#pred3"/>
+	<derived name="COND" type="#test-cond">
+		<expr>{SIGN} | ({ZERO} &lt;&lt; 2) | ({COMB} &lt;&lt; 4)</expr>
+	</derived>
+	<derived name="TMODE" expr="#test-mode" type="uint"/>
+	<derived name="DST" type="#dst" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+		<param name="TMODE" as="MODE"/>
+	</derived>
+	<derived name="NODST" type="custom" width="10">
+		<expr>{DN} | ({DB} &lt;&lt; 7) | ({DE} &lt;&lt; 9)</expr>
+	</derived>
+	<derived name="SRC1" type="#src" width="10">
+		<expr>{S1N} | ({S1B} &lt;&lt; 7) | ({S1E} &lt;&lt; 9)</expr>
+		<param name="TMODE" as="MODE"/>
+	</derived>
+	<derived name="SRC2" type="#src" width="10">
+		<expr>{S2N} | ({S2B} &lt;&lt; 7) | ({S2E} &lt;&lt; 9)</expr>
+		<param name="TMODE" as="MODE"/>
+	</derived>
+	<encode>
+		<map name="ALU">src->alu</map>
+		<map name="DW">src->dst.file != SGX_ISA_FILE_NONE</map>
+		<map name="SIGN">src->tcond &amp; 3</map>
+		<map name="ZERO">(src->tcond &gt;&gt; 2) &amp; 3</map>
+		<map name="COMB">src->tcond &gt;&gt; 4</map>
+		<map name="MASK">src->mask</map>
+		<map name="F2_0">src->f2_0</map>
+		<map name="DN">SGX_TDST(SGX_EXPR(__test_mode)) &amp; 0x7f</map>
+		<map name="DB">(SGX_TDST(SGX_EXPR(__test_mode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="DE">SGX_TDST(SGX_EXPR(__test_mode)) &gt;&gt; 9</map>
+		<map name="S1N">SGX_SRC(1, SGX_EXPR(__test_mode)) &amp; 0x7f</map>
+		<map name="S1B">(SGX_SRC(1, SGX_EXPR(__test_mode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S1E">SGX_SRC(1, SGX_EXPR(__test_mode)) &gt;&gt; 9</map>
+		<map name="S2N">SGX_SRC(2, SGX_EXPR(__test_mode)) &amp; 0x7f</map>
+		<map name="S2B">(SGX_SRC(2, SGX_EXPR(__test_mode)) &gt;&gt; 7) &amp; 3</map>
+		<map name="S2E">SGX_SRC(2, SGX_EXPR(__test_mode)) &gt;&gt; 9</map>
+		<map name="PDST">src->pdst</map>
+		<map name="CHAN">src->chan</map>
+		<map name="TTYPE">src->ttype</map>
+	</encode>
+</bitset>
+
+<bitset name="test" extends="#test">
+	<override>
+		<expr>{DW}</expr>
+		<display>
+			{PRED}{NAME}{ALU}{COND} {PDST}, {DST}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {MASK} {CHAN} {FMT} {F2_0}]
+		</display>
+	</override>
+	<display>
+		{PRED}{NAME}{ALU}{COND} {PDST}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {MASK} {CHAN} {FMT} {F2_0} {NODST}]
+	</display>
+	<field name="PDST" low="34" high="35" type="#pn"/>
+	<field name="CHAN" low="36" high="38" type="#chan8"/>
+	<pattern low="59" high="63">01001</pattern>
+</bitset>
+
+<bitset name="testmask" extends="#test">
+	<override>
+		<expr>{DW}</expr>
+		<display>
+			{PRED}{NAME}{ALU}{COND}{TTYPE} {DST}, {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {MASK} {FMT} {F2_0}]
+		</display>
+	</override>
+	<display>
+		{PRED}{NAME}{ALU}{COND}{TTYPE} {SRC1}, {SRC2} [{SKIPINV} {NOSCHED} {SYNCS} {MASK} {FMT} {F2_0} {NODST}]
+	</display>
+	<pattern low="34" high="35">00</pattern>
+	<field name="TTYPE" low="36" high="37" type="#testmask-type"/>
+	<pattern pos="38">0</pattern>
+	<pattern low="59" high="63">01111</pattern>
+</bitset>
