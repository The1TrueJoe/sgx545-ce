# The X session kit-desktop starts (as root, the first client): lets "desk"
# connect, starts Xfce as desk, runs the smoke test, then waits on Xfce so the
# desktop stays for the tester.
xhost +si:localuser:desk > /dev/null
xrandr --verbose > /tmp/results/xrandr.txt 2>&1
U="runuser -u desk -- env HOME=/home/desk USER=desk DISPLAY=:0 XDG_RUNTIME_DIR=/tmp/desk-run"
mkdir -p -m 700 /tmp/desk-run && chown desk /tmp/desk-run
$U dbus-launch --exit-with-session startxfce4 > /tmp/results/xfce.txt 2>&1 &
x=$!
# the dark-panel workaround, once: a full modeset of the panel's output, with gma500's
# display registers (its read-only debugfs dump) and a screenshot before and after
O=/tmp/results
regs() {   # FILE: every gma500 register dump in debugfs (read-only)
	for f in /sys/kernel/debug/dri/*/*reg*; do [ -r "$f" ] && { echo "== $f"; cat "$f"; }; done > "$1" 2>&1
}
sleep 10
lvds=$(xrandr 2>/dev/null | awk '/^LVDS[^ ]* connected/ { print $1; exit }')
regs $O/display-regs-before.txt
import -window root -resize 50% "png:$O/screenshots/00-before-modeset.png" 2>/dev/null
if [ -n "$lvds" ]; then
	xrandr --output "$lvds" --off; sleep 1; xrandr --output "$lvds" --auto
	sleep 3
	what="modeset of $lvds (xrandr off, then auto)"
else
	what="no LVDS output connected, no modeset"
fi
regs $O/display-regs-after.txt
import -window root -resize 50% "png:$O/screenshots/00-after-modeset.png" 2>/dev/null
a=$(md5sum < $O/screenshots/00-before-modeset.png 2>/dev/null) b=$(md5sum < $O/screenshots/00-after-modeset.png 2>/dev/null)
[ "$a" = "$b" ] && same="the same" || same="different"
cmp -s $O/display-regs-before.txt $O/display-regs-after.txt && rsame="the same" || rsame="different"
printf '    %-5s %s\n' INFO "$what: screenshots $same, register dumps $rsame" > $O/modeset.txt
$U /usr/local/bin/kit-smoke /tmp/results > /tmp/results/smoke-log.txt 2>&1
touch /tmp/kit-smoke.done
wait $x
