+/**
+ * Find the render node of a device whose parent is \p parent (a resolved
+ * sysfs path): a render-only GPU that a display driver creates as a device
+ * of its own, as gma500 does for the SGX on an auxiliary device of its PCI
+ * function.  libdrm's device list leaves out devices on the auxiliary bus,
+ * so this reads \p sysfs_drm (/sys/class/drm) directly.
+ *
+ * \p name gets the node's name (renderD128); the lowest numbered one wins.
+ */
+bool
+loader_find_child_render_node(const char *sysfs_drm, const char *parent,
+                              char *name, size_t size)
+{
+   char path[PATH_MAX], real[PATH_MAX];
+   struct dirent *ent;
+   long best = -1;
+   DIR *dir = opendir(sysfs_drm);
+
+   if (!dir)
+      return false;
+   while ((ent = readdir(dir))) {
+      long n;
+
+      if (strncmp(ent->d_name, "renderD", 7) != 0)
+         continue;
+      n = strtol(ent->d_name + 7, NULL, 10);
+      snprintf(path, sizeof(path), "%s/%s/device/..", sysfs_drm, ent->d_name);
+      if (!realpath(path, real) || strcmp(real, parent) != 0)
+         continue;
+      if (best < 0 || n < best) {
+         best = n;
+         snprintf(name, size, "%s", ent->d_name);
+      }
+   }
+   closedir(dir);
+   return best >= 0;
+}
+
+/**
+ * Open the render node of a child device of \p kms_fd's device
+ * (loader_find_child_render_node) when its kernel driver is one of
+ * \p drivers.  Returns the fd, or -1.
+ */
+int
+loader_open_child_render_node(int kms_fd, const char * const drivers[],
+                              unsigned int n_drivers)
+{
+#ifdef __linux__
+   char path[PATH_MAX], parent[PATH_MAX], name[32];
+   drmVersionPtr version;
+   struct stat st;
+   bool found = false;
+   int fd;
+
+   if (fstat(kms_fd, &st) || !S_ISCHR(st.st_mode))
+      return -1;
+   snprintf(path, sizeof(path), "/sys/dev/char/%u:%u/device",
+            major(st.st_rdev), minor(st.st_rdev));
+   if (!realpath(path, parent) ||
+       !loader_find_child_render_node("/sys/class/drm", parent, name,
+                                      sizeof(name)))
+      return -1;
+   snprintf(path, sizeof(path), "%s/%s", DRM_DIR_NAME, name);
+   fd = loader_open_device(path);
+   if (fd < 0)
+      return -1;
+   version = drmGetVersion(fd);
+   for (unsigned i = 0; version && i < n_drivers; i++)
+      found |= strcmp(version->name, drivers[i]) == 0;
+   drmFreeVersion(version);
+   if (!found) {
+      close(fd);
+      return -1;
+   }
+   return fd;
+#else
+   return -1;
+#endif
+}
+
+#ifdef __linux__
+static bool
+sysfs_link_name(const char *dir, const char *link, char *name, size_t size)
+{
+   char path[PATH_MAX], real[PATH_MAX];
+   const char *base;
+
+   snprintf(path, sizeof(path), "%s/%s", dir, link);
+   if (!realpath(path, real))
+      return false;
+   base = strrchr(real, '/');
+   snprintf(name, size, "%s", base ? base + 1 : real);
+   return true;
+}
+
+static bool
+sysfs_hex(const char *dir, const char *file, unsigned *value)
+{
+   char path[PATH_MAX];
+   FILE *f;
+   bool ok;
+
+   snprintf(path, sizeof(path), "%s/%s", dir, file);
+   if (!(f = fopen(path, "r")))
+      return false;
+   ok = fscanf(f, "%x", value) == 1;
+   fclose(f);
+   return ok;
+}
+#endif
+
+drmDevicePtr
+loader_drm_device_from_sysfs(const char *sysfs, unsigned maj, unsigned min)
+{
+#ifdef __linux__
+   char path[PATH_MAX], dev[PATH_MAX], parent[PATH_MAX], name[NAME_MAX + 1];
+   unsigned domain, bus, slot, func, vendor, device, sub_vendor = 0,
+            sub_device = 0, revision = 0;
+   char nodes[DRM_NODE_MAX][32] = {{0}};
+   int available = 0;
+   struct dirent *ent;
+   DIR *dir;
+
+   snprintf(path, sizeof(path), "%s/dev/char/%u:%u/device", sysfs, maj, min);
+   if (!realpath(path, dev) ||
+       !sysfs_link_name(dev, "subsystem", name, sizeof(name)) ||
+       strcmp(name, "auxiliary") != 0)
+      return NULL;
+   snprintf(path, sizeof(path), "%s/..", dev);
+   if (!realpath(path, parent) ||
+       !sysfs_link_name(parent, "subsystem", name, sizeof(name)) ||
+       strcmp(name, "pci") != 0 || !strrchr(parent, '/') ||
+       sscanf(strrchr(parent, '/') + 1, "%x:%x:%x.%u", &domain, &bus, &slot,
+              &func) != 4 ||
+       !sysfs_hex(parent, "vendor", &vendor) ||
+       !sysfs_hex(parent, "device", &device))
+      return NULL;
+   sysfs_hex(parent, "subsystem_vendor", &sub_vendor);
+   sysfs_hex(parent, "subsystem_device", &sub_device);
+   sysfs_hex(parent, "revision", &revision);
+
+   /* the auxiliary device's own nodes */
+   snprintf(path, sizeof(path), "%s/drm", dev);
+   if (!(dir = opendir(path)))
+      return NULL;
+   while ((ent = readdir(dir))) {
+      int type = !strncmp(ent->d_name, "renderD", 7) ? DRM_NODE_RENDER
+                 : !strncmp(ent->d_name, "card", 4)  ? DRM_NODE_PRIMARY
+                                                     : -1;
+
+      if (type < 0 || (available & (1 << type)))
+         continue;
+      snprintf(nodes[type], sizeof(nodes[type]), "%s/%s", DRM_DIR_NAME,
+               ent->d_name);
+      available |= 1 << type;
+   }
+   closedir(dir);
+   if (!available)
+      return NULL;
+
+   /* one block, as libdrm allocates it: drmFreeDevice frees it */
+   size_t size = sizeof(drmDevice) + DRM_NODE_MAX * sizeof(char *) +
+                 sizeof(nodes) + sizeof(drmPciBusInfo) +
+                 sizeof(drmPciDeviceInfo);
+   drmDevicePtr d = calloc(1, size);
+   if (!d)
+      return NULL;
+   char *p = (char *)(d + 1);
+
+   d->nodes = (char **)p;
+   p += DRM_NODE_MAX * sizeof(char *);
+   for (int i = 0; i < DRM_NODE_MAX; i++) {
+      d->nodes[i] = p + i * sizeof(nodes[0]);
+      memcpy(d->nodes[i], nodes[i], sizeof(nodes[0]));
+   }
+   p += sizeof(nodes);
+   d->available_nodes = available;
+   d->bustype = DRM_BUS_PCI;
+   d->businfo.pci = (drmPciBusInfoPtr)p;
+   d->businfo.pci->domain = domain;
+   d->businfo.pci->bus = bus;
+   d->businfo.pci->dev = slot;
+   d->businfo.pci->func = func;
+   p += sizeof(drmPciBusInfo);
+   d->deviceinfo.pci = (drmPciDeviceInfoPtr)p;
+   d->deviceinfo.pci->vendor_id = vendor;
+   d->deviceinfo.pci->device_id = device;
+   d->deviceinfo.pci->subvendor_id = sub_vendor;
+   d->deviceinfo.pci->subdevice_id = sub_device;
+   d->deviceinfo.pci->revision_id = revision;
+   return d;
+#else
+   return NULL;
+#endif
+}
+
+int
+loader_drm_get_device(int fd, drmDevicePtr *device)
+{
+   struct stat st;
+
+   if (drmGetDevice2(fd, 0, device) == 0)
+      return 0;
+#ifdef __linux__
+   if (!fstat(fd, &st) && S_ISCHR(st.st_mode) &&
+       (*device = loader_drm_device_from_sysfs("/sys", major(st.st_rdev),
+                                               minor(st.st_rdev))))
+      return 0;
+#endif
+   return -ENODEV;
+}
+
+/* the render nodes in sysfs/class/drm that none of devices[0..n) has, as
+ * loader_drm_device_from_sysfs describes them; with devices NULL, counted */
+int
+loader_drm_add_sysfs_devices(const char *sysfs, drmDevicePtr devices[], int n,
+                             int max_devices)
+{
+#ifdef __linux__
+   char path[PATH_MAX];
+   struct dirent *ent;
+   DIR *dir;
+
+   snprintf(path, sizeof(path), "%s/class/drm", sysfs);
+   if (!(dir = opendir(path)))
+      return n;
+   while ((ent = readdir(dir))) {
+      unsigned maj, min;
+      drmDevicePtr d;
+      FILE *f;
+      bool known = false;
+
+      if (strncmp(ent->d_name, "renderD", 7) != 0)
+         continue;
+      snprintf(path, sizeof(path), "%s/class/drm/%s/dev", sysfs, ent->d_name);
+      if (!(f = fopen(path, "r")))
+         continue;
+      if (fscanf(f, "%u:%u", &maj, &min) != 2) {
+         fclose(f);
+         continue;
+      }
+      fclose(f);
+      if (!(d = loader_drm_device_from_sysfs(sysfs, maj, min)))
+         continue;
+      for (int i = 0; devices && i < n && !known; i++)
+         known = (devices[i]->available_nodes & (1 << DRM_NODE_RENDER)) &&
+                 !strcmp(devices[i]->nodes[DRM_NODE_RENDER],
+                         d->nodes[DRM_NODE_RENDER]);
+      if (known || (devices && n >= max_devices)) {
+         drmFreeDevice(&d);
+         continue;
+      }
+      if (devices)
+         devices[n] = d;
+      else
+         drmFreeDevice(&d);
+      n++;
+   }
+   closedir(dir);
+#endif
+   return n;
+}
+
+int
+loader_drm_get_devices(drmDevicePtr devices[], int max_devices)
+{
+   int n = drmGetDevices2(0, devices, max_devices);
+
+   if (n < 0)
+      n = 0;
+   return loader_drm_add_sysfs_devices("/sys", devices, n, max_devices);
+}
