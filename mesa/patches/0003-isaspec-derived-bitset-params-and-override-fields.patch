diff --git a/src/compiler/isaspec/encode.py b/src/compiler/isaspec/encode.py
index da94d59..24690f7 100755
--- a/src/compiler/isaspec/encode.py
+++ b/src/compiler/isaspec/encode.py
@@ -212,6 +212,19 @@ class State(object):
                                     if target_name not in unique_names:
                                         yield target_name
                                         unique_names.append(target_name)
+        # Derived fields of bitset type aren't encoded themselves (their
+        # expression's fields are), but their params still reach the
+        # bitset's own expressions:
+        for name, bitset in self.isa.all_bitsets():
+            for case in bitset.cases:
+                for field in case.fields.values():
+                    if isinstance(field, BitSetDerivedField) and \
+                       field.get_c_typename() == 'TYPE_BITSET':
+                        for param in field.params:
+                            target_name = param[1]
+                            if target_name not in unique_names:
+                                yield target_name
+                                unique_names.append(target_name)
 
     def case_name(self, bitset, name):
        return bitset.encode.case_prefix + name.upper().replace('.', '_').replace('-', '_').replace('#', '')
diff --git a/src/compiler/isaspec/isa.py b/src/compiler/isaspec/isa.py
index e5ba462..6d898c2 100644
--- a/src/compiler/isaspec/isa.py
+++ b/src/compiler/isaspec/isa.py
@@ -178,6 +178,14 @@ class BitSetDerivedField(BitSetField):
         if 'display' in xml.attrib:
             self.display = xml.attrib['display'].strip()
         self.call = 'call' in xml.attrib and xml.attrib['call'] == 'true'
+        # A derived field may have a bitset type (e.g. an operand whose bits
+        # are scattered across the instruction), and pass it parameters:
+        self.params = []
+        for param in xml.findall('param'):
+            aas = name = param.attrib['name']
+            if 'as' in param.attrib:
+                aas = param.attrib['as']
+            self.params.append([name, aas])
 
