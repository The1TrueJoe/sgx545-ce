+++ b/.clang-format-include
@@ -13,3 +13,6 @@ src/egl/**/*
 src/etnaviv/isa/**/*
 src/imagination/**/*
 src/kosmickrisp/**/*
+src/sgx/csbgen/**/*
+src/sgx/isa/**/*
+src/sgx/pds/**/*
