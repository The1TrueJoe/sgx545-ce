+(p0) fmad r1, r2, r3, r4
+(!p0) fmad r1, r2, r3, r4 [skipinv]
+(p3) fmad r1, r2, r3, r4
+(!p1) fmad r1, r2, r3, r4
+fmad r123, pa127, sa127, i3
+fmad r0, r1, g17, i0
