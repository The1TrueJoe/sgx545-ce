+/**
+ * Find the render node of a device whose parent is \p parent (a resolved
+ * sysfs path): a render-only GPU that a display driver creates as a device
+ * of its own, as gma500 does for the SGX on an auxiliary device of its PCI
+ * function.  libdrm's device list leaves out devices on the auxiliary bus,
+ * so this reads \p sysfs_drm (/sys/class/drm) directly.
+ *
+ * \p name gets the node's name (renderD128); the lowest numbered one wins.
+ */
+bool
+loader_find_child_render_node(const char *sysfs_drm, const char *parent,
+                              char *name, size_t size)
+{
+   char path[PATH_MAX], real[PATH_MAX];
+   struct dirent *ent;
+   long best = -1;
+   DIR *dir = opendir(sysfs_drm);
+
+   if (!dir)
+      return false;
+   while ((ent = readdir(dir))) {
+      long n;
+
+      if (strncmp(ent->d_name, "renderD", 7) != 0)
+         continue;
+      n = strtol(ent->d_name + 7, NULL, 10);
+      snprintf(path, sizeof(path), "%s/%s/device/..", sysfs_drm, ent->d_name);
+      if (!realpath(path, real) || strcmp(real, parent) != 0)
+         continue;
+      if (best < 0 || n < best) {
+         best = n;
+         snprintf(name, size, "%s", ent->d_name);
+      }
+   }
+   closedir(dir);
+   return best >= 0;
+}
+
+/**
+ * Open the render node of a child device of \p kms_fd's device
+ * (loader_find_child_render_node) when its kernel driver is one of
+ * \p drivers.  Returns the fd, or -1.
+ */
+int
+loader_open_child_render_node(int kms_fd, const char * const drivers[],
+                              unsigned int n_drivers)
+{
+#ifdef __linux__
+   char path[PATH_MAX], parent[PATH_MAX], name[32];
+   drmVersionPtr version;
+   struct stat st;
+   bool found = false;
+   int fd;
+
+   if (fstat(kms_fd, &st) || !S_ISCHR(st.st_mode))
+      return -1;
+   snprintf(path, sizeof(path), "/sys/dev/char/%u:%u/device",
+            major(st.st_rdev), minor(st.st_rdev));
+   if (!realpath(path, parent) ||
+       !loader_find_child_render_node("/sys/class/drm", parent, name,
+                                      sizeof(name)))
+      return -1;
+   snprintf(path, sizeof(path), "%s/%s", DRM_DIR_NAME, name);
+   fd = loader_open_device(path);
+   if (fd < 0)
+      return -1;
+   version = drmGetVersion(fd);
+   for (unsigned i = 0; version && i < n_drivers; i++)
+      found |= strcmp(version->name, drivers[i]) == 0;
+   drmFreeVersion(version);
+   if (!found) {
+      close(fd);
+      return -1;
+   }
+   return fd;
+#else
+   return -1;
+#endif
+}
