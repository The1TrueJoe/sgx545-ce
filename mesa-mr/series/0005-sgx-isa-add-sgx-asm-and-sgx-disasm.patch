@@ -47,7 +49,29 @@ line:
 `meson test --suite sgx` runs `sgx_isa` (with `-Dbuild-tests=true`):
 every line of the lists is assembled, encoded, disassembled and compared
 with its input, and a line that gives `; <lo> <hi>` must encode to those
-words.
+words. `sgx_isa_tools` puts the same lines through `sgx-asm` and
+`sgx-disasm`, as hex and as binary.
+
+## Tools
+
+With `-Dtools=sgx`, Mesa builds two command-line tools; both
+only read and write files.
+
+    sgx-asm [-c core] [-F fc] [-b | -L] [-o out] [file...]
+    sgx-disasm [-c core] [-F fc] [-x] [-w] [file...]
+
+`sgx-asm` assembles a whole file in one run, one instruction per line. It
+writes one output per instruction, in order: `<lo> <hi>` in hex (the
+default), the words in binary, low word first and little endian (`-b`), or a
+listing of offset, words and disassembly (`-L`). Blank lines and lines
+starting with `#` are skipped, and `;` starts a comment. An error is reported
+as `<file>:<line>: <text>: <message>`, and the exit status is then 1.
+`sgx-disasm` reads binary, or with `-x` the first two hex words of each line
+(so the output of `sgx-asm` and of `sgx-disasm -w` read back). It prints the
+text, or with `-w` the words and the text.
+`-c` selects the core (545, the default), and `-F` the starting format
+control (1 = C10, 2 = F16; 1 by default). Both tools follow `setfc` from
+there.
 
 ## Cores
 
diff --git a/src/sgx/isa/assembler.c b/src/sgx/isa/assembler.c
new file mode 100644
index 0000000..f641bf2
--- /dev/null
+++ b/src/sgx/isa/assembler.c
@@ -0,0 +1,193 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * sgx-asm: assemble the USSE text notation (README.md), one instruction per
+ * line.
+ *
+ *    sgx-asm [-c core] [-F fc] [-b | -L] [-o out] [file...]
+ *
+ * Reads the files (or stdin) in one pass and writes one instruction per input
+ * instruction, in order:
+ *    (default) "<lo> <hi>" in hex, one line each;
+ *    -b        the words, low word first, little endian;
+ *    -L        a listing, "<offset>: <lo> <hi>  <disassembly>".
+ * Blank lines and lines starting with '#' are skipped; ';' starts a comment.
+ * -c selects the core (545 or sgx545, the default); -F the format control at
+ * the start (bit 0 C10, bit 1 F16; default 1, the program-start state). setfc
+ * instructions change it for the lines after them. Errors go to stderr as
+ * "<file>:<line>: <text>: <message>"; the exit status is 1 if there was one.
+ */
+
+#include <errno.h>
+#include <getopt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sgx_isa.h"
+#include "sgx_isa_asm.h"
+
+enum out_mode {
+   OUT_HEX,
+   OUT_BIN,
+   OUT_LIST,
+};
+
+struct asm_state {
+   struct sgx_isa_fc fc;
+   enum out_mode mode;
+   FILE *out;
+   unsigned offset;
+   unsigned errors;
+};
+
+static void
+put_le32(FILE *out, uint32_t v)
+{
+   uint8_t b[4] = {v, v >> 8, v >> 16, v >> 24};
+
+   fwrite(b, 1, sizeof(b), out);
+}
+
+static void
+assemble_line(struct asm_state *st, const char *name, unsigned lineno,
+              char *line)
+{
+   struct sgx_isa_instr I;
+   char err[256];
+
+   line[strcspn(line, "\r\n")] = '\0';
+   char *text = line + strspn(line, " \t");
+   if (!*text || *text == '#' || *text == ';')
+      return;
+
+   if (!sgx_isa_asm_line(text, &I, err, sizeof(err))) {
+      fprintf(stderr, "%s:%u: %s: %s\n", name, lineno, text, err);
+      st->errors++;
+      return;
+   }
+
+   uint64_t w = sgx_isa_encode(&I, &st->fc);
+   uint32_t lo = w, hi = w >> 32;
+
+   switch (st->mode) {
+   case OUT_HEX:
+      fprintf(st->out, "%08x %08x\n", lo, hi);
+      break;
+   case OUT_BIN:
+      put_le32(st->out, lo);
+      put_le32(st->out, hi);
+      break;
+   case OUT_LIST: {
+      char dis[512];
+
+      sgx_disasm_one(w, &st->fc, dis, sizeof(dis));
+      fprintf(st->out, "%06x: %08x %08x  %s\n", st->offset, lo, hi, dis);
+      break;
+   }
+   }
+   st->offset += 8;
+   sgx_isa_setfc(w, &st->fc);
+}
+
+static void
+assemble_file(struct asm_state *st, const char *name, FILE *in)
+{
+   char line[1024];
+   unsigned lineno = 0;
+
+   while (fgets(line, sizeof(line), in)) {
+      lineno++;
+      assemble_line(st, name, lineno, line);
+   }
+}
+
+/* "545" or "sgx545"; 0 if sgx.xml doesn't describe it */
+static unsigned
+parse_core(const char *arg)
+{
+   char *end;
+
+   if (!strncmp(arg, "sgx", 3))
+      arg += 3;
+   unsigned long core = strtoul(arg, &end, 10);
+   return *arg && !*end && core && sgx_isa_core_supported(core) ? core : 0;
+}
+
+static void
+usage(void)
+{
+   fprintf(stderr,
+           "usage: sgx-asm [-c core] [-F fc] [-b | -L] [-o out] [file...]\n");
+   exit(2);
+}
+
+int
+main(int argc, char **argv)
+{
+   struct asm_state st = {
+      .fc = SGX_ISA_FC_START,
+      .mode = OUT_HEX,
+   };
+   const char *out_name = NULL;
+   int opt;
+
+   while ((opt = getopt(argc, argv, "c:F:bLo:h")) != -1) {
+      switch (opt) {
+      case 'c':
+         st.fc.core = parse_core(optarg);
+         if (!st.fc.core) {
+            fprintf(stderr, "sgx-asm: core %s is not in sgx.xml\n", optarg);
+            return 2;
+         }
+         break;
+      case 'F': {
+         unsigned fc = strtoul(optarg, NULL, 0);
+         st.fc.c10 = fc & 1;
+         st.fc.f16 = fc & 2;
+         break;
+      }
+      case 'b':
+         st.mode = OUT_BIN;
+         break;
+      case 'L':
+         st.mode = OUT_LIST;
+         break;
+      case 'o':
+         out_name = optarg;
+         break;
+      default:
+         usage();
+      }
+   }
+
+   st.out =
+      out_name ? fopen(out_name, st.mode == OUT_BIN ? "wb" : "w") : stdout;
+   if (!st.out) {
+      fprintf(stderr, "sgx-asm: %s: %s\n", out_name, strerror(errno));
+      return 2;
+   }
+
+   if (optind == argc)
+      assemble_file(&st, "<stdin>", stdin);
+   for (int i = optind; i < argc; i++) {
+      FILE *in = fopen(argv[i], "r");
+
+      if (!in) {
+         fprintf(stderr, "sgx-asm: %s: %s\n", argv[i], strerror(errno));
+         st.errors++;
+         continue;
+      }
+      assemble_file(&st, argv[i], in);
+      fclose(in);
+   }
+
+   if (fclose(st.out)) {
+      fprintf(stderr, "sgx-asm: write error: %s\n", strerror(errno));
+      return 2;
+   }
+   return st.errors ? 1 : 0;
+}
diff --git a/src/sgx/isa/disasm.c b/src/sgx/isa/disasm.c
new file mode 100644
index 0000000..14bface
--- /dev/null
+++ b/src/sgx/isa/disasm.c
@@ -0,0 +1,163 @@
+/*
+ * Copyright © 2026 Joseph Telaak
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * sgx-disasm: disassemble USSE instructions to the USSE text notation
+ * (README.md).
+ *
+ *    sgx-disasm [-c core] [-F fc] [-x] [-w] [file...]
+ *
+ * Reads the files (or stdin): words, low word first, little endian, or with
+ * -x hex text, the first two words of each line (so sgx-asm's output and
+ * -w's read back; '#' and ';' lines are skipped). Writes one line per
+ * instruction, the text alone, or with -w "<lo> <hi>  <text>". -c and -F as
+ * for sgx-asm; setfc words change the format control for the words after
+ * them. The exit status is 1 if a word didn't decode.
+ */
+
+#include <errno.h>
+#include <getopt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sgx_isa.h"
+
+struct dis_state {
+   struct sgx_isa_fc fc;
+   bool words;
+   unsigned errors;
+};
+
+static void
+disasm_word(struct dis_state *st, uint32_t lo, uint32_t hi)
+{
+   uint64_t w = lo | (uint64_t)hi << 32;
+   char dis[512];
+
+   if (!sgx_disasm_one(w, &st->fc, dis, sizeof(dis)))
+      st->errors++;
+   if (st->words)
+      printf("%08x %08x  %s\n", lo, hi, dis);
+   else
+      printf("%s\n", dis);
+   sgx_isa_setfc(w, &st->fc);
+}
+
+static void
+disasm_bin(struct dis_state *st, const char *name, FILE *in)
+{
+   uint8_t b[8];
+   size_t n;
+
+   while ((n = fread(b, 1, sizeof(b), in)) == sizeof(b)) {
+      disasm_word(st, b[0] | b[1] << 8 | b[2] << 16 | (uint32_t)b[3] << 24,
+                  b[4] | b[5] << 8 | b[6] << 16 | (uint32_t)b[7] << 24);
+   }
+   if (n) {
+      fprintf(stderr, "%s: %zu trailing bytes\n", name, n);
+      st->errors++;
+   }
+}
+
+static void
+disasm_hex(struct dis_state *st, const char *name, FILE *in)
+{
+   char line[1024];
+   unsigned lineno = 0;
+
+   while (fgets(line, sizeof(line), in)) {
+      char *text = line + strspn(line, " \t");
+      uint32_t lo, hi;
+
+      lineno++;
+      if (!*text || *text == '\n' || *text == '#' || *text == ';')
+         continue;
+      if (sscanf(text, "%x %x", &lo, &hi) != 2) {
+         text[strcspn(text, "\r\n")] = '\0';
+         fprintf(stderr, "%s:%u: not two hex words: %s\n", name, lineno, text);
+         st->errors++;
+         continue;
+      }
+      disasm_word(st, lo, hi);
+   }
+}
+
+/* "545" or "sgx545"; 0 if sgx.xml doesn't describe it */
+static unsigned
+parse_core(const char *arg)
+{
+   char *end;
+
+   if (!strncmp(arg, "sgx", 3))
+      arg += 3;
+   unsigned long core = strtoul(arg, &end, 10);
+   return *arg && !*end && core && sgx_isa_core_supported(core) ? core : 0;
+}
+
+static void
+usage(void)
+{
+   fprintf(stderr, "usage: sgx-disasm [-c core] [-F fc] [-x] [-w] [file...]\n");
+   exit(2);
+}
+
+int
+main(int argc, char **argv)
+{
+   struct dis_state st = {
+      .fc = SGX_ISA_FC_START,
+   };
+   bool hex = false;
+   int opt;
+
+   while ((opt = getopt(argc, argv, "c:F:xwh")) != -1) {
+      switch (opt) {
+      case 'c':
+         st.fc.core = parse_core(optarg);
+         if (!st.fc.core) {
+            fprintf(stderr, "sgx-disasm: core %s is not in sgx.xml\n", optarg);
+            return 2;
+         }
+         break;
+      case 'F': {
+         unsigned fc = strtoul(optarg, NULL, 0);
+         st.fc.c10 = fc & 1;
+         st.fc.f16 = fc & 2;
+         break;
+      }
+      case 'x':
+         hex = true;
+         break;
+      case 'w':
+         st.words = true;
+         break;
+      default:
+         usage();
+      }
+   }
+
+   if (optind == argc) {
+      if (hex)
+         disasm_hex(&st, "<stdin>", stdin);
+      else
+         disasm_bin(&st, "<stdin>", stdin);
+   }
+   for (int i = optind; i < argc; i++) {
+      FILE *in = fopen(argv[i], hex ? "r" : "rb");
+
+      if (!in) {
+         fprintf(stderr, "sgx-disasm: %s: %s\n", argv[i], strerror(errno));
+         st.errors++;
+         continue;
+      }
+      if (hex)
+         disasm_hex(&st, argv[i], in);
+      else
+         disasm_bin(&st, argv[i], in);
+      fclose(in);
+   }
+   return st.errors ? 1 : 0;
+}
