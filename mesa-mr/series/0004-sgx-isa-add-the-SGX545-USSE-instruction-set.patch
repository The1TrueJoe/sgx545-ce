+/*
+ * Operand patterns: D dst, 0/1/2 src slots, P pdst (pN), Q pdst with .nw,
+ * I i<n> second dst, C/c clip planes, T #target, V #value (into v[]),
+ * L smlsi operand, A #a (setfc), N #n, M #imm (into imm), E #imm11 (eld),
+ * U #temps4 (phas.i).
+ */
+static bool
+parse_operands(struct asm_ctx *c, struct sgx_isa_instr *I, const char *pat,
+               char **ops, unsigned nops)
+{
+   unsigned vi = 0, ai = 0;
+
+   if (strlen(pat) != nops)
+      return fail(c, "wrong operand count for pattern %s", pat);
+
+   for (unsigned i = 0; i < nops; i++) {
+      char *s = trim(ops[i]);
+      int64_t v;
+      int p;
+      switch (pat[i]) {
+      case 'D':
+         if (!parse_operand(c, s, &I->dst))
+            return false;
+         break;
+      case '0':
+      case '1':
+      case '2': {
+         struct sgx_isa_src *o = &I->src[pat[i] - '0'];
+         if (!parse_operand(c, s, o))
+            return false;
+         break;
+      }
+      case 'P':
+      case 'Q':
+         p = parse_pn(s);
+         if (p < 0)
+            return fail(c, "expected pN, got '%s'", s);
+         I->pdst = p;
+         if (pat[i] == 'Q')
+            I->pw = !strstr(s, ".nw");
+         break;
+      case 'I':
+         if (strcmp(s, "i0") && strcmp(s, "i1"))
+            return fail(c, "expected i0/i1, got '%s'", s);
+         I->idst = s[1] - '0';
+         break;
+      case 'C':
+      case 'c':
+         if (strncmp(s, "cp", 2) || !parse_int(s + 2, &v))
+            return fail(c, "expected cp<n>, got '%s'", s);
+         if (!STORE(I->cp[pat[i] == 'c'], v))
+            return fail(c, "%s doesn't fit its field", s);
+         break;
+      case 'T':
+         if (!parse_hash(c, s, &v))
+            return false;
+         if (!STORE(I->target, v))
+            return fail(c, "%s doesn't fit its field", s);
+         break;
+      case 'V':
+         if (!parse_hash(c, s, &v))
+            return false;
+         if (!STORE(I->v[vi], v))
+            return fail(c, "%s doesn't fit its field", s);
+         vi++;
+         break;
+      case 'L':
+         if (!strncmp(s, "#0.", 3) && strlen(s) == 7) {
+            unsigned sw = 0;
+            for (unsigned k = 0; k < 4; k++) {
+               const char *ch = strchr("xyzw", s[3 + k]);
+               if (!ch)
+                  return fail(c, "bad swizzle '%s'", s);
+               sw |= (ch - "xyzw") << (2 * k);
+            }
+            I->swzf[vi] = true;
+            I->v[vi++] = sw;
+         } else {
+            if (!parse_hash(c, s, &v))
+               return false;
+            if (v < -128 || v > 255)
+               return fail(c, "%s doesn't fit its field", s);
+            I->v[vi++] = v & 0xff;
+         }
+         break;
+      case 'A':
+         if (!parse_hash(c, s, &v))
+            return false;
+         if (!STORE(I->a[ai], v))
+            return fail(c, "%s doesn't fit its field", s);
+         ai++;
+         break;
+      case 'N':
+         if (!parse_hash(c, s, &v))
+            return false;
+         if (!STORE(I->n, v))
+            return fail(c, "%s doesn't fit its field", s);
+         break;
+      case 'U':
+         if (!parse_hash(c, s, &v))
+            return false;
+         if (!STORE(I->temps4, v))
+            return fail(c, "%s doesn't fit its field", s);
+         break;
+      case 'M':
+      case 'E':
+         if (!parse_hash(c, s, &v))
+            return false;
+         I->imm = (uint32_t)v;
+         break;
+      default:
+         return fail(c, "bad pattern %s", pat);
+      }
+   }
+   return true;
+}
